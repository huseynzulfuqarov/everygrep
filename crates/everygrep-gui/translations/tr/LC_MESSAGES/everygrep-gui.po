msgstr "Her ikinci satırın arka planı biraz farklıdır; bu, uzun satırları izlemeyi kolaylaştırır."

#: ui/settings.slint
msgid "Opening"
msgstr "Açma"

#: ui/settings.slint
msgid "Double-click in the Folder column opens the folder"
msgstr "Klasör sütununda çift tıklama klasörü açar"

#: ui/settings.slint
msgid "Off: a double-click anywhere in a row opens the item itself."
msgstr "Kapalıyken satırın herhangi bir yerine çift tıklama öğenin kendisini açar."

#: ui/settings.slint
msgid "Sizes"
msgstr "Boyutlar"

#: ui/settings.slint
msgid "Size format"
msgstr "Boyut biçimi"

#: ui/settings.slint
msgid "Size units"
msgstr "Boyut standardı"

#: ui/settings.slint
msgid "For the Size column and the status line. Automatic shows bytes below one kilobyte, then the largest unit that fits. Size searches (size:) always count 1 KB as 1024 bytes."
msgstr "Boyut sütunu ve durum satırı için. Otomatik, bir kilobayttan küçük boyutları bayt olarak, diğerlerini sığan en büyük birimle gösterir. Boyut aramaları (size:) 1 KB'ı her zaman 1024 bayt sayar."

#: src/labels.rs
msgid "Automatic"
msgstr "Otomatik"

#: src/labels.rs
msgid "Bytes"
msgstr "Bayt"

#: src/labels.rs
msgid "1 KB = 1024 bytes"
msgstr "1 KB = 1024 bayt"

#: src/labels.rs
msgid "1 KiB = 1024 bytes"
msgstr "1 KiB = 1024 bayt"

#: src/labels.rs
msgid "1 KB = 1000 bytes"
msgstr "1 KB = 1000 bayt"

#: src/commands.rs
msgid "Refresh"
msgstr "Yenile"

#: src/commands.rs
msgid "Copy path with quotes"
msgstr "Yolu tırnakla kopyala"

#: src/commands.rs
msgid "Copy full path with quotes"
msgstr "Tam yolu tırnakla kopyala"

#: ui/settings.slint
msgid "Copying"
msgstr "Kopyalama"

#: ui/settings.slint
msgid "Copy full path adds quotes"
msgstr "Tam yol kopyalanırken tırnak ekle"

#: ui/settings.slint
msgid "Each path is put in double quotes, as Copy full path with quotes does."
msgstr "Her yol, \"Tam yolu tırnakla kopyala\" komutundaki gibi çift tırnak içine alınır."

#: src/main.rs
msgid "Open {} item?"
msgid_plural "Open {} items?"
msgstr[0] "{} öğe açılsın mı?"
msgstr[1] "{} öğe açılsın mı?"

#: src/main.rs
msgid "Each one opens in its own application."
msgstr "Her biri kendi uygulamasında açılır."

#: ui/settings.slint
msgid "Ask before opening more items than"
msgstr "Şundan fazla öğe açmadan önce sor"

#: ui/settings.slint
msgid "Opening the selection asks first when it holds more items than this. 0 opens any number without asking."
msgstr "Seçim bundan fazla öğe içerdiğinde açmadan önce sorulur. 0, istenen sayıda öğeyi sormadan açar."

#: ui/settings.slint
msgid "Clear the selection when the search changes"
msgstr "Arama değiştiğinde seçimi temizle"

#: ui/settings.slint
msgid "Off: the selected items stay selected while the new results list them. Sorting and file changes never clear it."
msgstr "Kapalıyken seçili öğeler yeni sonuçlarda listelendikçe seçili kalır. Sıralama ve dosya değişiklikleri seçimi asla temizlemez."

#: ui/app.slint
msgid "Size column to fit"
msgstr "Sütunu içeriğe sığdır"

#: src/commands.rs
msgid "Size all columns to fit"
msgstr "Tüm sütunları içeriğe sığdır"

#: src/commands.rs
msgid "Fit columns to window"
msgstr "Tüm sütunları pencereye sığdır"

msgid "Show active matching modes in the status line"
msgstr "Etkin eşleştirme kiplerini durum satırında göster"

msgid "Wrap when moving to the next or previous filter"
msgstr "Sonraki veya önceki filtreye geçerken listeyi döngüle"

msgid "Match wildcards anywhere in the filename"
msgstr "Jokerleri dosya adının herhangi bir yerinde eşleştir"
