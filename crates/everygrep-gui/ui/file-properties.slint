import { Button, TextEdit } from "std-widgets.slint";
import { Theme, PopupCard } from "theme.slint";
export component FilePropertiesDialog inherits Rectangle {
    in property <string> text;
    callback close();
    background: #00000060;
    TouchArea { clicked => { root.close(); } }
    FocusScope {
        init => { editor.focus(); }
        key-pressed(e) => { if (e.text == Key.Escape) { root.close(); return accept; } return reject; }
        PopupCard {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(680px, parent.width - 2 * Theme.s5);
            height: min(540px, parent.height - 2 * Theme.s5);
            TouchArea { }
            VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.s3;
                Text { text: @tr("Properties"); color: Theme.text; font-size: Theme.body + 2px; font-weight: 600; }
                editor := TextEdit { text: root.text; read-only: true; wrap: word-wrap; vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    Button { text: @tr("Close"); clicked => { root.close(); } }
                }
            }
        }
    }
}
