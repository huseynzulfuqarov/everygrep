        if (c == 34) { root.show-dimensions = on; root.column-shown(c, on); return; }
        if (c == 35) { root.show-length = on; root.column-shown(c, on); return; }
        if (c == 36) { root.show-bit-rate = on; root.column-shown(c, on); return; }
