    in-out property <bool> organize-open;
    in-out property <string> organize-filter;
    // The columns of Organize columns that match the column search (see
    // src/columns.rs).
    pure callback filter-columns([ColumnChoice], string) -> [ColumnChoice];
    // Every column for Organize columns, in the order of the list.
    out property <[ColumnChoice]> column-choices: [
        { title: @tr("Name"), column: 0, checked: true, enabled: false },
        { title: @tr("Folder"), column: 1, checked: true, enabled: false },
        { title: @tr("Size"), column: 2, checked: true, enabled: false },
        { title: @tr("Modified"), column: 3, checked: true, enabled: false },
        { title: @tr("Type"), column: 4, checked: root.show-type, enabled: true },
