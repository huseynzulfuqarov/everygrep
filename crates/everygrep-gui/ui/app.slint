                                    right-pressed(x, y) => { root.menu-column = 56; header-menu.show({ x: self.x + x, y: y }); }
                                }
                            }
                            // Boundary grips, on top of the cells.
                            // A double-click on a grip sizes the column on its left to fit.
                            ColumnGrip {
                                x: root.name-width - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(0, delta); }
                                fit => { root.fit-column(0); }
                            }
                            ColumnGrip {
                                x: root.name-width + root.folder-width - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(1, delta); }
                                fit => { root.fit-column(1); }
                            }
                            ColumnGrip {
                                x: root.name-width + root.folder-width + root.size-width - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(2, delta); }
                                fit => { root.fit-column(2); }
                            }
                            // One on the left edge of each optional column shown.
                            if root.show-type: ColumnGrip {
                                x: root.type-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(4, delta); }
                                fit => { root.fit-column(root.left-of(4)); }
                            }
                            if root.show-ext: ColumnGrip {
                                x: root.ext-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(5, delta); }
                                fit => { root.fit-column(root.left-of(5)); }
                            }
                            if root.show-created: ColumnGrip {
                                x: root.created-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(6, delta); }
                                fit => { root.fit-column(root.left-of(6)); }
                            }
                            if root.show-accessed: ColumnGrip {
                                x: root.accessed-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(7, delta); }
                                fit => { root.fit-column(root.left-of(7)); }
                            }
                            if root.show-attrs: ColumnGrip {
                                x: root.attr-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(8, delta); }
                                fit => { root.fit-column(root.left-of(8)); }
                            }
                            if root.show-md5: ColumnGrip {
                                x: root.md5-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(9, delta); }
                                fit => { root.fit-column(root.left-of(9)); }
                            }
                            if root.show-sha256: ColumnGrip {
                                x: root.sha256-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(10, delta); }
                                fit => { root.fit-column(root.left-of(10)); }
                            }
                            if root.show-crc32: ColumnGrip {
                                x: root.crc32-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(11, delta); }
                                fit => { root.fit-column(root.left-of(11)); }
                            }
                            if root.show-name-freq: ColumnGrip {
                                x: root.name-freq-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(12, delta); }
                                fit => { root.fit-column(root.left-of(12)); }
                            }
                            if root.show-ext-freq: ColumnGrip {
                                x: root.ext-freq-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(13, delta); }
                                fit => { root.fit-column(root.left-of(13)); }
                            }
                            if root.show-size-freq: ColumnGrip {
                                x: root.size-freq-x - self.width / 2;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(14, delta); }
                                fit => { root.fit-column(root.left-of(14)); }
                            }
                            if root.show-full-path: ColumnGrip {
                                x: root.full-path-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(15, d); }
                                fit => { root.fit-column(root.left-of(15)); }
                            }
                            if root.show-parent-path: ColumnGrip {
                                x: root.parent-path-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(16, d); }
                                fit => { root.fit-column(root.left-of(16)); }
                            }
                            if root.show-stem: ColumnGrip {
                                x: root.stem-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(17, d); }
                                fit => { root.fit-column(root.left-of(17)); }
                            }
                            if root.show-name-length: ColumnGrip {
                                x: root.name-length-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(18, d); }
                                fit => { root.fit-column(root.left-of(18)); }
                            }
                            if root.show-path-length: ColumnGrip {
                                x: root.path-length-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(19, d); }
                                fit => { root.fit-column(root.left-of(19)); }
                            }
                            if root.show-disk-size: ColumnGrip {
                                x: root.disk-size-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(20, d); }
                                fit => { root.fit-column(root.left-of(20)); }
                            }
                            if root.show-total-size: ColumnGrip {
                                x: root.total-size-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(21, d); }
                                fit => { root.fit-column(root.left-of(21)); }
                            }
                            if root.show-child-count: ColumnGrip {
                                x: root.child-count-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(22, d); }
                                fit => { root.fit-column(root.left-of(22)); }
                            }
                            if root.show-child-files: ColumnGrip {
                                x: root.child-files-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(23, d); }
