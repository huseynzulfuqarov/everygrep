    // After an optional column (4 to 14, see sort-column) was shown or hidden:
    // hiding the sorted column sorts by name again.
    function column-shown(column: int, shown: bool) {
        if (!shown) {
            root.last-removed-column = column;
        } else if (root.last-removed-column == column) {
            root.last-removed-column = -1;
        }
        if (!shown && root.sort-column == column) {
            root.clear-then-sort();
            root.sort-column = 0;
            root.sort-descending = false;
            root.results-replaced();
            root.sort-changed(0, false);
        } else if (!shown && (root.sort-then1-column == column || root.sort-then2-column == column)) {
            if (root.sort-then1-column == column) {
                root.sort-then1-column = root.sort-then2-column;
                root.sort-then1-descending = root.sort-then2-descending;
            }
            root.sort-then2-column = -1;
            root.results-replaced();
            root.sort-changed(root.sort-column, root.sort-descending);
        }
    }

    // The optional column last hidden (4 to 14), -1 for none: Restore
    // removed column shows it again.
    in-out property <int> last-removed-column: -1;
    // Organize columns: the dialog is open, and what is typed into its
