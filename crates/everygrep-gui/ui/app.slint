    function left-of(c: int) -> int {
        if (c > 56 && root.show-dupe-group) { return 56; }
        if (c > 55 && root.show-xxhash) { return 55; }
        if (c > 54 && root.show-sha512) { return 54; }
        if (c > 53 && root.show-sha384) { return 53; }
        if (c > 52 && root.show-sha1) { return 52; }
        if (c > 51 && root.show-gps-long) { return 51; }
        if (c > 50 && root.show-gps-lat) { return 50; }
        if (c > 49 && root.show-date-taken) { return 49; }
        if (c > 48 && root.show-camera-model) { return 48; }
        if (c > 47 && root.show-camera-maker) { return 47; }
        if (c > 46 && root.show-word-count) { return 46; }
        if (c > 45 && root.show-page-count) { return 45; }
        if (c > 44 && root.show-tags) { return 44; }
        if (c > 43 && root.show-rating) { return 43; }
        if (c > 42 && root.show-genre) { return 42; }
        if (c > 41 && root.show-track) { return 41; }
        if (c > 40 && root.show-year) { return 40; }
        if (c > 39 && root.show-album) { return 39; }
