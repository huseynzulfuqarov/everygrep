        if (c > 28 && root.show-folder-depth) { return 28; }
        if (c > 27 && root.show-desc-folders) { return 27; }
        if (c > 26 && root.show-desc-files) { return 26; }
        if (c > 25 && root.show-desc-count) { return 25; }
        if (c > 24 && root.show-child-folders) { return 24; }
        if (c > 23 && root.show-child-files) { return 23; }
