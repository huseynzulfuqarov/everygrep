        if (root.show-hard-links) { root.hard-links-want = max(root.hard-links-min, w29 * f); }
        if (root.show-shortcut-target) { root.shortcut-target-want = max(root.shortcut-target-min, w30 * f); }
        if (root.show-owner) { root.owner-want = max(root.owner-min, w31 * f); }
        if (root.show-width) { root.width-want = max(root.width-min, w32 * f); }
        if (root.show-height) { root.height-want = max(root.height-min, w33 * f); }
        if (root.show-dimensions) { root.dimensions-want = max(root.dimensions-min, w34 * f); }
        if (root.show-length) { root.length-want = max(root.length-min, w35 * f); }
        if (root.show-bit-rate) { root.bit-rate-want = max(root.bit-rate-min, w36 * f); }
        if (root.show-title) { root.title-want = max(root.title-min, w37 * f); }
        if (root.show-artist) { root.artist-want = max(root.artist-min, w38 * f); }
        if (root.show-album) { root.album-want = max(root.album-min, w39 * f); }
        if (root.show-year) { root.year-want = max(root.year-min, w40 * f); }
        if (root.show-track) { root.track-want = max(root.track-min, w41 * f); }
        if (root.show-genre) { root.genre-want = max(root.genre-min, w42 * f); }
        if (root.show-rating) { root.rating-want = max(root.rating-min, w43 * f); }
        if (root.show-tags) { root.tags-want = max(root.tags-min, w44 * f); }
        if (root.show-page-count) { root.page-count-want = max(root.page-count-min, w45 * f); }
        if (root.show-word-count) { root.word-count-want = max(root.word-count-min, w46 * f); }
        if (root.show-camera-maker) { root.camera-maker-want = max(root.camera-maker-min, w47 * f); }
        if (root.show-camera-model) { root.camera-model-want = max(root.camera-model-min, w48 * f); }
        if (root.show-date-taken) { root.date-taken-want = max(root.date-taken-min, w49 * f); }
        if (root.show-gps-lat) { root.gps-lat-want = max(root.gps-lat-min, w50 * f); }
        if (root.show-gps-long) { root.gps-long-want = max(root.gps-long-min, w51 * f); }
