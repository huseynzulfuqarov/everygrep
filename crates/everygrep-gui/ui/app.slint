import { AboutSlint, Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView } from "std-widgets.slint";
import { TabStrip, TabEntry } from "tabs.slint";
export { TabEntry, TabsWindow } from "tabs.slint";
import { FilePropertiesDialog } from "file-properties.slint";
import { PreviewPanel } from "preview.slint";
import { FoldersPanel, FolderEntry } from "folders.slint";
export { FolderEntry } from "folders.slint";
import { Theme } from "theme.slint";
import { FileopsConflict } from "fileops-conflict.slint";
import { ExportOptions } from "export.slint";
import { FileopsRename } from "fileops-rename.slint";
import { FileopsBulk, BulkRow } from "fileops-bulk.slint";
export { BulkRow }
import { FileopsDupes, DupeRow } from "fileops-dupes.slint";
export { DupeRow }
import { Command, MenuKeys } from "commands.slint";
export { Command, MenuKeys }
export { SettingsWindow, DriveRow, FileListRow, ShortcutCommand } from "settings.slint";
export { FileUndoWindow } from "fileops-undo.slint";
export { HistoryWindow } from "history.slint";
export { SavedWindow } from "saved.slint";
export { AdvancedWindow } from "advanced.slint";
export { NameListWindow } from "name-list.slint";
export { LargestFoldersWindow } from "largest-folders.slint";
export { StalledDialog } from "stalled.slint";
export { DebugLogWindow } from "debuglog.slint";
export { FileListEditor } from "filelist-editor.slint";
export { JournalWindow } from "journal.slint";

// A text with up to four highlighted runs: plain and bold pieces in turn,
// p0 b0 p1 b1 ... p4. Without a highlight all of it is in p0; runs after the
// fourth stay plain in p4.
export struct Marked {
    p0: string,
    b0: string,
    p1: string,
    b1: string,
    p2: string,
    b2: string,
    p3: string,
    b3: string,
    p4: string,
}

export struct ResultRow {
    // The name and the folder, with the matched search terms marked.
    name: Marked,
    folder: Marked,
    size: string,
    modified: string,
    modified-full: string,
    // Words for the Type column ("PNG image") and the extension as written.
    type-name: string,
    extension: string,
    // Read from the file system for the rows on screen, only while their
    // column is shown; empty when unknown.
    created: string,
    accessed: string,
    attributes: string,
    md5: string,
    sha256: string,
    crc32: string,
    sha1: string,
    sha384: string,
    sha512: string,
    xxhash: string,
    dupe-group: string,

    name-freq: string,
    ext-freq: string,
    size-freq: string,
    properties: [string],
    is-dir: bool,
    // Index into Icons.types (FileKind in src/filetype.rs).
    kind: int,
    selected: bool,
    // On a drive that is not connected: drawn dimmed, actions refused.
    offline: bool,
    // The number of its group of duplicates, from 1; 0 when the list is not
    // in groups.
    group: int,
}

// One choice of a group in a menu (theme, density, filter, ...), with its
// check mark. The program gives a new list whenever the choice changes, since
// activating a checkable menu item overwrites its check mark.
export struct MenuChoice {
    title: string,
    checked: bool,
}

// A search text split by split-location(): a folder search at its start is
// shown as `label` in front of the rest of the text (empty `scope` when the
// text starts with none).
export struct LocationSplit {
    label: string,
    detail: string,
    scope: string,
    scope-bytes: int,
    rest: string,
}

// One entry of a list shown in a menu (an open tab, a bookmark, a filter):
// `index` is its place in the whole list, since a long list shows only part
// of it (see menus.rs).
export struct MenuEntry {
    title: string,
    checked: bool,
    index: int,
}

// A bookmark folder in the Bookmarks menu: a submenu of its entries.
export struct BookmarkFolder {
    // The folder's place in the whole bookmark list.
    index: int,
    title: string,
    items: [MenuEntry],
}

// A column of the View → Sort by menu, with its check mark; disabled while
// the column is hidden.
struct SortChoice {
    title: string,
    column: int,
    checked: bool,
    enabled: bool,
}

// The complete column order shared with the sort policy callbacks.
export struct ColumnSort {
    column: int,
    descending: bool,
    then1: int,
    then1-descending: bool,
    then2: int,
    then2-descending: bool,
}

// A column of Organize columns, with its check mark; the columns that are
// always shown cannot be unchecked.
export struct ColumnChoice {
    title: string,
    column: int,
    checked: bool,
    enabled: bool,
}

// The texts of a column that look widest among the rows on screen; the
// window measures them to size the column to fit.
export struct FitTexts {
    a: string,
    b: string,
    c: string,
}

// The result list's columns (numbered as sort-column; 0 for a hidden one)
// as the window shows them, for drag-columns.
export struct ColumnLayout {
    widths: [length],
    mins: [length],
    window: length,
    folder-want: length,
}

// The widths of the two columns at a dragged header border, and Folder's
// own width (0 for none).
export struct ColumnDrag {
    left: length,
    right: length,
    folder-want: length,
}

// A line of the keyboard shortcuts dialog.
export struct ShortcutRow {
    keys: string,
    action: string,
}

// One line of a help page: what is typed and what it does; a heading has
// no example.
export struct HelpRow {
    example: string,
    meaning: string,
}

// File-type icons, in the order of FileKind. They carry their own colours and
// must not be colorized.
global Icons {
    out property <[image]> types: [
        @image-url("icons/types/folder.svg"),
        @image-url("icons/types/file.svg"),
        @image-url("icons/types/text.svg"),
        @image-url("icons/types/document.svg"),
        @image-url("icons/types/pdf.svg"),
        @image-url("icons/types/spreadsheet.svg"),
        @image-url("icons/types/presentation.svg"),
        @image-url("icons/types/image.svg"),
        @image-url("icons/types/audio.svg"),
        @image-url("icons/types/video.svg"),
        @image-url("icons/types/archive.svg"),
        @image-url("icons/types/code.svg"),
        @image-url("icons/types/executable.svg"),
        @image-url("icons/types/font.svg"),
        @image-url("icons/types/disk-image.svg"),
        @image-url("icons/types/link.svg")
    ];
}

// A small on/off button for a matching mode, shown inside the search field.
// A small flat button in the status line (Cancel).
component StatusButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: label.preferred-width + 2 * Theme.s2;
    height: Theme.badge-height + 2px;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.line;
    background: touch.pressed ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    label := Text {
        text: root.text;
        font-size: Theme.small;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A button of the toolbar: a symbol and a word, flat until hovered.
component ToolButton inherits Rectangle {
    in property <string> glyph;
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> checked;
    callback clicked();

    width: tool-row.preferred-width;
    height: Theme.field-height - 4px;
    border-radius: Theme.radius;
    background: !root.enabled ? transparent : touch.pressed || root.checked ? Theme.selection
        : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checked: root.checked;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    tool-row := HorizontalLayout {
        padding-left: Theme.s2;
        padding-right: Theme.s2;
        spacing: Theme.s1;
        if root.glyph != "": Text {
            text: root.glyph;
            font-size: Theme.body;
            color: root.enabled ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-size: Theme.small;
            color: root.enabled ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ModeToggle inherits Rectangle {
    in property <string> glyph;
    // Draws a line under the glyph (the whole-words look).
    in property <bool> underline;
    in property <string> tip;
    in-out property <bool> checked;
    out property <bool> hovered: touch.has-hover;
    callback toggled();

    width: 26px;
    height: 24px;
    border-radius: 4px;
    background: root.checked ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    border-width: root.checked ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: checkbox;
    accessible-label: root.tip;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(); }

    property <color> ink: root.checked ? Theme.selection-text : Theme.text-muted;
    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    Text {
        text: root.glyph;
        font-size: Theme.small;
        font-weight: 600;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.underline: Rectangle {
        x: 7px;
        y: parent.height - 6px;
        width: parent.width - 14px;
        height: 1px;
        background: root.ink;
    }
}

// The folder a search is limited to, in front of the search text.
component ScopeChip inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    out property <bool> hovered: touch.has-hover || close.has-hover;
    callback cleared();

    height: Theme.field-height - 2 * Theme.s1 - 2px;
    border-radius: 4px;
    background: Theme.selection;
    accessible-role: button;
    accessible-label: root.detail;
    accessible-description: @tr("Remove the folder from the search");
    accessible-action-default => { root.cleared(); }
    touch := TouchArea { }
    HorizontalLayout {
        padding-left: Theme.s2;
        padding-right: Theme.s1;
        spacing: Theme.s1;
        Image {
            source: @image-url("icons/types/folder.svg");
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            max-width: 220px;
            overflow: elide;
            vertical-alignment: center;
            font-size: Theme.body;
            color: Theme.selection-text;
        }
        Rectangle {
            width: 18px;
            height: 18px;
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: close.has-hover ? Theme.hover : transparent;
            Text {
                text: "×";
                color: Theme.selection-text;
                font-size: Theme.body;
            }
            close := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.cleared(); }
            }
        }
    }
}

// The search text after an entry of the Insert menus was put in, and where
// the text cursor goes (a byte offset).
export struct SearchInsert {
    text: string,
    caret: int,
}

component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    out property <bool> focused: input.has-focus;
    // Matching modes, changed by the toggles at the right end.
    in-out property <bool> match-case;
    in-out property <bool> whole-words;
    in-out property <bool> match-path;
    in-out property <bool> match-diacritics;
    in-out property <bool> use-regex;
    // A click into the field while it does not have the focus selects all
    // of its text; the next click places the caret.
    in property <bool> select-on-click;
    // A folder search in front of the text, shown as the folder's name
    // (`scope-label`; the full path is its tip). Its × or Backspace at the
    // start of an empty field removes it.
    in property <string> scope-label;
    in property <string> scope-detail;
    callback scope-cleared();
    // The tip of the toggle under the mouse and where to show it.
    out property <string> hover-tip: scope-chip.hovered ? root.scope-detail
        : case-toggle.hovered ? case-toggle.tip
        : words-toggle.hovered ? words-toggle.tip
        : path-toggle.hovered ? path-toggle.tip
        : marks-toggle.hovered ? marks-toggle.tip
        : regex-toggle.hovered ? regex-toggle.tip : "";
    out property <length> hover-x: scope-chip.hovered ? scope-chip.absolute-position.x
        : case-toggle.hovered ? case-toggle.absolute-position.x
        : words-toggle.hovered ? words-toggle.absolute-position.x
        : path-toggle.hovered ? path-toggle.absolute-position.x
        : marks-toggle.hovered ? marks-toggle.absolute-position.x
        : regex-toggle.absolute-position.x;
    out property <length> hover-bottom: case-toggle.absolute-position.y + case-toggle.height;
    callback edited(string);
    callback accepted();
    callback down-pressed();
    callback history-requested();
    callback escape-pressed();
    callback modes-changed();
    // The keys of the window's commands; returns whether the key was used.
    callback shortcut(KeyEvent) -> bool;
    // The text with an entry of the Insert menus put in at the selection.
    pure callback insert-part(string, int, int, int, int) -> SearchInsert;
    function put(menu: int, index: int) {
        let r = root.insert-part(input.text, input.anchor-position-byte-offset,
            input.cursor-position-byte-offset, menu, index);
        input.text = r.text;
        input.focus();
        input.set-selection-offsets(r.caret, r.caret);
        root.edited(input.text);
        // Popup dismissal restores the previous focus after activation.
        // Restore the editor and its byte caret on the following turn.
        root.insert-caret = r.caret;
        insert-focus.running = true;
    }
    property <int> insert-caret;
    insert-focus := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            input.focus();
            input.set-selection-offsets(root.insert-caret, root.insert-caret);
        }
    }
    public function focus-and-select() {
        input.focus();
        input.select-all();
    }
    // Puts the text cursor at `offset` (in bytes) with nothing selected.
    public function place-caret(offset: int) {
        input.set-selection-offsets(offset, offset);
    }

    height: Theme.field-height;
    border-radius: Theme.radius;
    background: Theme.field;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-line;

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s1;
        spacing: Theme.s2;
        Image {
            source: @image-url("icons/search.svg");
            colorize: Theme.text-muted;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        // The label and the text, without a gap while there is no label.
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: root.scope-label != "" ? Theme.s2 : 0px;
            scope-chip := ScopeChip {
                visible: root.scope-label != "";
                width: self.visible ? self.preferred-width : 0px;
                y: (parent.height - self.height) / 2;
                label: root.scope-label;
                detail: root.scope-detail;
                cleared => {
                    root.scope-cleared();
                    input.focus();
                }
            }
            // The field takes the width the layout gives it, not the width of the
            // text: long text scrolls inside the clip instead of pushing the
            // toggles and the filter selector aside.
            Rectangle {
                horizontal-stretch: 1;
                // A TextInput of width 0 cannot take focus.
                min-width: 1px;
                clip: true;
                input := TextInput {
                    // Scroll offset that keeps the text cursor visible.
                    property <length> scroll-x;

                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    vertical-alignment: center;
                    font-size: Theme.body + 1px;
                    color: Theme.text;
                    selection-background-color: Theme.selection;
                    selection-foreground-color: Theme.selection-text;
                    single-line: true;
                    cursor-position-changed(position) => {
                        if (position.x + self.scroll-x < 0px) {
                            self.scroll-x = -position.x;
                        } else if (position.x + self.scroll-x > parent.width - self.text-cursor-width) {
                            self.scroll-x = parent.width - position.x - self.text-cursor-width;
                        }
                    }
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(); }
                    key-pressed(event) => {
                        if (root.shortcut(event)) {
                            return accept;
                        }
                        if (event.text == Key.DownArrow) {
                            root.down-pressed();
                            return accept;
                        }
                        if (event.text == Key.Escape) {
                            root.escape-pressed();
                            return accept;
                        }
                        if (event.text == Key.Backspace && root.scope-label != ""
                            && self.text == "") {
                            root.scope-cleared();
                            return accept;
                        }
                        reject
                    }
                }
                // Takes the first click while the field has no focus; once it
                // has, clicks go to the text input and place the caret.
                TouchArea {
                    enabled: root.select-on-click && !input.has-focus;
                    mouse-cursor: MouseCursor.text;
                    clicked => {
                        input.focus();
                        input.select-all();
                    }
                }
                // Right-click: editing, and parts of the query language
                // put in at the cursor (see src/insert.rs).
                ContextMenuArea {
                    Menu {
                        MenuItem { title: @tr("Undo"); activated => { input.undo(); } }
                        MenuItem { title: @tr("Redo"); activated => { input.redo(); } }
                        MenuSeparator { }
                        MenuItem { title: @tr("Cut"); activated => { input.cut(); root.edited(input.text); } }
                        MenuItem { title: @tr("Copy"); activated => { input.copy(); } }
                        MenuItem { title: @tr("Paste"); activated => { input.paste(); root.edited(input.text); } }
                        MenuItem { title: @tr("Select all"); activated => { input.focus(); input.select-all(); } }
                        MenuSeparator { }
                        Menu {
                            title: @tr("Combine");
                        MenuItem { title: @tr("Both (space)"); activated => { root.put(0, 0); } }
                        MenuItem { title: @tr("Either  |"); activated => { root.put(0, 1); } }
                        MenuItem { title: @tr("Without  !"); activated => { root.put(0, 2); } }
                        MenuItem { title: @tr("Group  < >"); activated => { root.put(0, 3); } }
                        MenuItem { title: @tr("Exact text  \" \""); activated => { root.put(0, 4); } }
                        }
                        Menu {
                            title: @tr("Match options");
                        MenuItem { title: "case:  " + @tr("match case"); activated => { root.put(1, 0); } }
                        MenuItem { title: "nocase:  " + @tr("ignore case"); activated => { root.put(1, 1); } }
                        MenuItem { title: "wholeword:  " + @tr("whole words"); activated => { root.put(1, 2); } }
                        MenuItem { title: "diacritics:  " + @tr("match diacritics"); activated => { root.put(1, 3); } }
                        MenuItem { title: "path:  " + @tr("match the full path"); activated => { root.put(1, 4); } }
                        MenuItem { title: "prefix:  " + @tr("the name starts with"); activated => { root.put(1, 5); } }
                        MenuItem { title: "suffix:  " + @tr("the name ends with"); activated => { root.put(1, 6); } }
                        MenuItem { title: "wholename:  " + @tr("whole file name"); activated => { root.put(1, 7); } }
                        MenuItem { title: "nopunct:  " + @tr("ignore punctuation"); activated => { root.put(1, 8); } }
                        MenuItem { title: "nospace:  " + @tr("ignore spaces"); activated => { root.put(1, 9); } }
                        MenuItem { title: "regex:  " + @tr("regular expression"); activated => { root.put(1, 10); } }
                        MenuItem { title: "file:  " + @tr("files only"); activated => { root.put(1, 11); } }
                        MenuItem { title: "folder:  " + @tr("folders only"); activated => { root.put(1, 12); } }
                        }
                        Menu {
                            title: @tr("Conditions");
                        MenuItem { title: "ext:  " + @tr("extensions"); activated => { root.put(2, 0); } }
                        MenuItem { title: "size:>  " + @tr("larger than"); activated => { root.put(2, 1); } }
                        MenuItem { title: "size:<  " + @tr("smaller than"); activated => { root.put(2, 2); } }
                        MenuItem { title: "modified:>  " + @tr("modified before"); activated => { root.put(2, 3); } }
                        MenuItem { title: "modified:<  " + @tr("modified within"); activated => { root.put(2, 4); } }
                        MenuItem { title: "modified:today  " + @tr("modified today"); activated => { root.put(2, 5); } }
                        MenuItem { title: "created:  " + @tr("created"); activated => { root.put(2, 6); } }
                        MenuItem { title: "accessed:  " + @tr("accessed"); activated => { root.put(2, 7); } }
                        MenuItem { title: "content:  " + @tr("file contents"); activated => { root.put(2, 8); } }
                        MenuItem { title: "count:  " + @tr("first results only"); activated => { root.put(2, 9); } }
                        MenuItem { title: "duplicates:  " + @tr("duplicates"); activated => { root.put(2, 10); } }
                        MenuItem { title: "type:  " + @tr("file type"); activated => { root.put(2, 11); } }
                        MenuItem { title: "attributes:  " + @tr("attributes"); activated => { root.put(2, 12); } }
                        MenuItem { title: "parent:  " + @tr("parent folder"); activated => { root.put(2, 13); } }
                        MenuItem { title: "child:  " + @tr("item inside"); activated => { root.put(2, 14); } }
                        MenuItem { title: "depth:  " + @tr("folder depth"); activated => { root.put(2, 15); } }
                        MenuItem { title: "children:  " + @tr("items inside"); activated => { root.put(2, 16); } }
                        MenuItem { title: "len:  " + @tr("name length"); activated => { root.put(2, 17); } }
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            // The toggles keep their height; centre them in the field.
            padding-top: (root.height - 24px) / 2;
            padding-bottom: (root.height - 24px) / 2;
            case-toggle := ModeToggle {
                glyph: "Aa";
                tip: @tr("Match case (Alt+C)");
                checked <=> root.match-case;
                toggled => { root.modes-changed(); }
            }
            words-toggle := ModeToggle {
                glyph: "ab";
                underline: true;
                tip: @tr("Match whole words (Alt+W)");
                checked <=> root.whole-words;
                toggled => { root.modes-changed(); }
            }
            path-toggle := ModeToggle {
                glyph: "a/b";
                tip: @tr("Match the full path (Alt+P)");
                checked <=> root.match-path;
                toggled => { root.modes-changed(); }
            }
            marks-toggle := ModeToggle {
                glyph: "é";
                tip: @tr("Match diacritics (Alt+D)");
                checked <=> root.match-diacritics;
                toggled => { root.modes-changed(); }
            }
            regex-toggle := ModeToggle {
                glyph: ".*";
                tip: @tr("Regular expression (Alt+R)");
                checked <=> root.use-regex;
                toggled => { root.modes-changed(); }
            }
        }
        Button {
            text: "▼";
            width: 28px;
            accessible-label: @tr("Show search history");
            clicked => { root.history-requested(); }
        }
    }
    placeholder := Text {
        x: Theme.s3 + Theme.icon + Theme.s2;
        visible: input.text == "" && root.scope-label == "";
        text: @tr("Search files and folders");
        color: Theme.text-muted;
        font-size: Theme.body + 1px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <TextHorizontalAlignment> align: left;
    // Whether the results are sorted by this column, and in which direction.
    in property <bool> sorted;
    in property <bool> descending;
    callback clicked();
    callback right-pressed(length, length);

    property <bool> right: root.align == TextHorizontalAlignment.right;
    property <length> arrow-space: root.sorted ? Theme.icon : 0px;
    property <length> label-width: min(label-text.preferred-width, label-text.width);

    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.right-pressed(self.mouse-x, self.mouse-y);
            }
        }
    }
    label-text := Text {
        x: root.right ? Theme.s2 + root.arrow-space : Theme.s2;
        width: parent.width - 2 * Theme.s2 - root.arrow-space;
        height: parent.height;
        text: root.label;
        font-size: Theme.small;
        font-weight: 600;
        color: root.sorted ? Theme.text : Theme.text-muted;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        overflow: elide;
    }
    // The arrow sits next to the label, on the side away from the alignment.
    Image {
        visible: root.sorted;
        x: root.right
            ? parent.width - Theme.s2 - root.label-width - self.width
            : Theme.s2 + root.label-width;
        y: (parent.height - self.height) / 2;
        width: Theme.icon;
        height: Theme.icon;
        source: root.descending ? @image-url("icons/sort-down.svg") : @image-url("icons/sort-up.svg");
        colorize: Theme.accent;
    }
}

// One piece of a MarkedText. It takes its natural width while there is
// room; the piece that runs out of room is elided. The last piece takes all
// the room left.
component Piece inherits Text {
    // Width from this piece to the end of the cell.
    in property <length> room;
    in property <bool> last;
    // An empty Text still reports a small preferred width; force 0.
    width: self.text == "" ? 0px : self.last ? max(0px, self.room) : min(self.preferred-width, self.room);
    visible: self.text != "";
    vertical-alignment: center;
    overflow: elide;
}

// A one-line text with the matched search terms in bold (see Marked); the
// cell clips what does not fit.
component MarkedText inherits Rectangle {
    in property <Marked> text;
    in property <color> text-color;
    in property <bool> italic;
    in property <length> font-size;
    clip: true;

    p0 := Piece {
        x: 0;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p0;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b0 := Piece {
        x: p0.x + p0.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b0;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p1 := Piece {
        x: b0.x + b0.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p1;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b1 := Piece {
        x: p1.x + p1.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b1;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p2 := Piece {
        x: b1.x + b1.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p2;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b2 := Piece {
        x: p2.x + p2.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b2;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p3 := Piece {
        x: b2.x + b2.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p3;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b3 := Piece {
        x: p3.x + p3.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b3;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p4 := Piece {
        x: b3.x + b3.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p4;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        last: true;
    }
}

component Row inherits Rectangle {
    in property <ResultRow> data;
    // The keyboard cursor is on this row and the list has focus.
    in property <bool> current;
    // Every second row, drawn in the row-alt color when that is on.
    in property <bool> alternate;
    in property <length> name-width;
    in property <length> folder-width;
    in property <length> size-width;
    in property <length> date-width;
    // Optional columns; 0 when hidden.
    in property <length> type-width;
    in property <length> ext-width;
    in property <length> created-width;
    in property <length> accessed-width;
    in property <length> attr-width;
    in property <length> md5-width;
    in property <length> sha256-width;
    in property <length> crc32-width;
    in property <length> name-freq-width;
    in property <length> ext-freq-width;
    in property <length> size-freq-width;
    in property <length> full-path-width;
    in property <length> parent-path-width;
    in property <length> stem-width;
    in property <length> name-length-width;
    in property <length> path-length-width;
    in property <length> disk-size-width;
    in property <length> total-size-width;
    in property <length> child-count-width;
    in property <length> child-files-width;
    in property <length> child-folders-width;
    in property <length> desc-count-width;
    in property <length> desc-files-width;
    in property <length> desc-folders-width;
    in property <length> folder-depth-width;
    in property <length> hard-links-width;
    in property <length> shortcut-target-width;
    in property <length> owner-width;
    in property <length> width-width;
    in property <length> height-width;
    in property <length> dimensions-width;
    in property <length> length-width;
    in property <length> bit-rate-width;
    in property <length> title-width;
    in property <length> artist-width;
    in property <length> album-width;
    in property <length> year-width;
    in property <length> track-width;
    in property <length> genre-width;
    in property <length> rating-width;
    in property <length> tags-width;
    in property <length> page-count-width;
    in property <length> word-count-width;
    in property <length> camera-maker-width;
    in property <length> camera-model-width;
    in property <length> date-taken-width;
    in property <length> gps-lat-width;
    in property <length> gps-long-width;
    in property <length> sha1-width;
    in property <length> sha384-width;
    in property <length> sha512-width;
    in property <length> xxhash-width;
    in property <length> dupe-group-width;

    // The name is being edited in place.
    in property <bool> editing;
    in-out property <string> edit-text;
    // Bytes of the name selected when editing starts (the part before the
    // extension).
    in property <int> edit-stem;
    callback pressed(KeyboardModifiers);
    // Dragging rows onto folder rows (see src/fileops_drop.rs).
    in property <bool> drag-enabled;
    in property <data-transfer> drag-data;
    callback drag-started();
    callback drag-ended();
    // A press on a selected row without Shift or Ctrl: the row gets the
    // cursor, and the selection becomes this row only at the release, so
    // the selected rows can be dragged together.
    callback focus-pressed();
    pure callback drop-allowed() -> bool;
    // Dropped here; with Ctrl (copy) and the position in the row.
    callback dropped-here(bool, length, length);
    property <bool> select-at-release;
    callback right-pressed(length, length, int);
    // With the x position of the click in the row.
    callback double-clicked(length);
    callback edit-commit(string);
    callback edit-cancel();

    function value-column-at(x: length) -> int {
        if (x < 0px) { return -1; }
        if (x < root.name-width) { return 0; }
        if (x < root.name-width + root.folder-width) { return 1; }
        if (x < root.name-width + root.folder-width + root.size-width) { return 2; }
        if (x < root.type-x) { return 3; }
        if (x >= root.type-x + root.type-width && x < root.type-x + root.type-width + root.ext-width) { return 5; }
        if (root.type-width > 0px && x >= root.type-x && x < root.type-x + root.type-width) { return 4; }
        if (root.created-width > 0px && x >= root.created-x && x < root.created-x + root.created-width) { return 6; }
        if (root.accessed-width > 0px && x >= root.created-x + root.created-width && x < root.created-x + root.created-width + root.accessed-width) { return 7; }
        if (root.attr-width > 0px && x >= root.created-x + root.created-width + root.accessed-width && x < root.md5-x) { return 8; }
        if (root.md5-width > 0px && x >= root.md5-x && x < root.md5-x + root.md5-width) { return 9; }
        if (root.sha256-width > 0px && x >= root.sha256-x && x < root.sha256-x + root.sha256-width) { return 10; }
        if (root.crc32-width > 0px && x >= root.crc32-x && x < root.crc32-x + root.crc32-width) { return 11; }
        if (root.sha1-width > 0px && x >= root.sha1-x && x < root.sha1-x + root.sha1-width) { return 52; }
        if (root.sha384-width > 0px && x >= root.sha384-x && x < root.sha384-x + root.sha384-width) { return 53; }
        if (root.sha512-width > 0px && x >= root.sha512-x && x < root.sha512-x + root.sha512-width) { return 54; }
        if (root.xxhash-width > 0px && x >= root.xxhash-x && x < root.xxhash-x + root.xxhash-width) { return 55; }
        return -1;
    }

    property <bool> selected: root.data.selected;
    property <bool> offline: root.data.offline;
    // Text colors: offline rows are dimmed (unless selected) and their names
    // slanted, so the state is not shown by color alone.
    property <color> name-color: selected ? Theme.selection-text : offline ? Theme.text-offline : Theme.text;
    property <color> other-color: selected ? Theme.selection-text : offline ? Theme.text-offline : Theme.text-muted;

    height: Theme.row-height;
    background: selected ? Theme.selection : touch.has-hover ? Theme.hover
        : root.alternate ? Theme.row-alt : transparent;

    drop := DropArea {
        enabled: root.drag-enabled && root.data.is-dir && !root.data.offline;
        can-drop(event) => {
            if (!root.drop-allowed()) { return DragAction.none; }
            return event.proposed-action == DragAction.copy ? DragAction.copy : DragAction.move;
        }
        dropped(event) => {
            root.dropped-here(event.proposed-action == DragAction.copy, event.position.x, event.position.y);
            return event.proposed-action;
        }
    }
    drag := DragArea {
        enabled: root.drag-enabled && !root.editing;
        allow-copy: true;
        allow-move: true;
        data: root.drag-data;
        changed dragging => {
            if (self.dragging) { root.drag-started(); }
        }
        drag-finished(action) => { root.drag-ended(); }
        touch := TouchArea {
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    root.select-at-release = false;
                    if (event.button == PointerEventButton.left) {
                        if (root.drag-enabled && root.selected && !event.modifiers.shift && !event.modifiers.control) {
                            root.select-at-release = true;
                            root.focus-pressed();
                        } else {
                            root.pressed(event.modifiers);
                        }
                    } else if (event.button == PointerEventButton.right) {
                        root.right-pressed(self.mouse-x, self.mouse-y, root.value-column-at(self.mouse-x));
                    }
                } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left && root.select-at-release) {
                    root.select-at-release = false;
                    root.pressed(event.modifiers);
                }
            }
            double-clicked => { root.double-clicked(self.mouse-x); }
        }
    }
    // The folder a drag would drop into.
    Rectangle {
        visible: drop.has-drag;
        border-width: 2px;
        border-color: Theme.accent;
        background: Theme.selection.with-alpha(0.5);
    }
    // Focus ring of the keyboard cursor.
    Rectangle {
        visible: root.current;
        border-width: 1px;
        border-color: Theme.accent;
    }

    // Cells are positioned directly to keep the columns aligned with the header.
    Image {
        x: Theme.s3;
        opacity: root.offline ? 0.45 : 1;
        source: Icons.types[root.data.kind];
        width: Theme.row-icon;
        height: Theme.row-icon;
        y: (parent.height - self.height) / 2;
    }
    name-cell := MarkedText {
        x: Theme.s3 + Theme.row-icon + Theme.s2;
        width: max(0px, root.name-width - self.x - Theme.s2);
        height: parent.height;
        text: root.data.name;
        text-color: root.name-color;
        italic: root.offline;
        font-size: Theme.list-text;
    }
    if root.editing: Rectangle {
        x: name-cell.x - Theme.s1;
        width: name-cell.width + Theme.s1;
        y: 2px;
        height: parent.height - 4px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: 3px;
        edit := TextInput {
            x: Theme.s1;
            width: parent.width - 2 * Theme.s1;
            text <=> root.edit-text;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.list-text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.selection-text;
            init => {
                self.focus();
                self.set-selection-offsets(0, root.edit-stem);
            }
            accepted => { root.edit-commit(self.text); }
            // Leaving the field (a click elsewhere) cancels; only Enter renames.
            changed has-focus => {
                if (!self.has-focus) { root.edit-cancel(); }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.edit-cancel();
                    return accept;
                }
                // Keep list keys from moving the selection while editing.
                if (event.text == Key.UpArrow || event.text == Key.DownArrow
                    || event.text == Key.PageUp || event.text == Key.PageDown || event.text == Key.F2) {
                    return accept;
                }
                reject
            }
        }
    }
    MarkedText {
        x: root.name-width + Theme.s2;
        width: root.folder-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.folder;
        text-color: root.other-color;
        font-size: Theme.list-text;
    }
    Text {
        x: root.name-width + root.folder-width;
        width: root.size-width - Theme.s2;
        height: parent.height;
        text: root.data.size;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    Text {
        x: root.name-width + root.folder-width + root.size-width + Theme.s2;
        width: root.date-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.modified;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> type-x: root.name-width + root.folder-width + root.size-width + root.date-width;
    if root.type-width > 0: Text {
        x: root.type-x + Theme.s2;
        width: root.type-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.type-name;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.ext-width > 0: Text {
        x: root.type-x + root.type-width + Theme.s2;
        width: root.ext-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.extension;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> created-x: root.type-x + root.type-width + root.ext-width;
    if root.created-width > 0: Text {
        x: root.created-x + Theme.s2;
        width: root.created-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.created;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.accessed-width > 0: Text {
        x: root.created-x + root.created-width + Theme.s2;
        width: root.accessed-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.accessed;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.attr-width > 0: Text {
        x: root.created-x + root.created-width + root.accessed-width + Theme.s2;
        width: root.attr-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.attributes;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> md5-x: root.created-x + root.created-width + root.accessed-width + root.attr-width;
    if root.md5-width > 0: Text {
        x: root.md5-x + Theme.s2;
        width: root.md5-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.md5;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> sha256-x: root.md5-x + root.md5-width;
    if root.sha256-width > 0: Text {
        x: root.sha256-x + Theme.s2;
        width: root.sha256-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.sha256;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> crc32-x: root.sha256-x + root.sha256-width;
    if root.crc32-width > 0: Text {
        x: root.crc32-x + Theme.s2;
        width: root.crc32-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.crc32;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> name-freq-x: root.crc32-x + root.crc32-width;
    if root.name-freq-width > 0: Text {
        x: root.name-freq-x + Theme.s2;
        width: root.name-freq-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.name-freq;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
    property <length> ext-freq-x: root.name-freq-x + root.name-freq-width;
    if root.ext-freq-width > 0: Text {
        x: root.ext-freq-x + Theme.s2;
        width: root.ext-freq-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.ext-freq;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
    property <length> size-freq-x: root.ext-freq-x + root.ext-freq-width;
    if root.size-freq-width > 0: Text {
        x: root.size-freq-x + Theme.s2;
        width: root.size-freq-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.size-freq;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
    property <length> full-path-x: root.size-freq-x + root.size-freq-width;
    if root.full-path-width > 0: Text {
        x: root.full-path-x + Theme.s2;
        width: root.full-path-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[0];
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> parent-path-x: root.full-path-x + root.full-path-width;
    if root.parent-path-width > 0: Text {
        x: root.parent-path-x + Theme.s2;
        width: root.parent-path-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[1];
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> stem-x: root.parent-path-x + root.parent-path-width;
    if root.stem-width > 0: Text {
        x: root.stem-x + Theme.s2;
        width: root.stem-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[2];
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> name-length-x: root.stem-x + root.stem-width;
    if root.name-length-width > 0: Text {
        x: root.name-length-x + Theme.s2;
        width: root.name-length-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[3];
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> path-length-x: root.name-length-x + root.name-length-width;
    if root.path-length-width > 0: Text {
        x: root.path-length-x + Theme.s2;
        width: root.path-length-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[4];
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> disk-size-x: root.path-length-x + root.path-length-width;
    if root.disk-size-width > 0: Text {
        x: root.disk-size-x + Theme.s2;
        width: root.disk-size-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[5];
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> total-size-x: root.disk-size-x + root.disk-size-width;
    if root.total-size-width > 0: Text {
        x: root.total-size-x + Theme.s2;
        width: root.total-size-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[6];
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> child-count-x: root.total-size-x + root.total-size-width;
    if root.child-count-width > 0: Text {
        x: root.child-count-x + Theme.s2;
        width: root.child-count-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[7];
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> child-files-x: root.child-count-x + root.child-count-width;
    if root.child-files-width > 0: Text {
        x: root.child-files-x + Theme.s2;
        width: root.child-files-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.properties[8];
        color: root.other-color;
