            : c > 11 && root.show-crc32 ? 11
            : c > 10 && root.show-sha256 ? 10
            : c > 9 && root.show-md5 ? 9
            : c > 8 && root.show-attrs ? 8
            : c > 7 && root.show-accessed ? 7 : c > 6 && root.show-created ? 6
