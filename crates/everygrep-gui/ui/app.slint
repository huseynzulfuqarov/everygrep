    }

    // The last shown column.
    function last-shown() -> int {
        if (root.show-dupe-group) { return 56; }
        if (root.show-xxhash) { return 55; }
        if (root.show-sha512) { return 54; }
        if (root.show-sha384) { return 53; }
        if (root.show-sha1) { return 52; }
        if (root.show-gps-long) { return 51; }
        if (root.show-gps-lat) { return 50; }
        if (root.show-date-taken) { return 49; }
        if (root.show-camera-model) { return 48; }
        if (root.show-camera-maker) { return 47; }
        if (root.show-word-count) { return 46; }
        if (root.show-page-count) { return 45; }
        if (root.show-tags) { return 44; }
        if (root.show-rating) { return 43; }
        if (root.show-genre) { return 42; }
        if (root.show-track) { return 41; }
        if (root.show-year) { return 40; }
        if (root.show-album) { return 39; }
        if (root.show-artist) { return 38; }
        if (root.show-title) { return 37; }
        if (root.show-bit-rate) { return 36; }
        if (root.show-length) { return 35; }
        if (root.show-dimensions) { return 34; }
        if (root.show-height) { return 33; }
        if (root.show-width) { return 32; }
        if (root.show-owner) { return 31; }
        if (root.show-shortcut-target) { return 30; }
        if (root.show-hard-links) { return 29; }
        if (root.show-folder-depth) { return 28; }
        if (root.show-desc-folders) { return 27; }
        if (root.show-desc-files) { return 26; }
        if (root.show-desc-count) { return 25; }
        if (root.show-child-folders) { return 24; }
        if (root.show-child-files) { return 23; }
        if (root.show-child-count) { return 22; }
        if (root.show-total-size) { return 21; }
        if (root.show-disk-size) { return 20; }
        if (root.show-path-length) { return 19; }
        if (root.show-name-length) { return 18; }
        if (root.show-stem) { return 17; }
        if (root.show-parent-path) { return 16; }
        if (root.show-full-path) { return 15; }
        return root.show-size-freq ? 14
            : root.show-ext-freq ? 13
            : root.show-name-freq ? 12
            : root.show-crc32 ? 11
            : root.show-sha256 ? 10
            : root.show-md5 ? 9
            : root.show-attrs ? 8 : root.show-accessed ? 7 : root.show-created ? 6
            : root.show-ext ? 5 : root.show-type ? 4 : 3;
    }

    // Dragging a boundary moves it with the pointer: 0 is Name|Folder, 1
    // Folder|Size, 2 Size|Modified, 4 to 14 the left edge of that optional
    // column, 99 the right edge of the last column. The column on the left
    // grows or shrinks; the one on the right gives or takes the room while
    // the columns fit, and past that they get wider than the window (or
    // narrower again). See src/columns.rs.
    function drag-boundary(boundary: int, delta: length) {
        let left = boundary <= 2 ? boundary : boundary == 99 ? root.last-shown() : root.left-of(boundary);
        let right = boundary <= 2 ? boundary + 1 : boundary == 99 ? -1 : boundary;
        let next = root.drag-columns({
            widths: [root.name-width, root.folder-width, root.size-width, root.date-width,
                root.type-width, root.ext-width, root.created-width, root.accessed-width,
                root.attr-width,
                root.md5-width,
                root.sha256-width,
                root.crc32-width,
                root.name-freq-width,
                root.ext-freq-width,
                root.size-freq-width, root.full-path-width, root.parent-path-width, root.stem-width, root.name-length-width, root.path-length-width, root.disk-size-width, root.total-size-width, root.child-count-width, root.child-files-width, root.child-folders-width, root.desc-count-width, root.desc-files-width, root.desc-folders-width, root.folder-depth-width, root.hard-links-width, root.shortcut-target-width, root.owner-width, root.width-width, root.height-width, root.dimensions-width, root.length-width, root.bit-rate-width, root.title-width, root.artist-width, root.album-width, root.year-width, root.track-width, root.genre-width, root.rating-width, root.tags-width, root.page-count-width, root.word-count-width, root.camera-maker-width, root.camera-model-width, root.date-taken-width, root.gps-lat-width, root.gps-long-width, root.sha1-width, root.sha384-width, root.sha512-width, root.xxhash-width, root.dupe-group-width],
            mins: [root.name-min, root.folder-min, root.size-min, root.date-min, root.type-min,
                root.ext-min, root.created-min, root.accessed-min, root.attr-min,
                root.md5-min,
                root.sha256-min,
                root.crc32-min,
                root.name-freq-min,
                root.ext-freq-min,
                root.size-freq-min, root.full-path-min, root.parent-path-min, root.stem-min, root.name-length-min, root.path-length-min, root.disk-size-min, root.total-size-min, root.child-count-min, root.child-files-min, root.child-folders-min, root.desc-count-min, root.desc-files-min, root.desc-folders-min, root.folder-depth-min, root.hard-links-min, root.shortcut-target-min, root.owner-min, root.width-min, root.height-min, root.dimensions-min, root.length-min, root.bit-rate-min, root.title-min, root.artist-min, root.album-min, root.year-min, root.track-min, root.genre-min, root.rating-min, root.tags-min, root.page-count-min, root.word-count-min, root.camera-maker-min, root.camera-model-min, root.date-taken-min, root.gps-lat-min, root.gps-long-min, root.sha1-min, root.sha384-min, root.sha512-min, root.xxhash-min, root.dupe-group-min],
            window: list.visible-width,
            folder-want: root.folder-want,
        }, left, right, delta);
        if (left <= 3) {
            // Name keeps its width from now on (until then it follows the
            // window and the widths of Size and Modified).
            root.name-want = root.name-width;
            root.name-set = true;
        }
        root.folder-want = next.folder-want;
        root.take-width(left, next.left);
