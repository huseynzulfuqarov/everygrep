import { AboutSlint, Button, ComboBox, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { SettingsWindow } from "settings.slint";

export struct ResultRow {
    // The name, split around the highlighted match; without a match all of it
    // is in name-before.
    name-before: string,
    name-match: string,
    name-after: string,
    folder: string,
    size: string,
    modified: string,
    modified-full: string,
    // Words for the Type column ("PNG image") and the extension as written.
    type-name: string,
    extension: string,
    is-dir: bool,
    // Index into Icons.types (FileKind in src/filetype.rs).
    kind: int,
    selected: bool,
}

// One choice of a group in a menu (theme, density, filter, ...), with its
// check mark. The program gives a new list whenever the choice changes, since
// activating a checkable menu item overwrites its check mark.
export struct MenuChoice {
    title: string,
    checked: bool,
}

// A line of the keyboard shortcuts dialog.
export struct ShortcutRow {
    keys: string,
    action: string,
}

// File-type icons, in the order of FileKind. They carry their own colours and
// must not be colorized.
global Icons {
    out property <[image]> types: [
        @image-url("icons/types/folder.svg"),
        @image-url("icons/types/file.svg"),
        @image-url("icons/types/text.svg"),
        @image-url("icons/types/document.svg"),
        @image-url("icons/types/pdf.svg"),
        @image-url("icons/types/spreadsheet.svg"),
        @image-url("icons/types/presentation.svg"),
        @image-url("icons/types/image.svg"),
        @image-url("icons/types/audio.svg"),
        @image-url("icons/types/video.svg"),
        @image-url("icons/types/archive.svg"),
        @image-url("icons/types/code.svg"),
        @image-url("icons/types/executable.svg"),
        @image-url("icons/types/font.svg"),
        @image-url("icons/types/disk-image.svg"),
        @image-url("icons/types/link.svg")
    ];
}

// A small on/off button for a matching mode, shown inside the search field.
component ModeToggle inherits Rectangle {
    in property <string> glyph;
    // Draws a line under the glyph (the whole-words look).
    in property <bool> underline;
    in property <string> tip;
    in-out property <bool> checked;
    out property <bool> hovered: touch.has-hover;
    callback toggled();

    width: 26px;
    height: 24px;
    border-radius: 4px;
    background: root.checked ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    border-width: root.checked ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: checkbox;
    accessible-label: root.tip;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(); }

    property <color> ink: root.checked ? Theme.selection-text : Theme.text-muted;
    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    Text {
        text: root.glyph;
        font-size: Theme.small;
        font-weight: 600;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.underline: Rectangle {
        x: 7px;
        y: parent.height - 6px;
        width: parent.width - 14px;
        height: 1px;
        background: root.ink;
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    // Matching modes, changed by the toggles at the right end.
    in-out property <bool> match-case;
    in-out property <bool> whole-words;
    in-out property <bool> match-path;
    in-out property <bool> match-diacritics;
    // The tip of the toggle under the mouse and where to show it.
    out property <string> hover-tip: case-toggle.hovered ? case-toggle.tip
        : words-toggle.hovered ? words-toggle.tip
        : path-toggle.hovered ? path-toggle.tip
        : marks-toggle.hovered ? marks-toggle.tip : "";
    out property <length> hover-x: case-toggle.hovered ? case-toggle.absolute-position.x
        : words-toggle.hovered ? words-toggle.absolute-position.x
        : path-toggle.hovered ? path-toggle.absolute-position.x
        : marks-toggle.absolute-position.x;
    out property <length> hover-bottom: case-toggle.absolute-position.y + case-toggle.height;
    callback edited(string);
    callback accepted();
    callback down-pressed();
    callback escape-pressed();
    callback modes-changed();
    // Window-wide shortcuts; returns whether the key was used.
    callback shortcut(KeyEvent) -> bool;
    public function focus-and-select() {
        input.focus();
        input.select-all();
    }
    // Puts the text cursor at `offset` (in bytes) with nothing selected.
    public function place-caret(offset: int) {
        input.set-selection-offsets(offset, offset);
    }

    height: Theme.field-height;
    border-radius: Theme.radius;
    background: Theme.field;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-line;

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s1;
        spacing: Theme.s2;
        Image {
            source: @image-url("icons/search.svg");
            colorize: Theme.text-muted;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        // The field takes the width the layout gives it, not the width of the
        // text: long text scrolls inside the clip instead of pushing the
        // toggles and the filter selector aside.
        Rectangle {
            horizontal-stretch: 1;
            // A TextInput of width 0 cannot take focus.
            min-width: 1px;
            clip: true;
            input := TextInput {
                // Scroll offset that keeps the text cursor visible.
                property <length> scroll-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                font-size: Theme.body + 1px;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.selection-text;
                single-line: true;
                cursor-position-changed(position) => {
                    if (position.x + self.scroll-x < 0px) {
                        self.scroll-x = -position.x;
                    } else if (position.x + self.scroll-x > parent.width - self.text-cursor-width) {
                        self.scroll-x = parent.width - position.x - self.text-cursor-width;
                    }
                }
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
                key-pressed(event) => {
                    if (root.shortcut(event)) {
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.down-pressed();
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        root.escape-pressed();
                        return accept;
                    }
                    reject
                }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            // The toggles keep their height; centre them in the field.
            padding-top: (root.height - 24px) / 2;
            padding-bottom: (root.height - 24px) / 2;
            case-toggle := ModeToggle {
                glyph: "Aa";
                tip: @tr("Match case (Alt+C)");
                checked <=> root.match-case;
                toggled => { root.modes-changed(); }
            }
            words-toggle := ModeToggle {
                glyph: "ab";
                underline: true;
                tip: @tr("Match whole words (Alt+W)");
                checked <=> root.whole-words;
                toggled => { root.modes-changed(); }
            }
            path-toggle := ModeToggle {
                glyph: "a/b";
                tip: @tr("Match the full path (Alt+P)");
                checked <=> root.match-path;
                toggled => { root.modes-changed(); }
            }
            marks-toggle := ModeToggle {
                glyph: "é";
                tip: @tr("Match diacritics (Alt+D)");
                checked <=> root.match-diacritics;
                toggled => { root.modes-changed(); }
            }
        }
    }
    placeholder := Text {
        x: Theme.s3 + Theme.icon + Theme.s2;
        visible: input.text == "";
        text: @tr("Search files and folders");
        color: Theme.text-muted;
        font-size: Theme.body + 1px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <TextHorizontalAlignment> align: left;
    // Whether the results are sorted by this column, and in which direction.
    in property <bool> sorted;
    in property <bool> descending;
    callback clicked();
    callback right-pressed(length, length);

    property <bool> right: root.align == TextHorizontalAlignment.right;
    property <length> arrow-space: root.sorted ? Theme.icon : 0px;
    property <length> label-width: min(label-text.preferred-width, label-text.width);

    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.right-pressed(self.mouse-x, self.mouse-y);
            }
        }
    }
    label-text := Text {
        x: root.right ? Theme.s2 + root.arrow-space : Theme.s2;
        width: parent.width - 2 * Theme.s2 - root.arrow-space;
        height: parent.height;
        text: root.label;
        font-size: Theme.small;
        font-weight: 600;
        color: root.sorted ? Theme.text : Theme.text-muted;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        overflow: elide;
    }
    // The arrow sits next to the label, on the side away from the alignment.
    Image {
        visible: root.sorted;
        x: root.right
            ? parent.width - Theme.s2 - root.label-width - self.width
            : Theme.s2 + root.label-width;
        y: (parent.height - self.height) / 2;
        width: Theme.icon;
        height: Theme.icon;
        source: root.descending ? @image-url("icons/sort-down.svg") : @image-url("icons/sort-up.svg");
        colorize: Theme.accent;
    }
}

component Row inherits Rectangle {
    in property <ResultRow> data;
    // The keyboard cursor is on this row and the list has focus.
    in property <bool> current;
    in property <length> name-width;
    in property <length> folder-width;
    in property <length> size-width;
    in property <length> date-width;
    // Optional columns; 0 when hidden.
    in property <length> type-width;
    in property <length> ext-width;
    // The name is being edited in place.
    in property <bool> editing;
    in-out property <string> edit-text;
    // Bytes of the name selected when editing starts (the part before the
    // extension).
    in property <int> edit-stem;
    callback pressed(KeyboardModifiers);
    callback right-pressed(length, length);
    callback double-clicked();
    callback edit-commit(string);
    callback edit-cancel();

    property <bool> selected: root.data.selected;

    height: Theme.row-height;
    background: selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    root.pressed(event.modifiers);
                } else if (event.button == PointerEventButton.right) {
                    root.right-pressed(self.mouse-x, self.mouse-y);
                }
            }
        }
        double-clicked => { root.double-clicked(); }
    }
    // Focus ring of the keyboard cursor.
    Rectangle {
        visible: root.current;
        border-width: 1px;
        border-color: Theme.accent;
    }

    // Cells are positioned directly to keep the columns aligned with the header.
    Image {
        x: Theme.s3;
        source: Icons.types[root.data.kind];
        width: Theme.row-icon;
        height: Theme.row-icon;
        y: (parent.height - self.height) / 2;
    }
    // The name as up to three pieces: before, match (bold) and after. Each
    // piece takes its natural width while there is room; the piece that runs
    // out of room is elided, and the cell clips the rest.
    name-cell := Rectangle {
        x: Theme.s3 + Theme.row-icon + Theme.s2;
        width: max(0px, root.name-width - self.x - Theme.s2);
        height: parent.height;
        clip: true;
        before := Text {
            x: 0;
            // An empty Text still reports a small preferred width; force 0.
            width: self.text == "" ? 0px : min(self.preferred-width, parent.width);
            height: parent.height;
            text: root.data.name-before;
            color: root.selected ? Theme.selection-text : Theme.text;
            font-size: Theme.list-text;
            vertical-alignment: center;
            overflow: elide;
        }
        matched := Text {
            x: before.width;
            width: self.text == "" ? 0px : min(self.preferred-width, parent.width - self.x);
            height: parent.height;
            visible: self.text != "";
            text: root.data.name-match;
            color: root.selected ? Theme.selection-text : Theme.text;
            font-size: Theme.list-text;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: matched.x + matched.width;
            width: max(0px, parent.width - self.x);
            height: parent.height;
            visible: self.text != "";
            text: root.data.name-after;
            color: root.selected ? Theme.selection-text : Theme.text;
            font-size: Theme.list-text;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.editing: Rectangle {
        x: name-cell.x - Theme.s1;
        width: name-cell.width + Theme.s1;
        y: 2px;
        height: parent.height - 4px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: 3px;
        edit := TextInput {
            x: Theme.s1;
            width: parent.width - 2 * Theme.s1;
            text <=> root.edit-text;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.list-text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.selection-text;
            init => {
                self.focus();
                self.set-selection-offsets(0, root.edit-stem);
            }
            accepted => { root.edit-commit(self.text); }
            // Leaving the field (a click elsewhere) cancels; only Enter renames.
            changed has-focus => {
                if (!self.has-focus) { root.edit-cancel(); }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.edit-cancel();
                    return accept;
                }
                // Keep list keys from moving the selection while editing.
                if (event.text == Key.UpArrow || event.text == Key.DownArrow
                    || event.text == Key.PageUp || event.text == Key.PageDown || event.text == Key.F2) {
                    return accept;
                }
                reject
            }
        }
    }
    Text {
        x: root.name-width + Theme.s2;
        width: root.folder-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.folder;
        color: root.selected ? Theme.selection-text : Theme.text-muted;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.name-width + root.folder-width;
        width: root.size-width - Theme.s2;
        height: parent.height;
        text: root.data.size;
        color: root.selected ? Theme.selection-text : Theme.text-muted;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    Text {
        x: root.name-width + root.folder-width + root.size-width + Theme.s2;
        width: root.date-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.modified;
        color: root.selected ? Theme.selection-text : Theme.text-muted;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> type-x: root.name-width + root.folder-width + root.size-width + root.date-width;
    if root.type-width > 0: Text {
        x: root.type-x + Theme.s2;
        width: root.type-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.type-name;
        color: root.selected ? Theme.selection-text : Theme.text-muted;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.ext-width > 0: Text {
        x: root.type-x + root.type-width + Theme.s2;
        width: root.ext-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.extension;
        color: root.selected ? Theme.selection-text : Theme.text-muted;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A dialog above the window: a dimmed backdrop, a card with a title, the
// content and a Close button. Esc, Enter and a click outside close it.
component InfoDialog inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 420px;
    callback close();

    background: #00000060;
    TouchArea {
        clicked => { root.close(); }
    }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Return) {
                root.close();
            }
            accept
        }
    }
    Rectangle {
        width: min(root.card-width, root.width - 2 * Theme.s5);
        height: min(card-layout.preferred-height, root.height - 2 * Theme.s5);
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        clip: true;
        // Clicks on the card stay on it.
        TouchArea { }
        card-layout := VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s3;
            Text {
                text: root.title;
                font-size: Theme.body + 2px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            @children
            HorizontalLayout {
                alignment: end;
                padding-top: Theme.s2;
                Button {
                    text: @tr("Close");
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

// A drag handle on the boundary between two header cells.
component ColumnGrip inherits TouchArea {
    callback dragged(length);
    width: Theme.s2;
    mouse-cursor: col-resize;
    // The grip follows the boundary, so the offset from the press point is the
    // movement since the previous event.
    moved => { root.dragged(self.mouse-x - self.pressed-x); }
    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        y: parent.height / 4;
        height: parent.height / 2;
        background: root.pressed || root.has-hover ? Theme.text-muted : Theme.line;
    }
}

export component AppWindow inherits Window {
    title: "EveryGrep";
    // Used on X11; Wayland compositors take the icon from the desktop entry
    // that matches the app id.
    icon: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
    preferred-width: 1040px;
    preferred-height: 660px;
    min-width: 560px;
    min-height: 320px;
    background: Theme.surface;
    default-font-size: Theme.body;

    in property <[ResultRow]> results;
    in property <string> status-left;
    in property <string> status-right;
    in property <string> message;
    in-out property <int> current: -1;
    // Text of the search field.
    in-out property <string> query <=> search.text;

    // Sort column (0 name, 1 folder, 2 size, 3 modified, 4 type, 5 extension)
    // and direction.
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-descending: false;

    // Matching modes and the filter; options-changed() runs the query again.
    in-out property <bool> match-case <=> search.match-case;
    in-out property <bool> whole-words <=> search.whole-words;
    in-out property <bool> match-path <=> search.match-path;
    in-out property <bool> match-diacritics <=> search.match-diacritics;
    in property <[string]> filter-names;
    in-out property <int> filter-index: 0;
    // Words for the modes that are on, shown in the status line.
    in property <[string]> badges;
    callback options-changed();

    // Search history: step -1 goes back, 1 forward; the handler sets the
    // query. history-record() keeps the current query.
    callback history-step(int);
    callback history-record();

    // The settings window, and ending the program (also when closing the
    // window only hides it).
    callback open-settings();
    callback quit();
    // Another window over the same index.
    callback new-window();

    // Menu bar and the appearance choices in its View menu. The choices
    // are saved as settings; the program sets the lists again after a
    // change.
    in-out property <bool> show-menu-bar: true;
    in-out property <bool> status-details: true;
    in property <[MenuChoice]> filter-items;
    in property <[MenuChoice]> theme-items;
    in property <[MenuChoice]> density-items;
    in property <[MenuChoice]> folder-size-items;
    callback menu-bar-changed(bool);
    callback status-details-changed(bool);
    callback choose-theme(int);
    callback choose-density(int);
    callback choose-folder-size(int);

    // Help: the keyboard shortcuts and the about dialog.
    in property <[ShortcutRow]> shortcuts;
    in property <string> version;
    in-out property <bool> shortcuts-open;
    in-out property <bool> about-open;

    callback query-edited(string);
    callback sort-changed(int, bool);
    callback activate(int);
    callback open-folder(int);
    // Selection: mode 0 selects only the row, 1 toggles it, 2 extends the
    // range from the anchor to it.
    callback select(int, int);
    // Actions on the selection, or on the given row when it is not selected.
    callback copy-names(int);
    callback copy-paths(int);
    callback rename-start(int);
    callback rename-commit(string);
    callback rename-cancel();
    callback trash(int);
    callback delete-request(int);
    callback confirm-accepted();
    callback confirm-cancelled();

    // A short note in the status line, e.g. "Copied 3 paths." or an error.
    in property <string> notice;
    in property <bool> notice-error;

    // In-place rename: the row being edited (-1 for none), its text and the
    // part selected at the start.
    in property <int> rename-row: -1;
    in-out property <string> rename-text;
    in property <int> rename-stem;

    // Confirmation dialog.
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-action;
    callback select-all();
    // Returns whether anything was selected.
    callback clear-selection() -> bool;
    pure callback is-selected(int) -> bool;

    // Column widths. Size and Modified keep the width the user gave them; Name
    // and Folder share the rest of the window, so the columns always end at the
    // right edge. Name keeps its chosen width while Folder can stay at least at
    // its minimum, then shrinks. Until the user drags Name, it takes 48 % of
    // the shared space.
    in-out property <length> name-want: (self.width - self.size-want - self.date-want) * 0.48;
    in-out property <length> size-want: 96px;
    in-out property <length> date-want: 120px;
    in-out property <length> type-want: 130px;
    in-out property <length> ext-want: 80px;
    // Optional columns after Modified, hidden by default.
    in-out property <bool> show-type: false;
    in-out property <bool> show-ext: false;
    // Whether Name has a width of its own (dragged, or restored from the
    // settings) rather than its share of the window.
    in-out property <bool> name-set: false;
    out property <length> name-min: 120px;
    out property <length> folder-min: 100px;
    out property <length> size-min: 56px;
    out property <length> date-min: 80px;
    out property <length> type-min: 64px;
    out property <length> ext-min: 48px;
    property <length> size-width: max(self.size-min, self.size-want);
    property <length> date-width: max(self.date-min, self.date-want);
    property <length> type-width: self.show-type ? max(self.type-min, self.type-want) : 0px;
    property <length> ext-width: self.show-ext ? max(self.ext-min, self.ext-want) : 0px;
    property <length> fixed-width: self.size-width + self.date-width + self.type-width + self.ext-width;
    property <length> flex-width: max(self.name-min + self.folder-min, self.width - self.fixed-width);
    property <length> name-width: max(self.name-min, min(self.name-want, self.flex-width - self.folder-min));
    property <length> folder-width: self.flex-width - self.name-width;

    // Dragging a boundary moves it between its two neighbours; neither gets
    // narrower than its minimum, so the total width stays the same.
    function drag-boundary(boundary: int, delta: length) {
        if (boundary <= 1) {
            root.name-set = true;
        }
        if (boundary == 0) {
            root.name-want = max(root.name-min, min(root.name-width + delta, root.name-width + root.folder-width - root.folder-min));
        } else if (boundary == 1) {
            root.name-want = root.name-width;
            root.size-want = max(root.size-min, min(root.size-width - delta, root.size-width + root.folder-width - root.folder-min));
        } else if (boundary == 2) {
            let pair = root.size-width + root.date-width;
            let size = max(root.size-min, min(root.size-width + delta, pair - root.date-min));
            root.size-want = size;
            root.date-want = pair - size;
        } else if (boundary == 3 && root.show-type) {
            let pair = root.date-width + root.type-width;
            let date = max(root.date-min, min(root.date-width + delta, pair - root.type-min));
            root.date-want = date;
            root.type-want = pair - date;
        } else if (boundary == 3) {
            let pair = root.date-width + root.ext-width;
            let date = max(root.date-min, min(root.date-width + delta, pair - root.ext-min));
            root.date-want = date;
            root.ext-want = pair - date;
        } else {
            let pair = root.type-width + root.ext-width;
            let type = max(root.type-min, min(root.type-width + delta, pair - root.ext-min));
            root.type-want = type;
            root.ext-want = pair - type;
        }
    }

    // After an optional column (4 type, 5 extension) was shown or hidden: hiding the sorted
    // column sorts by name again.
    function column-shown(column: int, shown: bool) {
        if (!shown && root.sort-column == column) {
            root.sort-column = 0;
            root.sort-descending = false;
            root.results-replaced();
            root.sort-changed(0, false);
        }
    }

    // Back to the top of a new result list.
    function results-replaced() {
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
    }

    function options-edited() {
        root.results-replaced();
        root.options-changed();
    }

    function history-go(step: int) {
        root.history-step(step);
        root.results-replaced();
    }

    // Shortcuts that work in the search field and in the list.
    function shortcut(event: KeyEvent) -> bool {
        if (event.modifiers.control && !event.modifiers.alt) {
            if (event.text == ",") {
                root.open-settings();
                return true;
            }
            if (event.text == "q" || event.text == "Q") {
                root.quit();
                return true;
            }
            return false;
        }
        if (!event.modifiers.alt || event.modifiers.control) {
            return false;
        }
        if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
            root.history-go(event.text == Key.LeftArrow ? -1 : 1);
            return true;
        }
        if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
            let n = root.filter-names.length;
            if (n > 0) {
                root.filter-index = Math.mod(root.filter-index + (event.text == Key.UpArrow ? -1 : 1), n);
                root.options-edited();
            }
            return true;
        }
        if (event.text == "c" || event.text == "C") {
            root.match-case = !root.match-case;
        } else if (event.text == "w" || event.text == "W") {
            root.whole-words = !root.whole-words;
        } else if (event.text == "p" || event.text == "P") {
            root.match-path = !root.match-path;
        } else if (event.text == "d" || event.text == "D") {
            root.match-diacritics = !root.match-diacritics;
        } else {
            return false;
        }
        root.options-edited();
        true
    }

    // Colors: 1 light, 2 dark, 0 the toolkit's reading of the desktop
    // setting. Sets the palette of the standard widgets too.
    public function set-color-scheme(scheme: int) {
        Theme.scheme = scheme == 1 ? ColorScheme.light : scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Palette.color-scheme = Theme.scheme;
    }

    // Density of the list: compact or comfortable.
    public function set-compact(compact: bool) {
        Theme.compact = compact;
    }

    public function focus-search() {
        search.focus-and-select();
    }

    // Puts the search field's text cursor at `offset` (in bytes), nothing
    // selected; used after the query is set from the history.
    public function place-search-caret(offset: int) {
        search.place-caret(offset);
    }

    public function focus-list() {
        keys.focus();
    }

    // Puts text on the clipboard through a hidden text field; Slint has no
    // clipboard API of its own.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    // Opens the context menu next to the current row.
    function show-menu-at-current() {
        if (root.current >= 0) {
            menu-area.show({
                x: Theme.s3 + Theme.icon,
                y: (root.current + 1) * Theme.row-height + list.content-y,
            });
        }
    }

    // Moves the cursor; mode as for select(), or -1 to move without changing
    // the selection.
    function move-to(row: int, mode: int) {
        if (root.results.length == 0) {
            return;
        }
        root.current = max(0, min(root.results.length - 1, row));
        if (mode >= 0) {
            root.select(root.current, mode);
        }
        // Keep the current row inside the visible part of the list.
        let top = root.current * Theme.row-height;
        if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + Theme.row-height > -list.content-y + list.visible-height) {
            list.content-y = -(top + Theme.row-height - list.visible-height);
        }
    }

    // A click on the sorted column flips the direction; another column starts
    // ascending.
    function sort-by(column: int) {
        if (root.sort-column == column) {
            root.sort-descending = !root.sort-descending;
        } else {
            root.sort-column = column;
            root.sort-descending = false;
        }
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
        root.sort-changed(root.sort-column, root.sort-descending);
    }

    property <int> page: max(1, floor(list.visible-height / Theme.row-height) - 1);

    VerticalLayout {
        // Top bar
        Rectangle {
            height: Theme.top-bar-height;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                padding-top: (Theme.top-bar-height - Theme.field-height) / 2;
                padding-bottom: (Theme.top-bar-height - Theme.field-height) / 2;
                spacing: Theme.s2;
                search := SearchField {
                    horizontal-stretch: 1;
                    edited(text) => {
                        root.current = root.results.length > 0 ? 0 : -1;
                        list.content-y = 0;
                        root.query-edited(text);
                    }
                    modes-changed => { root.options-edited(); }
                    shortcut(event) => { root.shortcut(event) }
                    accepted => {
                        root.history-record();
                        if (root.current >= 0) {
                            root.activate(root.current);
                        }
                    }
                    down-pressed => {
                        keys.focus();
                        root.move-to(root.current < 0 ? 0 : root.current + 1, 0);
                    }
                    escape-pressed => {
                        self.text = "";
                        root.query-edited("");
                    }
                }
                ComboBox {
                    width: 160px;
                    horizontal-stretch: 0;
                    accessible-label: @tr("Filter");
                    model: root.filter-names;
                    current-index <=> root.filter-index;
                    selected => { root.options-edited(); }
                }
                // Overflow menu, in place of the menu bar when that is hidden.
                if !root.show-menu-bar: more-menu := ContextMenuArea {
                    width: 34px;
                    Menu {
                        MenuItem {
                            title: @tr("Settings");
                            activated => { root.open-settings(); }
                        }
                        MenuItem {
                            title: @tr("Keyboard shortcuts");
                            activated => { root.shortcuts-open = true; }
                        }
                        MenuItem {
                            title: @tr("About EveryGrep");
                            activated => { root.about-open = true; }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Show the menu bar");
                            activated => {
                                root.show-menu-bar = true;
                                root.menu-bar-changed(true);
                            }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Quit");
                            activated => { root.quit(); }
                        }
                    }
                    Rectangle {
                        border-radius: Theme.radius;
                        background: more-touch.has-hover ? Theme.hover : transparent;
                        accessible-role: button;
                        accessible-label: @tr("More (settings: Ctrl+comma, keyboard shortcuts, about, quit: Ctrl+Q)");
                        accessible-action-default => { more-menu.show({ x: 0, y: self.height }); }
                        more-touch := TouchArea {
                            clicked => { more-menu.show({ x: 0, y: self.height }); }
                        }
                        Image {
                            source: @image-url("icons/more.svg");
                            colorize: Theme.text-muted;
                            width: Theme.icon;
                            height: Theme.icon;
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // Column headers (positioned directly, so they never feed back into
        // the window's layout). Right-click shows or hides optional columns.
        Rectangle {
            height: Theme.header-height;
            background: Theme.surface-alt;
            header-menu := ContextMenuArea {
                Menu {
                    // Activating a checkable item flips its check mark, which
                    // is tied to the column flag both ways.
                    MenuItem {
                        title: @tr("Type");
                        checkable: true;
                        checked <=> root.show-type;
                        activated => { root.column-shown(4, root.show-type); }
                    }
                    MenuItem {
                        title: @tr("Extension");
                        checkable: true;
                        checked <=> root.show-ext;
                        activated => { root.column-shown(5, root.show-ext); }
                    }
                }
                HeaderCell {
                    x: Theme.s1;
                    width: root.name-width - Theme.s1;
                    height: parent.height;
                    label: @tr("Name");
                    sorted: root.sort-column == 0;
                    descending: root.sort-descending;
                    clicked => { root.sort-by(0); }
                    right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                }
                HeaderCell {
                    x: root.name-width;
                    width: root.folder-width;
                    height: parent.height;
                    label: @tr("Folder");
                    sorted: root.sort-column == 1;
                    descending: root.sort-descending;
                    clicked => { root.sort-by(1); }
                    right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                }
                HeaderCell {
                    x: root.name-width + root.folder-width;
                    width: root.size-width;
                    height: parent.height;
                    label: @tr("Size");
                    align: right;
                    sorted: root.sort-column == 2;
                    descending: root.sort-descending;
                    clicked => { root.sort-by(2); }
                    right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                }
                HeaderCell {
                    x: root.name-width + root.folder-width + root.size-width;
                    width: root.date-width;
                    height: parent.height;
                    label: @tr("Modified");
                    sorted: root.sort-column == 3;
                    descending: root.sort-descending;
                    clicked => { root.sort-by(3); }
                    right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                }
                if root.show-type: HeaderCell {
                    x: root.name-width + root.folder-width + root.size-width + root.date-width;
                    width: root.type-width;
                    height: parent.height;
                    label: @tr("Type");
                    sorted: root.sort-column == 4;
                    descending: root.sort-descending;
                    clicked => { root.sort-by(4); }
                    right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                }
                if root.show-ext: HeaderCell {
                    x: root.name-width + root.folder-width + root.fixed-width - root.ext-width;
                    width: root.ext-width;
                    height: parent.height;
                    label: @tr("Extension");
                    sorted: root.sort-column == 5;
                    descending: root.sort-descending;
                    clicked => { root.sort-by(5); }
                    right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                }
            }
            // Boundary grips, on top of the cells.
            ColumnGrip {
                x: root.name-width - self.width / 2;
                height: parent.height;
                dragged(delta) => { root.drag-boundary(0, delta); }
            }
            ColumnGrip {
                x: root.name-width + root.folder-width - self.width / 2;
                height: parent.height;
                dragged(delta) => { root.drag-boundary(1, delta); }
            }
            ColumnGrip {
                x: root.name-width + root.folder-width + root.size-width - self.width / 2;
                height: parent.height;
                dragged(delta) => { root.drag-boundary(2, delta); }
            }
            if root.show-type || root.show-ext: ColumnGrip {
                x: root.name-width + root.folder-width + root.size-width + root.date-width - self.width / 2;
                height: parent.height;
                dragged(delta) => { root.drag-boundary(3, delta); }
            }
            if root.show-type && root.show-ext: ColumnGrip {
                x: root.name-width + root.folder-width + root.fixed-width - root.ext-width - self.width / 2;
                height: parent.height;
                dragged(delta) => { root.drag-boundary(4, delta); }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // Results
        keys := FocusScope {
            vertical-stretch: 1;
            // Shift extends the selection, Ctrl moves the cursor alone.
            property <int> move-mode: 0;
            key-pressed(event) => {
                if (root.shortcut(event)) {
                    return accept;
                }
                self.move-mode = event.modifiers.shift ? 2 : event.modifiers.control ? -1 : 0;
                if (event.text == Key.DownArrow) { root.move-to(root.current + 1, self.move-mode); return accept; }
                if (event.text == Key.UpArrow) {
                    if (root.current <= 0 && !event.modifiers.shift) { search.focus-and-select(); } else { root.move-to(root.current - 1, self.move-mode); }
                    return accept;
                }
                if (event.text == Key.PageDown) { root.move-to(root.current + root.page, self.move-mode); return accept; }
                if (event.text == Key.PageUp) { root.move-to(root.current - root.page, self.move-mode); return accept; }
                if (event.text == Key.Home) { root.move-to(0, self.move-mode); return accept; }
                if (event.text == Key.End) { root.move-to(root.results.length - 1, self.move-mode); return accept; }
                if (event.text == " " && event.modifiers.control) {
                    if (root.current >= 0) { root.select(root.current, 1); }
                    return accept;
                }
                if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                    root.select-all();
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.current >= 0) {
                        if (event.modifiers.control) { root.open-folder(root.current); } else { root.activate(root.current); }
                    }
                    return accept;
                }
                if (event.text == Key.F2) {
                    if (root.current >= 0) { root.rename-start(root.current); }
                    return accept;
                }
                if (event.text == Key.Delete) {
                    if (root.current >= 0) {
                        if (event.modifiers.shift) { root.delete-request(root.current); } else { root.trash(root.current); }
                    }
                    return accept;
                }
                if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                    if (root.current >= 0) {
                        if (event.modifiers.shift) { root.copy-paths(root.current); } else { root.copy-names(root.current); }
                    }
                    return accept;
                }
                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                    root.show-menu-at-current();
                    return accept;
                }
                // Esc clears the selection first, then goes back to the search.
                if (event.text == Key.Escape) {
                    if (!root.clear-selection()) { search.focus-and-select(); }
                    return accept;
                }
                if (event.modifiers.control && (event.text == "f" || event.text == "l")) {
                    search.focus-and-select();
                    return accept;
                }
                reject
            }

            menu-area := ContextMenuArea {
                enabled: root.current >= 0;
                Menu {
                    MenuItem {
                        title: @tr("Open");
                        activated => { root.activate(root.current); }
                    }
                    MenuItem {
                        title: @tr("Open containing folder");
                        activated => { root.open-folder(root.current); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Copy name");
                        activated => { root.copy-names(root.current); }
                    }
                    MenuItem {
                        title: @tr("Copy full path");
                        activated => { root.copy-paths(root.current); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Rename");
                        activated => { root.rename-start(root.current); }
                    }
                    MenuItem {
                        title: @tr("Move to trash");
                        activated => { root.trash(root.current); }
                    }
                    MenuItem {
                        title: @tr("Delete permanently…");
                        activated => { root.delete-request(root.current); }
                    }
                }

            list := ListView {
                for row[i] in root.results: Row {
                    data: row;
                    current: i == root.current && keys.has-focus;
                    name-width: root.name-width;
                    folder-width: root.folder-width;
                    size-width: root.size-width;
                    date-width: root.date-width;
                    type-width: root.type-width;
                    ext-width: root.ext-width;
                    pressed(mods) => {
                        root.current = i;
                        keys.focus();
                        root.select(i, mods.shift ? 2 : mods.control ? 1 : 0);
                    }
                    right-pressed(x, y) => {
                        root.current = i;
                        keys.focus();
                        if (!root.is-selected(i)) { root.select(i, 0); }
                        menu-area.show({ x: x, y: i * Theme.row-height + list.content-y + y });
                    }
                    double-clicked => { root.activate(i); }
                    editing: i == root.rename-row;
                    edit-text <=> root.rename-text;
                    edit-stem: root.rename-stem;
                    edit-commit(text) => { root.rename-commit(text); }
                    edit-cancel => { root.rename-cancel(); }
                }
            }
            }

            Text {
                visible: root.message != "";
                text: root.message;
                color: Theme.text-muted;
                font-size: Theme.body;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        // Status line
        Rectangle { height: 1px; background: Theme.line; }
        Rectangle {
            height: Theme.status-height;
            background: Theme.surface-alt;
            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                spacing: Theme.s4;
                Text {
                    text: root.status-left;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                    // Shrinks (elided) before the badges and the time do.
                    min-width: 0px;
                    horizontal-stretch: 1;
                }
                // Matching modes that are on.
                HorizontalLayout {
                    spacing: Theme.s1;
                    alignment: start;
                    for badge in root.badges: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: Theme.badge-height;
                            width: badge-text.preferred-width + 2 * Theme.s1 + 2px;
                            border-radius: 4px;
                            background: Theme.selection;
                            badge-text := Text {
                                text: badge;
                                font-size: Theme.small - 1px;
                                color: Theme.selection-text;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: root.notice;
                    font-size: Theme.small;
                    color: root.notice-error ? Theme.danger : Theme.text;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.status-right;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }

    // The window's top left corner below the menu bar: the tip is placed
    // from absolute positions.
    origin := Rectangle {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
    }

    // Tip of the matching-mode toggle under the mouse.
    if search.hover-tip != "": Rectangle {
        x: min(search.hover-x - origin.absolute-position.x, root.width - self.width - Theme.s2);
        y: search.hover-bottom - origin.absolute-position.y + Theme.s1;
        width: tip-text.preferred-width + 2 * Theme.s2;
        height: tip-text.preferred-height + 2 * Theme.s1;
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000030;
        tip-text := Text {
            text: search.hover-tip;
            font-size: Theme.small;
            color: Theme.text;
        }
    }

    // Hidden text field used by copy-text().
    clip := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        single-line: false;
        read-only: true;
        enabled: false;
    }

    // Confirmation dialog, above all other content. The backdrop takes all
    // clicks so the window behind cannot be used meanwhile.
    if root.confirm-open: Rectangle {
        background: #00000060;
        TouchArea { }
        dialog-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.confirm-cancelled(); return accept; }
                if (event.text == Key.Return) { root.confirm-accepted(); return accept; }
                accept
            }
        }
        Rectangle {
            width: min(420px, root.width - 2 * Theme.s5);
            height: dialog-layout.preferred-height;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            dialog-layout := VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s3;
                Text {
                    text: root.confirm-title;
                    font-size: Theme.body + 2px;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-text;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.s2;
                    padding-top: Theme.s2;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.confirm-cancelled(); }
                    }
                    Button {
                        text: root.confirm-action;
                        primary: true;
                        clicked => { root.confirm-accepted(); }
                    }
                }
            }
        }
    }

    if root.shortcuts-open: InfoDialog {
        title: @tr("Keyboard shortcuts");
        card-width: 520px;
        close => {
            root.shortcuts-open = false;
            search.focus-and-select();
        }
        ListView {
            // Grows with the rows up to what the window leaves.
            preferred-height: root.shortcuts.length * 24px;
            min-height: 120px;
            for row in root.shortcuts: HorizontalLayout {
                height: 24px;
                spacing: Theme.s3;
                Text {
                    width: 200px;
                    text: row.keys;
                    color: Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.action;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    if root.about-open: InfoDialog {
        title: @tr("About EveryGrep");
        close => {
            root.about-open = false;
            search.focus-and-select();
        }
        HorizontalLayout {
            spacing: Theme.s3;
            Image {
                source: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "EveryGrep";
                    font-size: Theme.body + 4px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: @tr("Version {}", root.version);
                    color: Theme.text-muted;
                }
            }
        }
        Text {
            text: @tr("Finds files and folders by name as you type.");
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: @tr("Licensed under the MIT license or the Apache License 2.0, at your option.");
            font-size: Theme.small;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        // The toolkit's attribution, required by its royalty-free license.
        HorizontalLayout {
            alignment: center;
            AboutSlint { }
        }
    }

    // The menu bar. It is drawn inside the window (GNOME has no global menu
    // bar). Its shortcuts are handled before the focused field sees the key,
    // so only keys that mean the same everywhere get one: Ctrl+C, Delete or
    // F2 keep their meaning in the search field.
    if root.show-menu-bar: MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New window");
                shortcut: @keys(Control + N);
                enabled: !root.confirm-open;
                activated => { root.new-window(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Settings…");
                shortcut: @keys(Control + ",");
                enabled: !root.confirm-open;
                activated => { root.open-settings(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Quit");
                shortcut: @keys(Control + Q);
                enabled: !root.confirm-open;
                activated => { root.quit(); }
            }
        }
        Menu {
            title: @tr("Edit");
            MenuItem {
                title: @tr("Copy name");
                enabled: root.current >= 0;
                activated => { root.copy-names(root.current); }
            }
            MenuItem {
                title: @tr("Copy full path");
                enabled: root.current >= 0;
                activated => { root.copy-paths(root.current); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Select all");
                enabled: root.results.length > 0;
                activated => {
                    root.select-all();
                    keys.focus();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Rename");
                enabled: root.current >= 0 && root.rename-row < 0;
                activated => { root.rename-start(root.current); }
            }
            MenuItem {
                title: @tr("Move to trash");
                enabled: root.current >= 0;
                activated => { root.trash(root.current); }
            }
            MenuItem {
                title: @tr("Delete permanently…");
                enabled: root.current >= 0;
                activated => { root.delete-request(root.current); }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Type column");
                checkable: true;
                checked <=> root.show-type;
                activated => { root.column-shown(4, root.show-type); }
            }
            MenuItem {
                title: @tr("Extension column");
                checkable: true;
                checked <=> root.show-ext;
                activated => { root.column-shown(5, root.show-ext); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Folder size");
                for item[i] in root.folder-size-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-folder-size(i); }
                }
            }
            Menu {
                title: @tr("Density");
                for item[i] in root.density-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-density(i); }
                }
            }
            Menu {
                title: @tr("Theme");
                for item[i] in root.theme-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-theme(i); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Selection details");
                checkable: true;
                checked <=> root.status-details;
                activated => { root.status-details-changed(root.status-details); }
            }
            MenuItem {
                title: @tr("Menu bar");
                checkable: true;
                checked <=> root.show-menu-bar;
                activated => { root.menu-bar-changed(root.show-menu-bar); }
            }
        }
        Menu {
            title: @tr("Search");
            MenuItem {
                title: @tr("Match case");
                shortcut: @keys(Alt + C);
                checkable: true;
                checked <=> root.match-case;
                activated => { root.options-edited(); }
            }
            MenuItem {
                title: @tr("Match whole words");
                shortcut: @keys(Alt + W);
                checkable: true;
                checked <=> root.whole-words;
                activated => { root.options-edited(); }
            }
            MenuItem {
                title: @tr("Match the full path");
                shortcut: @keys(Alt + P);
                checkable: true;
                checked <=> root.match-path;
                activated => { root.options-edited(); }
            }
            MenuItem {
                title: @tr("Match diacritics");
                shortcut: @keys(Alt + D);
                checkable: true;
                checked <=> root.match-diacritics;
                activated => { root.options-edited(); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Filter");
                for item[i] in root.filter-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => {
                        root.filter-index = i;
                        root.options-edited();
                    }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Previous search");
                shortcut: @keys(Alt + LeftArrow);
                activated => { root.history-go(-1); }
            }
            MenuItem {
                title: @tr("Next search");
                shortcut: @keys(Alt + RightArrow);
                activated => { root.history-go(1); }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Keyboard shortcuts");
                activated => { root.shortcuts-open = true; }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("About EveryGrep");
                activated => { root.about-open = true; }
            }
        }
    }

    init => { search.focus-and-select(); }
}
