        root.show-attrs = false;
        root.show-md5 = false;
        root.show-sha256 = false;
        root.show-crc32 = false;
        root.show-name-freq = false;
        root.show-ext-freq = false;
        root.show-size-freq = false;
        root.show-full-path = false; root.full-path-want = 160px;
        root.show-parent-path = false; root.parent-path-want = 160px;
        root.show-stem = false; root.stem-want = 160px;
        root.show-name-length = false; root.name-length-want = 160px;
        root.show-path-length = false; root.path-length-want = 160px;
        root.show-disk-size = false; root.disk-size-want = 160px;
        root.show-total-size = false; root.total-size-want = 160px;
        root.show-child-count = false; root.child-count-want = 160px;
        root.show-child-files = false; root.child-files-want = 160px;
        root.show-child-folders = false; root.child-folders-want = 160px;
        root.show-desc-count = false; root.desc-count-want = 160px;
        root.show-desc-files = false; root.desc-files-want = 160px;
        root.show-desc-folders = false; root.desc-folders-want = 160px;
        root.show-folder-depth = false; root.folder-depth-want = 160px;
        root.show-hard-links = false; root.hard-links-want = 160px;
        root.show-shortcut-target = false; root.shortcut-target-want = 160px;
        root.show-owner = false; root.owner-want = 160px;
        root.show-width = false; root.width-want = 160px;
        root.show-height = false; root.height-want = 160px;
        root.show-dimensions = false; root.dimensions-want = 160px;
        root.show-length = false; root.length-want = 160px;
        root.show-bit-rate = false; root.bit-rate-want = 160px;
        root.show-title = false; root.title-want = 160px;
        root.show-artist = false; root.artist-want = 160px;
        root.show-album = false; root.album-want = 160px;
        root.show-year = false; root.year-want = 160px;
        root.show-track = false; root.track-want = 160px;
        root.show-genre = false; root.genre-want = 160px;
        root.show-rating = false; root.rating-want = 160px;
        root.show-tags = false; root.tags-want = 160px;
        root.show-page-count = false; root.page-count-want = 160px;
        root.show-word-count = false; root.word-count-want = 160px;
        root.show-camera-maker = false; root.camera-maker-want = 160px;
        root.show-camera-model = false; root.camera-model-want = 160px;
        root.show-date-taken = false; root.date-taken-want = 160px;
        root.show-gps-lat = false; root.gps-lat-want = 160px;
        root.show-gps-long = false; root.gps-long-want = 160px;
        root.show-sha1 = false; root.sha1-want = 220px;
        root.show-sha384 = false; root.sha384-want = 430px;
        root.show-sha512 = false; root.sha512-want = 570px;
        root.show-xxhash = false; root.xxhash-want = 270px;
        root.show-dupe-group = false; root.dupe-group-want = 120px;
        root.size-want = 96px;
        root.date-want = 120px;
        root.type-want = 130px;
        root.ext-want = 80px;
        root.created-want = 120px;
        root.accessed-want = 120px;
        root.size-freq-want = 110px;
        root.ext-freq-want = 110px;
        root.name-freq-want = 110px;
        root.crc32-want = 90px;
        root.sha256-want = 300px;
        root.md5-want = 270px;
        root.attr-want = 64px;
        root.folder-want = 0px;
        root.name-set = false;
        root.name-want = (root.width - root.size-want - root.date-want) * 0.48;
        root.last-removed-column = -1;
    }

    // Back to the top of a new result list.
    function results-replaced() {
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
    }

    function options-edited() {
        root.results-replaced();
        root.options-changed();
    }

    function history-go(step: int) {
        root.history-open = false;
        root.history-step(step);
        root.results-replaced();
    }

    // The command a key runs while the focus is in a scope (0 anywhere,
    // 1 the search field, 2 the result list); Command.none for none. See
    // src/commands.rs.
    callback add-filter();
    callback organize-filters();
    callback restore-filters();
    callback add-bookmark();
    callback organize-bookmarks();
    callback find-bookmark();
    callback find-filter();
    in property <[MenuEntry]> bookmark-items;
    in property <[BookmarkFolder]> bookmark-folders;
    in property <bool> more-bookmarks;
    callback open-bookmark(int);
    callback append-bookmark(int);
    // Opens the bookmarks whose name or search holds the text (all for an
    // empty one) in new tabs, asking first when there are many.
    callback open-all-bookmarks(string);
    // Opens the searches of the bookmark folder at the index in new tabs.
    callback open-bookmark-folder(int);
    callback add-starter-bookmarks();
    callback saved-key(string, bool, bool, bool, bool) -> bool;
    callback advanced-search();
    callback search-name-list();
    callback largest-folders();
    in-out property <bool> largest-folders-visible;
    callback resolve-key(int, string, bool, bool, bool, bool) -> Command;

    // File actions that are refused, with a note, for an item on a drive
    // that is not connected.
    function needs-online(c: Command) -> bool {
        return c == Command.open || c == Command.open-folder || c == Command.open-with
            || c == Command.cut || c == Command.copy || c == Command.paste
            || c == Command.rename || c == Command.create-shortcut || c == Command.new-folder || c == Command.bulk-rename || c == Command.copy-to-folder || c == Command.move-to-folder || c == Command.trash || c == Command.delete-permanently;
    }

    // Whether a command can run now; menu items are enabled by it.
    function can-run(c: Command) -> bool {
        if (root.properties-open || root.export-open || root.confirm-open || root.fileops-rename-open || root.bulk-open || root.dupes-open || root.fileops-conflict-open) {
            return false;
        }
        if (c == Command.properties) { return root.current >= 0; }
        if (c == Command.close-preview-panel) { return root.preview-visible; }
        if (c == Command.close-folders-panel) { return root.folders-visible; }
        if (c == Command.undo-file) { return root.file-undo-enabled && root.file-can-undo; }
        if (c == Command.redo-file) { return root.file-undo-enabled && root.file-can-redo; }
        if (c == Command.file-undo-history) { return root.file-undo-enabled; }
        if (root.needs-online(c)) {
            return root.current >= 0 && !root.current-offline
                && (c != Command.rename || root.rename-row < 0);
        }
        if (c == Command.search-property-value) { return root.current >= 0 && root.value-available; }
        if (c == Command.read-extended) { return root.current >= 0; }
        if (c == Command.copy-column-value || c == Command.copy-properties) { return root.current >= 0; }
        if (c == Command.copy-name || c == Command.copy-path || c == Command.copy-full-path
                || c == Command.copy-path-quoted || c == Command.copy-full-path-quoted
                || c == Command.search-in-program || c == Command.search-containing-folder
                || c == Command.search-filename || c == Command.search-exact-name || c == Command.search-stem || c == Command.search-whole-stem
                || c == Command.toggle-row || c == Command.context-menu) {
            return root.current >= 0;
        }
        if (c == Command.export-results || c == Command.select-all || c == Command.invert-selection || c == Command.clean-duplicates) {
            return root.results.length > 0;
        }
        if (c == Command.restore-removed-column) {
            return root.last-removed-column >= 4;
        }
        return c != Command.none;
    }

    // A menu gives the focus back to the control that had it when the menu
    // closes, which is after its item ran (Slint 1.18). A command that moves
    // the focus therefore moves it once more just after that: 1 the folder
    // tree, 2 the result list (the search field when there are no results).
    property <int> focus-after-menu;
    focus-later := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.running = false;
            if (root.focus-after-menu == 1 && root.folders-visible) {
                folders.focus-tree();
            } else if (root.focus-after-menu == 3 && root.preview-visible) {
                preview.focus-panel();
            } else if (root.focus-after-menu == 2) {
                if (root.results.length > 0) { root.focus-list(); } else { root.focus-search(); }
            }
            root.focus-after-menu = 0;
        }
    }
    function focus-soon(target: int) {
        root.focus-after-menu = target;
        focus-later.running = true;
    }

    // Runs a command.
    function run(c: Command) {
        if (c == Command.new-tab || c == Command.close-tab || c == Command.duplicate-tab || c == Command.next-tab || c == Command.previous-tab || c == Command.select-tab-1 || c == Command.select-tab-2 || c == Command.select-tab-3 || c == Command.select-tab-4 || c == Command.select-tab-5 || c == Command.select-tab-6 || c == Command.select-tab-7 || c == Command.select-tab-8 || c == Command.select-tab-9 || c == Command.select-tab-10 || c == Command.list-tabs || c == Command.close-multiple-tabs || c == Command.close-left-tabs || c == Command.close-right-tabs || c == Command.close-other-tabs || c == Command.reopen-tab || c == Command.reopen-all-tabs) {
            root.tab-command(c);
        } else if (c == Command.new-window) {
            root.new-window();
        } else if (c == Command.close-window) {
            root.close-window();
        } else if (c == Command.export-results) {
            root.export-results();
        } else if (c == Command.quit) {
            root.quit();
        } else if (c == Command.open) {
            root.activate(root.current);
        } else if (c == Command.open-folder) {
            root.open-folder(root.current);
        } else if (c == Command.properties) {
            root.show-properties(root.current);
        } else if (c == Command.open-with) {
            root.open-with(root.current);
        } else if (c == Command.cut) {
            root.cut-items(root.current);
        } else if (c == Command.copy) {
            root.copy-items(root.current);
        } else if (c == Command.paste) {
            root.paste-items(root.current);
        } else if (c == Command.copy-name) {
            root.copy-names(root.current);
        } else if (c == Command.read-extended) {
            root.read-extended(root.current);
        } else if (c == Command.copy-column-value) {
            root.copy-column-values(root.current, root.copy-column);
        } else if (c == Command.copy-properties) {
            root.copy-properties(root.current, root.all-col-shown(), root.all-col-labels());
        } else if (c == Command.copy-path) {
            root.copy-folders(root.current, false);
        } else if (c == Command.copy-full-path) {
            root.copy-paths(root.current, false);
        } else if (c == Command.copy-path-quoted) {
            root.copy-folders(root.current, true);
        } else if (c == Command.copy-full-path-quoted) {
            root.copy-paths(root.current, true);
        } else if (c == Command.select-all) {
            root.select-all();
            keys.focus();
        } else if (c == Command.invert-selection) {
            root.invert-selection();
            keys.focus();
        } else if (c == Command.toggle-row) {
            root.select(root.current, 1);
        } else if (c == Command.search-in-program || c == Command.search-containing-folder) {
            root.fileops-search(root.current, c == Command.search-containing-folder);
        } else if (c == Command.create-shortcut) {
            root.fileops-shortcuts(root.current);
        } else if (c == Command.new-folder) {
            root.fileops-new-folder(root.current);
        } else if (c == Command.bulk-rename) {
            root.fileops-bulk-rename(root.current);
        } else if (c == Command.clean-duplicates) {
            root.fileops-clean-duplicates();
        } else if (c == Command.copy-to-folder || c == Command.move-to-folder) {
            root.fileops-to-folder(root.current, c == Command.move-to-folder);
        } else if (c == Command.search-property-value) {
            root.fileops-search-value();
        } else if (c == Command.search-filename || c == Command.search-exact-name || c == Command.search-stem || c == Command.search-whole-stem) {
            root.fileops-search-filename(root.current, c == Command.search-exact-name || c == Command.search-whole-stem, c == Command.search-stem || c == Command.search-whole-stem);
        } else if (c == Command.undo-file || c == Command.redo-file) {
            root.file-undo(c == Command.redo-file);
        } else if (c == Command.file-undo-history) {
            root.file-undo-history();
        } else if (c == Command.rename) {
            root.rename-start(root.current);
        } else if (c == Command.trash) {
            root.trash(root.current);
        } else if (c == Command.delete-permanently) {
            root.delete-request(root.current);
        } else if (c == Command.focus-search) {
            search.focus-and-select();
        } else if (c == Command.context-menu) {
            root.show-menu-at-current();
        } else if (c == Command.type-column) {
            root.show-type = !root.show-type;
            root.toggled(c);
        } else if (c == Command.extension-column) {
            root.show-ext = !root.show-ext;
            root.toggled(c);
        } else if (c == Command.created-column) {
            root.show-created = !root.show-created;
            root.toggled(c);
        } else if (c == Command.accessed-column) {
            root.show-accessed = !root.show-accessed;
            root.toggled(c);
        } else if (c == Command.attributes-column) {
            root.show-attrs = !root.show-attrs;
            root.toggled(c);
        } else if (c == Command.md5-column) {
            root.show-md5 = !root.show-md5;
            root.toggled(c);
        } else if (c == Command.sha256-column) {
            root.show-sha256 = !root.show-sha256;
            root.toggled(c);
        } else if (c == Command.crc32-column) {
            root.show-crc32 = !root.show-crc32;
            root.toggled(c);
        } else if (c == Command.name-frequency-column) {
            root.show-name-freq = !root.show-name-freq;
            root.toggled(c);
        } else if (c == Command.extension-frequency-column) {
            root.show-ext-freq = !root.show-ext-freq;
            root.toggled(c);
        } else if (c == Command.size-frequency-column) {
            root.show-size-freq = !root.show-size-freq;
            root.toggled(c);
        } else if (c == Command.full-path-column) {
            root.set-column-shown(15, !root.col-shown(15));
        } else if (c == Command.parent-path-column) {
            root.set-column-shown(16, !root.col-shown(16));
        } else if (c == Command.stem-column) {
            root.set-column-shown(17, !root.col-shown(17));
        } else if (c == Command.name-length-column) {
            root.set-column-shown(18, !root.col-shown(18));
        } else if (c == Command.path-length-column) {
            root.set-column-shown(19, !root.col-shown(19));
        } else if (c == Command.disk-size-column) {
            root.set-column-shown(20, !root.col-shown(20));
        } else if (c == Command.total-size-column) {
            root.set-column-shown(21, !root.col-shown(21));
        } else if (c == Command.child-count-column) {
            root.set-column-shown(22, !root.col-shown(22));
        } else if (c == Command.child-files-column) {
            root.set-column-shown(23, !root.col-shown(23));
        } else if (c == Command.child-folders-column) {
            root.set-column-shown(24, !root.col-shown(24));
        } else if (c == Command.desc-count-column) {
            root.set-column-shown(25, !root.col-shown(25));
        } else if (c == Command.desc-files-column) {
            root.set-column-shown(26, !root.col-shown(26));
        } else if (c == Command.desc-folders-column) {
            root.set-column-shown(27, !root.col-shown(27));
        } else if (c == Command.folder-depth-column) {
            root.set-column-shown(28, !root.col-shown(28));
        } else if (c == Command.hard-links-column) {
            root.set-column-shown(29, !root.col-shown(29));
        } else if (c == Command.shortcut-target-column) {
            root.set-column-shown(30, !root.col-shown(30));
        } else if (c == Command.owner-column) {
            root.set-column-shown(31, !root.col-shown(31));
        } else if (c == Command.width-column) {
            root.set-column-shown(32, !root.col-shown(32));
        } else if (c == Command.height-column) {
            root.set-column-shown(33, !root.col-shown(33));
        } else if (c == Command.dimensions-column) {
            root.set-column-shown(34, !root.col-shown(34));
        } else if (c == Command.length-column) {
            root.set-column-shown(35, !root.col-shown(35));
        } else if (c == Command.bit-rate-column) {
            root.set-column-shown(36, !root.col-shown(36));
        } else if (c == Command.title-column) {
            root.set-column-shown(37, !root.col-shown(37));
        } else if (c == Command.artist-column) {
            root.set-column-shown(38, !root.col-shown(38));
        } else if (c == Command.album-column) {
            root.set-column-shown(39, !root.col-shown(39));
        } else if (c == Command.year-column) {
            root.set-column-shown(40, !root.col-shown(40));
        } else if (c == Command.track-column) {
            root.set-column-shown(41, !root.col-shown(41));
        } else if (c == Command.genre-column) {
            root.set-column-shown(42, !root.col-shown(42));
        } else if (c == Command.rating-column) {
            root.set-column-shown(43, !root.col-shown(43));
        } else if (c == Command.tags-column) {
            root.set-column-shown(44, !root.col-shown(44));
        } else if (c == Command.page-count-column) {
            root.set-column-shown(45, !root.col-shown(45));
        } else if (c == Command.word-count-column) {
            root.set-column-shown(46, !root.col-shown(46));
        } else if (c == Command.camera-maker-column) {
            root.set-column-shown(47, !root.col-shown(47));
        } else if (c == Command.camera-model-column) {
            root.set-column-shown(48, !root.col-shown(48));
        } else if (c == Command.date-taken-column) {
            root.set-column-shown(49, !root.col-shown(49));
        } else if (c == Command.gps-lat-column) {
            root.set-column-shown(50, !root.col-shown(50));
        } else if (c == Command.gps-long-column) {
            root.set-column-shown(51, !root.col-shown(51));
        } else if (c == Command.sha1-column) {
            root.set-column-shown(52, !root.col-shown(52));
        } else if (c == Command.sha384-column) {
            root.set-column-shown(53, !root.col-shown(53));
        } else if (c == Command.sha512-column) {
            root.set-column-shown(54, !root.col-shown(54));
        } else if (c == Command.xxhash-column) {
            root.set-column-shown(55, !root.col-shown(55));
        } else if (c == Command.dupe-group-column) {
            root.set-column-shown(56, !root.col-shown(56));
        } else if (c == Command.selection-details) {
            root.status-details = !root.status-details;
            root.toggled(c);
        } else if (c == Command.menu-bar) {
            root.show-menu-bar = !root.show-menu-bar;
            root.toggled(c);
        } else if (c == Command.status-bar) {
            root.show-status-bar = !root.show-status-bar;
            root.toggled(c);
        } else if (c == Command.toolbar) {
            root.show-toolbar = !root.show-toolbar;
            root.toggled(c);
        } else if (c == Command.zoom-in) {
            root.zoom-step(1);
        } else if (c == Command.zoom-out) {
            root.zoom-step(-1);
        } else if (c == Command.zoom-reset) {
            root.zoom-step(0);
        } else if (c == Command.match-case) {
            root.match-case = !root.match-case;
            root.toggled(c);
        } else if (c == Command.whole-words) {
            root.whole-words = !root.whole-words;
            root.toggled(c);
        } else if (c == Command.match-path) {
            root.match-path = !root.match-path;
            root.toggled(c);
        } else if (c == Command.match-diacritics) {
            root.match-diacritics = !root.match-diacritics;
            root.toggled(c);
        } else if (c == Command.regex) {
            root.use-regex = !root.use-regex;
            root.toggled(c);
        } else if (c == Command.match-prefix) {
            root.match-prefix = !root.match-prefix;
            root.toggled(c);
        } else if (c == Command.match-suffix) {
            root.match-suffix = !root.match-suffix;
            root.toggled(c);
        } else if (c == Command.ignore-punctuation) {
            root.ignore-punctuation = !root.ignore-punctuation;
            root.toggled(c);
        } else if (c == Command.ignore-whitespace) {
            root.ignore-whitespace = !root.ignore-whitespace;
            root.toggled(c);
        } else if (c == Command.show-hidden-files) {
            root.choose-hidden-files(0);
        } else if (c == Command.hide-hidden-files) {
            root.choose-hidden-files(1);
        } else if (c == Command.only-hidden-files) {
            root.choose-hidden-files(2);
        } else if (c == Command.cycle-hidden-files) {
            root.choose-hidden-files(Math.mod(root.hidden-files + 1, 3));
        } else if (c == Command.previous-filter || c == Command.next-filter) {
            let n = root.filter-names.length;
            if (n > 0) {
                let step = c == Command.previous-filter ? -1 : 1;
                let next = root.filter-wrap ? Math.mod(root.filter-index + step + n, n)
                    : max(0, min(n - 1, root.filter-index + step));
                if (next != root.filter-index) {
                    root.filter-index = next;
                    root.options-edited();
                }
            }
        } else if (c == Command.previous-search) {
            root.history-go(-1);
        } else if (c == Command.next-search) {
            root.history-go(1);
        } else if (c == Command.find-duplicates) {
            root.dupe-term(0);
            root.results-replaced();
        } else if (c == Command.find-name-duplicates) {
            root.dupe-term(1);
            root.results-replaced();
        } else if (c == Command.find-size-duplicates) {
            root.dupe-term(2);
            root.results-replaced();
        } else if (c == Command.clear-duplicates) {
            root.dupe-term(-1);
            root.results-replaced();
        } else if (c == Command.rebuild-index) {
            root.rebuild-index();
        } else if (c == Command.pause-index-updates) {
            root.index-paused = !root.index-paused;
            root.toggled(c);
        } else if (c == Command.hide-offline-entries) {
            root.hide-offline = !root.hide-offline;
            root.toggled(c);
        } else if (c == Command.create-file-list) {
            root.create-file-list();
        } else if (c == Command.show-history) {
            root.history-full = true;
            root.history-current = -1;
            root.history-list-requested();
            root.history-open = !root.history-open;
            search.focus-and-select();
        } else if (c == Command.organize-history) {
            root.history-open = false;
            root.organize-history();
        } else if (c == Command.add-filter) {
            root.add-filter();
        } else if (c == Command.organize-filters) {
            root.organize-filters();
        } else if (c == Command.restore-filters) {
            root.restore-filters();
        } else if (c == Command.add-bookmark) { root.add-bookmark();
        } else if (c == Command.organize-bookmarks) { root.organize-bookmarks();
        } else if (c == Command.find-bookmark) { root.find-bookmark();
        } else if (c == Command.find-filter) { root.find-filter();
        } else if (c == Command.open-all-bookmarks) { root.open-all-bookmarks("");
        } else if (c == Command.copy-search) { root.copy-text(root.query);
        } else if (c == Command.largest-folders) { root.largest-folders();
        } else if (c == Command.search-name-list) { root.search-name-list();
        } else if (c == Command.advanced-search) { root.advanced-search();
        } else if (c == Command.settings) {
            root.open-settings();
        } else if (c == Command.keyboard-settings) {
            root.open-keyboard-settings();
        } else if (c == Command.shortcuts-help) {
            root.shortcuts-open = true;
        } else if (c == Command.search-syntax-help) {
            root.help-page = 0;
            root.help-open = true;
        } else if (c == Command.regex-help) {
            root.help-page = 1;
            root.help-open = true;
        } else if (c == Command.command-line-help) {
            root.help-page = 2;
            root.help-open = true;
        } else if (c == Command.open-settings-file) {
            root.open-settings-file();
        } else if (c == Command.copy-troubleshooting-info) {
            root.copy-troubleshooting-info();
        } else if (c == Command.debug-log) {
            root.open-debug-log();
        } else if (c == Command.about) {
            root.about-open = true;
        } else if (c == Command.preview-panel) {
            root.preview-visible = !root.preview-visible; root.preview-changed();
        } else if (c == Command.focus-preview) {
            root.preview-visible = true; root.preview-changed(); preview.focus-panel(); root.focus-soon(3);
        } else if (c == Command.close-preview-panel) {
            root.preview-visible = false; root.preview-changed();
            if (root.results.length > 0) { root.focus-list(); } else { root.focus-search(); } root.focus-soon(2);
        } else if (c == Command.close-folders-panel) {
            root.folders-visible = false;
            root.folders-changed();
            if (root.results.length > 0) { root.focus-list(); } else { root.focus-search(); }
            root.focus-soon(2);
        } else if (c == Command.folders-panel) {
            root.folders-visible = !root.folders-visible;
            root.folders-changed();
        } else if (c == Command.focus-folders) {
            root.folders-visible = true;
            root.folders-changed();
            folders.focus-tree();
            root.focus-soon(1);
        } else if (c == Command.refresh) {
            root.refresh();
        } else if (c == Command.organize-columns) {
            root.organize-filter = "";
            root.organize-open = true;
        } else if (c == Command.advanced-sort) {
            root.advanced-sort-opening();
            root.advanced-sort-open = true;
        } else if (c == Command.reset-columns) {
            root.reset-columns();
        } else if (c == Command.restore-removed-column) {
            root.set-column-shown(root.last-removed-column, true);
        } else if (c == Command.fit-columns) {
            root.fit-all-columns();
        } else if (c == Command.fit-columns-to-window) {
            root.fit-columns-to-window();
        }
    }

    // After an on/off command changed its flag (by a key, or by its
    // checkable menu item, which flips the flag itself): applies it.
    function toggled(c: Command) {
        if (c == Command.type-column) {
            root.column-shown(4, root.show-type);
        } else if (c == Command.extension-column) {
            root.column-shown(5, root.show-ext);
        } else if (c == Command.created-column) {
            root.column-shown(6, root.show-created);
        } else if (c == Command.accessed-column) {
            root.column-shown(7, root.show-accessed);
        } else if (c == Command.attributes-column) {
            root.column-shown(8, root.show-attrs);
        } else if (c == Command.md5-column) {
            root.column-shown(9, root.show-md5);
        } else if (c == Command.sha256-column) {
            root.column-shown(10, root.show-sha256);
        } else if (c == Command.crc32-column) {
            root.column-shown(11, root.show-crc32);
        } else if (c == Command.name-frequency-column) {
            root.column-shown(12, root.show-name-freq);
        } else if (c == Command.extension-frequency-column) {
            root.column-shown(13, root.show-ext-freq);
        } else if (c == Command.size-frequency-column) {
            root.column-shown(14, root.show-size-freq);
        } else if (c == Command.selection-details) {
            root.status-details-changed(root.status-details);
        } else if (c == Command.menu-bar) {
            root.menu-bar-changed(root.show-menu-bar);
        } else if (c == Command.status-bar) {
            root.status-bar-changed(root.show-status-bar);
        } else if (c == Command.toolbar) {
            root.toolbar-changed(root.show-toolbar);
        } else if (c == Command.pause-index-updates) {
            root.index-paused-changed(root.index-paused);
        } else if (c == Command.hide-offline-entries) {
            root.hide-offline-changed(root.hide-offline);
        } else {
            root.options-edited();
        }
    }

    // View → Sort by: the columns, the shown optional ones enabled, and the
    // two directions. A new list on every change gives fresh check marks.
    out property <[SortChoice]> sort-items: [
        { title: @tr("Name"), column: 0, checked: root.sort-column == 0, enabled: true },
        { title: @tr("Folder"), column: 1, checked: root.sort-column == 1, enabled: true },
        { title: @tr("Size"), column: 2, checked: root.sort-column == 2, enabled: true },
        { title: @tr("Modified"), column: 3, checked: root.sort-column == 3, enabled: true },
        { title: @tr("Type"), column: 4, checked: root.sort-column == 4, enabled: root.show-type },
        { title: @tr("Extension"), column: 5, checked: root.sort-column == 5, enabled: root.show-ext },
        { title: @tr("Created"), column: 6, checked: root.sort-column == 6, enabled: root.show-created },
        { title: @tr("Accessed"), column: 7, checked: root.sort-column == 7, enabled: root.show-accessed },
        { title: @tr("Attributes"), column: 8, checked: root.sort-column == 8, enabled: root.show-attrs },
        { title: @tr("Same name"), column: 12, checked: root.sort-column == 12, enabled: root.show-name-freq },
        { title: @tr("Same extension"), column: 13, checked: root.sort-column == 13, enabled: root.show-ext-freq },
        { title: @tr("Same size"), column: 14, checked: root.sort-column == 14, enabled: root.show-size-freq },
        { title: @tr("MD5"), column: 9, checked: root.sort-column == 9, enabled: root.show-md5 },
        { title: @tr("SHA-256"), column: 10, checked: root.sort-column == 10, enabled: root.show-sha256 },
        { title: @tr("CRC-32"), column: 11, checked: root.sort-column == 11, enabled: root.show-crc32 },
        { title: @tr("Full path"), column: 15, checked: root.sort-column == 15, enabled: root.show-full-path },
        { title: @tr("Parent path"), column: 16, checked: root.sort-column == 16, enabled: root.show-parent-path },
        { title: @tr("Stem"), column: 17, checked: root.sort-column == 17, enabled: root.show-stem },
        { title: @tr("Name length"), column: 18, checked: root.sort-column == 18, enabled: root.show-name-length },
        { title: @tr("Path length"), column: 19, checked: root.sort-column == 19, enabled: root.show-path-length },
        { title: @tr("Size on disk"), column: 20, checked: root.sort-column == 20, enabled: root.show-disk-size },
        { title: @tr("Total size"), column: 21, checked: root.sort-column == 21, enabled: root.show-total-size },
        { title: @tr("Items"), column: 22, checked: root.sort-column == 22, enabled: root.show-child-count },
        { title: @tr("Files inside"), column: 23, checked: root.sort-column == 23, enabled: root.show-child-files },
        { title: @tr("Subfolders"), column: 24, checked: root.sort-column == 24, enabled: root.show-child-folders },
        { title: @tr("Items at any depth"), column: 25, checked: root.sort-column == 25, enabled: root.show-desc-count },
        { title: @tr("Files at any depth"), column: 26, checked: root.sort-column == 26, enabled: root.show-desc-files },
        { title: @tr("Subfolders at any depth"), column: 27, checked: root.sort-column == 27, enabled: root.show-desc-folders },
        { title: @tr("Folder depth"), column: 28, checked: root.sort-column == 28, enabled: root.show-folder-depth },
        { title: @tr("Hard link count"), column: 29, checked: root.sort-column == 29, enabled: root.show-hard-links },
        { title: @tr("Shortcut target"), column: 30, checked: root.sort-column == 30, enabled: root.show-shortcut-target },
        { title: @tr("Owner"), column: 31, checked: root.sort-column == 31, enabled: root.show-owner },
        { title: @tr("Width"), column: 32, checked: root.sort-column == 32, enabled: root.show-width },
        { title: @tr("Height"), column: 33, checked: root.sort-column == 33, enabled: root.show-height },
        { title: @tr("Dimensions"), column: 34, checked: root.sort-column == 34, enabled: root.show-dimensions },
        { title: @tr("Length"), column: 35, checked: root.sort-column == 35, enabled: root.show-length },
        { title: @tr("Bit rate"), column: 36, checked: root.sort-column == 36, enabled: root.show-bit-rate },
        { title: @tr("Title"), column: 37, checked: root.sort-column == 37, enabled: root.show-title },
        { title: @tr("Artist"), column: 38, checked: root.sort-column == 38, enabled: root.show-artist },
        { title: @tr("Album"), column: 39, checked: root.sort-column == 39, enabled: root.show-album },
        { title: @tr("Year"), column: 40, checked: root.sort-column == 40, enabled: root.show-year },
        { title: @tr("Track"), column: 41, checked: root.sort-column == 41, enabled: root.show-track },
        { title: @tr("Genre"), column: 42, checked: root.sort-column == 42, enabled: root.show-genre },
        { title: @tr("Rating"), column: 43, checked: root.sort-column == 43, enabled: root.show-rating },
        { title: @tr("Tags"), column: 44, checked: root.sort-column == 44, enabled: root.show-tags },
        { title: @tr("Page count"), column: 45, checked: root.sort-column == 45, enabled: root.show-page-count },
        { title: @tr("Word count"), column: 46, checked: root.sort-column == 46, enabled: root.show-word-count },
        { title: @tr("Camera maker"), column: 47, checked: root.sort-column == 47, enabled: root.show-camera-maker },
        { title: @tr("Camera model"), column: 48, checked: root.sort-column == 48, enabled: root.show-camera-model },
        { title: @tr("Date taken"), column: 49, checked: root.sort-column == 49, enabled: root.show-date-taken },
        { title: @tr("GPS latitude"), column: 50, checked: root.sort-column == 50, enabled: root.show-gps-lat },
        { title: @tr("GPS longitude"), column: 51, checked: root.sort-column == 51, enabled: root.show-gps-long },
        { title: @tr("SHA-1"), column: 52, checked: root.sort-column == 52, enabled: root.show-sha1 },
        { title: @tr("SHA-384"), column: 53, checked: root.sort-column == 53, enabled: root.show-sha384 },
        { title: @tr("SHA-512"), column: 54, checked: root.sort-column == 54, enabled: root.show-sha512 },
        { title: @tr("xxHash (XXH3-128)"), column: 55, checked: root.sort-column == 55, enabled: root.show-xxhash },
        { title: @tr("Duplicate group"), column: 56, checked: root.sort-column == 56, enabled: root.show-dupe-group },
    ];
    property <[MenuChoice]> sort-order-items: [
        { title: @tr("Ascending"), checked: !root.sort-descending },
        { title: @tr("Descending"), checked: root.sort-descending },
    ];

    // Drops the secondary and tertiary sort columns.
    function clear-then-sort() {
        root.sort-then1-column = -1;
        root.sort-then2-column = -1;
    }

    // Sorts by the choices of the Advanced sort dialog.
    function apply-advanced-sort() {
        root.sort-column = root.advanced-sort-columns[root.advanced-sort-chosen[0]];
        root.sort-descending = root.advanced-sort-descending[0];
        root.sort-then1-column = root.advanced-sort-chosen[1] == 0 ? -1 : root.advanced-sort-columns[root.advanced-sort-chosen[1] - 1];
        root.sort-then1-descending = root.advanced-sort-descending[1];
        root.sort-then2-column = root.advanced-sort-chosen[2] == 0 ? -1 : root.advanced-sort-columns[root.advanced-sort-chosen[2] - 1];
        root.sort-then2-descending = root.advanced-sort-descending[2];
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
        root.results-replaced();
        root.sort-changed(root.sort-column, root.sort-descending);
    }

    // Sorts by a column in a direction.
    function sort-to(column: int, descending: bool) {
        if (column != root.sort-column) {
            root.clear-then-sort();
        }
        root.sort-column = column;
        root.sort-descending = descending;
        root.results-replaced();
        root.sort-changed(column, descending);
    }

    // Runs the command of a key pressed with the focus in `scope`; returns
    // whether the key belongs to a command (it is used even when the
    // command cannot run now). A file action on an offline item runs, so
    // the program can say why it is refused.
    function dispatch(scope: int, event: KeyEvent) -> bool {
        let c = root.resolve-key(scope, event.text, event.modifiers.control, event.modifiers.alt,
            event.modifiers.shift, event.modifiers.meta);
        if (c == Command.search-property-value) {
            root.value-column = 0;
            root.value-available = root.fileops-prepare-value(root.current, 0);
        }
        if (c == Command.none) {
            if (root.export-open || root.confirm-open || root.fileops-rename-open || root.bulk-open || root.dupes-open || root.fileops-conflict-open) { return false; }
            return root.saved-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
        }
        if (root.can-run(c) || (!root.export-open && !root.confirm-open && !root.fileops-rename-open && !root.bulk-open && !root.dupes-open && !root.fileops-conflict-open && ((root.current >= 0 && root.needs-online(c)) || c == Command.undo-file || c == Command.redo-file))) {
            root.run(c);
        }
        true
    }

    // Colors: 1 light, 2 dark, 0 the toolkit's reading of the desktop
    // setting. Sets the palette of the standard widgets too.
    public function set-color-scheme(scheme: int) {
        Theme.scheme = scheme == 1 ? ColorScheme.light : scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Palette.color-scheme = Theme.scheme;
    }

    // Density of the list: compact or comfortable.
    public function set-compact(compact: bool) {
        Theme.compact = compact;
    }

    // Zoom of the result list (1 = 100 %).
    public function set-zoom(zoom: float) {
        Theme.zoom = zoom;
    }

    public function focus-search() {
        search.focus-and-select();
    }

    // Puts the search field's text cursor at `offset` (in bytes), nothing
    // selected; used after the query is set from the history.
    public function place-search-caret(offset: int) {
        // The offset counts in the whole text; the field holds what follows
        // the folder label.
        root.sync-scope();
        search.place-caret(root.scope == "" ? offset : max(0, offset - root.scope-bytes - 1));
    }

    public function focus-list() {
        keys.focus();
    }

    // Puts text on the clipboard through a hidden text field; Slint has no
    // clipboard API of its own.
    callback clipboard-text-written();
    public function copy-text(text: string) {
        root.clipboard-text-written();
        root.copy-file-text(text);
    }

    // File offers keep their lossless paths while publishing fallback text.
    public function copy-file-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    // The text on the clipboard, read through the same hidden field.
    public function paste-text() -> string {
        clip.text = "";
        clip.paste();
        let text = clip.text;
        clip.text = "";
        return text;
    }

    // Opens the context menu next to the current row.
    function show-menu-at-current() {
        if (root.current >= 0) {
            root.value-column = 0;
            root.value-available = root.fileops-prepare-value(root.current, 0);
            root.copy-column = 0;
            menu-area.show({
                x: Theme.s3 + Theme.icon,
                y: (root.current + 1) * Theme.row-height + list.content-y,
            });
        }
    }

    // Moves the cursor; mode as for select(), or -1 to move without changing
    // the selection. A jump in progress ends.
    function move-to(row: int, mode: int) {
        root.jump-reset();
        root.place-cursor(row, mode);
    }

    // move-to() without ending a jump, for the jump itself.
    function place-cursor(row: int, mode: int) {
        if (root.results.length == 0) {
            return;
        }
        root.current = max(0, min(root.results.length - 1, row));
        if (mode >= 0) {
            root.select(root.current, mode);
        }
        // Keep the current row inside the visible part of the list.
        let top = root.current * Theme.row-height;
        if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + Theme.row-height > -list.content-y + list.visible-height) {
            list.content-y = -(top + Theme.row-height - list.visible-height);
        }
    }

    // A click on the sorted column flips the direction; another column starts
    // ascending, or descending for dates and sizes when the settings say so.
    function sort-by(column: int) {
        let next = root.single-column-sort({
            column: root.sort-column, descending: root.sort-descending,
            then1: root.sort-then1-column, then1-descending: root.sort-then1-descending,
            then2: root.sort-then2-column, then2-descending: root.sort-then2-descending,
        }, column, root.first-descending(column));
        root.sort-column = next.column;
        root.sort-descending = next.descending;
        root.sort-then1-column = next.then1;
        root.sort-then1-descending = next.then1-descending;
        root.sort-then2-column = next.then2;
        root.sort-then2-descending = next.then2-descending;
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
        root.sort-changed(root.sort-column, root.sort-descending);
    }

    property <int> page: max(1, floor(list.visible-height / Theme.row-height) - 1);
    // The current row is on a drive that is not connected: file actions
    // are off for it.
    property <bool> current-offline: root.current >= 0 && root.current < root.results.length
        && root.results[root.current].offline;

    // Keys pressed while the focus is on a control without keys of its own
    // (the filter selector, a button) run the global commands. It never
    // takes the focus itself.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (root.dispatch(0, event)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Toolbar (optional): commands that are in the menus too.
            if root.show-toolbar: Rectangle {
                height: Theme.field-height + Theme.s2;
                background: Theme.surface-alt;
                HorizontalLayout {
                    padding-left: Theme.margin - Theme.s2;
                    padding-right: Theme.margin;
                    padding-top: Theme.s1;
                    padding-bottom: Theme.s1;
                    spacing: Theme.s1;
                    alignment: start;
                    ToolButton { glyph: "←"; text: @tr("Back"); enabled: root.can-run(Command.previous-search); clicked => { root.run(Command.previous-search); } }
                    ToolButton { glyph: "→"; text: @tr("Forward"); enabled: root.can-run(Command.next-search); clicked => { root.run(Command.next-search); } }
                    Rectangle { width: 1px; background: Theme.line; }
                    ToolButton { glyph: "+"; text: @tr("New tab"); enabled: root.can-run(Command.new-tab); clicked => { root.run(Command.new-tab); } }
                    ToolButton { glyph: "⟳"; text: @tr("Rescan"); enabled: root.can-run(Command.rebuild-index); clicked => { root.run(Command.rebuild-index); } }
                    ToolButton { glyph: "≡"; text: @tr("Filters"); enabled: root.can-run(Command.organize-filters); clicked => { root.run(Command.organize-filters); } }
                    ToolButton { glyph: "▣"; text: @tr("Preview"); checked: root.preview-visible; enabled: root.can-run(Command.preview-panel); clicked => { root.run(Command.preview-panel); } }
                    ToolButton { glyph: "⚙"; text: @tr("Settings"); enabled: root.can-run(Command.settings); clicked => { root.run(Command.settings); } }
                }
            }
            if root.show-toolbar: Rectangle { height: 1px; background: Theme.line; }
            if root.tabs.length >= 2: TabStrip {
                tabs: root.tabs;
                active: root.active-tab;
                selected(i) => { root.tab-selected(i); }
                closed(i) => { root.tab-closed(i); }
                list => { root.tab-command(Command.list-tabs); }
            }
            // Top bar
            Rectangle {
                height: Theme.top-bar-height;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.margin;
                    padding-right: Theme.margin;
                    padding-top: (Theme.top-bar-height - Theme.field-height) / 2;
                    padding-bottom: (Theme.top-bar-height - Theme.field-height) / 2;
                    spacing: Theme.s2;
                    search := SearchField {
                        horizontal-stretch: 1;
                        select-on-click: root.select-search-on-click;
                        scope-label: root.scope-label;
                        scope-detail: root.scope-detail;
                        scope-cleared => {
                            root.scope = "";
                            root.scope-label = "";
                            root.query = self.text;
                            self.edited(self.text);
                        }
                        edited(text) => {
                            root.query = root.compose(text);
                            root.current = root.results.length > 0 ? 0 : -1;
                            list.content-y = 0;
                            root.history-full = false;
                            root.history-current = -1;
                            root.query-edited(root.query);
                            root.history-open = root.history-suggestions && root.history-rows.length > 0;
                        }
                        modes-changed => { root.options-edited(); }
                        history-requested => { root.run(Command.show-history); }
                        shortcut(event) => { root.history-key(event) || root.dispatch(1, event) }
                        insert-part(text, anchor, cursor, menu, index) => { root.insert-search-part(text, anchor, cursor, menu, index) }
                        accepted => {
                            root.history-open = false;
                            // Rust checks held searches and the generation of
                            // the displayed rows before any activation.
                            if (!root.search-now()) {
                                root.history-record();
                                if (root.current >= 0) {
                                    root.activate(root.current);
                                }
                            }
                        }
                        down-pressed => {
                            keys.focus();
                            // The current row is not shown while the search
                            // field has the focus: an unselected one (as after
                            // a new search) is where Down lands; from a kept
                            // selection Down goes on to the next row.
                            root.move-to(root.current < 0 ? 0 : root.is-selected(root.current) ? root.current + 1 : root.current, 0);
                        }
                        escape-pressed => {
                            root.scope = "";
                            root.scope-label = "";
                            self.text = "";
                            root.query = "";
                            root.query-edited("");
                        }
                    }
                    if root.show-scope: ComboBox {
                        width: 170px;
                        horizontal-stretch: 0;
                        accessible-label: @tr("Search in");
                        model: root.scope-names;
                        current-index <=> root.scope-index;
                        selected => { root.scope-chosen(self.current-index); }
                    }
                    ComboBox {
                        width: 160px;
                        horizontal-stretch: 0;
                        accessible-label: @tr("Filter");
                        model: root.filter-names;
                        current-index <=> root.filter-index;
                        selected => { root.options-edited(); }
                    }
                    // Overflow menu, in place of the menu bar when that is hidden.
                    if !root.show-menu-bar: more-menu := ContextMenuArea {
                        width: 34px;
                        Menu {
                            MenuItem {
                                title: @tr("Settings…");
                                enabled: root.can-run(Command.settings);
                                activated => { root.run(Command.settings); }
                            }
                            MenuItem {
                                title: @tr("Customize shortcuts…");
                                enabled: root.can-run(Command.keyboard-settings);
                                activated => { root.run(Command.keyboard-settings); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Search syntax");
                                activated => { root.run(Command.search-syntax-help); }
                            }
                            MenuItem {
                                title: @tr("Keyboard shortcuts");
                                activated => { root.run(Command.shortcuts-help); }
                            }
                            MenuItem {
                                title: @tr("About EveryGrep");
                                activated => { root.run(Command.about); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Show the menu bar");
                                activated => { root.run(Command.menu-bar); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Quit");
                                enabled: root.can-run(Command.quit);
                                activated => { root.run(Command.quit); }
                            }
                        }
                        Rectangle {
                            border-radius: Theme.radius;
                            background: more-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: root.more-label;
                            accessible-action-default => { more-menu.show({ x: 0, y: self.height }); }
                            more-touch := TouchArea {
                                clicked => { more-menu.show({ x: 0, y: self.height }); }
                            }
                            Image {
                                source: @image-url("icons/more.svg");
                                colorize: Theme.text-muted;
                                width: Theme.icon;
                                height: Theme.icon;
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }

            HorizontalLayout {
                folders := FoldersPanel {
                    visible: root.folders-visible;
                    width: root.folders-visible ? root.folders-width * 1px : 0px;
                    min-height: 0px;
                    clip: true;
                    entries: root.folder-entries;
                    current <=> root.folder-current;
                    scroll-y <=> root.folders-scroll-y;
                    recursive <=> root.folders-recursive;
                    dim-empty <=> root.folders-dim-empty;
                    action(row, kind) => { root.folder-action(row, kind); }
                    recursive-changed => { root.folders-changed(); }
                    close => { root.run(Command.close-folders-panel); }
                    key(event) => { return root.dispatch(0, event); }
                }
                if root.folders-visible: Rectangle {
                    width: 5px;
                    background: Theme.line;
                    grip := TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.up) { root.folders-changed(); }
                        }
                        // This grip moves with the panel boundary, so its
                        // local delta is movement since the previous event.
                        moved => { if (self.pressed) { root.folders-width = clamp(root.folders-width + (self.mouse-x - self.pressed-x) / 1px, 140, 600); } }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    // Kept off the window edges; the folder panel's grip
                    // already separates it on the left.
                    padding-left: root.folders-visible ? 0px : Theme.margin;
                    padding-right: Theme.margin;
                    // Column headers (positioned directly, so they never feed back into
                    // the window's layout). Right-click shows or hides optional columns.
                    Rectangle {
                        height: Theme.header-height;
                        background: Theme.surface-alt;
                        clip: true;
                        // The headers move with the rows when the list scrolls sideways.
                        Rectangle {
                            x: list.content-x;
                            width: root.table-width;
                            height: parent.height;
                            header-menu := ContextMenuArea {
                                Menu {
                                    // Activating a checkable item flips its check mark, which
                                    // is tied to the column flag both ways.
                                    MenuItem {
                                        title: @tr("Type");
                                        checkable: true;
                                        checked <=> root.show-type;
                                        activated => { root.column-shown(4, root.show-type); }
                                    }
                                    MenuItem {
                                        title: @tr("Extension");
                                        checkable: true;
                                        checked <=> root.show-ext;
                                        activated => { root.column-shown(5, root.show-ext); }
                                    }
                                    MenuItem {
                                        title: @tr("Created");
                                        checkable: true;
                                        checked <=> root.show-created;
                                        activated => { root.column-shown(6, root.show-created); }
                                    }
                                    MenuItem {
                                        title: @tr("Accessed");
                                        checkable: true;
                                        checked <=> root.show-accessed;
                                        activated => { root.column-shown(7, root.show-accessed); }
                                    }
                                    MenuItem {
                                        title: @tr("Attributes");
                                        checkable: true;
                                        checked <=> root.show-attrs;
                                        activated => { root.column-shown(8, root.show-attrs); }
                                    }
                                    MenuItem {
                                        title: @tr("MD5");
                                        checkable: true;
                                        checked <=> root.show-md5;
                                        activated => { root.column-shown(9, root.show-md5); }
                                    }
                                    MenuItem {
                                        title: @tr("SHA-256");
                                        checkable: true;
                                        checked <=> root.show-sha256;
                                        activated => { root.column-shown(10, root.show-sha256); }
                                    }
                                    MenuItem {
                                        title: @tr("CRC-32");
                                        checkable: true;
                                        checked <=> root.show-crc32;
                                        activated => { root.column-shown(11, root.show-crc32); }
                                    }
                                    MenuItem {
                                        title: @tr("Same name");
                                        checkable: true;
                                        checked <=> root.show-name-freq;
                                        activated => { root.column-shown(12, root.show-name-freq); }
                                    }
                                    MenuItem {
                                        title: @tr("Same extension");
                                        checkable: true;
                                        checked <=> root.show-ext-freq;
                                        activated => { root.column-shown(13, root.show-ext-freq); }
                                    }
                                    MenuItem {
                                        title: @tr("Same size");
                                        checkable: true;
                                        checked <=> root.show-size-freq;
                                        activated => { root.column-shown(14, root.show-size-freq); }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: @tr("Size column to fit");
                                        activated => { root.fit-column(root.menu-column); }
                                    }
                                    MenuItem {
                                        title: @tr("Size all columns to fit");
                                        activated => { root.run(Command.fit-columns); }
                                    }
                                    MenuItem {
                                        title: @tr("Fit columns to window");
                                        activated => { root.run(Command.fit-columns-to-window); }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: @tr("Organize columns…");
                                        activated => { root.run(Command.organize-columns); }
                                    }
                                    MenuItem {
                                        title: @tr("Advanced sort…");
                                        activated => { root.run(Command.advanced-sort); }
                                    }
                                    MenuItem {
                                        title: @tr("Restore removed column");
                                        enabled: root.can-run(Command.restore-removed-column);
                                        activated => { root.run(Command.restore-removed-column); }
                                    }
                                    MenuItem {
                                        title: @tr("Reset columns");
                                        activated => { root.run(Command.reset-columns); }
                                    }
                                }
                                HeaderCell {
                                    x: Theme.s1;
                                    width: root.name-width - Theme.s1;
                                    height: parent.height;
                                    label: @tr("Name");
                                    sorted: root.sort-column == 0;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(0); }
                                    right-pressed(x, y) => {
                                        root.menu-column = 0;
                                        header-menu.show({ x: self.x + x, y: y });
                                    }
                                }
                                HeaderCell {
                                    x: root.name-width;
                                    width: root.folder-width;
                                    height: parent.height;
                                    label: @tr("Folder");
                                    sorted: root.sort-column == 1;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(1); }
                                    right-pressed(x, y) => {
                                        root.menu-column = 1;
                                        header-menu.show({ x: self.x + x, y: y });
                                    }
                                }
                                HeaderCell {
                                    x: root.name-width + root.folder-width;
                                    width: root.size-width;
                                    height: parent.height;
                                    label: @tr("Size");
                                    align: right;
                                    sorted: root.sort-column == 2;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(2); }
                                    right-pressed(x, y) => {
                                        root.menu-column = 2;
                                        header-menu.show({ x: self.x + x, y: y });
                                    }
                                }
                                HeaderCell {
                                    x: root.name-width + root.folder-width + root.size-width;
                                    width: root.date-width;
                                    height: parent.height;
                                    label: @tr("Modified");
                                    sorted: root.sort-column == 3;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(3); }
                                    right-pressed(x, y) => {
                                        root.menu-column = 3;
                                        header-menu.show({ x: self.x + x, y: y });
                                    }
                                }
                                if root.show-type: HeaderCell {
                                    x: root.type-x;
                                    width: root.type-width;
                                    height: parent.height;
                                    label: @tr("Type");
                                    sorted: root.sort-column == 4;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(4); }
                                    right-pressed(x, y) => {
                                        root.menu-column = 4;
                                        header-menu.show({ x: self.x + x, y: y });
                                    }
                                }
                                if root.show-ext: HeaderCell {
                                    x: root.ext-x;
                                    width: root.ext-width;
                                    height: parent.height;
                                    label: @tr("Extension");
                                    sorted: root.sort-column == 5;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(5); }
                                    right-pressed(x, y) => {
                                        root.menu-column = 5;
                                        header-menu.show({ x: self.x + x, y: y });
                                    }
                                }
                                if root.show-created: HeaderCell {
                                    x: root.created-x;
                                    width: root.created-width;
                                    height: parent.height;
                                    label: @tr("Created");
                                    sorted: root.sort-column == 6;
                                    descending: root.sort-descending;
                                    clicked => { root.sort-by(6); }
                                    right-pressed(x, y) => {
                                        root.menu-column = 6;
                                        header-menu.show({ x: self.x + x, y: y });
