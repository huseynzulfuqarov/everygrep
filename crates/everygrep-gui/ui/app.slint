                                    label: @tr("MD5");
                                    sorted: root.sort-column == 9; descending: root.sort-descending;
                                    clicked => { root.sort-by(9); }
                                    right-pressed(x, y) => {
                                        root.menu-column = 9;
                                        header-menu.show({ x: self.x + x, y: y });
