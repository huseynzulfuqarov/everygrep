    // Texts measured to size a column to fit: the widest-looking cells of
    // the rows on screen and the header label.
    property <string> fit-a;
    property <string> fit-b;
    property <string> fit-c;
    property <string> fit-label;
    // The column whose header was right-clicked, for "Size column to fit".
    property <int> menu-column: 0;
    property <string> hash-value;

    // The width column c needs for its cells on screen and its header
    // label; 0 for a hidden column.
    function fit-width(c: int) -> length {
        if (!root.col-shown(c)) {
            return 0px;
        }
        let first = max(0, floor(-list.content-y / Theme.row-height));
        let count = ceil(list.visible-height / Theme.row-height) + 1;
        let texts = root.fit-texts(c, first, count);
        root.fit-a = texts.a;
        root.fit-b = texts.b;
        root.fit-c = texts.c;
        root.fit-label = root.col-label(c);
        let text = max(fit-a-probe.preferred-width, max(fit-b-probe.preferred-width, fit-c-probe.preferred-width));
        // The room around the text in a cell (see Row): Name has the icon
        // and its bold marks, Folder its bold marks.
        let room = c == 0 ? Theme.s3 + Theme.row-icon + 2 * Theme.s2 + Theme.s1
            : c == 1 ? 2 * Theme.s2 + Theme.s1 : 2 * Theme.s2;
        let label = fit-label-probe.preferred-width + 2 * Theme.s2 + Theme.icon;
        return max(root.any-min(c), max(text + room, label));
    }

    // Gives column c the width w. Folder takes what Name leaves, so it is
    // sized through Name.
    function set-width(c: int, w: length) {
        if (c == 0) {
            root.name-want = w;
            root.name-set = true;
        } else if (c == 1) {
            // Name takes the rest; when that is less than its minimum, Folder
            // keeps w as its own width and the columns get wider than the
            // window.
            root.name-want = max(root.name-min, list.visible-width - root.fixed-width - w);
            root.name-set = true;
            root.folder-want = root.name-min + w + root.fixed-width > list.visible-width ? w : 0px;
        } else if (c == 2) {
            root.size-want = w;
        } else {
            root.set-col-want(c, w);
        }
    }

    // Sizes one column to fit the rows on screen.
    function fit-column(c: int) {
        root.set-width(c, root.fit-width(c));
    }

    // Sizes every shown column to fit; Folder takes the rest of the window.
    function fit-all-columns() {
        root.folder-want = 0px;
        root.fit-column(2);
        root.fit-column(3);
        if (root.show-type) { root.fit-column(4); }
        if (root.show-ext) { root.fit-column(5); }
        if (root.show-created) { root.fit-column(6); }
        if (root.show-accessed) { root.fit-column(7); }
        if (root.show-attrs) { root.fit-column(8); }
        if (root.show-md5) { root.fit-column(9); }
        if (root.show-sha256) { root.fit-column(10); }
        if (root.show-crc32) { root.fit-column(11); }
        if (root.show-name-freq) { root.fit-column(12); }
        if (root.show-ext-freq) { root.fit-column(13); }
        if (root.show-size-freq) { root.fit-column(14); }
        if (root.show-full-path) { root.fit-column(15); }
        if (root.show-parent-path) { root.fit-column(16); }
        if (root.show-stem) { root.fit-column(17); }
        if (root.show-name-length) { root.fit-column(18); }
        if (root.show-path-length) { root.fit-column(19); }
        if (root.show-disk-size) { root.fit-column(20); }
        if (root.show-total-size) { root.fit-column(21); }
        if (root.show-child-count) { root.fit-column(22); }
        if (root.show-child-files) { root.fit-column(23); }
        if (root.show-child-folders) { root.fit-column(24); }
        if (root.show-desc-count) { root.fit-column(25); }
        if (root.show-desc-files) { root.fit-column(26); }
        if (root.show-desc-folders) { root.fit-column(27); }
        if (root.show-folder-depth) { root.fit-column(28); }
        if (root.show-hard-links) { root.fit-column(29); }
        if (root.show-shortcut-target) { root.fit-column(30); }
        if (root.show-owner) { root.fit-column(31); }
        if (root.show-width) { root.fit-column(32); }
        if (root.show-height) { root.fit-column(33); }
        if (root.show-dimensions) { root.fit-column(34); }
        if (root.show-length) { root.fit-column(35); }
        if (root.show-bit-rate) { root.fit-column(36); }
        if (root.show-title) { root.fit-column(37); }
        if (root.show-artist) { root.fit-column(38); }
        if (root.show-album) { root.fit-column(39); }
        if (root.show-year) { root.fit-column(40); }
        if (root.show-track) { root.fit-column(41); }
        if (root.show-genre) { root.fit-column(42); }
        if (root.show-rating) { root.fit-column(43); }
        if (root.show-tags) { root.fit-column(44); }
        if (root.show-page-count) { root.fit-column(45); }
        if (root.show-word-count) { root.fit-column(46); }
        if (root.show-camera-maker) { root.fit-column(47); }
        if (root.show-camera-model) { root.fit-column(48); }
        if (root.show-date-taken) { root.fit-column(49); }
        if (root.show-gps-lat) { root.fit-column(50); }
        if (root.show-gps-long) { root.fit-column(51); }
        if (root.show-sha1) { root.fit-column(52); }
        if (root.show-sha384) { root.fit-column(53); }
        if (root.show-sha512) { root.fit-column(54); }
        if (root.show-xxhash) { root.fit-column(55); }
        if (root.show-dupe-group) { root.fit-column(56); }
        root.fit-column(0);
    }

    // Sizes every shown column to fit, then widens or narrows all of them
    // by the same factor so together they fill the window.
    function fit-columns-to-window() {
        let w0 = root.fit-width(0);
        let w1 = root.fit-width(1);
        let w2 = root.fit-width(2);
        let w3 = root.fit-width(3);
        let w4 = root.fit-width(4);
        let w5 = root.fit-width(5);
        let w6 = root.fit-width(6);
