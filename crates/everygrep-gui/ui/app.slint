            : c == 6 ? root.created-min : c == 7 ? root.accessed-min : c == 8 ? root.attr-min : c == 9 ? root.md5-min : c == 10 ? root.sha256-min : c == 11 ? root.crc32-min : c == 12 ? root.name-freq-min : c == 13 ? root.ext-freq-min : root.size-freq-min;
    }
    function set-col-want(c: int, w: length) {
        if (c == 15) { root.full-path-want = w; return; }
        if (c == 16) { root.parent-path-want = w; return; }
        if (c == 17) { root.stem-want = w; return; }
        if (c == 18) { root.name-length-want = w; return; }
        if (c == 19) { root.path-length-want = w; return; }
        if (c == 20) { root.disk-size-want = w; return; }
        if (c == 21) { root.total-size-want = w; return; }
        if (c == 22) { root.child-count-want = w; return; }
        if (c == 23) { root.child-files-want = w; return; }
        if (c == 24) { root.child-folders-want = w; return; }
        if (c == 25) { root.desc-count-want = w; return; }
        if (c == 26) { root.desc-files-want = w; return; }
        if (c == 27) { root.desc-folders-want = w; return; }
        if (c == 28) { root.folder-depth-want = w; return; }
        if (c == 29) { root.hard-links-want = w; return; }
        if (c == 30) { root.shortcut-target-want = w; return; }
        if (c == 31) { root.owner-want = w; return; }
        if (c == 32) { root.width-want = w; return; }
        if (c == 33) { root.height-want = w; return; }
        if (c == 34) { root.dimensions-want = w; return; }
        if (c == 35) { root.length-want = w; return; }
        if (c == 36) { root.bit-rate-want = w; return; }
        if (c == 37) { root.title-want = w; return; }
        if (c == 38) { root.artist-want = w; return; }
        if (c == 39) { root.album-want = w; return; }
        if (c == 40) { root.year-want = w; return; }
        if (c == 41) { root.track-want = w; return; }
        if (c == 42) { root.genre-want = w; return; }
        if (c == 43) { root.rating-want = w; return; }
        if (c == 44) { root.tags-want = w; return; }
        if (c == 45) { root.page-count-want = w; return; }
        if (c == 46) { root.word-count-want = w; return; }
        if (c == 47) { root.camera-maker-want = w; return; }
        if (c == 48) { root.camera-model-want = w; return; }
        if (c == 49) { root.date-taken-want = w; return; }
        if (c == 50) { root.gps-lat-want = w; return; }
        if (c == 51) { root.gps-long-want = w; return; }
        if (c == 52) { root.sha1-want = w; return; }
        if (c == 53) { root.sha384-want = w; return; }
        if (c == 54) { root.sha512-want = w; return; }
        if (c == 55) { root.xxhash-want = w; return; }
        if (c == 56) { root.dupe-group-want = w; return; }
        if (c == 3) {
            root.date-want = w;
        } else if (c == 4) {
            root.type-want = w;
        } else if (c == 5) {
            root.ext-want = w;
        } else if (c == 6) {
            root.created-want = w;
        } else if (c == 7) {
            root.accessed-want = w;
        } else if (c == 8) {
            root.attr-want = w;
        } else if (c == 9) {
            root.md5-want = w;
        } else if (c == 10) {
            root.sha256-want = w;
        } else if (c == 11) {
            root.crc32-want = w;
        } else if (c == 12) {
            root.name-freq-want = w;
        } else if (c == 13) {
            root.ext-freq-want = w;
        } else {
            root.size-freq-want = w;
        }
    }
    // Header label and minimum width of any column, numbered as sort-column.
    function col-label(c: int) -> string {
        if (c == 15) { return @tr("Full path"); }
        if (c == 16) { return @tr("Parent path"); }
        if (c == 17) { return @tr("Stem"); }
        if (c == 18) { return @tr("Name length"); }
        if (c == 19) { return @tr("Path length"); }
        if (c == 20) { return @tr("Size on disk"); }
        if (c == 21) { return @tr("Total size"); }
        if (c == 22) { return @tr("Items"); }
        if (c == 23) { return @tr("Files inside"); }
        if (c == 24) { return @tr("Subfolders"); }
        if (c == 25) { return @tr("Items at any depth"); }
        if (c == 26) { return @tr("Files at any depth"); }
        if (c == 27) { return @tr("Subfolders at any depth"); }
        if (c == 28) { return @tr("Folder depth"); }
        if (c == 29) { return @tr("Hard link count"); }
        if (c == 30) { return @tr("Shortcut target"); }
        if (c == 31) { return @tr("Owner"); }
        if (c == 32) { return @tr("Width"); }
        if (c == 33) { return @tr("Height"); }
        if (c == 34) { return @tr("Dimensions"); }
        if (c == 35) { return @tr("Length"); }
        if (c == 36) { return @tr("Bit rate"); }
        if (c == 37) { return @tr("Title"); }
        if (c == 38) { return @tr("Artist"); }
        if (c == 39) { return @tr("Album"); }
        if (c == 40) { return @tr("Year"); }
        if (c == 41) { return @tr("Track"); }
        if (c == 42) { return @tr("Genre"); }
        if (c == 43) { return @tr("Rating"); }
        if (c == 44) { return @tr("Tags"); }
        if (c == 45) { return @tr("Page count"); }
        if (c == 46) { return @tr("Word count"); }
        if (c == 47) { return @tr("Camera maker"); }
        if (c == 48) { return @tr("Camera model"); }
        if (c == 49) { return @tr("Date taken"); }
        if (c == 50) { return @tr("GPS latitude"); }
        if (c == 51) { return @tr("GPS longitude"); }
        if (c == 52) { return @tr("SHA-1"); }
        if (c == 53) { return @tr("SHA-384"); }
        if (c == 54) { return @tr("SHA-512"); }
        if (c == 55) { return @tr("xxHash (XXH3-128)"); }
        if (c == 56) { return @tr("Duplicate group"); }
        return c == 0 ? @tr("Name") : c == 1 ? @tr("Folder") : c == 2 ? @tr("Size")
            : c == 3 ? @tr("Modified") : c == 4 ? @tr("Type") : c == 5 ? @tr("Extension")
            : c == 6 ? @tr("Created") : c == 7 ? @tr("Accessed") : c == 8 ? @tr("Attributes") : c == 9 ? @tr("MD5") : c == 10 ? @tr("SHA-256") : c == 11 ? @tr("CRC-32") : c == 12 ? @tr("Same name") : c == 13 ? @tr("Same extension") : @tr("Same size");
    }
    function any-min(c: int) -> length {
        return c == 0 ? root.name-min : c == 1 ? root.folder-min : c == 2 ? root.size-min
            : root.col-min(c);
    }
    function col-shown(c: int) -> bool {
        return c <= 3 || (c == 4 && root.show-type) || (c == 5 && root.show-ext)
            || (c == 6 && root.show-created) || (c == 7 && root.show-accessed)
            || (c == 8 && root.show-attrs)
            || (c == 9 && root.show-md5)
            || (c == 10 && root.show-sha256)
            || (c == 11 && root.show-crc32)
            || (c == 12 && root.show-name-freq)
            || (c == 13 && root.show-ext-freq)
            || (c == 14 && root.show-size-freq)
            || (c == 15 && root.show-full-path)
            || (c == 16 && root.show-parent-path)
            || (c == 17 && root.show-stem)
            || (c == 18 && root.show-name-length)
            || (c == 19 && root.show-path-length)
            || (c == 20 && root.show-disk-size)
            || (c == 21 && root.show-total-size)
            || (c == 22 && root.show-child-count)
            || (c == 23 && root.show-child-files)
            || (c == 24 && root.show-child-folders)
            || (c == 25 && root.show-desc-count)
            || (c == 26 && root.show-desc-files)
            || (c == 27 && root.show-desc-folders)
            || (c == 28 && root.show-folder-depth)
            || (c == 29 && root.show-hard-links)
            || (c == 30 && root.show-shortcut-target)
            || (c == 31 && root.show-owner)
            || (c == 32 && root.show-width)
            || (c == 33 && root.show-height)
            || (c == 34 && root.show-dimensions)
            || (c == 35 && root.show-length)
            || (c == 36 && root.show-bit-rate)
            || (c == 37 && root.show-title)
            || (c == 38 && root.show-artist)
            || (c == 39 && root.show-album)
            || (c == 40 && root.show-year)
            || (c == 41 && root.show-track)
            || (c == 42 && root.show-genre)
            || (c == 43 && root.show-rating)
            || (c == 44 && root.show-tags)
            || (c == 45 && root.show-page-count)
            || (c == 46 && root.show-word-count)
            || (c == 47 && root.show-camera-maker)
            || (c == 48 && root.show-camera-model)
            || (c == 49 && root.show-date-taken)
            || (c == 50 && root.show-gps-lat)
            || (c == 51 && root.show-gps-long)
