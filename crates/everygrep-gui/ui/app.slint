                                    label: @tr("Name length");
                                    sorted: root.sort-column == 18; descending: root.sort-descending;
                                    clicked => { root.sort-by(18); }
                                    right-pressed(x, y) => { root.menu-column = 18; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-path-length: HeaderCell {
                                    x: root.path-length-x; width: root.path-length-width; height: parent.height;
                                    label: @tr("Path length");
                                    sorted: root.sort-column == 19; descending: root.sort-descending;
                                    clicked => { root.sort-by(19); }
                                    right-pressed(x, y) => { root.menu-column = 19; header-menu.show({ x: self.x + x, y: y }); }
