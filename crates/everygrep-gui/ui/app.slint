        let w35 = root.fit-width(35);
        let w36 = root.fit-width(36);
        let w37 = root.fit-width(37);
        let w38 = root.fit-width(38);
        let w39 = root.fit-width(39);
        let w40 = root.fit-width(40);
        let w41 = root.fit-width(41);
        let w42 = root.fit-width(42);
        let w43 = root.fit-width(43);
        let w44 = root.fit-width(44);
        let w45 = root.fit-width(45);
        let w46 = root.fit-width(46);
        let w47 = root.fit-width(47);
        let w48 = root.fit-width(48);
        let w49 = root.fit-width(49);
        let w50 = root.fit-width(50);
        let w51 = root.fit-width(51);
        let w52 = root.fit-width(52);
        let w53 = root.fit-width(53);
        let w54 = root.fit-width(54);
        let w55 = root.fit-width(55);
        let w56 = root.fit-width(56);
        let total = w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8
            + w9
            + w10
            + w11
            + w12
            + w13
            + w14 + w15 + w16 + w17 + w18 + w19 + w20 + w21 + w22 + w23 + w24 + w25 + w26 + w27 + w28 + w29 + w30 + w31 + w32 + w33 + w34 + w35 + w36 + w37 + w38 + w39 + w40 + w41 + w42 + w43 + w44 + w45 + w46 + w47 + w48 + w49 + w50 + w51 + w52 + w53 + w54 + w55 + w56;
        if (total <= 0px) {
            return;
        }
        let f = list.visible-width / total;
        root.folder-want = 0px;
        root.size-want = max(root.size-min, w2 * f);
        root.date-want = max(root.date-min, w3 * f);
        if (root.show-type) { root.type-want = max(root.type-min, w4 * f); }
        if (root.show-ext) { root.ext-want = max(root.ext-min, w5 * f); }
        if (root.show-created) { root.created-want = max(root.created-min, w6 * f); }
        if (root.show-accessed) { root.accessed-want = max(root.accessed-min, w7 * f); }
        if (root.show-attrs) { root.attr-want = max(root.attr-min, w8 * f); }
        if (root.show-md5) { root.md5-want = max(root.md5-min, w9 * f); }
        if (root.show-sha256) { root.sha256-want = max(root.sha256-min, w10 * f); }
        if (root.show-crc32) { root.crc32-want = max(root.crc32-min, w11 * f); }
        if (root.show-name-freq) { root.name-freq-want = max(root.name-freq-min, w12 * f); }
        if (root.show-ext-freq) { root.ext-freq-want = max(root.ext-freq-min, w13 * f); }
        if (root.show-size-freq) { root.size-freq-want = max(root.size-freq-min, w14 * f); }
        root.name-want = max(root.name-min, w0 * f);
        if (root.show-full-path) { root.full-path-want = max(root.full-path-min, w15 * f); }
        if (root.show-parent-path) { root.parent-path-want = max(root.parent-path-min, w16 * f); }
        if (root.show-stem) { root.stem-want = max(root.stem-min, w17 * f); }
        if (root.show-name-length) { root.name-length-want = max(root.name-length-min, w18 * f); }
        if (root.show-path-length) { root.path-length-want = max(root.path-length-min, w19 * f); }
        if (root.show-disk-size) { root.disk-size-want = max(root.disk-size-min, w20 * f); }
        if (root.show-total-size) { root.total-size-want = max(root.total-size-min, w21 * f); }
        if (root.show-child-count) { root.child-count-want = max(root.child-count-min, w22 * f); }
        if (root.show-child-files) { root.child-files-want = max(root.child-files-min, w23 * f); }
        if (root.show-child-folders) { root.child-folders-want = max(root.child-folders-min, w24 * f); }
        if (root.show-desc-count) { root.desc-count-want = max(root.desc-count-min, w25 * f); }
