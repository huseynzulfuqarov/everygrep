    // Shows or hides optional column c (4 to 14).
    function set-column-shown(c: int, on: bool) {
        if (c == 15) { root.show-full-path = on; root.column-shown(c, on); return; }
        if (c == 16) { root.show-parent-path = on; root.column-shown(c, on); return; }
