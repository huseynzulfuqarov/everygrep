import { Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct ResultRow {
    // The name, split around the highlighted match; without a match all of it
    // is in name-before.
    name-before: string,
    name-match: string,
    name-after: string,
    folder: string,
    size: string,
    modified: string,
    modified-full: string,
    is-dir: bool,
    // Index into Icons.types (FileKind in src/filetype.rs).
    kind: int,
    selected: bool,
}

// File-type icons, in the order of FileKind. They carry their own colours and
// must not be colorized.
global Icons {
    out property <[image]> types: [
        @image-url("icons/types/folder.svg"),
        @image-url("icons/types/file.svg"),
        @image-url("icons/types/text.svg"),
        @image-url("icons/types/document.svg"),
        @image-url("icons/types/pdf.svg"),
        @image-url("icons/types/spreadsheet.svg"),
        @image-url("icons/types/presentation.svg"),
        @image-url("icons/types/image.svg"),
        @image-url("icons/types/audio.svg"),
        @image-url("icons/types/video.svg"),
        @image-url("icons/types/archive.svg"),
        @image-url("icons/types/code.svg"),
        @image-url("icons/types/executable.svg"),
        @image-url("icons/types/font.svg"),
        @image-url("icons/types/disk-image.svg"),
        @image-url("icons/types/link.svg")
    ];
}

component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted();
    callback down-pressed();
    callback escape-pressed();
    public function focus-and-select() {
        input.focus();
        input.select-all();
    }

    height: 34px;
    border-radius: Theme.radius;
    background: Theme.field;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        spacing: Theme.s2;
        Image {
            source: @image-url("icons/search.svg");
            colorize: Theme.text-muted;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        input := TextInput {
            vertical-alignment: center;
            font-size: Theme.body + 1px;
            color: Theme.text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.selection-text;
            single-line: true;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
            key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.down-pressed();
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.escape-pressed();
                    return accept;
                }
                reject
            }
        }
    }
    placeholder := Text {
        x: Theme.s3 + Theme.icon + Theme.s2;
        visible: input.text == "";
        text: "Search files and folders";
        color: Theme.text-muted;
        font-size: Theme.body + 1px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <TextHorizontalAlignment> align: left;
    // Whether the results are sorted by this column, and in which direction.
    in property <bool> sorted;
    in property <bool> descending;
    callback clicked();

    property <bool> right: root.align == TextHorizontalAlignment.right;
    property <length> arrow-space: root.sorted ? Theme.icon : 0px;
    property <length> label-width: min(label-text.preferred-width, label-text.width);

    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    label-text := Text {
        x: root.right ? Theme.s2 + root.arrow-space : Theme.s2;
        width: parent.width - 2 * Theme.s2 - root.arrow-space;
        height: parent.height;
        text: root.label;
        font-size: Theme.small;
        font-weight: 600;
        color: root.sorted ? Theme.text : Theme.text-muted;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        overflow: elide;
    }
    // The arrow sits next to the label, on the side away from the alignment.
    Image {
        visible: root.sorted;
        x: root.right
            ? parent.width - Theme.s2 - root.label-width - self.width
            : Theme.s2 + root.label-width;
        y: (parent.height - self.height) / 2;
        width: Theme.icon;
        height: Theme.icon;
        source: root.descending ? @image-url("icons/sort-down.svg") : @image-url("icons/sort-up.svg");
        colorize: Theme.accent;
    }
}

component Row inherits Rectangle {
    in property <ResultRow> data;
    // The keyboard cursor is on this row and the list has focus.
    in property <bool> current;
    in property <length> name-width;
    in property <length> folder-width;
    in property <length> size-width;
    in property <length> date-width;
    // The name is being edited in place.
    in property <bool> editing;
    in-out property <string> edit-text;
    // Bytes of the name selected when editing starts (the part before the
    // extension).
    in property <int> edit-stem;
    callback pressed(KeyboardModifiers);
    callback right-pressed(length, length);
    callback double-clicked();
    callback edit-commit(string);
    callback edit-cancel();

    property <bool> selected: root.data.selected;

    height: Theme.row-height;
    background: selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    root.pressed(event.modifiers);
                } else if (event.button == PointerEventButton.right) {
                    root.right-pressed(self.mouse-x, self.mouse-y);
                }
            }
        }
        double-clicked => { root.double-clicked(); }
    }
    // Focus ring of the keyboard cursor.
    Rectangle {
        visible: root.current;
        border-width: 1px;
        border-color: Theme.accent;
    }

    // Cells are positioned directly to keep the columns aligned with the header.
    Image {
        x: Theme.s3;
        source: Icons.types[root.data.kind];
        width: Theme.icon;
        height: Theme.icon;
        y: (parent.height - self.height) / 2;
    }
    // The name as up to three pieces: before, match (bold) and after. Each
    // piece takes its natural width while there is room; the piece that runs
    // out of room is elided, and the cell clips the rest.
    name-cell := Rectangle {
        x: Theme.s3 + Theme.icon + Theme.s2;
        width: max(0px, root.name-width - self.x - Theme.s2);
        height: parent.height;
        clip: true;
        before := Text {
            x: 0;
            width: min(self.preferred-width, parent.width);
            height: parent.height;
            text: root.data.name-before;
            color: root.selected ? Theme.selection-text : Theme.text;
            font-size: Theme.body;
            vertical-alignment: center;
            overflow: elide;
        }
        matched := Text {
            x: before.width;
            width: min(self.preferred-width, parent.width - self.x);
            height: parent.height;
            visible: self.text != "";
            text: root.data.name-match;
            color: root.selected ? Theme.selection-text : Theme.text;
            font-size: Theme.body;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            x: matched.x + matched.width;
            width: max(0px, parent.width - self.x);
            height: parent.height;
            visible: self.text != "";
            text: root.data.name-after;
            color: root.selected ? Theme.selection-text : Theme.text;
            font-size: Theme.body;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if root.editing: Rectangle {
        x: name-cell.x - Theme.s1;
        width: name-cell.width + Theme.s1;
        y: 2px;
        height: parent.height - 4px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: 3px;
        edit := TextInput {
            x: Theme.s1;
            width: parent.width - 2 * Theme.s1;
            text <=> root.edit-text;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.body;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.selection-text;
            init => {
                self.focus();
                self.set-selection-offsets(0, root.edit-stem);
            }
            accepted => { root.edit-commit(self.text); }
            // Leaving the field (a click elsewhere) cancels; only Enter renames.
            changed has-focus => {
                if (!self.has-focus) { root.edit-cancel(); }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.edit-cancel();
                    return accept;
                }
                // Keep list keys from moving the selection while editing.
                if (event.text == Key.UpArrow || event.text == Key.DownArrow
                    || event.text == Key.PageUp || event.text == Key.PageDown || event.text == Key.F2) {
                    return accept;
                }
                reject
            }
        }
    }
    Text {
        x: root.name-width + Theme.s2;
        width: root.folder-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.folder;
        color: root.selected ? Theme.selection-text : Theme.text-muted;
        font-size: Theme.body;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.name-width + root.folder-width;
        width: root.size-width - Theme.s2;
        height: parent.height;
        text: root.data.size;
        color: root.selected ? Theme.selection-text : Theme.text-muted;
        font-size: Theme.body;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    Text {
        x: root.name-width + root.folder-width + root.size-width + Theme.s2;
        width: root.date-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.modified;
        color: root.selected ? Theme.selection-text : Theme.text-muted;
        font-size: Theme.body;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A drag handle on the boundary between two header cells.
component ColumnGrip inherits TouchArea {
    callback dragged(length);
    width: Theme.s2;
    mouse-cursor: col-resize;
    // The grip follows the boundary, so the offset from the press point is the
    // movement since the previous event.
    moved => { root.dragged(self.mouse-x - self.pressed-x); }
    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        y: parent.height / 4;
        height: parent.height / 2;
        background: root.pressed || root.has-hover ? Theme.text-muted : Theme.line;
    }
}

export component AppWindow inherits Window {
    title: "EveryGrep";
    // Used on X11; Wayland compositors take the icon from the desktop entry
    // that matches the app id.
    icon: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
    preferred-width: 1040px;
    preferred-height: 660px;
    min-width: 560px;
    min-height: 320px;
    background: Theme.surface;
    default-font-size: Theme.body;

    in property <[ResultRow]> results;
    in property <string> status-left;
    in property <string> status-right;
    in property <string> message;
    in-out property <int> current: -1;
    // Text of the search field.
    in-out property <string> query <=> search.text;

    // Sort column (0 name, 1 folder, 2 size, 3 modified) and direction.
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-descending: false;

    callback query-edited(string);
    callback sort-changed(int, bool);
    callback activate(int);
    callback open-folder(int);
    // Selection: mode 0 selects only the row, 1 toggles it, 2 extends the
    // range from the anchor to it.
    callback select(int, int);
    // Actions on the selection, or on the given row when it is not selected.
    callback copy-names(int);
    callback copy-paths(int);
    callback rename-start(int);
    callback rename-commit(string);
    callback rename-cancel();
    callback trash(int);
    callback delete-request(int);
    callback confirm-accepted();
    callback confirm-cancelled();

    // A short note in the status line, e.g. "Copied 3 paths." or an error.
    in property <string> notice;
    in property <bool> notice-error;

    // In-place rename: the row being edited (-1 for none), its text and the
    // part selected at the start.
    in property <int> rename-row: -1;
    in-out property <string> rename-text;
    in property <int> rename-stem;

    // Confirmation dialog.
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-action;
    callback select-all();
    // Returns whether anything was selected.
    callback clear-selection() -> bool;
    pure callback is-selected(int) -> bool;

    // Column widths. Size and Modified keep the width the user gave them; Name
    // and Folder share the rest of the window, so the columns always end at the
    // right edge. Name keeps its chosen width while Folder can stay at least at
    // its minimum, then shrinks. Until the user drags Name, it takes 48 % of
    // the shared space.
    in-out property <length> name-want: (self.width - self.size-want - self.date-want) * 0.48;
    in-out property <length> size-want: 96px;
    in-out property <length> date-want: 120px;
    out property <length> name-min: 120px;
    out property <length> folder-min: 100px;
    out property <length> size-min: 56px;
    out property <length> date-min: 80px;
    property <length> size-width: max(self.size-min, self.size-want);
    property <length> date-width: max(self.date-min, self.date-want);
    property <length> flex-width: max(self.name-min + self.folder-min, self.width - self.size-width - self.date-width);
    property <length> name-width: max(self.name-min, min(self.name-want, self.flex-width - self.folder-min));
    property <length> folder-width: self.flex-width - self.name-width;

    // Dragging a boundary moves it between its two neighbours; neither gets
    // narrower than its minimum, so the total width stays the same.
    function drag-boundary(boundary: int, delta: length) {
        if (boundary == 0) {
            root.name-want = max(root.name-min, min(root.name-width + delta, root.name-width + root.folder-width - root.folder-min));
        } else if (boundary == 1) {
            root.name-want = root.name-width;
            root.size-want = max(root.size-min, min(root.size-width - delta, root.size-width + root.folder-width - root.folder-min));
        } else {
            let pair = root.size-width + root.date-width;
            let size = max(root.size-min, min(root.size-width + delta, pair - root.date-min));
            root.size-want = size;
            root.date-want = pair - size;
        }
    }

    public function focus-search() {
        search.focus-and-select();
    }

    public function focus-list() {
        keys.focus();
    }

    // Puts text on the clipboard through a hidden text field; Slint has no
    // clipboard API of its own.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    // Opens the context menu next to the current row.
    function show-menu-at-current() {
        if (root.current >= 0) {
            menu-area.show({
                x: Theme.s3 + Theme.icon,
                y: (root.current + 1) * Theme.row-height + list.content-y,
            });
        }
    }

    // Moves the cursor; mode as for select(), or -1 to move without changing
    // the selection.
    function move-to(row: int, mode: int) {
        if (root.results.length == 0) {
            return;
        }
        root.current = max(0, min(root.results.length - 1, row));
        if (mode >= 0) {
            root.select(root.current, mode);
        }
        // Keep the current row inside the visible part of the list.
        let top = root.current * Theme.row-height;
        if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + Theme.row-height > -list.content-y + list.visible-height) {
            list.content-y = -(top + Theme.row-height - list.visible-height);
        }
    }

    // A click on the sorted column flips the direction; another column starts
    // ascending.
    function sort-by(column: int) {
        if (root.sort-column == column) {
            root.sort-descending = !root.sort-descending;
        } else {
            root.sort-column = column;
            root.sort-descending = false;
        }
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
        root.sort-changed(root.sort-column, root.sort-descending);
    }

    property <int> page: max(1, floor(list.visible-height / Theme.row-height) - 1);

    VerticalLayout {
        // Top bar
        Rectangle {
            height: Theme.top-bar-height;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                padding-top: (Theme.top-bar-height - 34px) / 2;
                padding-bottom: (Theme.top-bar-height - 34px) / 2;
                search := SearchField {
                    edited(text) => {
                        root.current = root.results.length > 0 ? 0 : -1;
                        list.content-y = 0;
                        root.query-edited(text);
                    }
                    accepted => {
                        if (root.current >= 0) {
                            root.activate(root.current);
                        }
                    }
                    down-pressed => {
                        keys.focus();
                        root.move-to(root.current < 0 ? 0 : root.current + 1, 0);
                    }
                    escape-pressed => {
                        self.text = "";
                        root.query-edited("");
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // Column headers (positioned directly, so they never feed back into
        // the window's layout)
        Rectangle {
            height: Theme.header-height;
            background: Theme.surface-alt;
            HeaderCell {
                x: Theme.s1;
                width: root.name-width - Theme.s1;
                height: parent.height;
                label: "Name";
                sorted: root.sort-column == 0;
                descending: root.sort-descending;
                clicked => { root.sort-by(0); }
            }
            HeaderCell {
                x: root.name-width;
                width: root.folder-width;
                height: parent.height;
                label: "Folder";
                sorted: root.sort-column == 1;
                descending: root.sort-descending;
                clicked => { root.sort-by(1); }
            }
            HeaderCell {
                x: root.name-width + root.folder-width;
                width: root.size-width;
                height: parent.height;
                label: "Size";
                align: right;
                sorted: root.sort-column == 2;
                descending: root.sort-descending;
                clicked => { root.sort-by(2); }
            }
            HeaderCell {
                x: root.name-width + root.folder-width + root.size-width;
                width: root.date-width;
                height: parent.height;
                label: "Modified";
                sorted: root.sort-column == 3;
                descending: root.sort-descending;
                clicked => { root.sort-by(3); }
            }
            // Boundary grips, on top of the cells.
            ColumnGrip {
                x: root.name-width - self.width / 2;
                height: parent.height;
                dragged(delta) => { root.drag-boundary(0, delta); }
            }
            ColumnGrip {
                x: root.name-width + root.folder-width - self.width / 2;
                height: parent.height;
                dragged(delta) => { root.drag-boundary(1, delta); }
            }
            ColumnGrip {
                x: root.name-width + root.folder-width + root.size-width - self.width / 2;
                height: parent.height;
                dragged(delta) => { root.drag-boundary(2, delta); }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }

        // Results
        keys := FocusScope {
            vertical-stretch: 1;
            // Shift extends the selection, Ctrl moves the cursor alone.
            property <int> move-mode: 0;
            key-pressed(event) => {
                self.move-mode = event.modifiers.shift ? 2 : event.modifiers.control ? -1 : 0;
                if (event.text == Key.DownArrow) { root.move-to(root.current + 1, self.move-mode); return accept; }
                if (event.text == Key.UpArrow) {
                    if (root.current <= 0 && !event.modifiers.shift) { search.focus-and-select(); } else { root.move-to(root.current - 1, self.move-mode); }
                    return accept;
                }
                if (event.text == Key.PageDown) { root.move-to(root.current + root.page, self.move-mode); return accept; }
                if (event.text == Key.PageUp) { root.move-to(root.current - root.page, self.move-mode); return accept; }
                if (event.text == Key.Home) { root.move-to(0, self.move-mode); return accept; }
                if (event.text == Key.End) { root.move-to(root.results.length - 1, self.move-mode); return accept; }
                if (event.text == " " && event.modifiers.control) {
                    if (root.current >= 0) { root.select(root.current, 1); }
                    return accept;
                }
                if (event.modifiers.control && (event.text == "a" || event.text == "A")) {
                    root.select-all();
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.current >= 0) {
                        if (event.modifiers.control) { root.open-folder(root.current); } else { root.activate(root.current); }
                    }
                    return accept;
                }
                if (event.text == Key.F2) {
                    if (root.current >= 0) { root.rename-start(root.current); }
                    return accept;
                }
                if (event.text == Key.Delete) {
                    if (root.current >= 0) {
                        if (event.modifiers.shift) { root.delete-request(root.current); } else { root.trash(root.current); }
                    }
                    return accept;
                }
                if (event.modifiers.control && (event.text == "c" || event.text == "C")) {
                    if (root.current >= 0) {
                        if (event.modifiers.shift) { root.copy-paths(root.current); } else { root.copy-names(root.current); }
                    }
                    return accept;
                }
                if (event.text == Key.Menu || (event.text == Key.F10 && event.modifiers.shift)) {
                    root.show-menu-at-current();
                    return accept;
                }
                // Esc clears the selection first, then goes back to the search.
                if (event.text == Key.Escape) {
                    if (!root.clear-selection()) { search.focus-and-select(); }
                    return accept;
                }
                if (event.modifiers.control && (event.text == "f" || event.text == "l")) {
                    search.focus-and-select();
                    return accept;
                }
                reject
            }

            menu-area := ContextMenuArea {
                enabled: root.current >= 0;
                Menu {
                    MenuItem {
                        title: "Open";
                        activated => { root.activate(root.current); }
                    }
                    MenuItem {
                        title: "Open containing folder";
                        activated => { root.open-folder(root.current); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: "Copy name";
                        activated => { root.copy-names(root.current); }
                    }
                    MenuItem {
                        title: "Copy full path";
                        activated => { root.copy-paths(root.current); }
                    }
                    MenuSeparator { }
                    MenuItem {
                        title: "Rename";
                        activated => { root.rename-start(root.current); }
                    }
                    MenuItem {
                        title: "Move to trash";
                        activated => { root.trash(root.current); }
                    }
                    MenuItem {
                        title: "Delete permanently…";
                        activated => { root.delete-request(root.current); }
                    }
                }

            list := ListView {
                for row[i] in root.results: Row {
                    data: row;
                    current: i == root.current && keys.has-focus;
                    name-width: root.name-width;
                    folder-width: root.folder-width;
                    size-width: root.size-width;
                    date-width: root.date-width;
                    pressed(mods) => {
                        root.current = i;
                        keys.focus();
                        root.select(i, mods.shift ? 2 : mods.control ? 1 : 0);
                    }
                    right-pressed(x, y) => {
                        root.current = i;
                        keys.focus();
                        if (!root.is-selected(i)) { root.select(i, 0); }
                        menu-area.show({ x: x, y: i * Theme.row-height + list.content-y + y });
                    }
                    double-clicked => { root.activate(i); }
                    editing: i == root.rename-row;
                    edit-text <=> root.rename-text;
                    edit-stem: root.rename-stem;
                    edit-commit(text) => { root.rename-commit(text); }
                    edit-cancel => { root.rename-cancel(); }
                }
            }
            }

            Text {
                visible: root.message != "";
                text: root.message;
                color: Theme.text-muted;
                font-size: Theme.body;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        // Status line
        Rectangle { height: 1px; background: Theme.line; }
        Rectangle {
            height: Theme.status-height;
            background: Theme.surface-alt;
            HorizontalLayout {
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                spacing: Theme.s4;
                Text {
                    text: root.status-left;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.notice;
                    font-size: Theme.small;
                    color: root.notice-error ? Theme.danger : Theme.text;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.status-right;
                    font-size: Theme.small;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
        }
    }

    // Hidden text field used by copy-text().
    clip := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        single-line: false;
        read-only: true;
        enabled: false;
    }

    // Confirmation dialog, above all other content. The backdrop takes all
    // clicks so the window behind cannot be used meanwhile.
    if root.confirm-open: Rectangle {
        background: #00000060;
        TouchArea { }
        dialog-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.confirm-cancelled(); return accept; }
                if (event.text == Key.Return) { root.confirm-accepted(); return accept; }
                accept
            }
        }
        Rectangle {
            width: min(420px, root.width - 2 * Theme.s5);
            height: dialog-layout.preferred-height;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            dialog-layout := VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s3;
                Text {
                    text: root.confirm-title;
                    font-size: Theme.body + 2px;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-text;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.s2;
                    padding-top: Theme.s2;
                    Button {
                        text: "Cancel";
                        clicked => { root.confirm-cancelled(); }
                    }
                    Button {
                        text: root.confirm-action;
                        primary: true;
                        clicked => { root.confirm-accepted(); }
                    }
                }
            }
        }
    }

    init => { search.focus-and-select(); }
}
