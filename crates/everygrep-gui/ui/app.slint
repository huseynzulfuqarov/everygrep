import { AboutSlint, Button, ComboBox, ListView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Command, MenuKeys } from "commands.slint";
export { Command, MenuKeys }
export { SettingsWindow, DriveRow, ShortcutCommand } from "settings.slint";
export { StalledDialog } from "stalled.slint";

// A text with up to four highlighted runs: plain and bold pieces in turn,
// p0 b0 p1 b1 ... p4. Without a highlight all of it is in p0; runs after the
// fourth stay plain in p4.
export struct Marked {
    p0: string,
    b0: string,
    p1: string,
    b1: string,
    p2: string,
    b2: string,
    p3: string,
    b3: string,
    p4: string,
}

export struct ResultRow {
    // The name and the folder, with the matched search terms marked.
    name: Marked,
    folder: Marked,
    size: string,
    modified: string,
    modified-full: string,
    // Words for the Type column ("PNG image") and the extension as written.
    type-name: string,
    extension: string,
    // Read from the file system for the rows on screen, only while their
    // column is shown; empty when unknown.
    created: string,
    accessed: string,
    attributes: string,
    is-dir: bool,
    // Index into Icons.types (FileKind in src/filetype.rs).
    kind: int,
    selected: bool,
    // On a drive that is not connected: drawn dimmed, actions refused.
    offline: bool,
}

// One choice of a group in a menu (theme, density, filter, ...), with its
// check mark. The program gives a new list whenever the choice changes, since
// activating a checkable menu item overwrites its check mark.
export struct MenuChoice {
    title: string,
    checked: bool,
}

// A column of the View → Sort by menu, with its check mark; disabled while
// the column is hidden.
struct SortChoice {
    title: string,
    column: int,
    checked: bool,
    enabled: bool,
}

// A line of the keyboard shortcuts dialog.
export struct ShortcutRow {
    keys: string,
    action: string,
}

// File-type icons, in the order of FileKind. They carry their own colours and
// must not be colorized.
global Icons {
    out property <[image]> types: [
        @image-url("icons/types/folder.svg"),
        @image-url("icons/types/file.svg"),
        @image-url("icons/types/text.svg"),
        @image-url("icons/types/document.svg"),
        @image-url("icons/types/pdf.svg"),
        @image-url("icons/types/spreadsheet.svg"),
        @image-url("icons/types/presentation.svg"),
        @image-url("icons/types/image.svg"),
        @image-url("icons/types/audio.svg"),
        @image-url("icons/types/video.svg"),
        @image-url("icons/types/archive.svg"),
        @image-url("icons/types/code.svg"),
        @image-url("icons/types/executable.svg"),
        @image-url("icons/types/font.svg"),
        @image-url("icons/types/disk-image.svg"),
        @image-url("icons/types/link.svg")
    ];
}

// A small on/off button for a matching mode, shown inside the search field.
// A small flat button in the status line (Cancel).
component StatusButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: label.preferred-width + 2 * Theme.s2;
    height: Theme.badge-height + 2px;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.line;
    background: touch.pressed ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    label := Text {
        text: root.text;
        font-size: Theme.small;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ModeToggle inherits Rectangle {
    in property <string> glyph;
    // Draws a line under the glyph (the whole-words look).
    in property <bool> underline;
    in property <string> tip;
    in-out property <bool> checked;
    out property <bool> hovered: touch.has-hover;
    callback toggled();

    width: 26px;
    height: 24px;
    border-radius: 4px;
    background: root.checked ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    border-width: root.checked ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: checkbox;
    accessible-label: root.tip;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(); }

    property <color> ink: root.checked ? Theme.selection-text : Theme.text-muted;
    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    Text {
        text: root.glyph;
        font-size: Theme.small;
        font-weight: 600;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.underline: Rectangle {
        x: 7px;
        y: parent.height - 6px;
        width: parent.width - 14px;
        height: 1px;
        background: root.ink;
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    out property <bool> focused: input.has-focus;
    // Matching modes, changed by the toggles at the right end.
    in-out property <bool> match-case;
    in-out property <bool> whole-words;
    in-out property <bool> match-path;
    in-out property <bool> match-diacritics;
    in-out property <bool> use-regex;
    // A click into the field while it does not have the focus selects all
    // of its text; the next click places the caret.
    in property <bool> select-on-click;
    // The tip of the toggle under the mouse and where to show it.
    out property <string> hover-tip: case-toggle.hovered ? case-toggle.tip
        : words-toggle.hovered ? words-toggle.tip
        : path-toggle.hovered ? path-toggle.tip
        : marks-toggle.hovered ? marks-toggle.tip
        : regex-toggle.hovered ? regex-toggle.tip : "";
    out property <length> hover-x: case-toggle.hovered ? case-toggle.absolute-position.x
        : words-toggle.hovered ? words-toggle.absolute-position.x
        : path-toggle.hovered ? path-toggle.absolute-position.x
        : marks-toggle.hovered ? marks-toggle.absolute-position.x
        : regex-toggle.absolute-position.x;
    out property <length> hover-bottom: case-toggle.absolute-position.y + case-toggle.height;
    callback edited(string);
    callback accepted();
    callback down-pressed();
    callback escape-pressed();
    callback modes-changed();
    // The keys of the window's commands; returns whether the key was used.
    callback shortcut(KeyEvent) -> bool;
    public function focus-and-select() {
        input.focus();
        input.select-all();
    }
    // Puts the text cursor at `offset` (in bytes) with nothing selected.
    public function place-caret(offset: int) {
        input.set-selection-offsets(offset, offset);
    }

    height: Theme.field-height;
    border-radius: Theme.radius;
    background: Theme.field;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-line;

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s1;
        spacing: Theme.s2;
        Image {
            source: @image-url("icons/search.svg");
            colorize: Theme.text-muted;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        // The field takes the width the layout gives it, not the width of the
        // text: long text scrolls inside the clip instead of pushing the
        // toggles and the filter selector aside.
        Rectangle {
            horizontal-stretch: 1;
            // A TextInput of width 0 cannot take focus.
            min-width: 1px;
            clip: true;
            input := TextInput {
                // Scroll offset that keeps the text cursor visible.
                property <length> scroll-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                font-size: Theme.body + 1px;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.selection-text;
                single-line: true;
                cursor-position-changed(position) => {
                    if (position.x + self.scroll-x < 0px) {
                        self.scroll-x = -position.x;
                    } else if (position.x + self.scroll-x > parent.width - self.text-cursor-width) {
                        self.scroll-x = parent.width - position.x - self.text-cursor-width;
                    }
                }
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
                key-pressed(event) => {
                    if (root.shortcut(event)) {
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.down-pressed();
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        root.escape-pressed();
                        return accept;
                    }
                    reject
                }
            }
            // Takes the first click while the field has no focus; once it
            // has, clicks go to the text input and place the caret.
            TouchArea {
                enabled: root.select-on-click && !input.has-focus;
                mouse-cursor: MouseCursor.text;
                clicked => {
                    input.focus();
                    input.select-all();
                }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            // The toggles keep their height; centre them in the field.
            padding-top: (root.height - 24px) / 2;
            padding-bottom: (root.height - 24px) / 2;
            case-toggle := ModeToggle {
                glyph: "Aa";
                tip: @tr("Match case (Alt+C)");
                checked <=> root.match-case;
                toggled => { root.modes-changed(); }
            }
            words-toggle := ModeToggle {
                glyph: "ab";
                underline: true;
                tip: @tr("Match whole words (Alt+W)");
                checked <=> root.whole-words;
                toggled => { root.modes-changed(); }
            }
            path-toggle := ModeToggle {
                glyph: "a/b";
                tip: @tr("Match the full path (Alt+P)");
                checked <=> root.match-path;
                toggled => { root.modes-changed(); }
            }
            marks-toggle := ModeToggle {
                glyph: "é";
                tip: @tr("Match diacritics (Alt+D)");
                checked <=> root.match-diacritics;
                toggled => { root.modes-changed(); }
            }
            regex-toggle := ModeToggle {
                glyph: ".*";
                tip: @tr("Regular expression (Alt+R)");
                checked <=> root.use-regex;
                toggled => { root.modes-changed(); }
            }
        }
    }
    placeholder := Text {
        x: Theme.s3 + Theme.icon + Theme.s2;
        visible: input.text == "";
        text: @tr("Search files and folders");
        color: Theme.text-muted;
        font-size: Theme.body + 1px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <TextHorizontalAlignment> align: left;
    // Whether the results are sorted by this column, and in which direction.
    in property <bool> sorted;
    in property <bool> descending;
    callback clicked();
    callback right-pressed(length, length);

    property <bool> right: root.align == TextHorizontalAlignment.right;
    property <length> arrow-space: root.sorted ? Theme.icon : 0px;
    property <length> label-width: min(label-text.preferred-width, label-text.width);

    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.right-pressed(self.mouse-x, self.mouse-y);
            }
        }
    }
    label-text := Text {
        x: root.right ? Theme.s2 + root.arrow-space : Theme.s2;
        width: parent.width - 2 * Theme.s2 - root.arrow-space;
        height: parent.height;
        text: root.label;
        font-size: Theme.small;
        font-weight: 600;
        color: root.sorted ? Theme.text : Theme.text-muted;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        overflow: elide;
    }
    // The arrow sits next to the label, on the side away from the alignment.
    Image {
        visible: root.sorted;
        x: root.right
            ? parent.width - Theme.s2 - root.label-width - self.width
            : Theme.s2 + root.label-width;
        y: (parent.height - self.height) / 2;
        width: Theme.icon;
        height: Theme.icon;
        source: root.descending ? @image-url("icons/sort-down.svg") : @image-url("icons/sort-up.svg");
        colorize: Theme.accent;
    }
}

// One piece of a MarkedText. It takes its natural width while there is
// room; the piece that runs out of room is elided. The last piece takes all
// the room left.
component Piece inherits Text {
    // Width from this piece to the end of the cell.
    in property <length> room;
    in property <bool> last;
    // An empty Text still reports a small preferred width; force 0.
    width: self.text == "" ? 0px : self.last ? max(0px, self.room) : min(self.preferred-width, self.room);
    visible: self.text != "";
    vertical-alignment: center;
    overflow: elide;
}

// A one-line text with the matched search terms in bold (see Marked); the
// cell clips what does not fit.
component MarkedText inherits Rectangle {
    in property <Marked> text;
    in property <color> text-color;
    in property <bool> italic;
    in property <length> font-size;
    clip: true;

    p0 := Piece {
        x: 0;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p0;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b0 := Piece {
        x: p0.x + p0.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b0;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p1 := Piece {
        x: b0.x + b0.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p1;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b1 := Piece {
        x: p1.x + p1.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b1;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p2 := Piece {
        x: b1.x + b1.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p2;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b2 := Piece {
        x: p2.x + p2.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b2;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p3 := Piece {
        x: b2.x + b2.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p3;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b3 := Piece {
        x: p3.x + p3.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b3;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p4 := Piece {
        x: b3.x + b3.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p4;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        last: true;
    }
}

component Row inherits Rectangle {
    in property <ResultRow> data;
    // The keyboard cursor is on this row and the list has focus.
    in property <bool> current;
    in property <length> name-width;
    in property <length> folder-width;
    in property <length> size-width;
    in property <length> date-width;
    // Optional columns; 0 when hidden.
    in property <length> type-width;
    in property <length> ext-width;
    in property <length> created-width;
    in property <length> accessed-width;
    in property <length> attr-width;
    // The name is being edited in place.
    in property <bool> editing;
    in-out property <string> edit-text;
    // Bytes of the name selected when editing starts (the part before the
    // extension).
    in property <int> edit-stem;
    callback pressed(KeyboardModifiers);
    callback right-pressed(length, length);
    callback double-clicked();
    callback edit-commit(string);
    callback edit-cancel();

    property <bool> selected: root.data.selected;
    property <bool> offline: root.data.offline;
    // Text colors: offline rows are dimmed (unless selected) and their names
    // slanted, so the state is not shown by color alone.
    property <color> name-color: selected ? Theme.selection-text : offline ? Theme.text-offline : Theme.text;
    property <color> other-color: selected ? Theme.selection-text : offline ? Theme.text-offline : Theme.text-muted;

    height: Theme.row-height;
    background: selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    root.pressed(event.modifiers);
                } else if (event.button == PointerEventButton.right) {
                    root.right-pressed(self.mouse-x, self.mouse-y);
                }
            }
        }
        double-clicked => { root.double-clicked(); }
    }
    // Focus ring of the keyboard cursor.
    Rectangle {
        visible: root.current;
        border-width: 1px;
        border-color: Theme.accent;
    }

    // Cells are positioned directly to keep the columns aligned with the header.
    Image {
        x: Theme.s3;
        opacity: root.offline ? 0.45 : 1;
        source: Icons.types[root.data.kind];
        width: Theme.row-icon;
        height: Theme.row-icon;
        y: (parent.height - self.height) / 2;
    }
    name-cell := MarkedText {
        x: Theme.s3 + Theme.row-icon + Theme.s2;
        width: max(0px, root.name-width - self.x - Theme.s2);
        height: parent.height;
        text: root.data.name;
        text-color: root.name-color;
        italic: root.offline;
        font-size: Theme.list-text;
    }
    if root.editing: Rectangle {
        x: name-cell.x - Theme.s1;
        width: name-cell.width + Theme.s1;
        y: 2px;
        height: parent.height - 4px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: 3px;
        edit := TextInput {
            x: Theme.s1;
            width: parent.width - 2 * Theme.s1;
            text <=> root.edit-text;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.list-text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.selection-text;
            init => {
                self.focus();
                self.set-selection-offsets(0, root.edit-stem);
            }
            accepted => { root.edit-commit(self.text); }
            // Leaving the field (a click elsewhere) cancels; only Enter renames.
            changed has-focus => {
                if (!self.has-focus) { root.edit-cancel(); }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.edit-cancel();
                    return accept;
                }
                // Keep list keys from moving the selection while editing.
                if (event.text == Key.UpArrow || event.text == Key.DownArrow
                    || event.text == Key.PageUp || event.text == Key.PageDown || event.text == Key.F2) {
                    return accept;
                }
                reject
            }
        }
    }
    MarkedText {
        x: root.name-width + Theme.s2;
        width: root.folder-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.folder;
        text-color: root.other-color;
        font-size: Theme.list-text;
    }
    Text {
        x: root.name-width + root.folder-width;
        width: root.size-width - Theme.s2;
        height: parent.height;
        text: root.data.size;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    Text {
        x: root.name-width + root.folder-width + root.size-width + Theme.s2;
        width: root.date-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.modified;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> type-x: root.name-width + root.folder-width + root.size-width + root.date-width;
    if root.type-width > 0: Text {
        x: root.type-x + Theme.s2;
        width: root.type-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.type-name;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.ext-width > 0: Text {
        x: root.type-x + root.type-width + Theme.s2;
        width: root.ext-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.extension;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> created-x: root.type-x + root.type-width + root.ext-width;
    if root.created-width > 0: Text {
        x: root.created-x + Theme.s2;
        width: root.created-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.created;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.accessed-width > 0: Text {
        x: root.created-x + root.created-width + Theme.s2;
        width: root.accessed-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.accessed;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.attr-width > 0: Text {
        x: root.created-x + root.created-width + root.accessed-width + Theme.s2;
        width: root.attr-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.attributes;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
}

// A dialog above the window: a dimmed backdrop, a card with a title, the
// content and a Close button. Esc, Enter and a click outside close it.
component InfoDialog inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 420px;
    callback close();

    background: #00000060;
    TouchArea {
        clicked => { root.close(); }
    }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Return) {
                root.close();
            }
            accept
        }
    }
    Rectangle {
        width: min(root.card-width, root.width - 2 * Theme.s5);
        height: min(card-layout.preferred-height, root.height - 2 * Theme.s5);
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        clip: true;
        // Clicks on the card stay on it.
        TouchArea { }
        card-layout := VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s3;
            Text {
                text: root.title;
                font-size: Theme.body + 2px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            @children
            HorizontalLayout {
                alignment: end;
                padding-top: Theme.s2;
                Button {
                    text: @tr("Close");
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

// A drag handle on the boundary between two header cells.
component ColumnGrip inherits TouchArea {
    callback dragged(length);
    width: Theme.s2;
    mouse-cursor: col-resize;
    // The grip follows the boundary, so the offset from the press point is the
    // movement since the previous event.
    moved => { root.dragged(self.mouse-x - self.pressed-x); }
    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        y: parent.height / 4;
        height: parent.height / 2;
        background: root.pressed || root.has-hover ? Theme.text-muted : Theme.line;
    }
}

export component AppWindow inherits Window {
    title: "EveryGrep";
    // Used on X11; Wayland compositors take the icon from the desktop entry
    // that matches the app id.
    icon: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
    preferred-width: 1040px;
    preferred-height: 660px;
    min-width: 560px;
    min-height: 320px;
    background: Theme.surface;
    default-font-size: Theme.body;

    // Whether the search field or the list has the keyboard focus. The
    // focused item loses it when another window becomes active, so this
    // also says the window is in front (a rename, a dialog or a menu that
    // has the focus counts as not in front).
    out property <bool> typing-here: search.focused || keys.has-focus;

    in property <[ResultRow]> results;
    // The status line: result count, details of the selection, the index
    // and the time of the last search.
    in property <string> status-count;
    in property <string> status-detail;
    in property <string> status-index;
    in property <string> status-right;
    // A long operation ("Indexing: 42%"), empty when none is shown, and
    // whether it can be cancelled with cancel-task().
    in property <string> progress-text;
    in property <bool> can-cancel;
    callback cancel-task();
    in property <string> message;
    in-out property <int> current: -1;
    // Text of the search field.
    in-out property <string> query <=> search.text;

    // Sort column (0 name, 1 folder, 2 size, 3 modified, 4 type, 5 extension,
    // 6 created, 7 accessed, 8 attributes) and direction.
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-descending: false;

    // Matching modes and the filter; options-changed() runs the query again.
    in-out property <bool> match-case <=> search.match-case;
    in-out property <bool> whole-words <=> search.whole-words;
    in-out property <bool> match-path <=> search.match-path;
    in-out property <bool> match-diacritics <=> search.match-diacritics;
    in-out property <bool> use-regex <=> search.use-regex;
    // A click into the search field selects its text (a setting).
    in property <bool> select-search-on-click: true;
    // Modes without a toggle in the field: Search menu and Alt keys.
    in-out property <bool> match-prefix;
    in-out property <bool> match-suffix;
    in-out property <bool> ignore-punctuation;
    in-out property <bool> ignore-whitespace;
    in property <[string]> filter-names;
    in-out property <int> filter-index: 0;
    // Words for the modes that are on, shown in the status line.
    in property <[string]> badges;
    callback options-changed();

    // Search history: step -1 goes back, 1 forward; the handler sets the
    // query. history-record() keeps the current query.
    callback history-step(int);
    callback history-record();
    // Search as you type is off and the search field changed: Enter runs
    // the search (search-now) instead of opening the current row.
    in property <bool> search-pending;
    callback search-now();

    // The settings window, and ending the program (also when closing the
    // window only hides it).
    callback open-settings();
    callback quit();
    // Another window over the same index.
    callback new-window();
    // Closes the window as its close button does: hides it or quits, as
    // set on the Window page of the settings.
    callback close-window();
    // The settings window at its Keyboard page.
    callback open-keyboard-settings();
    // The keys shown in the menu bar, and the accessible label of the ⋯
    // button; both follow the keyboard settings.
    in property <MenuKeys> menu-keys;
    in property <string> more-label;
    // Saves the result list to a file.
    callback export-results();

    // Menu bar and the appearance choices in its View menu. The choices
    // are saved as settings; the program sets the lists again after a
    // change.
    in-out property <bool> show-menu-bar: true;
    in-out property <bool> status-details: true;
    in property <[MenuChoice]> filter-items;
    in property <[MenuChoice]> theme-items;
    in property <[MenuChoice]> density-items;
    in property <[MenuChoice]> folder-size-items;
    callback menu-bar-changed(bool);
    callback status-details-changed(bool);
    callback choose-theme(int);
    callback choose-density(int);
    callback choose-folder-size(int);

    // Help: the keyboard shortcuts and the about dialog.
    in property <[ShortcutRow]> shortcuts;
    in property <string> version;
    in-out property <bool> shortcuts-open;
    in-out property <bool> about-open;

    callback query-edited(string);
    callback sort-changed(int, bool);
    callback activate(int);
    // Asks the desktop which application to open the item with.
    callback open-with(int);
    callback open-folder(int);
    // Selection: mode 0 selects only the row, 1 toggles it, 2 extends the
    // range from the anchor to it.
    callback select(int, int);
    // Actions on the selection, or on the given row when it is not selected.
    callback copy-names(int);
    callback copy-paths(int);
    // The containing folders.
    callback copy-folders(int);
    // Files to the clipboard, and pasting them into the given folder row.
    callback cut-items(int);
    callback copy-items(int);
    callback paste-items(int);
    callback rename-start(int);
    callback rename-commit(string);
    callback rename-cancel();
    callback trash(int);
    callback delete-request(int);
    callback confirm-accepted();
    callback confirm-cancelled();

    // A short note in the status line, e.g. "Copied 3 paths.", and whether
    // it reports a failure (drawn in the danger color; hints are muted).
    in property <string> notice;
    in property <bool> notice-error;

    // In-place rename: the row being edited (-1 for none), its text and the
    // part selected at the start.
    in property <int> rename-row: -1;
    in-out property <string> rename-text;
    in property <int> rename-stem;

    // Confirmation dialog.
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-action;
    callback select-all();
    // Selects the rows that are not selected and unselects the others.
    callback invert-selection();
    // Returns whether anything was selected.
    callback clear-selection() -> bool;
    pure callback is-selected(int) -> bool;

    // Column widths. Size and Modified keep the width the user gave them; Name
    // and Folder share the rest of the window, so the columns always end at the
    // right edge. Name keeps its chosen width while Folder can stay at least at
    // its minimum, then shrinks. Until the user drags Name, it takes 48 % of
    // the shared space.
    in-out property <length> name-want: (self.width - self.size-want - self.date-want) * 0.48;
    in-out property <length> size-want: 96px;
    in-out property <length> date-want: 120px;
    in-out property <length> type-want: 130px;
    in-out property <length> ext-want: 80px;
    in-out property <length> created-want: 120px;
    in-out property <length> accessed-want: 120px;
    in-out property <length> attr-want: 64px;
    // Optional columns after Modified, hidden by default.
    in-out property <bool> show-type: false;
    in-out property <bool> show-ext: false;
    in-out property <bool> show-created: false;
    in-out property <bool> show-accessed: false;
    in-out property <bool> show-attrs: false;
    // Created, Accessed or Attributes was shown or hidden: their values are
    // read only while shown.
    callback detail-columns-changed();
    changed show-created => { root.detail-columns-changed(); }
    changed show-accessed => { root.detail-columns-changed(); }
    changed show-attrs => { root.detail-columns-changed(); }
    // Whether Name has a width of its own (dragged, or restored from the
    // settings) rather than its share of the window.
    in-out property <bool> name-set: false;
    out property <length> name-min: 120px;
    out property <length> folder-min: 100px;
    out property <length> size-min: 56px;
    out property <length> date-min: 80px;
    out property <length> type-min: 64px;
    out property <length> ext-min: 48px;
    out property <length> created-min: 80px;
    out property <length> accessed-min: 80px;
    out property <length> attr-min: 40px;
    property <length> size-width: max(self.size-min, self.size-want);
    property <length> date-width: max(self.date-min, self.date-want);
    property <length> type-width: self.show-type ? max(self.type-min, self.type-want) : 0px;
    property <length> ext-width: self.show-ext ? max(self.ext-min, self.ext-want) : 0px;
    property <length> created-width: self.show-created ? max(self.created-min, self.created-want) : 0px;
    property <length> accessed-width: self.show-accessed ? max(self.accessed-min, self.accessed-want) : 0px;
    property <length> attr-width: self.show-attrs ? max(self.attr-min, self.attr-want) : 0px;
    property <length> fixed-width: self.size-width + self.date-width + self.type-width + self.ext-width
        + self.created-width + self.accessed-width + self.attr-width;
    property <length> flex-width: max(self.name-min + self.folder-min, self.width - self.fixed-width);
    property <length> name-width: max(self.name-min, min(self.name-want, self.flex-width - self.folder-min));
    property <length> folder-width: self.flex-width - self.name-width;
    // Left edges of the optional columns.
    property <length> type-x: self.name-width + self.folder-width + self.size-width + self.date-width;
    property <length> ext-x: self.type-x + self.type-width;
    property <length> created-x: self.ext-x + self.ext-width;
    property <length> accessed-x: self.created-x + self.created-width;
    property <length> attr-x: self.accessed-x + self.accessed-width;

    // Width, minimum width and wanted width of column 3 (Modified) to 8
    // (Attributes), numbered as sort-column.
    function col-width(c: int) -> length {
        return c == 3 ? root.date-width : c == 4 ? root.type-width : c == 5 ? root.ext-width
            : c == 6 ? root.created-width : c == 7 ? root.accessed-width : root.attr-width;
    }
    function col-min(c: int) -> length {
        return c == 3 ? root.date-min : c == 4 ? root.type-min : c == 5 ? root.ext-min
            : c == 6 ? root.created-min : c == 7 ? root.accessed-min : root.attr-min;
    }
    function set-col-want(c: int, w: length) {
        if (c == 3) {
            root.date-want = w;
        } else if (c == 4) {
            root.type-want = w;
        } else if (c == 5) {
            root.ext-want = w;
        } else if (c == 6) {
            root.created-want = w;
        } else if (c == 7) {
            root.accessed-want = w;
        } else {
            root.attr-want = w;
        }
    }
    // The shown column left of optional column c; Modified (3) is always shown.
    function left-of(c: int) -> int {
        return c > 7 && root.show-accessed ? 7 : c > 6 && root.show-created ? 6
            : c > 5 && root.show-ext ? 5 : c > 4 && root.show-type ? 4 : 3;
    }

    // Dragging a boundary moves it between its two neighbours; neither gets
    // narrower than its minimum, so the total width stays the same.
    function drag-boundary(boundary: int, delta: length) {
        if (boundary <= 1) {
            root.name-set = true;
        }
        if (boundary == 0) {
            root.name-want = max(root.name-min, min(root.name-width + delta, root.name-width + root.folder-width - root.folder-min));
        } else if (boundary == 1) {
            root.name-want = root.name-width;
            root.size-want = max(root.size-min, min(root.size-width - delta, root.size-width + root.folder-width - root.folder-min));
        } else if (boundary == 2) {
            let pair = root.size-width + root.date-width;
            let size = max(root.size-min, min(root.size-width + delta, pair - root.date-min));
            root.size-want = size;
            root.date-want = pair - size;
        } else {
            // The left edge of optional column `boundary`.
            let left = root.left-of(boundary);
            let pair = root.col-width(left) + root.col-width(boundary);
            let w = max(root.col-min(left), min(root.col-width(left) + delta, pair - root.col-min(boundary)));
            root.set-col-want(left, w);
            root.set-col-want(boundary, pair - w);
        }
    }

    // After an optional column (4 to 8, see sort-column) was shown or hidden:
    // hiding the sorted column sorts by name again.
    function column-shown(column: int, shown: bool) {
        if (!shown && root.sort-column == column) {
            root.sort-column = 0;
            root.sort-descending = false;
            root.results-replaced();
            root.sort-changed(0, false);
        }
    }

    // Back to the top of a new result list.
    function results-replaced() {
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
    }

    function options-edited() {
        root.results-replaced();
        root.options-changed();
    }

    function history-go(step: int) {
        root.history-step(step);
        root.results-replaced();
    }

    // The command a key runs while the focus is in a scope (0 anywhere,
    // 1 the search field, 2 the result list); Command.none for none. See
    // src/commands.rs.
    callback resolve-key(int, string, bool, bool, bool, bool) -> Command;

    // File actions that are refused, with a note, for an item on a drive
    // that is not connected.
    function needs-online(c: Command) -> bool {
        return c == Command.open || c == Command.open-folder || c == Command.open-with
            || c == Command.cut || c == Command.copy || c == Command.paste
            || c == Command.rename || c == Command.trash || c == Command.delete-permanently;
    }

    // Whether a command can run now; menu items are enabled by it.
    function can-run(c: Command) -> bool {
        if (root.confirm-open) {
            return false;
        }
        if (root.needs-online(c)) {
            return root.current >= 0 && !root.current-offline
                && (c != Command.rename || root.rename-row < 0);
        }
        if (c == Command.copy-name || c == Command.copy-path || c == Command.copy-full-path
                || c == Command.toggle-row || c == Command.context-menu) {
            return root.current >= 0;
        }
        if (c == Command.export-results || c == Command.select-all || c == Command.invert-selection) {
            return root.results.length > 0;
        }
        return c != Command.none;
    }

    // Runs a command.
    function run(c: Command) {
        if (c == Command.new-window) {
            root.new-window();
        } else if (c == Command.close-window) {
            root.close-window();
        } else if (c == Command.export-results) {
            root.export-results();
        } else if (c == Command.quit) {
            root.quit();
        } else if (c == Command.open) {
            root.activate(root.current);
        } else if (c == Command.open-folder) {
            root.open-folder(root.current);
        } else if (c == Command.open-with) {
            root.open-with(root.current);
        } else if (c == Command.cut) {
            root.cut-items(root.current);
        } else if (c == Command.copy) {
            root.copy-items(root.current);
        } else if (c == Command.paste) {
            root.paste-items(root.current);
        } else if (c == Command.copy-name) {
            root.copy-names(root.current);
        } else if (c == Command.copy-path) {
            root.copy-folders(root.current);
        } else if (c == Command.copy-full-path) {
            root.copy-paths(root.current);
        } else if (c == Command.select-all) {
            root.select-all();
            keys.focus();
        } else if (c == Command.invert-selection) {
            root.invert-selection();
            keys.focus();
        } else if (c == Command.toggle-row) {
            root.select(root.current, 1);
        } else if (c == Command.rename) {
            root.rename-start(root.current);
        } else if (c == Command.trash) {
            root.trash(root.current);
        } else if (c == Command.delete-permanently) {
            root.delete-request(root.current);
        } else if (c == Command.focus-search) {
            search.focus-and-select();
        } else if (c == Command.context-menu) {
            root.show-menu-at-current();
        } else if (c == Command.type-column) {
            root.show-type = !root.show-type;
            root.toggled(c);
        } else if (c == Command.extension-column) {
            root.show-ext = !root.show-ext;
            root.toggled(c);
        } else if (c == Command.created-column) {
            root.show-created = !root.show-created;
            root.toggled(c);
        } else if (c == Command.accessed-column) {
            root.show-accessed = !root.show-accessed;
            root.toggled(c);
        } else if (c == Command.attributes-column) {
            root.show-attrs = !root.show-attrs;
            root.toggled(c);
        } else if (c == Command.selection-details) {
            root.status-details = !root.status-details;
            root.toggled(c);
        } else if (c == Command.menu-bar) {
            root.show-menu-bar = !root.show-menu-bar;
            root.toggled(c);
        } else if (c == Command.match-case) {
            root.match-case = !root.match-case;
            root.toggled(c);
        } else if (c == Command.whole-words) {
            root.whole-words = !root.whole-words;
            root.toggled(c);
        } else if (c == Command.match-path) {
            root.match-path = !root.match-path;
            root.toggled(c);
        } else if (c == Command.match-diacritics) {
            root.match-diacritics = !root.match-diacritics;
            root.toggled(c);
        } else if (c == Command.regex) {
            root.use-regex = !root.use-regex;
            root.toggled(c);
        } else if (c == Command.match-prefix) {
            root.match-prefix = !root.match-prefix;
            root.toggled(c);
        } else if (c == Command.match-suffix) {
            root.match-suffix = !root.match-suffix;
            root.toggled(c);
        } else if (c == Command.ignore-punctuation) {
            root.ignore-punctuation = !root.ignore-punctuation;
            root.toggled(c);
        } else if (c == Command.ignore-whitespace) {
            root.ignore-whitespace = !root.ignore-whitespace;
            root.toggled(c);
        } else if (c == Command.previous-filter || c == Command.next-filter) {
            let n = root.filter-names.length;
            if (n > 0) {
                root.filter-index = Math.mod(root.filter-index + (c == Command.previous-filter ? -1 : 1), n);
                root.options-edited();
            }
        } else if (c == Command.previous-search) {
            root.history-go(-1);
        } else if (c == Command.next-search) {
            root.history-go(1);
        } else if (c == Command.settings) {
            root.open-settings();
        } else if (c == Command.keyboard-settings) {
            root.open-keyboard-settings();
        } else if (c == Command.shortcuts-help) {
            root.shortcuts-open = true;
        } else if (c == Command.about) {
            root.about-open = true;
        }
    }

    // After an on/off command changed its flag (by a key, or by its
    // checkable menu item, which flips the flag itself): applies it.
    function toggled(c: Command) {
        if (c == Command.type-column) {
            root.column-shown(4, root.show-type);
        } else if (c == Command.extension-column) {
            root.column-shown(5, root.show-ext);
        } else if (c == Command.created-column) {
            root.column-shown(6, root.show-created);
        } else if (c == Command.accessed-column) {
            root.column-shown(7, root.show-accessed);
        } else if (c == Command.attributes-column) {
            root.column-shown(8, root.show-attrs);
        } else if (c == Command.selection-details) {
            root.status-details-changed(root.status-details);
        } else if (c == Command.menu-bar) {
            root.menu-bar-changed(root.show-menu-bar);
        } else {
            root.options-edited();
        }
    }

    // View → Sort by: the columns, the shown optional ones enabled, and the
    // two directions. A new list on every change gives fresh check marks.
    property <[SortChoice]> sort-items: [
        { title: @tr("Name"), column: 0, checked: root.sort-column == 0, enabled: true },
        { title: @tr("Folder"), column: 1, checked: root.sort-column == 1, enabled: true },
        { title: @tr("Size"), column: 2, checked: root.sort-column == 2, enabled: true },
        { title: @tr("Modified"), column: 3, checked: root.sort-column == 3, enabled: true },
        { title: @tr("Type"), column: 4, checked: root.sort-column == 4, enabled: root.show-type },
        { title: @tr("Extension"), column: 5, checked: root.sort-column == 5, enabled: root.show-ext },
        { title: @tr("Created"), column: 6, checked: root.sort-column == 6, enabled: root.show-created },
        { title: @tr("Accessed"), column: 7, checked: root.sort-column == 7, enabled: root.show-accessed },
        { title: @tr("Attributes"), column: 8, checked: root.sort-column == 8, enabled: root.show-attrs },
    ];
    property <[MenuChoice]> sort-order-items: [
        { title: @tr("Ascending"), checked: !root.sort-descending },
        { title: @tr("Descending"), checked: root.sort-descending },
    ];

    // Sorts by a column in a direction.
    function sort-to(column: int, descending: bool) {
        root.sort-column = column;
        root.sort-descending = descending;
        root.results-replaced();
        root.sort-changed(column, descending);
    }

    // Runs the command of a key pressed with the focus in `scope`; returns
    // whether the key belongs to a command (it is used even when the
    // command cannot run now). A file action on an offline item runs, so
    // the program can say why it is refused.
    function dispatch(scope: int, event: KeyEvent) -> bool {
        let c = root.resolve-key(scope, event.text, event.modifiers.control, event.modifiers.alt,
            event.modifiers.shift, event.modifiers.meta);
        if (c == Command.none) {
            return false;
        }
        if (root.can-run(c) || (!root.confirm-open && root.current >= 0 && root.needs-online(c))) {
            root.run(c);
        }
        true
    }

    // Colors: 1 light, 2 dark, 0 the toolkit's reading of the desktop
    // setting. Sets the palette of the standard widgets too.
    public function set-color-scheme(scheme: int) {
        Theme.scheme = scheme == 1 ? ColorScheme.light : scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Palette.color-scheme = Theme.scheme;
    }

    // Density of the list: compact or comfortable.
    public function set-compact(compact: bool) {
        Theme.compact = compact;
    }

    public function focus-search() {
        search.focus-and-select();
    }

    // Puts the search field's text cursor at `offset` (in bytes), nothing
    // selected; used after the query is set from the history.
    public function place-search-caret(offset: int) {
        search.place-caret(offset);
    }

    public function focus-list() {
        keys.focus();
    }

    // Puts text on the clipboard through a hidden text field; Slint has no
    // clipboard API of its own.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    // The text on the clipboard, read through the same hidden field.
    public function paste-text() -> string {
        clip.text = "";
        clip.paste();
        let text = clip.text;
        clip.text = "";
        return text;
    }

    // Opens the context menu next to the current row.
    function show-menu-at-current() {
        if (root.current >= 0) {
            menu-area.show({
                x: Theme.s3 + Theme.icon,
                y: (root.current + 1) * Theme.row-height + list.content-y,
            });
        }
    }

    // Moves the cursor; mode as for select(), or -1 to move without changing
    // the selection.
    function move-to(row: int, mode: int) {
        if (root.results.length == 0) {
            return;
        }
        root.current = max(0, min(root.results.length - 1, row));
        if (mode >= 0) {
            root.select(root.current, mode);
        }
        // Keep the current row inside the visible part of the list.
        let top = root.current * Theme.row-height;
        if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + Theme.row-height > -list.content-y + list.visible-height) {
            list.content-y = -(top + Theme.row-height - list.visible-height);
        }
    }

    // A click on the sorted column flips the direction; another column starts
    // ascending.
    function sort-by(column: int) {
        if (root.sort-column == column) {
            root.sort-descending = !root.sort-descending;
        } else {
            root.sort-column = column;
            root.sort-descending = false;
        }
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
        root.sort-changed(root.sort-column, root.sort-descending);
    }

    property <int> page: max(1, floor(list.visible-height / Theme.row-height) - 1);
    // The current row is on a drive that is not connected: file actions
    // are off for it.
    property <bool> current-offline: root.current >= 0 && root.current < root.results.length
        && root.results[root.current].offline;

    // Keys pressed while the focus is on a control without keys of its own
    // (the filter selector, a button) run the global commands. It never
    // takes the focus itself.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (root.dispatch(0, event)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            // Top bar
            Rectangle {
                height: Theme.top-bar-height;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.s3;
                    padding-right: Theme.s3;
                    padding-top: (Theme.top-bar-height - Theme.field-height) / 2;
                    padding-bottom: (Theme.top-bar-height - Theme.field-height) / 2;
                    spacing: Theme.s2;
                    search := SearchField {
                        horizontal-stretch: 1;
                        select-on-click: root.select-search-on-click;
                        edited(text) => {
                            root.current = root.results.length > 0 ? 0 : -1;
                            list.content-y = 0;
                            root.query-edited(text);
                        }
                        modes-changed => { root.options-edited(); }
                        shortcut(event) => { root.dispatch(1, event) }
                        accepted => {
                            if (root.search-pending) {
                                root.search-now();
                            } else {
                                root.history-record();
                                if (root.current >= 0) {
                                    root.activate(root.current);
                                }
                            }
                        }
                        down-pressed => {
                            keys.focus();
                            root.move-to(root.current < 0 ? 0 : root.current + 1, 0);
                        }
                        escape-pressed => {
                            self.text = "";
                            root.query-edited("");
                        }
                    }
                    ComboBox {
                        width: 160px;
                        horizontal-stretch: 0;
                        accessible-label: @tr("Filter");
                        model: root.filter-names;
                        current-index <=> root.filter-index;
                        selected => { root.options-edited(); }
                    }
                    // Overflow menu, in place of the menu bar when that is hidden.
                    if !root.show-menu-bar: more-menu := ContextMenuArea {
                        width: 34px;
                        Menu {
                            MenuItem {
                                title: @tr("Settings…");
                                enabled: root.can-run(Command.settings);
                                activated => { root.run(Command.settings); }
                            }
                            MenuItem {
                                title: @tr("Customize shortcuts…");
                                enabled: root.can-run(Command.keyboard-settings);
                                activated => { root.run(Command.keyboard-settings); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Keyboard shortcuts");
                                activated => { root.run(Command.shortcuts-help); }
                            }
                            MenuItem {
                                title: @tr("About EveryGrep");
                                activated => { root.run(Command.about); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Show the menu bar");
                                activated => { root.run(Command.menu-bar); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Quit");
                                enabled: root.can-run(Command.quit);
                                activated => { root.run(Command.quit); }
                            }
                        }
                        Rectangle {
                            border-radius: Theme.radius;
                            background: more-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: root.more-label;
                            accessible-action-default => { more-menu.show({ x: 0, y: self.height }); }
                            more-touch := TouchArea {
                                clicked => { more-menu.show({ x: 0, y: self.height }); }
                            }
                            Image {
                                source: @image-url("icons/more.svg");
                                colorize: Theme.text-muted;
                                width: Theme.icon;
                                height: Theme.icon;
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }

            // Column headers (positioned directly, so they never feed back into
            // the window's layout). Right-click shows or hides optional columns.
            Rectangle {
                height: Theme.header-height;
                background: Theme.surface-alt;
                header-menu := ContextMenuArea {
                    Menu {
                        // Activating a checkable item flips its check mark, which
                        // is tied to the column flag both ways.
                        MenuItem {
                            title: @tr("Type");
                            checkable: true;
                            checked <=> root.show-type;
                            activated => { root.column-shown(4, root.show-type); }
                        }
                        MenuItem {
                            title: @tr("Extension");
                            checkable: true;
                            checked <=> root.show-ext;
                            activated => { root.column-shown(5, root.show-ext); }
                        }
                        MenuItem {
                            title: @tr("Created");
                            checkable: true;
                            checked <=> root.show-created;
                            activated => { root.column-shown(6, root.show-created); }
                        }
                        MenuItem {
                            title: @tr("Accessed");
                            checkable: true;
                            checked <=> root.show-accessed;
                            activated => { root.column-shown(7, root.show-accessed); }
                        }
                        MenuItem {
                            title: @tr("Attributes");
                            checkable: true;
                            checked <=> root.show-attrs;
                            activated => { root.column-shown(8, root.show-attrs); }
                        }
                    }
                    HeaderCell {
                        x: Theme.s1;
                        width: root.name-width - Theme.s1;
                        height: parent.height;
                        label: @tr("Name");
                        sorted: root.sort-column == 0;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(0); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                    HeaderCell {
                        x: root.name-width;
                        width: root.folder-width;
                        height: parent.height;
                        label: @tr("Folder");
                        sorted: root.sort-column == 1;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(1); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                    HeaderCell {
                        x: root.name-width + root.folder-width;
                        width: root.size-width;
                        height: parent.height;
                        label: @tr("Size");
                        align: right;
                        sorted: root.sort-column == 2;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(2); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                    HeaderCell {
                        x: root.name-width + root.folder-width + root.size-width;
                        width: root.date-width;
                        height: parent.height;
                        label: @tr("Modified");
                        sorted: root.sort-column == 3;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(3); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                    if root.show-type: HeaderCell {
                        x: root.type-x;
                        width: root.type-width;
                        height: parent.height;
                        label: @tr("Type");
                        sorted: root.sort-column == 4;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(4); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                    if root.show-ext: HeaderCell {
                        x: root.ext-x;
                        width: root.ext-width;
                        height: parent.height;
                        label: @tr("Extension");
                        sorted: root.sort-column == 5;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(5); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                    if root.show-created: HeaderCell {
                        x: root.created-x;
                        width: root.created-width;
                        height: parent.height;
                        label: @tr("Created");
                        sorted: root.sort-column == 6;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(6); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                    if root.show-accessed: HeaderCell {
                        x: root.accessed-x;
                        width: root.accessed-width;
                        height: parent.height;
                        label: @tr("Accessed");
                        sorted: root.sort-column == 7;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(7); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                    if root.show-attrs: HeaderCell {
                        x: root.attr-x;
                        width: root.attr-width;
                        height: parent.height;
                        label: @tr("Attributes");
                        sorted: root.sort-column == 8;
                        descending: root.sort-descending;
                        clicked => { root.sort-by(8); }
                        right-pressed(x, y) => { header-menu.show({ x: self.x + x, y: y }); }
                    }
                }
                // Boundary grips, on top of the cells.
                ColumnGrip {
                    x: root.name-width - self.width / 2;
                    height: parent.height;
                    dragged(delta) => { root.drag-boundary(0, delta); }
                }
                ColumnGrip {
                    x: root.name-width + root.folder-width - self.width / 2;
                    height: parent.height;
                    dragged(delta) => { root.drag-boundary(1, delta); }
                }
                ColumnGrip {
                    x: root.name-width + root.folder-width + root.size-width - self.width / 2;
                    height: parent.height;
                    dragged(delta) => { root.drag-boundary(2, delta); }
                }
                // One on the left edge of each optional column shown.
                if root.show-type: ColumnGrip {
                    x: root.type-x - self.width / 2;
                    height: parent.height;
                    dragged(delta) => { root.drag-boundary(4, delta); }
                }
                if root.show-ext: ColumnGrip {
                    x: root.ext-x - self.width / 2;
                    height: parent.height;
                    dragged(delta) => { root.drag-boundary(5, delta); }
                }
                if root.show-created: ColumnGrip {
                    x: root.created-x - self.width / 2;
                    height: parent.height;
                    dragged(delta) => { root.drag-boundary(6, delta); }
                }
                if root.show-accessed: ColumnGrip {
                    x: root.accessed-x - self.width / 2;
                    height: parent.height;
                    dragged(delta) => { root.drag-boundary(7, delta); }
                }
                if root.show-attrs: ColumnGrip {
                    x: root.attr-x - self.width / 2;
                    height: parent.height;
                    dragged(delta) => { root.drag-boundary(8, delta); }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }

            // Results
            keys := FocusScope {
                vertical-stretch: 1;
                // Shift extends the selection, Ctrl moves the cursor alone.
                property <int> move-mode: 0;
                key-pressed(event) => {
                    if (root.dispatch(2, event)) {
                        return accept;
                    }
                    // Movement and Esc are fixed; every other key is a command.
                    self.move-mode = event.modifiers.shift ? 2 : event.modifiers.control ? -1 : 0;
                    if (event.modifiers.alt || event.modifiers.meta) {
                        return reject;
                    }
                    if (event.text == Key.DownArrow) { root.move-to(root.current + 1, self.move-mode); return accept; }
                    if (event.text == Key.UpArrow) {
                        if (root.current <= 0 && !event.modifiers.shift) { search.focus-and-select(); } else { root.move-to(root.current - 1, self.move-mode); }
                        return accept;
                    }
                    if (event.text == Key.PageDown) { root.move-to(root.current + root.page, self.move-mode); return accept; }
                    if (event.text == Key.PageUp) { root.move-to(root.current - root.page, self.move-mode); return accept; }
                    if (event.text == Key.Home) { root.move-to(0, self.move-mode); return accept; }
                    if (event.text == Key.End) { root.move-to(root.results.length - 1, self.move-mode); return accept; }
                    // Esc clears the selection first, then goes back to the search.
                    if (event.text == Key.Escape) {
                        if (!root.clear-selection()) { search.focus-and-select(); }
                        return accept;
                    }
                    reject
                }

                menu-area := ContextMenuArea {
                    enabled: root.current >= 0;
                    Menu {
                        MenuItem {
                            title: @tr("Open");
                            enabled: root.can-run(Command.open);
                            activated => { root.run(Command.open); }
                        }
                        MenuItem {
                            title: @tr("Open with…");
                            enabled: root.can-run(Command.open-with);
                            activated => { root.run(Command.open-with); }
                        }
                        MenuItem {
                            title: @tr("Open containing folder");
                            enabled: root.can-run(Command.open-folder);
                            activated => { root.run(Command.open-folder); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Cut");
                            enabled: root.can-run(Command.cut);
                            activated => { root.run(Command.cut); }
                        }
                        MenuItem {
                            title: @tr("Copy");
                            enabled: root.can-run(Command.copy);
                            activated => { root.run(Command.copy); }
                        }
                        MenuItem {
                            title: @tr("Paste into folder");
                            enabled: root.can-run(Command.paste);
                            activated => { root.run(Command.paste); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Copy name");
                            enabled: root.can-run(Command.copy-name);
                            activated => { root.run(Command.copy-name); }
                        }
                        MenuItem {
                            title: @tr("Copy path");
                            enabled: root.can-run(Command.copy-path);
                            activated => { root.run(Command.copy-path); }
                        }
                        MenuItem {
                            title: @tr("Copy full path");
                            enabled: root.can-run(Command.copy-full-path);
                            activated => { root.run(Command.copy-full-path); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Rename");
                            enabled: root.can-run(Command.rename);
                            activated => { root.run(Command.rename); }
                        }
                        MenuItem {
                            title: @tr("Move to trash");
                            enabled: root.can-run(Command.trash);
                            activated => { root.run(Command.trash); }
                        }
                        MenuItem {
                            title: @tr("Delete permanently…");
                            enabled: root.can-run(Command.delete-permanently);
                            activated => { root.run(Command.delete-permanently); }
                        }
                    }

                list := ListView {
                    for row[i] in root.results: Row {
                        data: row;
                        current: i == root.current && keys.has-focus;
                        name-width: root.name-width;
                        folder-width: root.folder-width;
                        size-width: root.size-width;
                        date-width: root.date-width;
                        type-width: root.type-width;
                        ext-width: root.ext-width;
                        created-width: root.created-width;
                        accessed-width: root.accessed-width;
                        attr-width: root.attr-width;
                        pressed(mods) => {
                            root.current = i;
                            keys.focus();
                            root.select(i, mods.shift ? 2 : mods.control ? 1 : 0);
                        }
                        right-pressed(x, y) => {
                            root.current = i;
                            keys.focus();
                            if (!root.is-selected(i)) { root.select(i, 0); }
                            menu-area.show({ x: x, y: i * Theme.row-height + list.content-y + y });
                        }
                        double-clicked => { root.activate(i); }
                        editing: i == root.rename-row;
                        edit-text <=> root.rename-text;
                        edit-stem: root.rename-stem;
                        edit-commit(text) => { root.rename-commit(text); }
                        edit-cancel => { root.rename-cancel(); }
                    }
                }
                }

                Text {
                    visible: root.message != "";
                    text: root.message;
                    color: Theme.text-muted;
                    font-size: Theme.body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Status line
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle {
                height: Theme.status-height;
                background: Theme.surface-alt;
                HorizontalLayout {
                    padding-left: Theme.s3;
                    padding-right: Theme.s3;
                    spacing: Theme.s4;
                    Text {
                        text: root.status-count;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        min-width: self.preferred-width;
                        horizontal-stretch: 0;
                    }
                    // Details of the selection: the part that shrinks (elided)
                    // first when the line runs out of room.
                    if root.status-detail != "": Text {
                        text: root.status-detail;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.status-index;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 0;
                    }
                    // Takes the room left, so what follows sits at the right end.
                    Rectangle {
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                    // The long operation running, and its Cancel button.
                    if root.progress-text != "": Text {
                        text: root.progress-text;
                        font-size: Theme.small;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if root.can-cancel: VerticalLayout {
                        alignment: center;
                        StatusButton {
                            text: @tr("Cancel");
                            clicked => { root.cancel-task(); }
                        }
                    }
                    // Matching modes that are on.
                    HorizontalLayout {
                        spacing: Theme.s1;
                        alignment: start;
                        for badge in root.badges: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: Theme.badge-height;
                                width: badge-text.preferred-width + 2 * Theme.s1 + 2px;
                                border-radius: 4px;
                                background: Theme.selection;
                                badge-text := Text {
                                    text: badge;
                                    font-size: Theme.small - 1px;
                                    color: Theme.selection-text;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                    // Shown in full up to a width that leaves room for the rest
                    // of the line even in a narrow window.
                    Text {
                        text: root.notice;
                        font-size: Theme.small;
                        color: root.notice-error ? Theme.danger : Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                        min-width: min(self.preferred-width, 360px);
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: root.status-right;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    // The window's top left corner below the menu bar: the tip is placed
    // from absolute positions.
    origin := Rectangle {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
    }

    // Tip of the matching-mode toggle under the mouse.
    if search.hover-tip != "": Rectangle {
        x: min(search.hover-x - origin.absolute-position.x, root.width - self.width - Theme.s2);
        y: search.hover-bottom - origin.absolute-position.y + Theme.s1;
        width: tip-text.preferred-width + 2 * Theme.s2;
        height: tip-text.preferred-height + 2 * Theme.s1;
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000030;
        tip-text := Text {
            text: search.hover-tip;
            font-size: Theme.small;
            color: Theme.text;
        }
    }

    // Hidden text field used by copy-text() and paste-text().
    clip := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        single-line: false;
        read-only: true;
        enabled: false;
    }

    // Confirmation dialog, above all other content. The backdrop takes all
    // clicks so the window behind cannot be used meanwhile.
    if root.confirm-open: Rectangle {
        background: #00000060;
        TouchArea { }
        dialog-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.confirm-cancelled(); return accept; }
                if (event.text == Key.Return) { root.confirm-accepted(); return accept; }
                accept
            }
        }
        Rectangle {
            width: min(420px, root.width - 2 * Theme.s5);
            height: dialog-layout.preferred-height;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            dialog-layout := VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s3;
                Text {
                    text: root.confirm-title;
                    font-size: Theme.body + 2px;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-text;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.s2;
                    padding-top: Theme.s2;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.confirm-cancelled(); }
                    }
                    Button {
                        text: root.confirm-action;
                        primary: true;
                        clicked => { root.confirm-accepted(); }
                    }
                }
            }
        }
    }

    if root.shortcuts-open: InfoDialog {
        title: @tr("Keyboard shortcuts");
        card-width: 520px;
        close => {
            root.shortcuts-open = false;
            search.focus-and-select();
        }
        ListView {
            // Grows with the rows up to what the window leaves.
            preferred-height: root.shortcuts.length * 24px;
            min-height: 120px;
            for row in root.shortcuts: HorizontalLayout {
                height: 24px;
                spacing: Theme.s3;
                Text {
                    width: 200px;
                    text: row.keys;
                    color: Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.action;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    if root.about-open: InfoDialog {
        title: @tr("About EveryGrep");
        close => {
            root.about-open = false;
            search.focus-and-select();
        }
        HorizontalLayout {
            spacing: Theme.s3;
            Image {
                source: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "EveryGrep";
                    font-size: Theme.body + 4px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: @tr("Version {}", root.version);
                    color: Theme.text-muted;
                }
            }
        }
        Text {
            text: @tr("Finds files and folders by name as you type.");
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: @tr("Licensed under the MIT license or the Apache License 2.0, at your option.");
            font-size: Theme.small;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        // The toolkit's attribution, required by its royalty-free license.
        HorizontalLayout {
            alignment: center;
            AboutSlint { }
        }
    }

    // The menu bar. It is drawn inside the window (GNOME has no global menu
    // bar). Its keys are matched before the focused control sees them, so
    // it only shows global keys that edit no text and that no control binds
    // otherwise (see menu-keys); Ctrl+C, Delete or F2 keep their meaning in
    // the search field.
    if root.show-menu-bar: MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New window");
                shortcut: root.menu-keys.new-window;
                enabled: root.can-run(Command.new-window);
                activated => { root.run(Command.new-window); }
            }
            MenuItem {
                title: @tr("Close window");
                shortcut: root.menu-keys.close-window;
                enabled: root.can-run(Command.close-window);
                activated => { root.run(Command.close-window); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Export results…");
                shortcut: root.menu-keys.export-results;
                enabled: root.can-run(Command.export-results);
                activated => { root.run(Command.export-results); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Quit");
                shortcut: root.menu-keys.quit;
                enabled: root.can-run(Command.quit);
                activated => { root.run(Command.quit); }
            }
        }
        Menu {
            title: @tr("Edit");
            MenuItem {
                title: @tr("Cut");
                shortcut: root.menu-keys.cut;
                enabled: root.can-run(Command.cut);
                activated => { root.run(Command.cut); }
            }
            MenuItem {
                title: @tr("Copy");
                shortcut: root.menu-keys.copy;
                enabled: root.can-run(Command.copy);
                activated => { root.run(Command.copy); }
            }
            MenuItem {
                title: @tr("Paste into folder");
                shortcut: root.menu-keys.paste;
                enabled: root.can-run(Command.paste);
                activated => { root.run(Command.paste); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Copy name");
                shortcut: root.menu-keys.copy-name;
                enabled: root.can-run(Command.copy-name);
                activated => { root.run(Command.copy-name); }
            }
            MenuItem {
                title: @tr("Copy path");
                shortcut: root.menu-keys.copy-path;
                enabled: root.can-run(Command.copy-path);
                activated => { root.run(Command.copy-path); }
            }
            MenuItem {
                title: @tr("Copy full path");
                shortcut: root.menu-keys.copy-full-path;
                enabled: root.can-run(Command.copy-full-path);
                activated => { root.run(Command.copy-full-path); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Select all");
                shortcut: root.menu-keys.select-all;
                enabled: root.can-run(Command.select-all);
                activated => { root.run(Command.select-all); }
            }
            MenuItem {
                title: @tr("Invert selection");
                shortcut: root.menu-keys.invert-selection;
                enabled: root.can-run(Command.invert-selection);
                activated => { root.run(Command.invert-selection); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Rename");
                shortcut: root.menu-keys.rename;
                enabled: root.can-run(Command.rename);
                activated => { root.run(Command.rename); }
            }
            MenuItem {
                title: @tr("Move to trash");
                shortcut: root.menu-keys.trash;
                enabled: root.can-run(Command.trash);
                activated => { root.run(Command.trash); }
            }
            MenuItem {
                title: @tr("Delete permanently…");
                shortcut: root.menu-keys.delete-permanently;
                enabled: root.can-run(Command.delete-permanently);
                activated => { root.run(Command.delete-permanently); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Focus the search field");
                shortcut: root.menu-keys.focus-search;
                enabled: root.can-run(Command.focus-search);
                activated => { root.run(Command.focus-search); }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Type column");
                shortcut: root.menu-keys.type-column;
                checkable: true;
                checked <=> root.show-type;
                activated => { root.toggled(Command.type-column); }
            }
            MenuItem {
                title: @tr("Extension column");
                shortcut: root.menu-keys.extension-column;
                checkable: true;
                checked <=> root.show-ext;
                activated => { root.toggled(Command.extension-column); }
            }
            MenuItem {
                title: @tr("Created column");
                shortcut: root.menu-keys.created-column;
                checkable: true;
                checked <=> root.show-created;
                activated => { root.toggled(Command.created-column); }
            }
            MenuItem {
                title: @tr("Accessed column");
                shortcut: root.menu-keys.accessed-column;
                checkable: true;
                checked <=> root.show-accessed;
                activated => { root.toggled(Command.accessed-column); }
            }
            MenuItem {
                title: @tr("Attributes column");
                shortcut: root.menu-keys.attributes-column;
                checkable: true;
                checked <=> root.show-attrs;
                activated => { root.toggled(Command.attributes-column); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Sort by");
                for item in root.sort-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    enabled: item.enabled && !root.confirm-open;
                    activated => { root.sort-to(item.column, root.sort-descending); }
                }
                MenuSeparator { }
                for item[i] in root.sort-order-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    enabled: !root.confirm-open;
                    activated => { root.sort-to(root.sort-column, i == 1); }
                }
            }
            Menu {
                title: @tr("Folder size");
                for item[i] in root.folder-size-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-folder-size(i); }
                }
            }
            Menu {
                title: @tr("Density");
                for item[i] in root.density-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-density(i); }
                }
            }
            Menu {
                title: @tr("Theme");
                for item[i] in root.theme-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-theme(i); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Selection details");
                shortcut: root.menu-keys.selection-details;
                checkable: true;
                checked <=> root.status-details;
                activated => { root.toggled(Command.selection-details); }
            }
            MenuItem {
                title: @tr("Menu bar");
                shortcut: root.menu-keys.menu-bar;
                checkable: true;
                checked <=> root.show-menu-bar;
                activated => { root.toggled(Command.menu-bar); }
            }
        }
        Menu {
            title: @tr("Search");
            MenuItem {
                title: @tr("Match case");
                shortcut: root.menu-keys.match-case;
                checkable: true;
                checked <=> root.match-case;
                activated => { root.toggled(Command.match-case); }
            }
            MenuItem {
                title: @tr("Match whole words");
                shortcut: root.menu-keys.whole-words;
                checkable: true;
                checked <=> root.whole-words;
                activated => { root.toggled(Command.whole-words); }
            }
            MenuItem {
                title: @tr("Match the full path");
                shortcut: root.menu-keys.match-path;
                checkable: true;
                checked <=> root.match-path;
                activated => { root.toggled(Command.match-path); }
            }
            MenuItem {
                title: @tr("Match diacritics");
                shortcut: root.menu-keys.match-diacritics;
                checkable: true;
                checked <=> root.match-diacritics;
                activated => { root.toggled(Command.match-diacritics); }
            }
            MenuItem {
                title: @tr("Regular expression");
                shortcut: root.menu-keys.regex;
                checkable: true;
                checked <=> root.use-regex;
                activated => { root.toggled(Command.regex); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Match prefix");
                shortcut: root.menu-keys.match-prefix;
                checkable: true;
                checked <=> root.match-prefix;
                activated => { root.toggled(Command.match-prefix); }
            }
            MenuItem {
                title: @tr("Match suffix");
                shortcut: root.menu-keys.match-suffix;
                checkable: true;
                checked <=> root.match-suffix;
                activated => { root.toggled(Command.match-suffix); }
            }
            MenuItem {
                title: @tr("Ignore punctuation");
                shortcut: root.menu-keys.ignore-punctuation;
                checkable: true;
                checked <=> root.ignore-punctuation;
                activated => { root.toggled(Command.ignore-punctuation); }
            }
            MenuItem {
                title: @tr("Ignore whitespace");
                shortcut: root.menu-keys.ignore-whitespace;
                checkable: true;
                checked <=> root.ignore-whitespace;
                activated => { root.toggled(Command.ignore-whitespace); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Filter");
                for item[i] in root.filter-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => {
                        root.filter-index = i;
                        root.options-edited();
                    }
                }
            }
            MenuItem {
                title: @tr("Previous filter");
                shortcut: root.menu-keys.previous-filter;
                enabled: root.can-run(Command.previous-filter);
                activated => { root.run(Command.previous-filter); }
            }
            MenuItem {
                title: @tr("Next filter");
                shortcut: root.menu-keys.next-filter;
                enabled: root.can-run(Command.next-filter);
                activated => { root.run(Command.next-filter); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Previous search");
                shortcut: root.menu-keys.previous-search;
                enabled: root.can-run(Command.previous-search);
                activated => { root.run(Command.previous-search); }
            }
            MenuItem {
                title: @tr("Next search");
                shortcut: root.menu-keys.next-search;
                enabled: root.can-run(Command.next-search);
                activated => { root.run(Command.next-search); }
            }
        }
        Menu {
            title: @tr("Tools");
            MenuItem {
                title: @tr("Settings…");
                shortcut: root.menu-keys.settings;
                enabled: root.can-run(Command.settings);
                activated => { root.run(Command.settings); }
            }
            MenuItem {
                title: @tr("Customize shortcuts…");
                shortcut: root.menu-keys.keyboard-settings;
                enabled: root.can-run(Command.keyboard-settings);
                activated => { root.run(Command.keyboard-settings); }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Keyboard shortcuts");
                shortcut: root.menu-keys.shortcuts-help;
                enabled: root.can-run(Command.shortcuts-help);
                activated => { root.run(Command.shortcuts-help); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("About EveryGrep");
                shortcut: root.menu-keys.about;
                enabled: root.can-run(Command.about);
                activated => { root.run(Command.about); }
            }
        }
    }

    init => { search.focus-and-select(); }
}
