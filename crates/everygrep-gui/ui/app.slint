                                dragged(d) => { root.drag-boundary(26, d); }
                                fit => { root.fit-column(root.left-of(26)); }
                            }
                            if root.show-desc-folders: ColumnGrip {
                                x: root.desc-folders-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(27, d); }
                                fit => { root.fit-column(root.left-of(27)); }
                            }
                            if root.show-folder-depth: ColumnGrip {
                                x: root.folder-depth-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(28, d); }
                                fit => { root.fit-column(root.left-of(28)); }
                            }
                            if root.show-hard-links: ColumnGrip {
                                x: root.hard-links-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(29, d); }
                                fit => { root.fit-column(root.left-of(29)); }
                            }
                            if root.show-shortcut-target: ColumnGrip {
                                x: root.shortcut-target-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(30, d); }
                                fit => { root.fit-column(root.left-of(30)); }
                            }
                            if root.show-owner: ColumnGrip {
                                x: root.owner-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(31, d); }
                                fit => { root.fit-column(root.left-of(31)); }
                            }
                            if root.show-width: ColumnGrip {
                                x: root.width-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(32, d); }
                                fit => { root.fit-column(root.left-of(32)); }
                            }
                            if root.show-height: ColumnGrip {
                                x: root.height-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(33, d); }
                                fit => { root.fit-column(root.left-of(33)); }
                            }
                            if root.show-dimensions: ColumnGrip {
                                x: root.dimensions-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(34, d); }
                                fit => { root.fit-column(root.left-of(34)); }
                            }
                            if root.show-length: ColumnGrip {
                                x: root.length-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(35, d); }
                                fit => { root.fit-column(root.left-of(35)); }
                            }
                            if root.show-bit-rate: ColumnGrip {
                                x: root.bit-rate-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(36, d); }
                                fit => { root.fit-column(root.left-of(36)); }
                            }
                            if root.show-title: ColumnGrip {
                                x: root.title-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(37, d); }
                                fit => { root.fit-column(root.left-of(37)); }
                            }
                            if root.show-artist: ColumnGrip {
                                x: root.artist-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(38, d); }
                                fit => { root.fit-column(root.left-of(38)); }
                            }
                            if root.show-album: ColumnGrip {
                                x: root.album-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(39, d); }
                                fit => { root.fit-column(root.left-of(39)); }
                            }
                            if root.show-year: ColumnGrip {
                                x: root.year-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(40, d); }
                                fit => { root.fit-column(root.left-of(40)); }
                            }
                            if root.show-track: ColumnGrip {
                                x: root.track-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(41, d); }
                                fit => { root.fit-column(root.left-of(41)); }
                            }
                            if root.show-genre: ColumnGrip {
                                x: root.genre-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(42, d); }
                                fit => { root.fit-column(root.left-of(42)); }
                            }
                            if root.show-rating: ColumnGrip {
                                x: root.rating-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(43, d); }
                                fit => { root.fit-column(root.left-of(43)); }
                            }
                            if root.show-tags: ColumnGrip {
                                x: root.tags-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(44, d); }
                                fit => { root.fit-column(root.left-of(44)); }
                            }
                            if root.show-page-count: ColumnGrip {
                                x: root.page-count-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(45, d); }
                                fit => { root.fit-column(root.left-of(45)); }
                            }
                            if root.show-word-count: ColumnGrip {
                                x: root.word-count-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(46, d); }
                                fit => { root.fit-column(root.left-of(46)); }
                            }
                            if root.show-camera-maker: ColumnGrip {
                                x: root.camera-maker-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(47, d); }
                                fit => { root.fit-column(root.left-of(47)); }
                            }
                            if root.show-camera-model: ColumnGrip {
                                x: root.camera-model-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(48, d); }
                                fit => { root.fit-column(root.left-of(48)); }
                            }
                            if root.show-date-taken: ColumnGrip {
                                x: root.date-taken-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(49, d); }
                                fit => { root.fit-column(root.left-of(49)); }
                            }
                            if root.show-gps-lat: ColumnGrip {
                                x: root.gps-lat-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(50, d); }
                                fit => { root.fit-column(root.left-of(50)); }
                            }
                            if root.show-gps-long: ColumnGrip {
                                x: root.gps-long-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(51, d); }
                                fit => { root.fit-column(root.left-of(51)); }
                            }
                            if root.show-sha1: ColumnGrip {
                                x: root.sha1-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(52, d); }
                                fit => { root.fit-column(root.left-of(52)); }
                            }
                            if root.show-sha384: ColumnGrip {
                                x: root.sha384-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(53, d); }
                                fit => { root.fit-column(root.left-of(53)); }
                            }
                            if root.show-sha512: ColumnGrip {
                                x: root.sha512-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(54, d); }
                                fit => { root.fit-column(root.left-of(54)); }
                            }
                            if root.show-xxhash: ColumnGrip {
                                x: root.xxhash-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(55, d); }
                                fit => { root.fit-column(root.left-of(55)); }
                            }
                            if root.show-dupe-group: ColumnGrip {
                                x: root.dupe-group-x - self.width / 2; height: parent.height;
                                dragged(d) => { root.drag-boundary(56, d); }
                                fit => { root.fit-column(root.left-of(56)); }
                            }
                            // The right edge of the last column: dragged to the right, the
                            // columns get wider than the window.
                            ColumnGrip {
                                x: root.table-width - self.width;
                                height: parent.height;
                                dragged(delta) => { root.drag-boundary(99, delta); }
                                fit => { root.fit-column(root.last-shown()); }
                            }
                        }
                        // Measures the texts of fit-width(); never drawn.
                        Rectangle {
                            width: 0px;
                            height: 0px;
                            clip: true;
                            fit-a-probe := Text { text: root.fit-a; font-size: Theme.list-text; }
                            fit-b-probe := Text { text: root.fit-b; font-size: Theme.list-text; }
                            fit-c-probe := Text { text: root.fit-c; font-size: Theme.list-text; }
                            fit-label-probe := Text { text: root.fit-label; font-size: Theme.small; font-weight: 600; }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.line; }

                    // Results
                    keys := FocusScope {
                        vertical-stretch: 1;
                        // Shift extends the selection, Ctrl moves the cursor alone.
                        property <int> move-mode: 0;
                        focus-lost(reason) => { root.jump-reset(); }
                        key-pressed(event) => {
                            if (root.dispatch(2, event)) {
                                root.jump-reset();
                                return accept;
                            }
                            // Movement and Esc are fixed; every other key is a command.
                            self.move-mode = event.modifiers.shift ? 2 : event.modifiers.control ? -1 : 0;
                            if (event.modifiers.alt || event.modifiers.meta) {
                                root.jump-reset();
                                return reject;
                            }
                            // Moving the cursor forgets the letters typed to jump.
                            if (event.text == Key.DownArrow) { root.jump-reset(); root.move-to(root.current + 1, self.move-mode); return accept; }
                            if (event.text == Key.UpArrow) {
                                root.jump-reset();
                                if (root.current <= 0 && !event.modifiers.shift) { search.focus-and-select(); } else { root.move-to(root.current - 1, self.move-mode); }
                                return accept;
                            }
                            if (event.text == Key.PageDown) { root.jump-reset(); root.move-to(root.current + root.page, self.move-mode); return accept; }
                            if (event.text == Key.PageUp) { root.jump-reset(); root.move-to(root.current - root.page, self.move-mode); return accept; }
                            if (event.text == Key.Home) { root.jump-reset(); root.move-to(0, self.move-mode); return accept; }
                            if (event.text == Key.End) { root.jump-reset(); root.move-to(root.results.length - 1, self.move-mode); return accept; }
                            // Left and Right scroll a table wider than the
                            // list sideways, Ctrl to its edge.
                            if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                                root.jump-reset();
                                let step = event.modifiers.control ? root.scroll-room : root.sideways-step;
                                root.results-scroll-x = event.text == Key.LeftArrow
                                    ? min(0px, root.results-scroll-x + step)
                                    : max(-root.scroll-room, root.results-scroll-x - step);
                                return accept;
                            }
                            // Esc clears the selection first, then goes back to the search.
                            if (event.text == Key.Escape) {
                                root.jump-reset();
                                if (!root.clear-selection()) { search.focus-and-select(); }
                                return accept;
                            }
                            if (!event.modifiers.control) {
                                let jump = root.jump-typed(event.text);
                                if (jump >= 0) { root.place-cursor(jump, 0); }
                                if (jump != -1) { return accept; }
                            }
                            // Not a jump key: a shortcut of the window may take it.
                            root.jump-reset();
                            reject
                        }

                        menu-area := ContextMenuArea {
                            // Opened only by `show` (row right-click, menu key), which
                            // first freezes the row's values for the menu items; on
                            // its own it would open with the values of an older menu.
                            enabled: false;
                            // The most used actions stay at the top level; the
                            // search and copy variants are grouped so that the
                            // menu fits a laptop screen (popups cannot scroll).
                            Menu {
                                if root.hash-value != "": MenuItem {
                                    title: @tr("Copy hash value");
                                    activated => { root.copy-text(root.hash-value); }
                                }
                                if root.value-available: MenuItem {
                                    title: root.value-column == 3 || root.value-column == 6 || root.value-column == 7 ? @tr("Search this day") : @tr("Search this value");
                                    enabled: root.can-run(Command.search-property-value);
                                    activated => { root.run(Command.search-property-value); }
                                }
                                MenuItem {
                                    title: @tr("Open");
                                    enabled: root.can-run(Command.open);
                                    activated => { root.run(Command.open); }
                                }
                                MenuItem { title: @tr("Properties"); enabled: root.can-run(Command.properties); activated => { root.run(Command.properties); } }
                                MenuItem { title: @tr("Load file details"); enabled: root.can-run(Command.read-extended); activated => { root.run(Command.read-extended); } }
                                MenuItem {
                                    title: @tr("Open with…");
                                    enabled: root.can-run(Command.open-with);
                                    activated => { root.run(Command.open-with); }
                                }
                                MenuItem {
                                    title: @tr("Open containing folder");
                                    enabled: root.can-run(Command.open-folder);
                                    activated => { root.run(Command.open-folder); }
                                }
                                MenuSeparator { }
                                Menu {
                                    title: @tr("Search");
                                    MenuItem {
                                        title: @tr("Search for this name");
                                        enabled: root.can-run(Command.search-filename);
                                        activated => { root.fileops-search-filename(-1, false, false); }
                                    }
                                    MenuItem {
                                        title: @tr("Search for this exact name");
                                        enabled: root.can-run(Command.search-exact-name);
                                        activated => { root.fileops-search-filename(-1, true, false); }
                                    }
                                    MenuItem {
                                        title: @tr("Search name without extension");
                                        enabled: root.can-run(Command.search-stem);
                                        activated => { root.fileops-search-filename(-1, false, true); }
                                    }
                                    MenuItem {
                                        title: @tr("Search whole name without extension");
                                        enabled: root.can-run(Command.search-whole-stem);
                                        activated => { root.fileops-search-filename(-1, true, true); }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: @tr("Search in EveryGrep");
                                        enabled: root.can-run(Command.search-in-program);
                                        activated => { root.run(Command.search-in-program); }
                                    }
                                    MenuItem {
                                        title: @tr("Search path in EveryGrep");
                                        enabled: root.can-run(Command.search-containing-folder);
                                        activated => { root.run(Command.search-containing-folder); }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Cut");
                                    enabled: root.can-run(Command.cut);
                                    activated => { root.run(Command.cut); }
                                }
                                MenuItem {
                                    title: @tr("Copy");
                                    enabled: root.can-run(Command.copy);
                                    activated => { root.run(Command.copy); }
                                }
                                MenuItem {
                                    title: @tr("Paste into folder");
                                    enabled: root.can-run(Command.paste);
                                    activated => { root.run(Command.paste); }
                                }
                                Menu {
                                    title: @tr("Copy or move to");
                                    MenuItem {
                                        title: @tr("Copy to folder…");
                                        enabled: root.can-run(Command.copy-to-folder);
                                        activated => { root.run(Command.copy-to-folder); }
                                    }
                                    MenuItem {
                                        title: @tr("Move to folder…");
                                        enabled: root.can-run(Command.move-to-folder);
                                        activated => { root.run(Command.move-to-folder); }
                                    }
                                }
                                MenuItem {
                                    title: @tr("Copy full path");
                                    enabled: root.can-run(Command.copy-full-path);
                                    activated => { root.run(Command.copy-full-path); }
                                }
                                Menu {
                                    title: @tr("Copy name or path");
                                    MenuItem {
                                        title: @tr("Copy name");
                                        enabled: root.can-run(Command.copy-name);
                                        activated => { root.run(Command.copy-name); }
                                    }
                                    MenuItem {
                                        title: @tr("Copy path");
                                        enabled: root.can-run(Command.copy-path);
                                        activated => { root.run(Command.copy-path); }
                                    }
                                    MenuItem {
                                        title: @tr("Copy path with quotes");
                                        enabled: root.can-run(Command.copy-path-quoted);
                                        activated => { root.run(Command.copy-path-quoted); }
                                    }
                                    MenuItem {
                                        title: @tr("Copy full path with quotes");
                                        enabled: root.can-run(Command.copy-full-path-quoted);
                                        activated => { root.run(Command.copy-full-path-quoted); }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        title: @tr("Copy “{}”", root.col-label(root.copy-column));
                                        enabled: root.can-run(Command.copy-column-value);
                                        activated => { root.run(Command.copy-column-value); }
                                    }
                                    MenuItem {
                                        title: @tr("Copy all properties (TSV)");
                                        enabled: root.can-run(Command.copy-properties);
                                        activated => { root.run(Command.copy-properties); }
                                    }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Rename");
                                    enabled: root.can-run(Command.rename);
                                    activated => { root.run(Command.rename); }
                                }
                                MenuItem {
                                    title: @tr("Rename several items…");
                                    enabled: root.can-run(Command.bulk-rename);
                                    activated => { root.run(Command.bulk-rename); }
                                }
                                if root.results[root.current].group > 0: MenuItem {
                                    title: @tr("Clean up duplicates…");
                                    enabled: root.can-run(Command.clean-duplicates);
                                    activated => { root.run(Command.clean-duplicates); }
                                }
                                MenuItem {
                                    title: @tr("Create shortcuts…");
                                    enabled: root.can-run(Command.create-shortcut);
                                    activated => { root.run(Command.create-shortcut); }
                                }
                                MenuItem {
                                    title: @tr("New folder…");
                                    enabled: root.can-run(Command.new-folder);
                                    activated => { root.run(Command.new-folder); }
                                }
                                MenuItem {
                                    title: @tr("Move to trash");
                                    enabled: root.can-run(Command.trash);
                                    activated => { root.run(Command.trash); }
                                }
                                MenuItem {
                                    title: @tr("Delete permanently…");
                                    enabled: root.can-run(Command.delete-permanently);
                                    activated => { root.run(Command.delete-permanently); }
                                }
                            }

                        // Asked after a drop when the setting says so.
                        drop-menu := ContextMenuArea {
                            enabled: false;
                            Menu {
                                MenuItem { title: @tr("Copy here"); activated => { root.drop-answer(1); } }
                                MenuItem { title: @tr("Move here"); activated => { root.drop-answer(2); } }
                                MenuSeparator { }
                                MenuItem { title: @tr("Cancel"); activated => { root.drop-answer(0); } }
                            }
                        }

                        // The menu of the empty area below the rows.
                        blank-menu := ContextMenuArea {
                            enabled: false;
                            Menu {
                                MenuItem {
                                    title: @tr("Select all");
                                    enabled: root.can-run(Command.select-all);
                                    activated => { root.run(Command.select-all); }
                                }
                                MenuItem {
                                    title: @tr("Invert selection");
                                    enabled: root.can-run(Command.invert-selection);
                                    activated => { root.run(Command.invert-selection); }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Export results…");
                                    enabled: root.can-run(Command.export-results);
                                    activated => { root.run(Command.export-results); }
                                }
                                MenuItem {
                                    title: @tr("Refresh");
                                    activated => { root.run(Command.refresh); }
                                }
                                MenuSeparator { }
                                MenuItem {
                                    title: @tr("Organize columns…");
                                    activated => { root.run(Command.organize-columns); }
                                }
                                MenuItem {
                                    title: @tr("Fit columns to window");
                                    activated => { root.run(Command.fit-columns-to-window); }
                                }
                            }
                        }
                        // Behind the list: it gets the right-clicks no row
                        // takes, those on the empty area below the rows.
                        TouchArea {
                            pointer-event(event) => {
                                if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                    root.jump-reset();
                                    keys.focus();
                                    blank-menu.show({ x: self.mouse-x, y: self.mouse-y });
                                }
                            }
                        }

                        list := ListView {
                            // Wider than the window when the columns do not fit.
                            content-width: root.table-width;
                            for row[i] in root.results: Row {
                                width: root.table-width;
                                data: row;
                                current: i == root.current && keys.has-focus;
                                // Groups of duplicates are shaded in turn
                                // instead of single rows.
                                alternate: root.alternate-rows && (row.group > 0 ? Math.mod(row.group, 2) == 0 : Math.mod(i, 2) == 1);
                                name-width: root.name-width;
                                folder-width: root.folder-width;
                                size-width: root.size-width;
                                date-width: root.date-width;
                                type-width: root.type-width;
                                ext-width: root.ext-width;
                                created-width: root.created-width;
                                accessed-width: root.accessed-width;
                                attr-width: root.attr-width;
                                md5-width: root.md5-width;
                                sha256-width: root.sha256-width;
                                crc32-width: root.crc32-width;
                                name-freq-width: root.name-freq-width;
                                ext-freq-width: root.ext-freq-width;
                                size-freq-width: root.size-freq-width;
                                full-path-width: root.full-path-width;
                                parent-path-width: root.parent-path-width;
                                stem-width: root.stem-width;
                                name-length-width: root.name-length-width;
                                path-length-width: root.path-length-width;
                                disk-size-width: root.disk-size-width;
                                total-size-width: root.total-size-width;
                                child-count-width: root.child-count-width;
                                child-files-width: root.child-files-width;
                                child-folders-width: root.child-folders-width;
                                desc-count-width: root.desc-count-width;
                                desc-files-width: root.desc-files-width;
                                desc-folders-width: root.desc-folders-width;
                                folder-depth-width: root.folder-depth-width;
                                hard-links-width: root.hard-links-width;
                                shortcut-target-width: root.shortcut-target-width;
                                owner-width: root.owner-width;
                                width-width: root.width-width;
                                height-width: root.height-width;
                                dimensions-width: root.dimensions-width;
                                length-width: root.length-width;
                                bit-rate-width: root.bit-rate-width;
                                title-width: root.title-width;
                                artist-width: root.artist-width;
                                album-width: root.album-width;
                                year-width: root.year-width;
                                track-width: root.track-width;
                                genre-width: root.genre-width;
                                rating-width: root.rating-width;
                                tags-width: root.tags-width;
                                page-count-width: root.page-count-width;
                                word-count-width: root.word-count-width;
                                camera-maker-width: root.camera-maker-width;
                                camera-model-width: root.camera-model-width;
                                date-taken-width: root.date-taken-width;
                                gps-lat-width: root.gps-lat-width;
                                gps-long-width: root.gps-long-width;
                                sha1-width: root.sha1-width;
                                sha384-width: root.sha384-width;
                                sha512-width: root.sha512-width;
                                xxhash-width: root.xxhash-width;
                                dupe-group-width: root.dupe-group-width;
                                pressed(mods) => {
                                    root.jump-reset();
                                    root.current = i;
                                    keys.focus();
                                    root.select(i, mods.shift ? 2 : mods.control ? 1 : 0);
                                }
                                drag-enabled: root.drag-to-folders;
                                drag-data: root.drag-payload;
                                focus-pressed => {
                                    root.jump-reset();
                                    root.current = i;
                                    keys.focus();
                                }
                                drag-started => { root.rows-drag-start(i); }
                                drag-ended => { root.rows-drag-end(); }
                                drop-allowed => { return root.drop-allowed(i); }
                                dropped-here(copy, x, y) => {
                                    if (root.drop-on(i, copy)) {
                                        drop-menu.show({ x: x + list.content-x, y: i * Theme.row-height + list.content-y + y });
                                    }
                                }
                                right-pressed(x, y, column) => {
                                    root.jump-reset();
                                    root.current = i;
                                    root.hash-value = column == 9 ? row.md5 : column == 10 ? row.sha256 : column == 11 ? row.crc32 : column == 52 ? row.sha1 : column == 53 ? row.sha384 : column == 54 ? row.sha512 : column == 55 ? row.xxhash : "";
                                    root.value-column = column;
                                    root.value-available = root.fileops-prepare-value(i, column);
                                    root.copy-column = max(0, root.column-at-x(root.all-col-widths(), x));
                                    keys.focus();
                                    if (!root.is-selected(i)) { root.select(i, 0); }
                                    menu-area.show({ x: x + list.content-x, y: i * Theme.row-height + list.content-y + y });
                                }
                                // In the Folder column it opens the containing
                                // folder, when the setting says so.
                                double-clicked(x) => {
                                    if (root.path-click-opens-folder && x >= root.name-width
                                            && x < root.name-width + root.folder-width) {
                                        root.open-folder(i);
                                    } else {
                                        root.activate(i);
                                    }
                                }
                                editing: i == root.rename-row;
                                edit-text <=> root.rename-text;
                                edit-stem: root.rename-stem;
                                edit-commit(text) => { root.rename-commit(text); }
                                edit-cancel => { root.rename-cancel(); }
                            }
                        }
                        }

                        Rectangle {
                            visible: root.message != "";
                            width: min(message-text.preferred-width, parent.width - 2 * Theme.s3);
                            height: message-text.preferred-height;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            message-text := Text {
                                width: parent.width;
                                text: root.message;
                                color: root.message-error ? Theme.danger : Theme.text-muted;
                                font-size: Theme.body;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                                accessible-description: root.message-details;
                            }
                            message-hover := TouchArea { visible: root.message-error; }
                        }
                    }

                }
                if root.preview-visible: Rectangle {
                    width: 5px; background: Theme.line;
                    TouchArea {
                        mouse-cursor: ew-resize;
                        pointer-event(e) => { if (e.kind == PointerEventKind.up) { root.preview-changed(); } }
                        moved => { if (self.pressed) { root.preview-width = clamp(root.preview-width - (self.mouse-x - self.pressed-x) / 1px, 180, 700); } }
                    }
                }
                preview := PreviewPanel {
                    visible: root.preview-visible;
                    width: root.preview-visible ? root.preview-width * 1px : 0px;
                    min-height: 0px; clip: true;
                    picture: root.preview-image; icon: Icons.types[root.preview-kind];
                    text: root.preview-text; info: root.preview-info;
                    close => { root.run(Command.close-preview-panel); }
                    key(e) => { return root.dispatch(0, e); }
                }
            }
            // Status line
            Rectangle { height: root.show-status-bar ? 1px : 0px; visible: root.show-status-bar; background: Theme.line; }
            Rectangle {
                height: root.show-status-bar ? Theme.status-height : 0px;
                visible: root.show-status-bar;
                background: Theme.surface-alt;
                HorizontalLayout {
                    padding-left: Theme.margin;
                    padding-right: Theme.margin;
                    spacing: Theme.s4;
                    Text {
                        text: root.status-count;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        min-width: self.preferred-width;
                        horizontal-stretch: 0;
                    }
                    // Details of the selection: the part that shrinks (elided)
                    // first when the line runs out of room.
                    if root.status-detail != "": Text {
                        text: root.status-detail;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.status-index;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 0;
                    }
                    // Takes the room left, so what follows sits at the right end.
                    Rectangle {
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                    // The long operation running, and its Cancel button.
                    if root.progress-text != "": Text {
                        text: root.progress-text;
                        font-size: Theme.small;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if root.can-cancel && !root.fileops-conflict-open && !root.export-open: VerticalLayout {
                        alignment: center;
                        StatusButton {
                            text: @tr("Cancel");
                            clicked => { root.cancel-task(); }
                        }
                    }
                    // Matching modes that are on.
                    if root.show-mode-badges: HorizontalLayout {
                        spacing: Theme.s1;
                        alignment: start;
                        for badge in root.badges: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: Theme.badge-height;
                                width: badge-text.preferred-width + 2 * Theme.s1 + 2px;
                                border-radius: 4px;
                                background: Theme.selection;
                                badge-text := Text {
                                    text: badge;
                                    font-size: Theme.small - 1px;
                                    color: Theme.selection-text;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                    // Shown in full up to a width that leaves room for the rest
                    // of the line even in a narrow window.
                    notice-cell := Rectangle {
                        accessible-role: text;
                        accessible-label: root.notice;
                        accessible-description: root.notice-has-details ? root.notice-details : root.notice;
                        min-width: min(notice-text.preferred-width, 360px);
                        horizontal-stretch: 0;
                        notice-text := Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.notice;
                            font-size: Theme.small;
                            color: root.notice-error ? Theme.danger : Theme.text-muted;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                            overflow: elide;
                        }
                        notice-hover := TouchArea { }
                    }
                    if root.zoom-text != "": Text {
                        text: root.zoom-text;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        accessible-label: @tr("Zoom");
                    }
                    Text {
                        text: root.status-right;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    // The window's top left corner below the menu bar: the tip is placed
    // from absolute positions.
    origin := Rectangle {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
    }

    if root.history-open: Rectangle {
        TouchArea { clicked => { root.history-open = false; } }
        Rectangle {
            x: search.absolute-position.x - origin.absolute-position.x;
            y: search.absolute-position.y - origin.absolute-position.y + search.height;
            width: search.width;
            height: min(300px, max(100px, root.height - self.y - Theme.s3));
            background: Theme.surface;
            border-color: Theme.line;
            border-width: 1px;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: Theme.s2;
                spacing: Theme.s1;
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Sort history by"); color: Theme.text; vertical-alignment: center; }
                    ComboBox {
                        accessible-label: @tr("Sort history by");
                        model: [@tr("Last used"), @tr("Times used"), @tr("Search text")];
                        current-index <=> root.history-sort;
                        selected => { root.history-current = -1; root.history-sort-changed(root.history-sort); }
                    }
                }
                if root.history-rows.length == 0: Text {
                    text: @tr("No search history"); color: Theme.text-muted;
                    vertical-alignment: center;
                }
                ListView {
                    content-y: -max(0, root.history-current - 6) * Theme.row-height;
                    for search-text[i] in root.history-rows: Rectangle {
                        height: Theme.row-height;
                        background: root.history-current == i ? Theme.selection : history-touch.has-hover ? Theme.hover : Theme.surface;
                        Text {
                            x: Theme.s2;
                            width: parent.width - 2 * Theme.s2;
                            height: parent.height;
                            text: search-text;
                            color: root.history-current == i ? Theme.selection-text : Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        history-touch := TouchArea { clicked => { root.choose-history(i); } }
                    }
                }
            }
        }
    }

    // With the status line hidden: the running operation, its Cancel
    // button and the last message, in a box at the bottom right while they
    // last. A click on the message hides it until the next one.
    property <string> dismissed-notice;
    property <bool> floating-notice: root.notice != "" && root.notice != root.dismissed-notice;
    property <bool> floating-cancel: root.can-cancel && !root.fileops-conflict-open && !root.export-open;
    if !root.show-status-bar && (root.progress-text != "" || root.floating-cancel || root.floating-notice): Rectangle {
        x: max(Theme.s2, root.width - self.width - Theme.s2);
        y: root.height - self.height - Theme.s2;
        width: min(floating-row.preferred-width, root.width - 2 * Theme.s2);
        height: floating-row.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000030;
        floating-row := HorizontalLayout {
            padding: Theme.s2;
            spacing: Theme.s3;
            if root.progress-text != "": Text {
                text: root.progress-text;
                font-size: Theme.small;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.floating-cancel: VerticalLayout {
                alignment: center;
                StatusButton {
                    text: @tr("Cancel");
                    clicked => { root.cancel-task(); }
                }
            }
            if root.floating-notice: Text {
                text: root.notice;
                font-size: Theme.small;
                color: root.notice-error ? Theme.danger : Theme.text-muted;
                vertical-alignment: center;
                max-width: 480px;
                overflow: elide;
                accessible-role: text;
                accessible-label: root.notice;
                TouchArea { clicked => { root.dismissed-notice = root.notice; } }
            }
        }
    }

    if notice-hover.has-hover && root.notice != "": Rectangle {
        x: max(Theme.s2, root.width - self.width - Theme.s2);
        y: root.height - (root.show-status-bar ? Theme.status-height : 0px) - self.height - Theme.s2;
        width: min(620px, root.width - 2 * Theme.s2);
        height: notice-tip.preferred-height + 2 * Theme.s2;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.line;
        notice-tip := Text {
            x: Theme.s2;
            y: Theme.s2;
            width: parent.width - 2 * Theme.s2;
            text: root.notice-has-details ? root.notice-details : root.notice;
            wrap: word-wrap;
            font-size: Theme.small;
            color: root.notice-error ? Theme.danger : Theme.text;
        }
    }

    if message-hover.has-hover && root.message-error && root.message-details != "": Rectangle {
        x: max(Theme.s3, min(message-hover.absolute-position.x - origin.absolute-position.x, root.width - self.width - Theme.s3));
        y: max(Theme.s3, min(message-hover.absolute-position.y - origin.absolute-position.y + message-hover.height + Theme.s2, root.height - self.height - Theme.s3));
        width: min(620px, root.width - 2 * Theme.s3);
        height: diagnostic.preferred-height + 2 * Theme.s2;
        background: Theme.surface;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.line;
        diagnostic := Text {
            x: Theme.s2; y: Theme.s2;
            width: parent.width - 2 * Theme.s2;
            text: @tr("Technical details") + "\n" + root.message-details;
            color: Theme.text;
            font-size: Theme.small;
            wrap: word-wrap;
        }
    }

    // Tip of the matching-mode toggle under the mouse.
    if search.hover-tip != "": Rectangle {
        x: min(search.hover-x - origin.absolute-position.x, root.width - self.width - Theme.s2);
        y: search.hover-bottom - origin.absolute-position.y + Theme.s1;
        width: tip-text.preferred-width + 2 * Theme.s2;
        height: tip-text.preferred-height + 2 * Theme.s1;
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000030;
        tip-text := Text {
            text: search.hover-tip;
            font-size: Theme.small;
            color: Theme.text;
        }
    }

    // Hidden text field used by copy-text() and paste-text().
    clip := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        single-line: false;
        read-only: true;
        enabled: false;
    }

    // Confirmation dialog, above all other content. The backdrop takes all
    // clicks so the window behind cannot be used meanwhile.
    if root.export-open: ExportOptions {
        format-index <=> root.export-format;
        only-selected <=> root.export-only-selected;
        has-selection: root.export-has-selection;
        selection-label: root.export-selection-label;
        done(accepted) => { root.export-choice(accepted); }
    }

    if root.confirm-open: Rectangle {
        background: #00000060;
        TouchArea { }
        dialog-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.confirm-cancelled(); return accept; }
                if (event.text == Key.Return) { root.confirm-accepted(); return accept; }
                accept
            }
        }
        Rectangle {
            width: min(420px, root.width - 2 * Theme.s5);
            // Never taller than the window, so the buttons stay on screen.
            height: min(dialog-layout.preferred-height, root.height - 2 * Theme.s5);
            clip: true;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            dialog-layout := VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.s3;
                Text {
                    text: root.confirm-title;
                    font-size: Theme.body + 2px;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-text;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 8 * (Theme.body + 4px);
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.s2;
                    padding-top: Theme.s2;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.confirm-cancelled(); }
                    }
                    Button {
                        text: root.confirm-action;
                        primary: true;
                        clicked => { root.confirm-accepted(); }
                    }
                }
            }
        }
    }

    if root.dupes-open: FileopsDupes {
        keep <=> root.dupes-keep;
        folder: root.dupes-folder;
        rows: root.dupes-rows;
        summary: root.dupes-summary;
        can-apply: root.dupes-can-apply;
        busy: root.dupes-busy;
        changed => { root.dupes-changed(); }
        choose-folder => { root.dupes-choose-folder(); }
        apply => { root.dupes-apply(); }
        cancel => { root.dupes-cancel(); }
    }
    if root.bulk-open: FileopsBulk {
        title: root.bulk-title;
        mode <=> root.bulk-mode;
        text <=> root.bulk-text;
        with <=> root.bulk-with;
        match-case <=> root.bulk-match-case;
        keep-extension <=> root.bulk-keep-extension;
        at-end <=> root.bulk-at-end;
        date-format <=> root.bulk-date-format;
        start <=> root.bulk-start;
        step <=> root.bulk-step;
        digits <=> root.bulk-digits;
        rows: root.bulk-rows;
        summary: root.bulk-summary;
        can-apply: root.bulk-can-apply;
        busy: root.bulk-busy;
        changed => { root.bulk-changed(); }
        apply => { root.bulk-apply(); }
        cancel => { root.bulk-cancel(); }
    }
    if root.fileops-rename-open: FileopsRename {
        title: root.fileops-rename-title;
        action: root.fileops-rename-action;
        label: root.fileops-rename-label;
        location: root.fileops-rename-location;
        name <=> root.fileops-rename-name;
        selection-end: root.fileops-rename-stem;
        error: root.fileops-rename-error;
        busy: root.fileops-rename-busy;
        edited(name) => { root.fileops-rename-edited(name); }
        submit => { root.fileops-rename-submit(); }
        cancel => { root.fileops-rename-cancel(); }
    }


    if root.properties-open: FilePropertiesDialog {
        text: root.properties-text;
        close => { root.properties-open = false; root.properties-closed();
            if (root.results.length > 0) { root.focus-list(); } else { root.focus-search(); }
        }
    }

    if root.shortcuts-open: InfoDialog {
        title: @tr("Keyboard shortcuts");
        card-width: 520px;
        close => {
            root.shortcuts-open = false;
            search.focus-and-select();
        }
        ListView {
            // Grows with the rows up to what the window leaves.
            preferred-height: root.shortcuts.length * 24px;
            min-height: 120px;
            for row in root.shortcuts: HorizontalLayout {
                height: 24px;
                spacing: Theme.s3;
                Text {
                    width: 200px;
                    text: row.keys;
                    color: Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.action;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    if root.help-open: InfoDialog {
        title: @tr("Help");
        card-width: 680px;
        close => {
            root.help-open = false;
            search.focus-and-select();
        }
        // Page tabs. They take no keyboard focus, so Esc keeps closing the
        // window after a click.
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: start;
            HelpTab {
                text: @tr("Search syntax");
                selected: root.help-page == 0;
                clicked => { root.help-page = 0; }
            }
            HelpTab {
                text: @tr("Regular expressions");
                selected: root.help-page == 1;
                clicked => { root.help-page = 1; }
            }
            HelpTab {
                text: @tr("Command line options");
                selected: root.help-page == 2;
                clicked => { root.help-page = 2; }
            }
        }
        ListView {
            property <[HelpRow]> rows: root.help-page == 0 ? root.help-syntax
                : root.help-page == 1 ? root.help-regex : root.help-command-line;
            // Grows with the rows up to what the window leaves.
            preferred-height: self.rows.length * 26px;
            min-height: 160px;
            for row in self.rows: HorizontalLayout {
                spacing: Theme.s3;
                padding-top: row.example == "" ? Theme.s3 : 2px;
                padding-bottom: 2px;
                if row.example != "": Text {
                    width: 230px;
                    text: row.example;
                    font-family: "monospace";
                    color: Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.meaning;
                    color: row.example == "" ? Theme.text : Theme.text-muted;
                    font-weight: row.example == "" ? 600 : 400;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    if root.organize-open: InfoDialog {
        title: @tr("Organize columns");
        card-width: 360px;
        close => {
            root.organize-open = false;
            search.focus-and-select();
        }
        // Esc in the search clears it first; a second Esc closes the dialog.
        FocusScope {
            key-pressed(event) => {
                if (event.text != Key.Escape) { return reject; }
                if (root.organize-filter != "") {
                    root.organize-filter = "";
                } else {
                    root.organize-open = false;
                    search.focus-and-select();
                }
                accept
            }
            VerticalLayout {
                LineEdit {
                    placeholder-text: @tr("Search columns");
                    text <=> root.organize-filter;
                }
            }
        }
        Text {
            text: @tr("Name, Folder, Size and Modified are always shown.");
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        // Every choice is a row of fixed height and the list keeps the
        // height of all of them, so the dialog keeps its size and place
        // while the search narrows the list. When the window is too low for
        // all of them, the list scrolls and the buttons stay in view.
        choices-view := ScrollView {
            property <length> choice-height: 18px;
            property <length> all-height: root.column-choices.length * (self.choice-height + Theme.s1) - Theme.s1;
            min-height: min(self.all-height, 120px);
            preferred-height: self.all-height;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: Theme.s1;
                alignment: start;
                for item in root.filter-columns(root.column-choices, root.organize-filter): CheckBox {
                    height: choices-view.choice-height;
                    text: item.title;
                    checked: item.checked;
                    enabled: item.enabled;
                    toggled => { root.set-column-shown(item.column, self.checked); }
                }
            }
        }
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: start;
            Button {
                text: @tr("Restore removed column");
                enabled: root.can-run(Command.restore-removed-column);
                clicked => { root.run(Command.restore-removed-column); }
            }
            Button {
                text: @tr("Reset columns");
                clicked => { root.run(Command.reset-columns); }
            }
        }
    }
    if root.advanced-sort-open: InfoDialog {
        title: @tr("Advanced sort");
        card-width: 520px;
        show-close: false;
        accepted => { root.apply-advanced-sort(); }
        close => {
            root.advanced-sort-open = false;
            search.focus-and-select();
        }
        for level in 3: HorizontalLayout {
            spacing: Theme.s2;
            Text {
                text: level == 0 ? @tr("Sort by") : @tr("Then by");
                color: Theme.text;
                vertical-alignment: center;
                min-width: 72px;
            }
            ComboBox {
                horizontal-stretch: 1;
                model: level == 0 ? root.advanced-sort-names : root.advanced-sort-then-names;
                current-index: root.advanced-sort-chosen[level];
                selected => { root.advanced-sort-chosen[level] = self.current-index; }
            }
            ComboBox {
                model: [@tr("Ascending"), @tr("Descending")];
                enabled: level == 0 || root.advanced-sort-chosen[level] > 0;
                current-index: root.advanced-sort-descending[level] ? 1 : 0;
                selected => { root.advanced-sort-descending[level] = self.current-index == 1; }
            }
        }
        Text {
            text: @tr("Entries equal by one column are ordered by the next. A click on a column header sorts by that column alone.");
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: end;
            Button {
                text: @tr("OK");
                primary: true;
                clicked => {
                    root.advanced-sort-open = false;
                    root.apply-advanced-sort();
                    search.focus-and-select();
                }
            }
            Button {
                text: @tr("Cancel");
                clicked => {
                    root.advanced-sort-open = false;
                    search.focus-and-select();
                }
            }
        }
    }
    if root.about-open: InfoDialog {
        title: @tr("About EveryGrep");
        close => {
            root.about-open = false;
            search.focus-and-select();
        }
        HorizontalLayout {
            spacing: Theme.s3;
            Image {
                source: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "EveryGrep";
                    font-size: Theme.body + 4px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: @tr("Version {}", root.version);
                    color: Theme.text-muted;
                }
            }
        }
        Text {
            text: @tr("Finds files and folders by name as you type.");
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: @tr("Licensed under the MIT license or the Apache License 2.0, at your option.");
            font-size: Theme.small;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        // The toolkit's attribution, required by its royalty-free license.
        HorizontalLayout {
            alignment: center;
            AboutSlint { }
        }
    }

    // The menu bar. It is drawn inside the window (GNOME has no global menu
    // bar). Its keys are matched before the focused control sees them, so
    // it only shows global keys that edit no text and that no control binds
    // otherwise (see menu-keys); Ctrl+C, Delete or F2 keep their meaning in
    // the search field.
    if root.show-menu-bar: MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New window");
                shortcut: root.menu-keys.new-window;
                enabled: root.can-run(Command.new-window);
                activated => { root.run(Command.new-window); }
            }
            MenuItem {
                title: @tr("Close window");
                shortcut: root.menu-keys.close-window;
                enabled: root.can-run(Command.close-window);
                activated => { root.run(Command.close-window); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Export results…");
                shortcut: root.menu-keys.export-results;
                enabled: root.can-run(Command.export-results);
                activated => { root.run(Command.export-results); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("New folder…");
                shortcut: root.menu-keys.new-folder;
                enabled: root.can-run(Command.new-folder);
                activated => { root.run(Command.new-folder); }
            }
            MenuItem { title: @tr("Properties"); enabled: root.can-run(Command.properties); activated => { root.run(Command.properties); } }
            MenuItem { title: @tr("Load file details"); shortcut: root.menu-keys.read-extended; enabled: root.can-run(Command.read-extended); activated => { root.run(Command.read-extended); } }
            MenuItem {
                title: @tr("Quit");
                shortcut: root.menu-keys.quit;
                enabled: root.can-run(Command.quit);
                activated => { root.run(Command.quit); }
            }
        }
        Menu {
            title: @tr("Edit");
            MenuItem {
                title: @tr("Undo file operation"); shortcut: root.menu-keys.undo-file;
                enabled: root.can-run(Command.undo-file); activated => { root.run(Command.undo-file); }
            }
            MenuItem {
                title: @tr("Redo file operation"); shortcut: root.menu-keys.redo-file;
                enabled: root.can-run(Command.redo-file); activated => { root.run(Command.redo-file); }
            }
            MenuItem {
                title: @tr("File undo history"); shortcut: root.menu-keys.file-undo-history;
                enabled: root.can-run(Command.file-undo-history); activated => { root.run(Command.file-undo-history); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Cut");
                shortcut: root.menu-keys.cut;
                enabled: root.can-run(Command.cut);
                activated => { root.run(Command.cut); }
            }
            MenuItem {
                title: @tr("Copy");
                shortcut: root.menu-keys.copy;
                enabled: root.can-run(Command.copy);
                activated => { root.run(Command.copy); }
            }
            MenuItem {
                title: @tr("Paste into folder");
                shortcut: root.menu-keys.paste;
                enabled: root.can-run(Command.paste);
                activated => { root.run(Command.paste); }
            }
            MenuItem {
                title: @tr("Copy to folder…");
                shortcut: root.menu-keys.copy-to-folder;
                enabled: root.can-run(Command.copy-to-folder);
                activated => { root.run(Command.copy-to-folder); }
            }
            MenuItem {
                title: @tr("Move to folder…");
                shortcut: root.menu-keys.move-to-folder;
                enabled: root.can-run(Command.move-to-folder);
                activated => { root.run(Command.move-to-folder); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Copy name");
                shortcut: root.menu-keys.copy-name;
                enabled: root.can-run(Command.copy-name);
                activated => { root.run(Command.copy-name); }
            }
            MenuItem {
                title: @tr("Copy path");
                shortcut: root.menu-keys.copy-path;
                enabled: root.can-run(Command.copy-path);
                activated => { root.run(Command.copy-path); }
            }
            MenuItem {
                title: @tr("Copy full path");
                shortcut: root.menu-keys.copy-full-path;
                enabled: root.can-run(Command.copy-full-path);
                activated => { root.run(Command.copy-full-path); }
            }
            MenuItem {
                title: @tr("Copy path with quotes");
                shortcut: root.menu-keys.copy-path-quoted;
                enabled: root.can-run(Command.copy-path-quoted);
                activated => { root.run(Command.copy-path-quoted); }
            }
            MenuItem {
                title: @tr("Copy full path with quotes");
                shortcut: root.menu-keys.copy-full-path-quoted;
                enabled: root.can-run(Command.copy-full-path-quoted);
                activated => { root.run(Command.copy-full-path-quoted); }
            }
            MenuItem {
                title: @tr("Copy column value");
                shortcut: root.menu-keys.copy-column-value;
                enabled: root.can-run(Command.copy-column-value);
                activated => { root.run(Command.copy-column-value); }
            }
            MenuItem {
                title: @tr("Copy all properties (TSV)");
                shortcut: root.menu-keys.copy-properties;
                enabled: root.can-run(Command.copy-properties);
                activated => { root.run(Command.copy-properties); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Select all");
                shortcut: root.menu-keys.select-all;
                enabled: root.can-run(Command.select-all);
                activated => { root.run(Command.select-all); }
            }
            MenuItem {
                title: @tr("Invert selection");
                shortcut: root.menu-keys.invert-selection;
                enabled: root.can-run(Command.invert-selection);
                activated => { root.run(Command.invert-selection); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Rename");
                shortcut: root.menu-keys.rename;
                enabled: root.can-run(Command.rename);
                activated => { root.run(Command.rename); }
            }
            MenuItem {
                title: @tr("Rename several items…");
                shortcut: root.menu-keys.bulk-rename;
                enabled: root.can-run(Command.bulk-rename);
                activated => { root.run(Command.bulk-rename); }
            }
            MenuItem {
                title: @tr("Clean up duplicates…");
                shortcut: root.menu-keys.clean-duplicates;
                enabled: root.can-run(Command.clean-duplicates);
                activated => { root.run(Command.clean-duplicates); }
            }
            MenuItem {
                title: @tr("Move to trash");
                shortcut: root.menu-keys.trash;
                enabled: root.can-run(Command.trash);
                activated => { root.run(Command.trash); }
            }
            MenuItem {
                title: @tr("Delete permanently…");
                shortcut: root.menu-keys.delete-permanently;
                enabled: root.can-run(Command.delete-permanently);
                activated => { root.run(Command.delete-permanently); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Focus the search field");
                shortcut: root.menu-keys.focus-search;
                enabled: root.can-run(Command.focus-search);
                activated => { root.run(Command.focus-search); }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem { title: @tr("Preview panel"); shortcut: root.menu-keys.preview-panel; enabled: root.can-run(Command.preview-panel); activated => { root.run(Command.preview-panel); } }
            MenuItem { title: @tr("Focus preview"); shortcut: root.menu-keys.focus-preview; enabled: root.can-run(Command.focus-preview); activated => { root.run(Command.focus-preview); } }
            MenuItem { title: @tr("Close preview panel"); shortcut: root.menu-keys.close-preview-panel; enabled: root.can-run(Command.close-preview-panel); activated => { root.run(Command.close-preview-panel); } }

            MenuItem {
                // Checked while the panel is shown; activating flips the flag.
                title: @tr("Folders panel"); shortcut: root.menu-keys.folders-panel;
                enabled: root.can-run(Command.folders-panel);
                checkable: true;
                checked <=> root.folders-visible;
                activated => { root.folders-changed(); }
            }
            MenuItem {
                title: @tr("Focus folders"); shortcut: root.menu-keys.focus-folders;
                enabled: root.can-run(Command.focus-folders);
                activated => { root.run(Command.focus-folders); }
            }
            MenuItem {
                title: @tr("Close folders panel"); shortcut: root.menu-keys.close-folders-panel;
                enabled: root.can-run(Command.close-folders-panel);
                activated => { root.run(Command.close-folders-panel); }
            }
            MenuItem {
                title: @tr("Refresh");
                shortcut: root.menu-keys.refresh;
                enabled: root.can-run(Command.refresh);
                activated => { root.run(Command.refresh); }
            }
            MenuSeparator { }
            // The optional columns, in a submenu so that the View menu
            // fits a laptop screen (popups cannot scroll).
            Menu {
                title: @tr("Columns");
                MenuItem {
                    title: @tr("Type column");
                    shortcut: root.menu-keys.type-column;
                    checkable: true;
                    checked <=> root.show-type;
                    activated => { root.toggled(Command.type-column); }
                }
                MenuItem {
                    title: @tr("Extension column");
                    shortcut: root.menu-keys.extension-column;
                    checkable: true;
                    checked <=> root.show-ext;
                    activated => { root.toggled(Command.extension-column); }
                }
                MenuItem {
                    title: @tr("Created column");
                    shortcut: root.menu-keys.created-column;
                    checkable: true;
                    checked <=> root.show-created;
                    activated => { root.toggled(Command.created-column); }
                }
                MenuItem {
                    title: @tr("Accessed column");
                    shortcut: root.menu-keys.accessed-column;
                    checkable: true;
                    checked <=> root.show-accessed;
                    activated => { root.toggled(Command.accessed-column); }
                }
                MenuItem {
                    title: @tr("Attributes column");
                    shortcut: root.menu-keys.attributes-column;
                    checkable: true;
                    checked <=> root.show-attrs;
                    activated => { root.toggled(Command.attributes-column); }
                }
                MenuItem {
                    title: @tr("MD5 column");
                    shortcut: root.menu-keys.md5-column;
                    checkable: true;
                    checked <=> root.show-md5;
                    activated => { root.toggled(Command.md5-column); }
                }
                MenuItem {
                    title: @tr("SHA-256 column");
                    shortcut: root.menu-keys.sha256-column;
                    checkable: true;
                    checked <=> root.show-sha256;
                    activated => { root.toggled(Command.sha256-column); }
                }
                MenuItem {
                    title: @tr("CRC-32 column");
                    shortcut: root.menu-keys.crc32-column;
                    checkable: true;
                    checked <=> root.show-crc32;
                    activated => { root.toggled(Command.crc32-column); }
                }
                MenuItem {
                    title: @tr("Same name column");
                    shortcut: root.menu-keys.name-frequency-column;
                    checkable: true;
                    checked <=> root.show-name-freq;
                    activated => { root.toggled(Command.name-frequency-column); }
                }
                MenuItem {
                    title: @tr("Same extension column");
                    shortcut: root.menu-keys.extension-frequency-column;
                    checkable: true;
                    checked <=> root.show-ext-freq;
                    activated => { root.toggled(Command.extension-frequency-column); }
                }
                MenuItem {
                    title: @tr("Same size column");
                    shortcut: root.menu-keys.size-frequency-column;
                    checkable: true;
                    checked <=> root.show-size-freq;
                    activated => { root.toggled(Command.size-frequency-column); }
                }
            }
            MenuItem {
                title: @tr("Size all columns to fit");
                shortcut: root.menu-keys.fit-columns;
                enabled: root.can-run(Command.fit-columns);
                activated => { root.run(Command.fit-columns); }
            }
            MenuItem {
                title: @tr("Fit columns to window");
                shortcut: root.menu-keys.fit-columns-to-window;
                enabled: root.can-run(Command.fit-columns-to-window);
                activated => { root.run(Command.fit-columns-to-window); }
            }
            MenuItem {
                title: @tr("Organize columns…");
                shortcut: root.menu-keys.organize-columns;
                enabled: root.can-run(Command.organize-columns);
                activated => { root.run(Command.organize-columns); }
            }
            MenuItem {
                title: @tr("Restore removed column");
                shortcut: root.menu-keys.restore-removed-column;
                enabled: root.can-run(Command.restore-removed-column);
                activated => { root.run(Command.restore-removed-column); }
            }
            MenuItem {
                title: @tr("Reset columns");
                shortcut: root.menu-keys.reset-columns;
                enabled: root.can-run(Command.reset-columns);
                activated => { root.run(Command.reset-columns); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Sort by");
                for item in root.sort-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    enabled: item.enabled && !root.export-open && !root.confirm-open && !root.fileops-conflict-open;
                    activated => { root.sort-to(item.column, root.sort-descending); }
                }
                MenuSeparator { }
                for item[i] in root.sort-order-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    enabled: !root.export-open && !root.confirm-open && !root.fileops-conflict-open;
                    activated => { root.sort-to(root.sort-column, i == 1); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Advanced sort…");
                    shortcut: root.menu-keys.advanced-sort;
                    enabled: root.can-run(Command.advanced-sort);
                    activated => { root.run(Command.advanced-sort); }
                }
            }
            MenuItem {
                title: @tr("Largest folders");
                shortcut: root.menu-keys.largest-folders;
                checkable: true;
                checked: root.largest-folders-visible;
                activated => { root.run(Command.largest-folders); }
            }
            Menu {
                title: @tr("Folder size");
                for item[i] in root.folder-size-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-folder-size(i); }
                }
            }
            Menu {
                title: @tr("Density");
                for item[i] in root.density-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-density(i); }
                }
            }
            Menu {
                title: @tr("Theme");
                for item[i] in root.theme-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-theme(i); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Selection details");
                shortcut: root.menu-keys.selection-details;
                checkable: true;
                checked <=> root.status-details;
                activated => { root.toggled(Command.selection-details); }
            }
            MenuItem {
                title: @tr("Menu bar");
                shortcut: root.menu-keys.menu-bar;
                checkable: true;
                checked <=> root.show-menu-bar;
                activated => { root.toggled(Command.menu-bar); }
            }
            MenuItem {
                title: @tr("Status bar");
                shortcut: root.menu-keys.status-bar;
                checkable: true;
                checked <=> root.show-status-bar;
                activated => { root.toggled(Command.status-bar); }
            }
            MenuItem {
                title: @tr("Toolbar");
                shortcut: root.menu-keys.toolbar;
                checkable: true;
                checked <=> root.show-toolbar;
                activated => { root.toggled(Command.toolbar); }
            }
            Menu {
                title: @tr("Zoom");
                MenuItem { title: @tr("Zoom in"); shortcut: root.menu-keys.zoom-in; activated => { root.run(Command.zoom-in); } }
                MenuItem { title: @tr("Zoom out"); shortcut: root.menu-keys.zoom-out; activated => { root.run(Command.zoom-out); } }
                MenuItem { title: @tr("Reset zoom"); shortcut: root.menu-keys.zoom-reset; activated => { root.run(Command.zoom-reset); } }
            }
        }
        Menu {
            title: @tr("Search");
            MenuItem {
                title: @tr("Match case");
                shortcut: root.menu-keys.match-case;
                checkable: true;
                checked <=> root.match-case;
                activated => { root.toggled(Command.match-case); }
            }
            MenuItem {
                title: @tr("Match whole words");
                shortcut: root.menu-keys.whole-words;
                checkable: true;
                checked <=> root.whole-words;
                activated => { root.toggled(Command.whole-words); }
            }
            MenuItem {
                title: @tr("Match the full path");
                shortcut: root.menu-keys.match-path;
                checkable: true;
                checked <=> root.match-path;
                activated => { root.toggled(Command.match-path); }
            }
            MenuItem {
                title: @tr("Match diacritics");
                shortcut: root.menu-keys.match-diacritics;
                checkable: true;
                checked <=> root.match-diacritics;
                activated => { root.toggled(Command.match-diacritics); }
            }
            MenuItem {
                title: @tr("Regular expression");
                shortcut: root.menu-keys.regex;
                checkable: true;
                checked <=> root.use-regex;
                activated => { root.toggled(Command.regex); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Match prefix");
                shortcut: root.menu-keys.match-prefix;
                checkable: true;
                checked <=> root.match-prefix;
                activated => { root.toggled(Command.match-prefix); }
            }
            MenuItem {
                title: @tr("Match suffix");
                shortcut: root.menu-keys.match-suffix;
                checkable: true;
                checked <=> root.match-suffix;
                activated => { root.toggled(Command.match-suffix); }
            }
            MenuItem {
                title: @tr("Ignore punctuation");
                shortcut: root.menu-keys.ignore-punctuation;
                checkable: true;
                checked <=> root.ignore-punctuation;
                activated => { root.toggled(Command.ignore-punctuation); }
            }
            MenuItem {
                title: @tr("Ignore whitespace");
                shortcut: root.menu-keys.ignore-whitespace;
                checkable: true;
                checked <=> root.ignore-whitespace;
                activated => { root.toggled(Command.ignore-whitespace); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Hidden files");
                MenuItem {
                    title: @tr("Show hidden files");
                    shortcut: root.menu-keys.show-hidden-files;
                    enabled: root.can-run(Command.show-hidden-files);
                    checkable: true;
                    checked: root.hidden-files == 0;
                    activated => { root.run(Command.show-hidden-files); }
                }
                MenuItem {
                    title: @tr("Hide hidden files");
                    shortcut: root.menu-keys.hide-hidden-files;
                    enabled: root.can-run(Command.hide-hidden-files);
                    checkable: true;
                    checked: root.hidden-files == 1;
                    activated => { root.run(Command.hide-hidden-files); }
                }
                MenuItem {
                    title: @tr("Only hidden files");
                    shortcut: root.menu-keys.only-hidden-files;
                    enabled: root.can-run(Command.only-hidden-files);
                    checkable: true;
                    checked: root.hidden-files == 2;
                    activated => { root.run(Command.only-hidden-files); }
                }
                MenuItem {
                    title: @tr("Cycle hidden files");
                    shortcut: root.menu-keys.cycle-hidden-files;
                    enabled: root.can-run(Command.cycle-hidden-files);
                    activated => { root.run(Command.cycle-hidden-files); }
                }
            }
            Menu {
                title: @tr("Filter");
                MenuItem { title: @tr("Save as filter…"); shortcut: root.menu-keys.add-filter; activated => { root.run(Command.add-filter); } }
                MenuItem { title: @tr("Manage filters…"); shortcut: root.menu-keys.organize-filters; activated => { root.run(Command.organize-filters); } }
                MenuItem { title: @tr("Find Filter…"); shortcut: root.menu-keys.find-filter; activated => { root.run(Command.find-filter); } }
                MenuItem { title: @tr("Restore default filters"); shortcut: root.menu-keys.restore-filters; activated => { root.run(Command.restore-filters); } }
                MenuSeparator { }
                for item in root.filter-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => {
                        root.filter-index = item.index;
                        root.options-edited();
                    }
                }
                if root.more-filters: MenuItem { title: @tr("More filters…"); activated => { root.run(Command.organize-filters); } }
            }
            MenuItem {
                title: @tr("Previous filter");
                shortcut: root.menu-keys.previous-filter;
                enabled: root.can-run(Command.previous-filter);
                activated => { root.run(Command.previous-filter); }
            }
            MenuItem {
                title: @tr("Next filter");
                shortcut: root.menu-keys.next-filter;
                enabled: root.can-run(Command.next-filter);
                activated => { root.run(Command.next-filter); }
            }
            MenuItem { title: @tr("Search a list of names…"); shortcut: root.menu-keys.search-name-list; activated => { root.run(Command.search-name-list); } }
            MenuItem { title: @tr("Advanced Search…"); shortcut: root.menu-keys.advanced-search; activated => { root.run(Command.advanced-search); } }
            MenuSeparator { }
            Menu {
                title: @tr("Find duplicates");
                MenuItem {
                    title: @tr("By contents");
                    shortcut: root.menu-keys.find-duplicates;
                    activated => { root.run(Command.find-duplicates); }
                }
                MenuItem {
                    title: @tr("By name");
                    shortcut: root.menu-keys.find-name-duplicates;
                    activated => { root.run(Command.find-name-duplicates); }
                }
                MenuItem {
                    title: @tr("By size");
                    shortcut: root.menu-keys.find-size-duplicates;
                    activated => { root.run(Command.find-size-duplicates); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Stop finding duplicates");
                    shortcut: root.menu-keys.clear-duplicates;
                    activated => { root.run(Command.clear-duplicates); }
                }
            }
        }
        Menu {
            title: @tr("Bookmarks");
            MenuItem { title: @tr("Save bookmark…"); shortcut: root.menu-keys.add-bookmark; activated => { root.run(Command.add-bookmark); } }
            MenuItem { title: @tr("Manage bookmarks…"); shortcut: root.menu-keys.organize-bookmarks; activated => { root.run(Command.organize-bookmarks); } }
            MenuItem { title: @tr("Find Bookmark…"); shortcut: root.menu-keys.find-bookmark; activated => { root.run(Command.find-bookmark); } }
            MenuItem { title: @tr("Copy Search"); shortcut: root.menu-keys.copy-search; activated => { root.run(Command.copy-search); } }
            MenuItem { title: @tr("Open all bookmarks"); shortcut: root.menu-keys.open-all-bookmarks; enabled: root.bookmark-items.length > 0 || root.bookmark-folders.length > 0; activated => { root.run(Command.open-all-bookmarks); } }
            if root.bookmark-items.length > 0 || root.bookmark-folders.length > 0: Menu {
                title: @tr("Append to search");
                for folder in root.bookmark-folders: Menu {
                    title: folder.title;
                    for item in folder.items: MenuItem {
                        title: item.title;
                        activated => { root.append-bookmark(item.index); }
                    }
                }
                for item in root.bookmark-items: MenuItem {
                    title: item.title;
                    activated => { root.append-bookmark(item.index); }
                }
            }
            MenuItem { title: @tr("Add ready-made searches"); activated => { root.add-starter-bookmarks(); } }
            if root.bookmark-items.length > 0 || root.bookmark-folders.length > 0: MenuSeparator { }
            for folder in root.bookmark-folders: Menu {
                title: folder.title;
                MenuItem { title: @tr("Open all in tabs"); enabled: folder.items.length > 0; activated => { root.open-bookmark-folder(folder.index); } }
                MenuSeparator { }
                for item in folder.items: MenuItem {
                    title: item.title;
                    activated => { root.open-bookmark(item.index); }
                }
            }
            for item in root.bookmark-items: MenuItem {
                title: item.title;
                activated => { root.open-bookmark(item.index); }
            }
            if root.more-bookmarks: MenuItem { title: @tr("More bookmarks…"); activated => { root.run(Command.organize-bookmarks); } }
        }
        Menu {
            title: @tr("History");
            MenuItem {
                title: @tr("Back");
                shortcut: root.menu-keys.previous-search;
                enabled: root.can-run(Command.previous-search);
                activated => { root.run(Command.previous-search); }
            }
            MenuItem {
                title: @tr("Forward");
                shortcut: root.menu-keys.next-search;
                enabled: root.can-run(Command.next-search);
                activated => { root.run(Command.next-search); }
            }
            MenuItem {
                title: @tr("Show search history");
                shortcut: root.menu-keys.show-history;
                activated => { root.run(Command.show-history); }
            }
            MenuItem {
                title: @tr("Organize search history…");
                shortcut: root.menu-keys.organize-history;
                activated => { root.run(Command.organize-history); }
            }
        }
        Menu { title: @tr("Tabs");
            MenuItem { title: @tr("New tab"); shortcut: root.menu-keys.new-tab; enabled: root.can-run(Command.new-tab); activated => { root.run(Command.new-tab); } }
            MenuItem { title: @tr("Duplicate tab"); shortcut: root.menu-keys.duplicate-tab; enabled: root.can-run(Command.duplicate-tab); activated => { root.run(Command.duplicate-tab); } }
            MenuItem { title: @tr("Close tab"); shortcut: root.menu-keys.close-tab; enabled: root.can-run(Command.close-tab); activated => { root.run(Command.close-tab); } }
            // Grouped so that the menu stays short (see menus.rs).
            Menu { title: @tr("Close tabs");
                MenuItem { title: @tr("Close multiple tabs"); shortcut: root.menu-keys.close-multiple-tabs; enabled: root.can-run(Command.close-multiple-tabs); activated => { root.run(Command.close-multiple-tabs); } }
                MenuItem { title: @tr("Close tabs to the left"); shortcut: root.menu-keys.close-left-tabs; enabled: root.can-run(Command.close-left-tabs); activated => { root.run(Command.close-left-tabs); } }
                MenuItem { title: @tr("Close tabs to the right"); shortcut: root.menu-keys.close-right-tabs; enabled: root.can-run(Command.close-right-tabs); activated => { root.run(Command.close-right-tabs); } }
                MenuItem { title: @tr("Close other tabs"); shortcut: root.menu-keys.close-other-tabs; enabled: root.can-run(Command.close-other-tabs); activated => { root.run(Command.close-other-tabs); } }
            }
            MenuItem { title: @tr("Reopen closed tab"); shortcut: root.menu-keys.reopen-tab; enabled: root.can-run(Command.reopen-tab); activated => { root.run(Command.reopen-tab); } }
            Menu { title: @tr("Recently closed tabs");
                MenuItem { title: @tr("Reopen all closed tabs"); shortcut: root.menu-keys.reopen-all-tabs; enabled: root.can-run(Command.reopen-all-tabs); activated => { root.run(Command.reopen-all-tabs); } }
                if root.closed-tab-names.length > 0: MenuSeparator { }
                for title[i] in root.closed-tab-names: MenuItem { title: title; activated => { root.closed-tab-selected(i); } }
            }
            MenuItem { title: @tr("Next tab"); shortcut: root.menu-keys.next-tab; enabled: root.can-run(Command.next-tab); activated => { root.run(Command.next-tab); } }
            MenuItem { title: @tr("Previous tab"); shortcut: root.menu-keys.previous-tab; enabled: root.can-run(Command.previous-tab); activated => { root.run(Command.previous-tab); } }
            MenuSeparator { }
            for tab in root.tab-items: MenuItem { title: tab.title; checkable: true; checked: tab.checked; activated => { root.tab-selected(tab.index); } }
            MenuItem { title: @tr("List all tabs"); shortcut: root.menu-keys.list-tabs; enabled: root.can-run(Command.list-tabs); activated => { root.run(Command.list-tabs); } }
            MenuSeparator { }
            Menu { title: @tr("Tab options");
                MenuItem { title: @tr("Open searches in tabs instead of new windows"); checkable: true; checked <=> root.open-searches-in-tabs; activated => { root.tab-preference-changed(0, self.checked); } }
                MenuItem { title: @tr("Switch to new tabs immediately"); checkable: true; checked <=> root.switch-to-new-tab; activated => { root.tab-preference-changed(1, self.checked); } }
                MenuItem { title: @tr("Restore the last window's tabs at startup"); checkable: true; checked <=> root.restore-session; activated => { root.tab-preference-changed(2, self.checked); } }
            }
        }
        Menu {
            title: @tr("Index");
            MenuItem {
                title: @tr("Rebuild index now");
                shortcut: root.menu-keys.rebuild-index;
                enabled: root.can-run(Command.rebuild-index);
                activated => { root.run(Command.rebuild-index); }
            }
            MenuItem {
                title: @tr("Pause index updates");
                shortcut: root.menu-keys.pause-index-updates;
                checkable: true;
                checked <=> root.index-paused;
                activated => { root.toggled(Command.pause-index-updates); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Hide offline entries");
                shortcut: root.menu-keys.hide-offline-entries;
                checkable: true;
                checked <=> root.hide-offline;
                activated => { root.toggled(Command.hide-offline-entries); }
            }
            MenuItem {
                title: @tr("Create file list…");
                shortcut: root.menu-keys.create-file-list;
                enabled: root.can-run(Command.create-file-list);
                activated => { root.run(Command.create-file-list); }
            }
            MenuItem {
                title: @tr("File list editor…");
                activated => { root.open-file-list-editor(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Index changes…");
                activated => { root.open-index-journal(); }
            }
        }
        Menu {
            title: @tr("Tools");
            MenuItem {
                title: @tr("Settings…");
                shortcut: root.menu-keys.settings;
                enabled: root.can-run(Command.settings);
                activated => { root.run(Command.settings); }
            }
            MenuItem {
                title: @tr("Customize shortcuts…");
                shortcut: root.menu-keys.keyboard-settings;
                enabled: root.can-run(Command.keyboard-settings);
                activated => { root.run(Command.keyboard-settings); }
            }
            MenuItem {
                title: @tr("Open the settings file");
                shortcut: root.menu-keys.open-settings-file;
                enabled: root.can-run(Command.open-settings-file);
                activated => { root.run(Command.open-settings-file); }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Search syntax");
                shortcut: root.menu-keys.search-syntax-help;
                enabled: root.can-run(Command.search-syntax-help);
                activated => { root.run(Command.search-syntax-help); }
            }
            MenuItem {
                title: @tr("Regular expressions");
                shortcut: root.menu-keys.regex-help;
                enabled: root.can-run(Command.regex-help);
                activated => { root.run(Command.regex-help); }
            }
            MenuItem {
                title: @tr("Command line options");
                shortcut: root.menu-keys.command-line-help;
                enabled: root.can-run(Command.command-line-help);
                activated => { root.run(Command.command-line-help); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Copy troubleshooting information");
                shortcut: root.menu-keys.copy-troubleshooting-info;
                enabled: root.can-run(Command.copy-troubleshooting-info);
                activated => { root.run(Command.copy-troubleshooting-info); }
            }
            MenuItem {
                title: @tr("Debug log");
                shortcut: root.menu-keys.debug-log;
                enabled: root.can-run(Command.debug-log);
                activated => { root.run(Command.debug-log); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Keyboard shortcuts");
                shortcut: root.menu-keys.shortcuts-help;
                enabled: root.can-run(Command.shortcuts-help);
                activated => { root.run(Command.shortcuts-help); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("About EveryGrep");
                shortcut: root.menu-keys.about;
                enabled: root.can-run(Command.about);
                activated => { root.run(Command.about); }
            }
        }
    }

    if root.fileops-conflict-open: FileopsConflict {
        message: root.fileops-conflict-text;
        can-overwrite: root.fileops-conflict-overwrite;
        is-error: root.fileops-conflict-error;
        answer(choice) => { root.fileops-conflict-answer(choice); }
    }

    init => { search.focus-and-select(); }
}
