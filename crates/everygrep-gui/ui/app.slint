                                if root.show-year: HeaderCell {
                                    x: root.year-x; width: root.year-width; height: parent.height;
                                    label: @tr("Year");
                                    sorted: root.sort-column == 40; descending: root.sort-descending;
                                    clicked => { root.sort-by(40); }
                                    right-pressed(x, y) => { root.menu-column = 40; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-track: HeaderCell {
                                    x: root.track-x; width: root.track-width; height: parent.height;
                                    label: @tr("Track");
                                    sorted: root.sort-column == 41; descending: root.sort-descending;
