                                    sorted: root.sort-column == 48; descending: root.sort-descending;
                                    clicked => { root.sort-by(48); }
                                    right-pressed(x, y) => { root.menu-column = 48; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-date-taken: HeaderCell {
                                    x: root.date-taken-x; width: root.date-taken-width; height: parent.height;
                                    label: @tr("Date taken");
                                    sorted: root.sort-column == 49; descending: root.sort-descending;
                                    clicked => { root.sort-by(49); }
                                    right-pressed(x, y) => { root.menu-column = 49; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-gps-lat: HeaderCell {
                                    x: root.gps-lat-x; width: root.gps-lat-width; height: parent.height;
                                    label: @tr("GPS latitude");
                                    sorted: root.sort-column == 50; descending: root.sort-descending;
                                    clicked => { root.sort-by(50); }
                                    right-pressed(x, y) => { root.menu-column = 50; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-gps-long: HeaderCell {
                                    x: root.gps-long-x; width: root.gps-long-width; height: parent.height;
                                    label: @tr("GPS longitude");
                                    sorted: root.sort-column == 51; descending: root.sort-descending;
                                    clicked => { root.sort-by(51); }
                                    right-pressed(x, y) => { root.menu-column = 51; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-sha1: HeaderCell {
                                    x: root.sha1-x; width: root.sha1-width; height: parent.height;
                                    label: @tr("SHA-1");
                                    sorted: root.sort-column == 52; descending: root.sort-descending;
                                    clicked => { root.sort-by(52); }
                                    right-pressed(x, y) => { root.menu-column = 52; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-sha384: HeaderCell {
                                    x: root.sha384-x; width: root.sha384-width; height: parent.height;
                                    label: @tr("SHA-384");
                                    sorted: root.sort-column == 53; descending: root.sort-descending;
                                    clicked => { root.sort-by(53); }
                                    right-pressed(x, y) => { root.menu-column = 53; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-sha512: HeaderCell {
                                    x: root.sha512-x; width: root.sha512-width; height: parent.height;
                                    label: @tr("SHA-512");
                                    sorted: root.sort-column == 54; descending: root.sort-descending;
                                    clicked => { root.sort-by(54); }
                                    right-pressed(x, y) => { root.menu-column = 54; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-xxhash: HeaderCell {
                                    x: root.xxhash-x; width: root.xxhash-width; height: parent.height;
                                    label: @tr("xxHash (XXH3-128)");
                                    sorted: root.sort-column == 55; descending: root.sort-descending;
                                    clicked => { root.sort-by(55); }
                                    right-pressed(x, y) => { root.menu-column = 55; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-dupe-group: HeaderCell {
                                    x: root.dupe-group-x; width: root.dupe-group-width; height: parent.height;
