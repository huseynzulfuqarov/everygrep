                                if root.show-full-path: HeaderCell {
                                    x: root.full-path-x; width: root.full-path-width; height: parent.height;
                                    label: @tr("Full path");
                                    sorted: root.sort-column == 15; descending: root.sort-descending;
                                    clicked => { root.sort-by(15); }
                                    right-pressed(x, y) => { root.menu-column = 15; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-parent-path: HeaderCell {
                                    x: root.parent-path-x; width: root.parent-path-width; height: parent.height;
                                    label: @tr("Parent path");
                                    sorted: root.sort-column == 16; descending: root.sort-descending;
                                    clicked => { root.sort-by(16); }
                                    right-pressed(x, y) => { root.menu-column = 16; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-stem: HeaderCell {
                                    x: root.stem-x; width: root.stem-width; height: parent.height;
                                    label: @tr("Stem");
                                    sorted: root.sort-column == 17; descending: root.sort-descending;
                                    clicked => { root.sort-by(17); }
                                    right-pressed(x, y) => { root.menu-column = 17; header-menu.show({ x: self.x + x, y: y }); }
