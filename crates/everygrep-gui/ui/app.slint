                                }
                                if root.show-genre: HeaderCell {
                                    x: root.genre-x; width: root.genre-width; height: parent.height;
                                    label: @tr("Genre");
                                    sorted: root.sort-column == 42; descending: root.sort-descending;
                                    clicked => { root.sort-by(42); }
                                    right-pressed(x, y) => { root.menu-column = 42; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-rating: HeaderCell {
                                    x: root.rating-x; width: root.rating-width; height: parent.height;
                                    label: @tr("Rating");
                                    sorted: root.sort-column == 43; descending: root.sort-descending;
                                    clicked => { root.sort-by(43); }
                                    right-pressed(x, y) => { root.menu-column = 43; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-tags: HeaderCell {
                                    x: root.tags-x; width: root.tags-width; height: parent.height;
                                    label: @tr("Tags");
                                    sorted: root.sort-column == 44; descending: root.sort-descending;
                                    clicked => { root.sort-by(44); }
                                    right-pressed(x, y) => { root.menu-column = 44; header-menu.show({ x: self.x + x, y: y }); }
                                }
                                if root.show-page-count: HeaderCell {
