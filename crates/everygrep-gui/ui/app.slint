import { AboutSlint, Button, ComboBox, ListView, Palette } from "std-widgets.slint";
import { TabStrip, TabEntry } from "tabs.slint";
export { TabEntry, TabsWindow } from "tabs.slint";
import { Theme } from "theme.slint";
import { FileopsRename } from "fileops-rename.slint";
import { Command, MenuKeys } from "commands.slint";
export { Command, MenuKeys }
export { SettingsWindow, DriveRow, ShortcutCommand } from "settings.slint";
export { HistoryWindow } from "history.slint";
export { SavedWindow } from "saved.slint";
export { AdvancedWindow } from "advanced.slint";
export { StalledDialog } from "stalled.slint";

// A text with up to four highlighted runs: plain and bold pieces in turn,
// p0 b0 p1 b1 ... p4. Without a highlight all of it is in p0; runs after the
// fourth stay plain in p4.
export struct Marked {
    p0: string,
    b0: string,
    p1: string,
    b1: string,
    p2: string,
    b2: string,
    p3: string,
    b3: string,
    p4: string,
}

export struct ResultRow {
    // The name and the folder, with the matched search terms marked.
    name: Marked,
    folder: Marked,
    size: string,
    modified: string,
    modified-full: string,
    // Words for the Type column ("PNG image") and the extension as written.
    type-name: string,
    extension: string,
    // Read from the file system for the rows on screen, only while their
    // column is shown; empty when unknown.
    created: string,
    accessed: string,
    attributes: string,
    md5: string,
    sha256: string,
    crc32: string,
    name-freq: string,
    ext-freq: string,
    size-freq: string,
    is-dir: bool,
    // Index into Icons.types (FileKind in src/filetype.rs).
    kind: int,
    selected: bool,
    // On a drive that is not connected: drawn dimmed, actions refused.
    offline: bool,
}

// One choice of a group in a menu (theme, density, filter, ...), with its
// check mark. The program gives a new list whenever the choice changes, since
// activating a checkable menu item overwrites its check mark.
export struct MenuChoice {
    title: string,
    checked: bool,
}

// A column of the View → Sort by menu, with its check mark; disabled while
// the column is hidden.
struct SortChoice {
    title: string,
    column: int,
    checked: bool,
    enabled: bool,
}

// The texts of a column that look widest among the rows on screen; the
// window measures them to size the column to fit.
export struct FitTexts {
    a: string,
    b: string,
    c: string,
}

// The result list's columns (numbered as sort-column; 0 for a hidden one)
// as the window shows them, for drag-columns.
export struct ColumnLayout {
    widths: [length],
    mins: [length],
    window: length,
    folder-want: length,
}

// The widths of the two columns at a dragged header border, and Folder's
// own width (0 for none).
export struct ColumnDrag {
    left: length,
    right: length,
    folder-want: length,
}

// A line of the keyboard shortcuts dialog.
export struct ShortcutRow {
    keys: string,
    action: string,
}

// One line of a help page: what is typed and what it does; a heading has
// no example.
export struct HelpRow {
    example: string,
    meaning: string,
}

// File-type icons, in the order of FileKind. They carry their own colours and
// must not be colorized.
global Icons {
    out property <[image]> types: [
        @image-url("icons/types/folder.svg"),
        @image-url("icons/types/file.svg"),
        @image-url("icons/types/text.svg"),
        @image-url("icons/types/document.svg"),
        @image-url("icons/types/pdf.svg"),
        @image-url("icons/types/spreadsheet.svg"),
        @image-url("icons/types/presentation.svg"),
        @image-url("icons/types/image.svg"),
        @image-url("icons/types/audio.svg"),
        @image-url("icons/types/video.svg"),
        @image-url("icons/types/archive.svg"),
        @image-url("icons/types/code.svg"),
        @image-url("icons/types/executable.svg"),
        @image-url("icons/types/font.svg"),
        @image-url("icons/types/disk-image.svg"),
        @image-url("icons/types/link.svg")
    ];
}

// A small on/off button for a matching mode, shown inside the search field.
// A small flat button in the status line (Cancel).
component StatusButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    width: label.preferred-width + 2 * Theme.s2;
    height: Theme.badge-height + 2px;
    border-radius: 4px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.line;
    background: touch.pressed ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    label := Text {
        text: root.text;
        font-size: Theme.small;
        color: Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component ModeToggle inherits Rectangle {
    in property <string> glyph;
    // Draws a line under the glyph (the whole-words look).
    in property <bool> underline;
    in property <string> tip;
    in-out property <bool> checked;
    out property <bool> hovered: touch.has-hover;
    callback toggled();

    width: 26px;
    height: 24px;
    border-radius: 4px;
    background: root.checked ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    border-width: root.checked ? 1px : 0px;
    border-color: Theme.accent;
    accessible-role: checkbox;
    accessible-label: root.tip;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.checked = !root.checked; root.toggled(); }

    property <color> ink: root.checked ? Theme.selection-text : Theme.text-muted;
    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    Text {
        text: root.glyph;
        font-size: Theme.small;
        font-weight: 600;
        color: root.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.underline: Rectangle {
        x: 7px;
        y: parent.height - 6px;
        width: parent.width - 14px;
        height: 1px;
        background: root.ink;
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text <=> input.text;
    out property <bool> focused: input.has-focus;
    // Matching modes, changed by the toggles at the right end.
    in-out property <bool> match-case;
    in-out property <bool> whole-words;
    in-out property <bool> match-path;
    in-out property <bool> match-diacritics;
    in-out property <bool> use-regex;
    // A click into the field while it does not have the focus selects all
    // of its text; the next click places the caret.
    in property <bool> select-on-click;
    // The tip of the toggle under the mouse and where to show it.
    out property <string> hover-tip: case-toggle.hovered ? case-toggle.tip
        : words-toggle.hovered ? words-toggle.tip
        : path-toggle.hovered ? path-toggle.tip
        : marks-toggle.hovered ? marks-toggle.tip
        : regex-toggle.hovered ? regex-toggle.tip : "";
    out property <length> hover-x: case-toggle.hovered ? case-toggle.absolute-position.x
        : words-toggle.hovered ? words-toggle.absolute-position.x
        : path-toggle.hovered ? path-toggle.absolute-position.x
        : marks-toggle.hovered ? marks-toggle.absolute-position.x
        : regex-toggle.absolute-position.x;
    out property <length> hover-bottom: case-toggle.absolute-position.y + case-toggle.height;
    callback edited(string);
    callback accepted();
    callback down-pressed();
    callback history-requested();
    callback escape-pressed();
    callback modes-changed();
    // The keys of the window's commands; returns whether the key was used.
    callback shortcut(KeyEvent) -> bool;
    public function focus-and-select() {
        input.focus();
        input.select-all();
    }
    // Puts the text cursor at `offset` (in bytes) with nothing selected.
    public function place-caret(offset: int) {
        input.set-selection-offsets(offset, offset);
    }

    height: Theme.field-height;
    border-radius: Theme.radius;
    background: Theme.field;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-line;

    HorizontalLayout {
        padding-left: Theme.s3;
        padding-right: Theme.s1;
        spacing: Theme.s2;
        Image {
            source: @image-url("icons/search.svg");
            colorize: Theme.text-muted;
            width: Theme.icon;
            height: Theme.icon;
            y: (parent.height - self.height) / 2;
        }
        // The field takes the width the layout gives it, not the width of the
        // text: long text scrolls inside the clip instead of pushing the
        // toggles and the filter selector aside.
        Rectangle {
            horizontal-stretch: 1;
            // A TextInput of width 0 cannot take focus.
            min-width: 1px;
            clip: true;
            input := TextInput {
                // Scroll offset that keeps the text cursor visible.
                property <length> scroll-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                font-size: Theme.body + 1px;
                color: Theme.text;
                selection-background-color: Theme.selection;
                selection-foreground-color: Theme.selection-text;
                single-line: true;
                cursor-position-changed(position) => {
                    if (position.x + self.scroll-x < 0px) {
                        self.scroll-x = -position.x;
                    } else if (position.x + self.scroll-x > parent.width - self.text-cursor-width) {
                        self.scroll-x = parent.width - position.x - self.text-cursor-width;
                    }
                }
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
                key-pressed(event) => {
                    if (root.shortcut(event)) {
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.down-pressed();
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        root.escape-pressed();
                        return accept;
                    }
                    reject
                }
            }
            // Takes the first click while the field has no focus; once it
            // has, clicks go to the text input and place the caret.
            TouchArea {
                enabled: root.select-on-click && !input.has-focus;
                mouse-cursor: MouseCursor.text;
                clicked => {
                    input.focus();
                    input.select-all();
                }
            }
        }
        HorizontalLayout {
            spacing: 2px;
            // The toggles keep their height; centre them in the field.
            padding-top: (root.height - 24px) / 2;
            padding-bottom: (root.height - 24px) / 2;
            case-toggle := ModeToggle {
                glyph: "Aa";
                tip: @tr("Match case (Alt+C)");
                checked <=> root.match-case;
                toggled => { root.modes-changed(); }
            }
            words-toggle := ModeToggle {
                glyph: "ab";
                underline: true;
                tip: @tr("Match whole words (Alt+W)");
                checked <=> root.whole-words;
                toggled => { root.modes-changed(); }
            }
            path-toggle := ModeToggle {
                glyph: "a/b";
                tip: @tr("Match the full path (Alt+P)");
                checked <=> root.match-path;
                toggled => { root.modes-changed(); }
            }
            marks-toggle := ModeToggle {
                glyph: "é";
                tip: @tr("Match diacritics (Alt+D)");
                checked <=> root.match-diacritics;
                toggled => { root.modes-changed(); }
            }
            regex-toggle := ModeToggle {
                glyph: ".*";
                tip: @tr("Regular expression (Alt+R)");
                checked <=> root.use-regex;
                toggled => { root.modes-changed(); }
            }
        }
        Button {
            text: "▼";
            width: 28px;
            accessible-label: @tr("Show search history");
            clicked => { root.history-requested(); }
        }
    }
    placeholder := Text {
        x: Theme.s3 + Theme.icon + Theme.s2;
        visible: input.text == "";
        text: @tr("Search files and folders");
        color: Theme.text-muted;
        font-size: Theme.body + 1px;
        vertical-alignment: center;
        height: parent.height;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <TextHorizontalAlignment> align: left;
    // Whether the results are sorted by this column, and in which direction.
    in property <bool> sorted;
    in property <bool> descending;
    callback clicked();
    callback right-pressed(length, length);

    property <bool> right: root.align == TextHorizontalAlignment.right;
    property <length> arrow-space: root.sorted ? Theme.icon : 0px;
    property <length> label-width: min(label-text.preferred-width, label-text.width);

    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.right-pressed(self.mouse-x, self.mouse-y);
            }
        }
    }
    label-text := Text {
        x: root.right ? Theme.s2 + root.arrow-space : Theme.s2;
        width: parent.width - 2 * Theme.s2 - root.arrow-space;
        height: parent.height;
        text: root.label;
        font-size: Theme.small;
        font-weight: 600;
        color: root.sorted ? Theme.text : Theme.text-muted;
        vertical-alignment: center;
        horizontal-alignment: root.align;
        overflow: elide;
    }
    // The arrow sits next to the label, on the side away from the alignment.
    Image {
        visible: root.sorted;
        x: root.right
            ? parent.width - Theme.s2 - root.label-width - self.width
            : Theme.s2 + root.label-width;
        y: (parent.height - self.height) / 2;
        width: Theme.icon;
        height: Theme.icon;
        source: root.descending ? @image-url("icons/sort-down.svg") : @image-url("icons/sort-up.svg");
        colorize: Theme.accent;
    }
}

// One piece of a MarkedText. It takes its natural width while there is
// room; the piece that runs out of room is elided. The last piece takes all
// the room left.
component Piece inherits Text {
    // Width from this piece to the end of the cell.
    in property <length> room;
    in property <bool> last;
    // An empty Text still reports a small preferred width; force 0.
    width: self.text == "" ? 0px : self.last ? max(0px, self.room) : min(self.preferred-width, self.room);
    visible: self.text != "";
    vertical-alignment: center;
    overflow: elide;
}

// A one-line text with the matched search terms in bold (see Marked); the
// cell clips what does not fit.
component MarkedText inherits Rectangle {
    in property <Marked> text;
    in property <color> text-color;
    in property <bool> italic;
    in property <length> font-size;
    clip: true;

    p0 := Piece {
        x: 0;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p0;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b0 := Piece {
        x: p0.x + p0.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b0;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p1 := Piece {
        x: b0.x + b0.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p1;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b1 := Piece {
        x: p1.x + p1.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b1;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p2 := Piece {
        x: b1.x + b1.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p2;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b2 := Piece {
        x: p2.x + p2.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b2;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p3 := Piece {
        x: b2.x + b2.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p3;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
    }
    b3 := Piece {
        x: p3.x + p3.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.b3;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        font-weight: 700;
    }
    p4 := Piece {
        x: b3.x + b3.width;
        room: root.width - self.x;
        height: root.height;
        text: root.text.p4;
        color: root.text-color;
        font-italic: root.italic;
        font-size: root.font-size;
        last: true;
    }
}

component Row inherits Rectangle {
    in property <ResultRow> data;
    // The keyboard cursor is on this row and the list has focus.
    in property <bool> current;
    // Every second row, drawn in the row-alt color when that is on.
    in property <bool> alternate;
    in property <length> name-width;
    in property <length> folder-width;
    in property <length> size-width;
    in property <length> date-width;
    // Optional columns; 0 when hidden.
    in property <length> type-width;
    in property <length> ext-width;
    in property <length> created-width;
    in property <length> accessed-width;
    in property <length> attr-width;
    in property <length> md5-width;
    in property <length> sha256-width;
    in property <length> crc32-width;
    in property <length> name-freq-width;
    in property <length> ext-freq-width;
    in property <length> size-freq-width;
    // The name is being edited in place.
    in property <bool> editing;
    in-out property <string> edit-text;
    // Bytes of the name selected when editing starts (the part before the
    // extension).
    in property <int> edit-stem;
    callback pressed(KeyboardModifiers);
    callback right-pressed(length, length);
    // With the x position of the click in the row.
    callback double-clicked(length);
    callback edit-commit(string);
    callback edit-cancel();

    property <bool> selected: root.data.selected;
    property <bool> offline: root.data.offline;
    // Text colors: offline rows are dimmed (unless selected) and their names
    // slanted, so the state is not shown by color alone.
    property <color> name-color: selected ? Theme.selection-text : offline ? Theme.text-offline : Theme.text;
    property <color> other-color: selected ? Theme.selection-text : offline ? Theme.text-offline : Theme.text-muted;

    height: Theme.row-height;
    background: selected ? Theme.selection : touch.has-hover ? Theme.hover
        : root.alternate ? Theme.row-alt : transparent;

    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    root.pressed(event.modifiers);
                } else if (event.button == PointerEventButton.right) {
                    root.right-pressed(self.mouse-x, self.mouse-y);
                }
            }
        }
        double-clicked => { root.double-clicked(self.mouse-x); }
    }
    // Focus ring of the keyboard cursor.
    Rectangle {
        visible: root.current;
        border-width: 1px;
        border-color: Theme.accent;
    }

    // Cells are positioned directly to keep the columns aligned with the header.
    Image {
        x: Theme.s3;
        opacity: root.offline ? 0.45 : 1;
        source: Icons.types[root.data.kind];
        width: Theme.row-icon;
        height: Theme.row-icon;
        y: (parent.height - self.height) / 2;
    }
    name-cell := MarkedText {
        x: Theme.s3 + Theme.row-icon + Theme.s2;
        width: max(0px, root.name-width - self.x - Theme.s2);
        height: parent.height;
        text: root.data.name;
        text-color: root.name-color;
        italic: root.offline;
        font-size: Theme.list-text;
    }
    if root.editing: Rectangle {
        x: name-cell.x - Theme.s1;
        width: name-cell.width + Theme.s1;
        y: 2px;
        height: parent.height - 4px;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.accent;
        border-radius: 3px;
        edit := TextInput {
            x: Theme.s1;
            width: parent.width - 2 * Theme.s1;
            text <=> root.edit-text;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.list-text;
            selection-background-color: Theme.selection;
            selection-foreground-color: Theme.selection-text;
            init => {
                self.focus();
                self.set-selection-offsets(0, root.edit-stem);
            }
            accepted => { root.edit-commit(self.text); }
            // Leaving the field (a click elsewhere) cancels; only Enter renames.
            changed has-focus => {
                if (!self.has-focus) { root.edit-cancel(); }
            }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.edit-cancel();
                    return accept;
                }
                // Keep list keys from moving the selection while editing.
                if (event.text == Key.UpArrow || event.text == Key.DownArrow
                    || event.text == Key.PageUp || event.text == Key.PageDown || event.text == Key.F2) {
                    return accept;
                }
                reject
            }
        }
    }
    MarkedText {
        x: root.name-width + Theme.s2;
        width: root.folder-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.folder;
        text-color: root.other-color;
        font-size: Theme.list-text;
    }
    Text {
        x: root.name-width + root.folder-width;
        width: root.size-width - Theme.s2;
        height: parent.height;
        text: root.data.size;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
    }
    Text {
        x: root.name-width + root.folder-width + root.size-width + Theme.s2;
        width: root.date-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.modified;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> type-x: root.name-width + root.folder-width + root.size-width + root.date-width;
    if root.type-width > 0: Text {
        x: root.type-x + Theme.s2;
        width: root.type-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.type-name;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.ext-width > 0: Text {
        x: root.type-x + root.type-width + Theme.s2;
        width: root.ext-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.extension;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> created-x: root.type-x + root.type-width + root.ext-width;
    if root.created-width > 0: Text {
        x: root.created-x + Theme.s2;
        width: root.created-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.created;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.accessed-width > 0: Text {
        x: root.created-x + root.created-width + Theme.s2;
        width: root.accessed-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.accessed;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.attr-width > 0: Text {
        x: root.created-x + root.created-width + root.accessed-width + Theme.s2;
        width: root.attr-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.attributes;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> md5-x: root.created-x + root.created-width + root.accessed-width + root.attr-width;
    if root.md5-width > 0: Text {
        x: root.md5-x + Theme.s2;
        width: root.md5-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.md5;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> sha256-x: root.md5-x + root.md5-width;
    if root.sha256-width > 0: Text {
        x: root.sha256-x + Theme.s2;
        width: root.sha256-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.sha256;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> crc32-x: root.sha256-x + root.sha256-width;
    if root.crc32-width > 0: Text {
        x: root.crc32-x + Theme.s2;
        width: root.crc32-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.crc32;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        overflow: elide;
    }
    property <length> name-freq-x: root.crc32-x + root.crc32-width;
    if root.name-freq-width > 0: Text {
        x: root.name-freq-x + Theme.s2;
        width: root.name-freq-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.name-freq;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
    property <length> ext-freq-x: root.name-freq-x + root.name-freq-width;
    if root.ext-freq-width > 0: Text {
        x: root.ext-freq-x + Theme.s2;
        width: root.ext-freq-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.ext-freq;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
    property <length> size-freq-x: root.ext-freq-x + root.ext-freq-width;
    if root.size-freq-width > 0: Text {
        x: root.size-freq-x + Theme.s2;
        width: root.size-freq-width - 2 * Theme.s2;
        height: parent.height;
        text: root.data.size-freq;
        color: root.other-color;
        font-size: Theme.list-text;
        vertical-alignment: center;
        horizontal-alignment: right;
        overflow: elide;
    }
}

// A dialog above the window: a dimmed backdrop, a card with a title, the
// content and a Close button. Esc, Enter and a click outside close it.
// A page tab of the help window: a label that is highlighted while its
// page is shown.
component HelpTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();

    height: label.preferred-height + 2 * Theme.s2;
    width: label.preferred-width + 2 * Theme.s3;
    border-radius: 4px;
    background: root.selected ? Theme.selection : touch.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.selected ? Theme.selection-text : Theme.text;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component InfoDialog inherits Rectangle {
    in property <string> title;
    in property <length> card-width: 420px;
    callback close();

    background: #00000060;
    TouchArea {
        clicked => { root.close(); }
    }
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape || event.text == Key.Return) {
                root.close();
            }
            accept
        }
    }
    Rectangle {
        width: min(root.card-width, root.width - 2 * Theme.s5);
        height: min(card-layout.preferred-height, root.height - 2 * Theme.s5);
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000040;
        clip: true;
        // Clicks on the card stay on it.
        TouchArea { }
        card-layout := VerticalLayout {
            padding: Theme.s5;
            spacing: Theme.s3;
            Text {
                text: root.title;
                font-size: Theme.body + 2px;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
            @children
            HorizontalLayout {
                alignment: end;
                padding-top: Theme.s2;
                Button {
                    text: @tr("Close");
                    primary: true;
                    clicked => { root.close(); }
                }
            }
        }
    }
}

// A drag handle on the boundary between two header cells.
component ColumnGrip inherits TouchArea {
    callback dragged(length);
    // A double-click sizes the column left of the boundary to fit.
    callback fit();
    width: Theme.s2;
    mouse-cursor: col-resize;
    // The grip follows the boundary, so the offset from the press point is the
    // movement since the previous event.
    moved => { root.dragged(self.mouse-x - self.pressed-x); }
    double-clicked => { root.fit(); }
    Rectangle {
        x: (parent.width - 1px) / 2;
        width: 1px;
        y: parent.height / 4;
        height: parent.height / 2;
        background: root.pressed || root.has-hover ? Theme.text-muted : Theme.line;
    }
}

export component AppWindow inherits Window {
    title: "EveryGrep";
    // Used on X11; Wayland compositors take the icon from the desktop entry
    // that matches the app id.
    icon: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
    preferred-width: 1040px;
    preferred-height: 660px;
    min-width: 560px;
    min-height: 320px;
    background: Theme.surface;
    default-font-size: Theme.body;

    // Whether the search field or the list has the keyboard focus. The
    // focused item loses it when another window becomes active, so this
    // also says the window is in front (a rename, a dialog or a menu that
    // has the focus counts as not in front).
    out property <bool> typing-here: search.focused || keys.has-focus;

    in property <[ResultRow]> results;
    // The status line: result count, details of the selection, the index
    // and the time of the last search.
    in property <string> status-count;
    in property <string> status-detail;
    in property <string> status-index;
    in property <string> status-right;
    // A long operation ("Indexing: 42%"), empty when none is shown, and
    // whether it can be cancelled with cancel-task().
    in property <string> progress-text;
    in property <bool> can-cancel;
    callback cancel-task();
    in property <string> message;
    in-out property <int> current: -1;
    // Text of the search field.
    in-out property <string> query <=> search.text;

    // Sort column (0 name, 1 folder, 2 size, 3 modified, 4 type, 5 extension,
    // 6 created, 7 accessed, 8 attributes; 9 MD5, 10 SHA-256 and 11 CRC-32,
    // which are never sorted by; 12 name, 13 extension and 14 size
    // frequency) and direction.
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-descending: false;

    // Matching modes and the filter; options-changed() runs the query again.
    in-out property <bool> match-case <=> search.match-case;
    in-out property <bool> whole-words <=> search.whole-words;
    in-out property <bool> match-path <=> search.match-path;
    in-out property <bool> match-diacritics <=> search.match-diacritics;
    in-out property <bool> use-regex <=> search.use-regex;
    // A click into the search field selects its text (a setting).
    in property <bool> select-search-on-click: true;
    // Every second row of the list has the row-alt background (a setting).
    in property <bool> alternate-rows: true;
    // A double-click on the Folder cell opens the containing folder (a
    // setting); elsewhere in the row it opens the item.
    in property <bool> path-click-opens-folder: true;
    // Modes without a toggle in the field: Search menu and Alt keys.
    in-out property <bool> match-prefix;
    in-out property <bool> match-suffix;
    in-out property <bool> ignore-punctuation;
    in-out property <bool> ignore-whitespace;
    in property <[string]> filter-names;
    in-out property <int> filter-index: 0;
    // Words for the modes that are on, shown in the status line.
    in property <[string]> badges;
    in property <bool> show-mode-badges: true;
    in property <bool> and-before-or;
    in property <bool> literal-operators;
    in property <bool> wildcards-anywhere;
    in property <bool> filter-wrap: true;
    in property <int> hidden-files;
    callback choose-hidden-files(int);
    callback options-changed();

    // Search history: step -1 goes back, 1 forward; the handler sets the
    // query. history-record() keeps the current query.
    callback history-step(int);
    // Puts a duplicate term in the query (0 contents, 1 name, 2 size) or
    // takes it out (-1).
    callback dupe-term(int);
    callback history-record();
    in property <[string]> history-rows;
    in-out property <int> history-sort;
    in property <bool> history-suggestions;
    in-out property <bool> history-full;
    property <bool> history-open;
    property <int> history-current: -1;
    callback history-list-requested();
    callback history-sort-changed(int);
    callback history-picked(string);
    callback organize-history();

    function choose-history(index: int) {
        if (index >= 0 && index < root.history-rows.length) {
            root.history-open = false;
            root.history-picked(root.history-rows[index]);
            root.results-replaced();
            search.focus-and-select();
        }
    }

    function history-key(event: KeyEvent) -> bool {
        if (!root.history-open) { return false; }
        if (event.text == Key.Escape) { root.history-open = false; return true; }
        if (!event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta
                && (event.text == Key.DownArrow || event.text == Key.UpArrow)) {
            root.history-current = max(-1, min(root.history-rows.length - 1,
                root.history-current + (event.text == Key.DownArrow ? 1 : -1)));
            return true;
        }
        if (event.text == Key.Return && root.history-current >= 0) {
            root.choose-history(root.history-current);
            return true;
        }
        return false;
    }
    // Search as you type is off and the search field changed: Enter runs
    // the search (search-now) instead of opening the current row.
    in property <bool> search-pending;
    callback search-now();

    // The settings window, and ending the program (also when closing the
    // window only hides it).
    callback open-settings();
    callback quit();
    // Another window over the same index.
    in property <[TabEntry]> tabs;
    in property <int> active-tab;
    in property <[string]> closed-tab-names;
    callback tab-command(Command);
    callback tab-selected(int);
    callback tab-closed(int);
    callback closed-tab-selected(int);
    in-out property <length> results-scroll-y <=> list.content-y;
    // Sideways scroll of the result table (0 or less), kept per tab.
    in-out property <length> results-scroll-x <=> list.content-x;
    in-out property <bool> open-searches-in-tabs;
    in-out property <bool> switch-to-new-tab;
    in-out property <bool> restore-session;
    callback tab-preference-changed(int, bool);
    callback new-window();
    // Closes the window as its close button does: hides it or quits, as
    // set on the Window page of the settings.
    callback close-window();
    // The settings window at its Keyboard page.
    callback open-keyboard-settings();
    // The keys shown in the menu bar, and the accessible label of the ⋯
    // button; both follow the keyboard settings.
    in property <MenuKeys> menu-keys;
    in property <string> more-label;
    // Saves the result list to a file.
    callback export-results();
    // Index menu: builds the index again from scratch, and stops applying
    // file changes until updates are resumed (the "Watch for changes"
    // setting, the other way round).
    callback rebuild-index();
    in-out property <bool> index-paused;
    callback index-paused-changed(bool);

    // Menu bar and the appearance choices in its View menu. The choices
    // are saved as settings; the program sets the lists again after a
    // change.
    in-out property <bool> show-menu-bar: true;
    in-out property <bool> status-details: true;
    in property <[MenuChoice]> filter-items;
    in property <[MenuChoice]> theme-items;
    in property <[MenuChoice]> density-items;
    in property <[MenuChoice]> folder-size-items;
    callback menu-bar-changed(bool);
    callback status-details-changed(bool);
    callback choose-theme(int);
    callback choose-density(int);
    callback choose-folder-size(int);

    // Help: the keyboard shortcuts and the about dialog.
    in property <[ShortcutRow]> shortcuts;
    in property <string> version;
    in-out property <bool> shortcuts-open;
    in-out property <bool> about-open;
    // The help window (F1): 0 search syntax, 1 regular expressions,
    // 2 command line options.
    in property <[HelpRow]> help-syntax;
    in property <[HelpRow]> help-regex;
    in property <[HelpRow]> help-command-line;
    in-out property <bool> help-open;
    in-out property <int> help-page;
    // Copies a report about the program and the system (no paths).
    callback copy-troubleshooting-info();
    // Opens the settings file in the desktop's application for it.
    callback open-settings-file();

    callback query-edited(string);
    callback generated-query-edited(string);
    // Runs the current search again and reads the shown details afresh.
    callback refresh();
    callback sort-changed(int, bool);
    // Whether a first click on the header of a column sorts it descending.
    pure callback first-descending(int) -> bool;
    // The widest-looking texts of a column (numbered as sort-column) in
    // `count` rows from row `first`.
    pure callback fit-texts(int, int, int) -> FitTexts;
    // The columns after the border right of column `left` (with column
    // `right` on its other side, -1 for none) was dragged by a length; see
    // src/columns.rs.
    pure callback drag-columns(ColumnLayout, int, int, length) -> ColumnDrag;
    callback activate(int);
    // Asks the desktop which application to open the item with.
    callback open-with(int);
    callback open-folder(int);
    // Selection: mode 0 selects only the row, 1 toggles it, 2 extends the
    // range from the anchor to it.
    callback select(int, int);
    // Actions on the selection, or on the given row when it is not selected.
    callback copy-names(int);
    // The full paths; with true each in double quotes (otherwise as the
    // "Copy full path adds quotes" setting says).
    callback copy-paths(int, bool);
    // The containing folders; with true each in double quotes.
    callback copy-folders(int, bool);
    // Files to the clipboard, and pasting them into the given folder row.
    callback cut-items(int);
    callback copy-items(int);
    callback paste-items(int);
    callback fileops-shortcuts(int);
    callback fileops-search(int, bool);
    callback rename-start(int);
    callback rename-commit(string);
    callback rename-cancel();
    callback trash(int);
    callback delete-request(int);
    callback confirm-accepted();
    callback confirm-cancelled();

    // A short note in the status line, e.g. "Copied 3 paths.", and whether
    // it reports a failure (drawn in the danger color; hints are muted).
    in property <string> notice;
    in property <bool> notice-error;

    // In-place rename: the row being edited (-1 for none), its text and the
    // part selected at the start.
    in property <int> rename-row: -1;
    in-out property <string> rename-text;
    in property <int> rename-stem;
    // The name being edited is in the first column: show it.
    changed rename-row => {
        if (self.rename-row >= 0) {
            list.content-x = 0;
        }
    }

    in property <bool> fileops-rename-open;
    in property <string> fileops-rename-location;
    in-out property <string> fileops-rename-name;
    in property <int> fileops-rename-stem;
    in property <string> fileops-rename-error;
    callback fileops-rename-edited(string);
    callback fileops-rename-submit();
    callback fileops-rename-cancel();

    // Confirmation dialog.
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-action;
    callback select-all();
    // Selects the rows that are not selected and unselects the others.
    callback invert-selection();
    // Returns whether anything was selected.
    callback clear-selection() -> bool;
    pure callback is-selected(int) -> bool;

    // Column widths. Every column but Folder keeps the width the user gave
    // it; Folder takes the rest of the window, so the columns end at the
    // right edge, or, when they do not fit (Folder at its minimum), they are
    // wider than the window and the list scrolls sideways. Until the user
    // drags Name, it takes 48 % of the room left by Size and Modified.
    in-out property <length> name-want: (self.width - self.size-want - self.date-want) * 0.48;
    // Folder's own width, 0 for none: set only while the columns are wider
    // than the window (see src/columns.rs), or by fitting Folder when it
    // cannot get its width otherwise.
    in-out property <length> folder-want: 0px;
    in-out property <length> size-want: 96px;
    in-out property <length> date-want: 120px;
    in-out property <length> type-want: 130px;
    in-out property <length> ext-want: 80px;
    in-out property <length> created-want: 120px;
    in-out property <length> accessed-want: 120px;
    in-out property <length> size-freq-want: 110px;
    in-out property <length> ext-freq-want: 110px;
    in-out property <length> name-freq-want: 110px;
    in-out property <length> crc32-want: 90px;
    in-out property <length> sha256-want: 300px;
    in-out property <length> md5-want: 270px;
    in-out property <length> attr-want: 64px;
    // Optional columns after Modified, hidden by default.
    in-out property <bool> show-type: false;
    in-out property <bool> show-ext: false;
    in-out property <bool> show-created: false;
    in-out property <bool> show-accessed: false;
    in-out property <bool> show-attrs: false;
    in-out property <bool> show-md5: false;
    in-out property <bool> show-sha256: false;
    in-out property <bool> show-crc32: false;
    in-out property <bool> show-name-freq: false;
    in-out property <bool> show-ext-freq: false;
    in-out property <bool> show-size-freq: false;
    // Created, Accessed, Attributes, a hash or a frequency column was shown
    // or hidden: their values are read (or counted) only while shown.
    callback detail-columns-changed();
    changed show-created => { root.detail-columns-changed(); }
    changed show-accessed => { root.detail-columns-changed(); }
    changed show-attrs => { root.detail-columns-changed(); }
    changed show-md5 => { root.detail-columns-changed(); }
    changed show-sha256 => { root.detail-columns-changed(); }
    changed show-crc32 => { root.detail-columns-changed(); }
    changed show-name-freq => { root.detail-columns-changed(); }
    changed show-ext-freq => { root.detail-columns-changed(); }
    changed show-size-freq => { root.detail-columns-changed(); }
    // Whether Name has a width of its own (dragged, or restored from the
    // settings) rather than its share of the window.
    in-out property <bool> name-set: false;
    out property <length> name-min: 120px;
    out property <length> folder-min: 100px;
    out property <length> size-min: 56px;
    out property <length> date-min: 80px;
    out property <length> type-min: 64px;
    out property <length> ext-min: 48px;
    out property <length> created-min: 80px;
    out property <length> accessed-min: 80px;
    out property <length> size-freq-min: 48px;
    out property <length> ext-freq-min: 48px;
    out property <length> name-freq-min: 48px;
    out property <length> crc32-min: 60px;
    out property <length> sha256-min: 60px;
    out property <length> md5-min: 60px;
    out property <length> attr-min: 40px;
    property <length> size-width: max(self.size-min, self.size-want);
    property <length> date-width: max(self.date-min, self.date-want);
    property <length> type-width: self.show-type ? max(self.type-min, self.type-want) : 0px;
    property <length> ext-width: self.show-ext ? max(self.ext-min, self.ext-want) : 0px;
    property <length> created-width: self.show-created ? max(self.created-min, self.created-want) : 0px;
    property <length> accessed-width: self.show-accessed ? max(self.accessed-min, self.accessed-want) : 0px;
    property <length> attr-width: self.show-attrs ? max(self.attr-min, self.attr-want) : 0px;
    property <length> md5-width: self.show-md5 ? max(self.md5-min, self.md5-want) : 0px;
    property <length> sha256-width: self.show-sha256 ? max(self.sha256-min, self.sha256-want) : 0px;
    property <length> crc32-width: self.show-crc32 ? max(self.crc32-min, self.crc32-want) : 0px;
    property <length> name-freq-width: self.show-name-freq ? max(self.name-freq-min, self.name-freq-want) : 0px;
    property <length> ext-freq-width: self.show-ext-freq ? max(self.ext-freq-min, self.ext-freq-want) : 0px;
    property <length> size-freq-width: self.show-size-freq ? max(self.size-freq-min, self.size-freq-want) : 0px;
    property <length> fixed-width: self.size-width + self.date-width + self.type-width + self.ext-width
        + self.created-width + self.accessed-width + self.attr-width
        + self.md5-width
        + self.sha256-width
        + self.crc32-width
        + self.name-freq-width
        + self.ext-freq-width
        + self.size-freq-width;
    property <length> name-width: max(self.name-min, self.name-want);
    property <length> folder-width: max(self.folder-min, max(self.folder-want,
        self.width - self.name-width - self.fixed-width));
    // Width of all columns: the window's, or more when they do not fit.
    property <length> table-width: self.name-width + self.folder-width + self.fixed-width;
    // How far the list can scroll sideways.
    out property <length> scroll-room: max(0px, self.table-width - list.visible-width);
    changed scroll-room => {
        list.content-x = max(list.content-x, -self.scroll-room);
    }
    // Left edges of the optional columns.
    property <length> type-x: self.name-width + self.folder-width + self.size-width + self.date-width;
    property <length> ext-x: self.type-x + self.type-width;
    property <length> created-x: self.ext-x + self.ext-width;
    property <length> accessed-x: self.created-x + self.created-width;
    property <length> attr-x: self.accessed-x + self.accessed-width;
    property <length> md5-x: self.attr-x + self.attr-width;
    property <length> sha256-x: self.md5-x + self.md5-width;
    property <length> crc32-x: self.sha256-x + self.sha256-width;
    property <length> name-freq-x: self.crc32-x + self.crc32-width;
    property <length> ext-freq-x: self.name-freq-x + self.name-freq-width;
    property <length> size-freq-x: self.ext-freq-x + self.ext-freq-width;

    // Width, minimum width and wanted width of column 3 (Modified) to 14
    // (Same size), numbered as sort-column.
    function col-width(c: int) -> length {
        return c == 3 ? root.date-width : c == 4 ? root.type-width : c == 5 ? root.ext-width
            : c == 6 ? root.created-width : c == 7 ? root.accessed-width : c == 8 ? root.attr-width : c == 9 ? root.md5-width : c == 10 ? root.sha256-width : c == 11 ? root.crc32-width : c == 12 ? root.name-freq-width : c == 13 ? root.ext-freq-width : root.size-freq-width;
    }
    function col-min(c: int) -> length {
        return c == 3 ? root.date-min : c == 4 ? root.type-min : c == 5 ? root.ext-min
            : c == 6 ? root.created-min : c == 7 ? root.accessed-min : c == 8 ? root.attr-min : c == 9 ? root.md5-min : c == 10 ? root.sha256-min : c == 11 ? root.crc32-min : c == 12 ? root.name-freq-min : c == 13 ? root.ext-freq-min : root.size-freq-min;
    }
    function set-col-want(c: int, w: length) {
        if (c == 3) {
            root.date-want = w;
        } else if (c == 4) {
            root.type-want = w;
        } else if (c == 5) {
            root.ext-want = w;
        } else if (c == 6) {
            root.created-want = w;
        } else if (c == 7) {
            root.accessed-want = w;
        } else if (c == 8) {
            root.attr-want = w;
        } else if (c == 9) {
            root.md5-want = w;
        } else if (c == 10) {
            root.sha256-want = w;
        } else if (c == 11) {
            root.crc32-want = w;
        } else if (c == 12) {
            root.name-freq-want = w;
        } else if (c == 13) {
            root.ext-freq-want = w;
        } else {
            root.size-freq-want = w;
        }
    }
    // Header label and minimum width of any column, numbered as sort-column.
    function col-label(c: int) -> string {
        return c == 0 ? @tr("Name") : c == 1 ? @tr("Folder") : c == 2 ? @tr("Size")
            : c == 3 ? @tr("Modified") : c == 4 ? @tr("Type") : c == 5 ? @tr("Extension")
            : c == 6 ? @tr("Created") : c == 7 ? @tr("Accessed") : c == 8 ? @tr("Attributes") : c == 9 ? @tr("MD5") : c == 10 ? @tr("SHA-256") : c == 11 ? @tr("CRC-32") : c == 12 ? @tr("Same name") : c == 13 ? @tr("Same extension") : @tr("Same size");
    }
    function any-min(c: int) -> length {
        return c == 0 ? root.name-min : c == 1 ? root.folder-min : c == 2 ? root.size-min
            : root.col-min(c);
    }
    function col-shown(c: int) -> bool {
        return c <= 3 || (c == 4 && root.show-type) || (c == 5 && root.show-ext)
            || (c == 6 && root.show-created) || (c == 7 && root.show-accessed)
            || (c == 8 && root.show-attrs)
            || (c == 9 && root.show-md5)
            || (c == 10 && root.show-sha256)
            || (c == 11 && root.show-crc32)
            || (c == 12 && root.show-name-freq)
            || (c == 13 && root.show-ext-freq)
            || (c == 14 && root.show-size-freq);
    }

    // Texts measured to size a column to fit: the widest-looking cells of
    // the rows on screen and the header label.
    property <string> fit-a;
    property <string> fit-b;
    property <string> fit-c;
    property <string> fit-label;
    // The column whose header was right-clicked, for "Size column to fit".
    property <int> menu-column: 0;

    // The width column c needs for its cells on screen and its header
    // label; 0 for a hidden column.
    function fit-width(c: int) -> length {
        if (!root.col-shown(c)) {
            return 0px;
        }
        let first = max(0, floor(-list.content-y / Theme.row-height));
        let count = ceil(list.visible-height / Theme.row-height) + 1;
        let texts = root.fit-texts(c, first, count);
        root.fit-a = texts.a;
        root.fit-b = texts.b;
        root.fit-c = texts.c;
        root.fit-label = root.col-label(c);
        let text = max(fit-a-probe.preferred-width, max(fit-b-probe.preferred-width, fit-c-probe.preferred-width));
        // The room around the text in a cell (see Row): Name has the icon
        // and its bold marks, Folder its bold marks.
        let room = c == 0 ? Theme.s3 + Theme.row-icon + 2 * Theme.s2 + Theme.s1
            : c == 1 ? 2 * Theme.s2 + Theme.s1 : 2 * Theme.s2;
        let label = fit-label-probe.preferred-width + 2 * Theme.s2 + Theme.icon;
        return max(root.any-min(c), max(text + room, label));
    }

    // Gives column c the width w. Folder takes what Name leaves, so it is
    // sized through Name.
    function set-width(c: int, w: length) {
        if (c == 0) {
            root.name-want = w;
            root.name-set = true;
        } else if (c == 1) {
            // Name takes the rest; when that is less than its minimum, Folder
            // keeps w as its own width and the columns get wider than the
            // window.
            root.name-want = max(root.name-min, root.width - root.fixed-width - w);
            root.name-set = true;
            root.folder-want = root.name-min + w + root.fixed-width > root.width ? w : 0px;
        } else if (c == 2) {
            root.size-want = w;
        } else {
            root.set-col-want(c, w);
        }
    }

    // Sizes one column to fit the rows on screen.
    function fit-column(c: int) {
        root.set-width(c, root.fit-width(c));
    }

    // Sizes every shown column to fit; Folder takes the rest of the window.
    function fit-all-columns() {
        root.folder-want = 0px;
        root.fit-column(2);
        root.fit-column(3);
        if (root.show-type) { root.fit-column(4); }
        if (root.show-ext) { root.fit-column(5); }
        if (root.show-created) { root.fit-column(6); }
        if (root.show-accessed) { root.fit-column(7); }
        if (root.show-attrs) { root.fit-column(8); }
        if (root.show-md5) { root.fit-column(9); }
        if (root.show-sha256) { root.fit-column(10); }
        if (root.show-crc32) { root.fit-column(11); }
        if (root.show-name-freq) { root.fit-column(12); }
        if (root.show-ext-freq) { root.fit-column(13); }
        if (root.show-size-freq) { root.fit-column(14); }
        root.fit-column(0);
    }

    // Sizes every shown column to fit, then widens or narrows all of them
    // by the same factor so together they fill the window.
    function fit-columns-to-window() {
        let w0 = root.fit-width(0);
        let w1 = root.fit-width(1);
        let w2 = root.fit-width(2);
        let w3 = root.fit-width(3);
        let w4 = root.fit-width(4);
        let w5 = root.fit-width(5);
        let w6 = root.fit-width(6);
        let w7 = root.fit-width(7);
        let w8 = root.fit-width(8);
        let w9 = root.fit-width(9);
        let w10 = root.fit-width(10);
        let w11 = root.fit-width(11);
        let w12 = root.fit-width(12);
        let w13 = root.fit-width(13);
        let w14 = root.fit-width(14);
        let total = w0 + w1 + w2 + w3 + w4 + w5 + w6 + w7 + w8
            + w9
            + w10
            + w11
            + w12
            + w13
            + w14;
        if (total <= 0px) {
            return;
        }
        let f = root.width / total;
        root.folder-want = 0px;
        root.size-want = max(root.size-min, w2 * f);
        root.date-want = max(root.date-min, w3 * f);
        if (root.show-type) { root.type-want = max(root.type-min, w4 * f); }
        if (root.show-ext) { root.ext-want = max(root.ext-min, w5 * f); }
        if (root.show-created) { root.created-want = max(root.created-min, w6 * f); }
        if (root.show-accessed) { root.accessed-want = max(root.accessed-min, w7 * f); }
        if (root.show-attrs) { root.attr-want = max(root.attr-min, w8 * f); }
        if (root.show-md5) { root.md5-want = max(root.md5-min, w9 * f); }
        if (root.show-sha256) { root.sha256-want = max(root.sha256-min, w10 * f); }
        if (root.show-crc32) { root.crc32-want = max(root.crc32-min, w11 * f); }
        if (root.show-name-freq) { root.name-freq-want = max(root.name-freq-min, w12 * f); }
        if (root.show-ext-freq) { root.ext-freq-want = max(root.ext-freq-min, w13 * f); }
        if (root.show-size-freq) { root.size-freq-want = max(root.size-freq-min, w14 * f); }
        root.name-want = max(root.name-min, w0 * f);
        root.name-set = true;
    }

    // The shown column left of optional column c; Modified (3) is always shown.
    function left-of(c: int) -> int {
        return c > 13 && root.show-ext-freq ? 13
            : c > 12 && root.show-name-freq ? 12
            : c > 11 && root.show-crc32 ? 11
            : c > 10 && root.show-sha256 ? 10
            : c > 9 && root.show-md5 ? 9
            : c > 8 && root.show-attrs ? 8
            : c > 7 && root.show-accessed ? 7 : c > 6 && root.show-created ? 6
            : c > 5 && root.show-ext ? 5 : c > 4 && root.show-type ? 4 : 3;
    }

    // The last shown column.
    function last-shown() -> int {
        return root.show-size-freq ? 14
            : root.show-ext-freq ? 13
            : root.show-name-freq ? 12
            : root.show-crc32 ? 11
            : root.show-sha256 ? 10
            : root.show-md5 ? 9
            : root.show-attrs ? 8 : root.show-accessed ? 7 : root.show-created ? 6
            : root.show-ext ? 5 : root.show-type ? 4 : 3;
    }

    // Dragging a boundary moves it with the pointer: 0 is Name|Folder, 1
    // Folder|Size, 2 Size|Modified, 4 to 14 the left edge of that optional
    // column, 99 the right edge of the last column. The column on the left
    // grows or shrinks; the one on the right gives or takes the room while
    // the columns fit, and past that they get wider than the window (or
    // narrower again). See src/columns.rs.
    function drag-boundary(boundary: int, delta: length) {
        let left = boundary <= 2 ? boundary : boundary == 99 ? root.last-shown() : root.left-of(boundary);
        let right = boundary <= 2 ? boundary + 1 : boundary == 99 ? -1 : boundary;
        let next = root.drag-columns({
            widths: [root.name-width, root.folder-width, root.size-width, root.date-width,
                root.type-width, root.ext-width, root.created-width, root.accessed-width,
                root.attr-width,
                root.md5-width,
                root.sha256-width,
                root.crc32-width,
                root.name-freq-width,
                root.ext-freq-width,
                root.size-freq-width],
            mins: [root.name-min, root.folder-min, root.size-min, root.date-min, root.type-min,
                root.ext-min, root.created-min, root.accessed-min, root.attr-min,
                root.md5-min,
                root.sha256-min,
                root.crc32-min,
                root.name-freq-min,
                root.ext-freq-min,
                root.size-freq-min],
            window: root.width,
            folder-want: root.folder-want,
        }, left, right, delta);
        if (left <= 3) {
            // Name keeps its width from now on (until then it follows the
            // window and the widths of Size and Modified).
            root.name-want = root.name-width;
            root.name-set = true;
        }
        root.folder-want = next.folder-want;
        root.take-width(left, next.left);
        if (right >= 0) {
            root.take-width(right, next.right);
        }
    }

    // Gives column c the width w after a drag; Folder's comes from
    // folder-want.
    function take-width(c: int, w: length) {
        if (c == 0) {
            root.name-want = w;
        } else if (c == 2) {
            root.size-want = w;
        } else if (c >= 3) {
            root.set-col-want(c, w);
        }
    }

    // After an optional column (4 to 14, see sort-column) was shown or hidden:
    // hiding the sorted column sorts by name again.
    function column-shown(column: int, shown: bool) {
        if (!shown && root.sort-column == column) {
            root.sort-column = 0;
            root.sort-descending = false;
            root.results-replaced();
            root.sort-changed(0, false);
        }
    }

    // Back to the top of a new result list.
    function results-replaced() {
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
    }

    function options-edited() {
        root.results-replaced();
        root.options-changed();
    }

    function history-go(step: int) {
        root.history-open = false;
        root.history-step(step);
        root.results-replaced();
    }

    // The command a key runs while the focus is in a scope (0 anywhere,
    // 1 the search field, 2 the result list); Command.none for none. See
    // src/commands.rs.
    callback add-filter();
    callback organize-filters();
    callback restore-filters();
    callback add-bookmark();
    callback organize-bookmarks();
    in property <[string]> bookmark-names;
    callback open-bookmark(int);
    callback saved-key(string, bool, bool, bool, bool) -> bool;
    callback advanced-search();
    callback resolve-key(int, string, bool, bool, bool, bool) -> Command;

    // File actions that are refused, with a note, for an item on a drive
    // that is not connected.
    function needs-online(c: Command) -> bool {
        return c == Command.open || c == Command.open-folder || c == Command.open-with
            || c == Command.cut || c == Command.copy || c == Command.paste
            || c == Command.rename || c == Command.create-shortcut || c == Command.trash || c == Command.delete-permanently;
    }

    // Whether a command can run now; menu items are enabled by it.
    function can-run(c: Command) -> bool {
        if (root.confirm-open || root.fileops-rename-open) {
            return false;
        }
        if (root.needs-online(c)) {
            return root.current >= 0 && !root.current-offline
                && (c != Command.rename || root.rename-row < 0);
        }
        if (c == Command.copy-name || c == Command.copy-path || c == Command.copy-full-path
                || c == Command.copy-path-quoted || c == Command.copy-full-path-quoted
                || c == Command.search-in-program || c == Command.search-containing-folder
                || c == Command.toggle-row || c == Command.context-menu) {
            return root.current >= 0;
        }
        if (c == Command.export-results || c == Command.select-all || c == Command.invert-selection) {
            return root.results.length > 0;
        }
        return c != Command.none;
    }

    // Runs a command.
    function run(c: Command) {
        if (c == Command.new-tab || c == Command.close-tab || c == Command.duplicate-tab || c == Command.next-tab || c == Command.previous-tab || c == Command.select-tab-1 || c == Command.select-tab-2 || c == Command.select-tab-3 || c == Command.select-tab-4 || c == Command.select-tab-5 || c == Command.select-tab-6 || c == Command.select-tab-7 || c == Command.select-tab-8 || c == Command.select-tab-9 || c == Command.select-tab-10 || c == Command.list-tabs || c == Command.close-multiple-tabs || c == Command.close-left-tabs || c == Command.close-right-tabs || c == Command.close-other-tabs || c == Command.reopen-tab || c == Command.reopen-all-tabs) {
            root.tab-command(c);
        } else if (c == Command.new-window) {
            root.new-window();
        } else if (c == Command.close-window) {
            root.close-window();
        } else if (c == Command.export-results) {
            root.export-results();
        } else if (c == Command.quit) {
            root.quit();
        } else if (c == Command.open) {
            root.activate(root.current);
        } else if (c == Command.open-folder) {
            root.open-folder(root.current);
        } else if (c == Command.open-with) {
            root.open-with(root.current);
        } else if (c == Command.cut) {
            root.cut-items(root.current);
        } else if (c == Command.copy) {
            root.copy-items(root.current);
        } else if (c == Command.paste) {
            root.paste-items(root.current);
        } else if (c == Command.copy-name) {
            root.copy-names(root.current);
        } else if (c == Command.copy-path) {
            root.copy-folders(root.current, false);
        } else if (c == Command.copy-full-path) {
            root.copy-paths(root.current, false);
        } else if (c == Command.copy-path-quoted) {
            root.copy-folders(root.current, true);
        } else if (c == Command.copy-full-path-quoted) {
            root.copy-paths(root.current, true);
        } else if (c == Command.select-all) {
            root.select-all();
            keys.focus();
        } else if (c == Command.invert-selection) {
            root.invert-selection();
            keys.focus();
        } else if (c == Command.toggle-row) {
            root.select(root.current, 1);
        } else if (c == Command.search-in-program || c == Command.search-containing-folder) {
            root.fileops-search(root.current, c == Command.search-containing-folder);
        } else if (c == Command.create-shortcut) {
            root.fileops-shortcuts(root.current);
        } else if (c == Command.rename) {
            root.rename-start(root.current);
        } else if (c == Command.trash) {
            root.trash(root.current);
        } else if (c == Command.delete-permanently) {
            root.delete-request(root.current);
        } else if (c == Command.focus-search) {
            search.focus-and-select();
        } else if (c == Command.context-menu) {
            root.show-menu-at-current();
        } else if (c == Command.type-column) {
            root.show-type = !root.show-type;
            root.toggled(c);
        } else if (c == Command.extension-column) {
            root.show-ext = !root.show-ext;
            root.toggled(c);
        } else if (c == Command.created-column) {
            root.show-created = !root.show-created;
            root.toggled(c);
        } else if (c == Command.accessed-column) {
            root.show-accessed = !root.show-accessed;
            root.toggled(c);
        } else if (c == Command.attributes-column) {
            root.show-attrs = !root.show-attrs;
            root.toggled(c);
        } else if (c == Command.md5-column) {
            root.show-md5 = !root.show-md5;
            root.toggled(c);
        } else if (c == Command.sha256-column) {
            root.show-sha256 = !root.show-sha256;
            root.toggled(c);
        } else if (c == Command.crc32-column) {
            root.show-crc32 = !root.show-crc32;
            root.toggled(c);
        } else if (c == Command.name-frequency-column) {
            root.show-name-freq = !root.show-name-freq;
            root.toggled(c);
        } else if (c == Command.extension-frequency-column) {
            root.show-ext-freq = !root.show-ext-freq;
            root.toggled(c);
        } else if (c == Command.size-frequency-column) {
            root.show-size-freq = !root.show-size-freq;
            root.toggled(c);
        } else if (c == Command.selection-details) {
            root.status-details = !root.status-details;
            root.toggled(c);
        } else if (c == Command.menu-bar) {
            root.show-menu-bar = !root.show-menu-bar;
            root.toggled(c);
        } else if (c == Command.match-case) {
            root.match-case = !root.match-case;
            root.toggled(c);
        } else if (c == Command.whole-words) {
            root.whole-words = !root.whole-words;
            root.toggled(c);
        } else if (c == Command.match-path) {
            root.match-path = !root.match-path;
            root.toggled(c);
        } else if (c == Command.match-diacritics) {
            root.match-diacritics = !root.match-diacritics;
            root.toggled(c);
        } else if (c == Command.regex) {
            root.use-regex = !root.use-regex;
            root.toggled(c);
        } else if (c == Command.match-prefix) {
            root.match-prefix = !root.match-prefix;
            root.toggled(c);
        } else if (c == Command.match-suffix) {
            root.match-suffix = !root.match-suffix;
            root.toggled(c);
        } else if (c == Command.ignore-punctuation) {
            root.ignore-punctuation = !root.ignore-punctuation;
            root.toggled(c);
        } else if (c == Command.ignore-whitespace) {
            root.ignore-whitespace = !root.ignore-whitespace;
            root.toggled(c);
        } else if (c == Command.show-hidden-files) {
            root.choose-hidden-files(0);
        } else if (c == Command.hide-hidden-files) {
            root.choose-hidden-files(1);
        } else if (c == Command.only-hidden-files) {
            root.choose-hidden-files(2);
        } else if (c == Command.cycle-hidden-files) {
            root.choose-hidden-files(Math.mod(root.hidden-files + 1, 3));
        } else if (c == Command.previous-filter || c == Command.next-filter) {
            let n = root.filter-names.length;
            if (n > 0) {
                let step = c == Command.previous-filter ? -1 : 1;
                let next = root.filter-wrap ? Math.mod(root.filter-index + step + n, n)
                    : max(0, min(n - 1, root.filter-index + step));
                if (next != root.filter-index) {
                    root.filter-index = next;
                    root.options-edited();
                }
            }
        } else if (c == Command.previous-search) {
            root.history-go(-1);
        } else if (c == Command.next-search) {
            root.history-go(1);
        } else if (c == Command.find-duplicates) {
            root.dupe-term(0);
            root.results-replaced();
        } else if (c == Command.find-name-duplicates) {
            root.dupe-term(1);
            root.results-replaced();
        } else if (c == Command.find-size-duplicates) {
            root.dupe-term(2);
            root.results-replaced();
        } else if (c == Command.clear-duplicates) {
            root.dupe-term(-1);
            root.results-replaced();
        } else if (c == Command.rebuild-index) {
            root.rebuild-index();
        } else if (c == Command.pause-index-updates) {
            root.index-paused = !root.index-paused;
            root.toggled(c);
        } else if (c == Command.show-history) {
            root.history-full = true;
            root.history-current = -1;
            root.history-list-requested();
            root.history-open = !root.history-open;
            search.focus-and-select();
        } else if (c == Command.organize-history) {
            root.history-open = false;
            root.organize-history();
        } else if (c == Command.add-filter) {
            root.add-filter();
        } else if (c == Command.organize-filters) {
            root.organize-filters();
        } else if (c == Command.restore-filters) {
            root.restore-filters();
        } else if (c == Command.add-bookmark) { root.add-bookmark();
        } else if (c == Command.organize-bookmarks) { root.organize-bookmarks();
        } else if (c == Command.advanced-search) { root.advanced-search();
        } else if (c == Command.settings) {
            root.open-settings();
        } else if (c == Command.keyboard-settings) {
            root.open-keyboard-settings();
        } else if (c == Command.shortcuts-help) {
            root.shortcuts-open = true;
        } else if (c == Command.search-syntax-help) {
            root.help-page = 0;
            root.help-open = true;
        } else if (c == Command.regex-help) {
            root.help-page = 1;
            root.help-open = true;
        } else if (c == Command.command-line-help) {
            root.help-page = 2;
            root.help-open = true;
        } else if (c == Command.open-settings-file) {
            root.open-settings-file();
        } else if (c == Command.copy-troubleshooting-info) {
            root.copy-troubleshooting-info();
        } else if (c == Command.about) {
            root.about-open = true;
        } else if (c == Command.refresh) {
            root.refresh();
        } else if (c == Command.fit-columns) {
            root.fit-all-columns();
        } else if (c == Command.fit-columns-to-window) {
            root.fit-columns-to-window();
        }
    }

    // After an on/off command changed its flag (by a key, or by its
    // checkable menu item, which flips the flag itself): applies it.
    function toggled(c: Command) {
        if (c == Command.type-column) {
            root.column-shown(4, root.show-type);
        } else if (c == Command.extension-column) {
            root.column-shown(5, root.show-ext);
        } else if (c == Command.created-column) {
            root.column-shown(6, root.show-created);
        } else if (c == Command.accessed-column) {
            root.column-shown(7, root.show-accessed);
        } else if (c == Command.attributes-column) {
            root.column-shown(8, root.show-attrs);
        } else if (c == Command.md5-column) {
            root.column-shown(9, root.show-md5);
        } else if (c == Command.sha256-column) {
            root.column-shown(10, root.show-sha256);
        } else if (c == Command.crc32-column) {
            root.column-shown(11, root.show-crc32);
        } else if (c == Command.name-frequency-column) {
            root.column-shown(12, root.show-name-freq);
        } else if (c == Command.extension-frequency-column) {
            root.column-shown(13, root.show-ext-freq);
        } else if (c == Command.size-frequency-column) {
            root.column-shown(14, root.show-size-freq);
        } else if (c == Command.selection-details) {
            root.status-details-changed(root.status-details);
        } else if (c == Command.menu-bar) {
            root.menu-bar-changed(root.show-menu-bar);
        } else if (c == Command.pause-index-updates) {
            root.index-paused-changed(root.index-paused);
        } else {
            root.options-edited();
        }
    }

    // View → Sort by: the columns, the shown optional ones enabled, and the
    // two directions. A new list on every change gives fresh check marks.
    property <[SortChoice]> sort-items: [
        { title: @tr("Name"), column: 0, checked: root.sort-column == 0, enabled: true },
        { title: @tr("Folder"), column: 1, checked: root.sort-column == 1, enabled: true },
        { title: @tr("Size"), column: 2, checked: root.sort-column == 2, enabled: true },
        { title: @tr("Modified"), column: 3, checked: root.sort-column == 3, enabled: true },
        { title: @tr("Type"), column: 4, checked: root.sort-column == 4, enabled: root.show-type },
        { title: @tr("Extension"), column: 5, checked: root.sort-column == 5, enabled: root.show-ext },
        { title: @tr("Created"), column: 6, checked: root.sort-column == 6, enabled: root.show-created },
        { title: @tr("Accessed"), column: 7, checked: root.sort-column == 7, enabled: root.show-accessed },
        { title: @tr("Attributes"), column: 8, checked: root.sort-column == 8, enabled: root.show-attrs },
        { title: @tr("Same name"), column: 12, checked: root.sort-column == 12, enabled: root.show-name-freq },
        { title: @tr("Same extension"), column: 13, checked: root.sort-column == 13, enabled: root.show-ext-freq },
        { title: @tr("Same size"), column: 14, checked: root.sort-column == 14, enabled: root.show-size-freq },
    ];
    property <[MenuChoice]> sort-order-items: [
        { title: @tr("Ascending"), checked: !root.sort-descending },
        { title: @tr("Descending"), checked: root.sort-descending },
    ];

    // Sorts by a column in a direction.
    function sort-to(column: int, descending: bool) {
        root.sort-column = column;
        root.sort-descending = descending;
        root.results-replaced();
        root.sort-changed(column, descending);
    }

    // Runs the command of a key pressed with the focus in `scope`; returns
    // whether the key belongs to a command (it is used even when the
    // command cannot run now). A file action on an offline item runs, so
    // the program can say why it is refused.
    function dispatch(scope: int, event: KeyEvent) -> bool {
        let c = root.resolve-key(scope, event.text, event.modifiers.control, event.modifiers.alt,
            event.modifiers.shift, event.modifiers.meta);
        if (c == Command.none) {
            if (root.confirm-open || root.fileops-rename-open) { return false; }
            return root.saved-key(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
        }
        if (root.can-run(c) || (!root.confirm-open && root.current >= 0 && root.needs-online(c))) {
            root.run(c);
        }
        true
    }

    // Colors: 1 light, 2 dark, 0 the toolkit's reading of the desktop
    // setting. Sets the palette of the standard widgets too.
    public function set-color-scheme(scheme: int) {
        Theme.scheme = scheme == 1 ? ColorScheme.light : scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Palette.color-scheme = Theme.scheme;
    }

    // Density of the list: compact or comfortable.
    public function set-compact(compact: bool) {
        Theme.compact = compact;
    }

    public function focus-search() {
        search.focus-and-select();
    }

    // Puts the search field's text cursor at `offset` (in bytes), nothing
    // selected; used after the query is set from the history.
    public function place-search-caret(offset: int) {
        search.place-caret(offset);
    }

    public function focus-list() {
        keys.focus();
    }

    // Puts text on the clipboard through a hidden text field; Slint has no
    // clipboard API of its own.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    // The text on the clipboard, read through the same hidden field.
    public function paste-text() -> string {
        clip.text = "";
        clip.paste();
        let text = clip.text;
        clip.text = "";
        return text;
    }

    // Opens the context menu next to the current row.
    function show-menu-at-current() {
        if (root.current >= 0) {
            menu-area.show({
                x: Theme.s3 + Theme.icon,
                y: (root.current + 1) * Theme.row-height + list.content-y,
            });
        }
    }

    // Moves the cursor; mode as for select(), or -1 to move without changing
    // the selection.
    function move-to(row: int, mode: int) {
        if (root.results.length == 0) {
            return;
        }
        root.current = max(0, min(root.results.length - 1, row));
        if (mode >= 0) {
            root.select(root.current, mode);
        }
        // Keep the current row inside the visible part of the list.
        let top = root.current * Theme.row-height;
        if (top < -list.content-y) {
            list.content-y = -top;
        } else if (top + Theme.row-height > -list.content-y + list.visible-height) {
            list.content-y = -(top + Theme.row-height - list.visible-height);
        }
    }

    // A click on the sorted column flips the direction; another column starts
    // ascending, or descending for dates and sizes when the settings say so.
    function sort-by(column: int) {
        if (root.sort-column == column) {
            root.sort-descending = !root.sort-descending;
        } else {
            root.sort-column = column;
            root.sort-descending = root.first-descending(column);
        }
        root.current = root.results.length > 0 ? 0 : -1;
        list.content-y = 0;
        root.sort-changed(root.sort-column, root.sort-descending);
    }

    property <int> page: max(1, floor(list.visible-height / Theme.row-height) - 1);
    // The current row is on a drive that is not connected: file actions
    // are off for it.
    property <bool> current-offline: root.current >= 0 && root.current < root.results.length
        && root.results[root.current].offline;

    // Keys pressed while the focus is on a control without keys of its own
    // (the filter selector, a button) run the global commands. It never
    // takes the focus itself.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(event) => {
            if (root.dispatch(0, event)) {
                return accept;
            }
            reject
        }

        VerticalLayout {
            if root.tabs.length >= 2: TabStrip {
                tabs: root.tabs;
                active: root.active-tab;
                selected(i) => { root.tab-selected(i); }
                closed(i) => { root.tab-closed(i); }
                list => { root.tab-command(Command.list-tabs); }
            }
            // Top bar
            Rectangle {
                height: Theme.top-bar-height;
                background: Theme.surface;
                HorizontalLayout {
                    padding-left: Theme.s3;
                    padding-right: Theme.s3;
                    padding-top: (Theme.top-bar-height - Theme.field-height) / 2;
                    padding-bottom: (Theme.top-bar-height - Theme.field-height) / 2;
                    spacing: Theme.s2;
                    search := SearchField {
                        horizontal-stretch: 1;
                        select-on-click: root.select-search-on-click;
                        edited(text) => {
                            root.current = root.results.length > 0 ? 0 : -1;
                            list.content-y = 0;
                            root.history-full = false;
                            root.history-current = -1;
                            root.query-edited(text);
                            root.history-open = root.history-suggestions && root.history-rows.length > 0;
                        }
                        modes-changed => { root.options-edited(); }
                        history-requested => { root.run(Command.show-history); }
                        shortcut(event) => { root.history-key(event) || root.dispatch(1, event) }
                        accepted => {
                            root.history-open = false;
                            if (root.search-pending) {
                                root.search-now();
                            } else {
                                root.history-record();
                                if (root.current >= 0) {
                                    root.activate(root.current);
                                }
                            }
                        }
                        down-pressed => {
                            keys.focus();
                            // The current row is not shown while the search
                            // field has the focus: an unselected one (as after
                            // a new search) is where Down lands; from a kept
                            // selection Down goes on to the next row.
                            root.move-to(root.current < 0 ? 0 : root.is-selected(root.current) ? root.current + 1 : root.current, 0);
                        }
                        escape-pressed => {
                            self.text = "";
                            root.query-edited("");
                        }
                    }
                    ComboBox {
                        width: 160px;
                        horizontal-stretch: 0;
                        accessible-label: @tr("Filter");
                        model: root.filter-names;
                        current-index <=> root.filter-index;
                        selected => { root.options-edited(); }
                    }
                    // Overflow menu, in place of the menu bar when that is hidden.
                    if !root.show-menu-bar: more-menu := ContextMenuArea {
                        width: 34px;
                        Menu {
                            MenuItem {
                                title: @tr("Settings…");
                                enabled: root.can-run(Command.settings);
                                activated => { root.run(Command.settings); }
                            }
                            MenuItem {
                                title: @tr("Customize shortcuts…");
                                enabled: root.can-run(Command.keyboard-settings);
                                activated => { root.run(Command.keyboard-settings); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Search syntax");
                                activated => { root.run(Command.search-syntax-help); }
                            }
                            MenuItem {
                                title: @tr("Keyboard shortcuts");
                                activated => { root.run(Command.shortcuts-help); }
                            }
                            MenuItem {
                                title: @tr("About EveryGrep");
                                activated => { root.run(Command.about); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Show the menu bar");
                                activated => { root.run(Command.menu-bar); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Quit");
                                enabled: root.can-run(Command.quit);
                                activated => { root.run(Command.quit); }
                            }
                        }
                        Rectangle {
                            border-radius: Theme.radius;
                            background: more-touch.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: root.more-label;
                            accessible-action-default => { more-menu.show({ x: 0, y: self.height }); }
                            more-touch := TouchArea {
                                clicked => { more-menu.show({ x: 0, y: self.height }); }
                            }
                            Image {
                                source: @image-url("icons/more.svg");
                                colorize: Theme.text-muted;
                                width: Theme.icon;
                                height: Theme.icon;
                            }
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }

            // Column headers (positioned directly, so they never feed back into
            // the window's layout). Right-click shows or hides optional columns.
            Rectangle {
                height: Theme.header-height;
                background: Theme.surface-alt;
                clip: true;
                // The headers move with the rows when the list scrolls sideways.
                Rectangle {
                    x: list.content-x;
                    width: root.table-width;
                    height: parent.height;
                    header-menu := ContextMenuArea {
                        Menu {
                            // Activating a checkable item flips its check mark, which
                            // is tied to the column flag both ways.
                            MenuItem {
                                title: @tr("Type");
                                checkable: true;
                                checked <=> root.show-type;
                                activated => { root.column-shown(4, root.show-type); }
                            }
                            MenuItem {
                                title: @tr("Extension");
                                checkable: true;
                                checked <=> root.show-ext;
                                activated => { root.column-shown(5, root.show-ext); }
                            }
                            MenuItem {
                                title: @tr("Created");
                                checkable: true;
                                checked <=> root.show-created;
                                activated => { root.column-shown(6, root.show-created); }
                            }
                            MenuItem {
                                title: @tr("Accessed");
                                checkable: true;
                                checked <=> root.show-accessed;
                                activated => { root.column-shown(7, root.show-accessed); }
                            }
                            MenuItem {
                                title: @tr("Attributes");
                                checkable: true;
                                checked <=> root.show-attrs;
                                activated => { root.column-shown(8, root.show-attrs); }
                            }
                            MenuItem {
                                title: @tr("MD5");
                                checkable: true;
                                checked <=> root.show-md5;
                                activated => { root.column-shown(9, root.show-md5); }
                            }
                            MenuItem {
                                title: @tr("SHA-256");
                                checkable: true;
                                checked <=> root.show-sha256;
                                activated => { root.column-shown(10, root.show-sha256); }
                            }
                            MenuItem {
                                title: @tr("CRC-32");
                                checkable: true;
                                checked <=> root.show-crc32;
                                activated => { root.column-shown(11, root.show-crc32); }
                            }
                            MenuItem {
                                title: @tr("Same name");
                                checkable: true;
                                checked <=> root.show-name-freq;
                                activated => { root.column-shown(12, root.show-name-freq); }
                            }
                            MenuItem {
                                title: @tr("Same extension");
                                checkable: true;
                                checked <=> root.show-ext-freq;
                                activated => { root.column-shown(13, root.show-ext-freq); }
                            }
                            MenuItem {
                                title: @tr("Same size");
                                checkable: true;
                                checked <=> root.show-size-freq;
                                activated => { root.column-shown(14, root.show-size-freq); }
                            }
                            MenuSeparator { }
                            MenuItem {
                                title: @tr("Size column to fit");
                                activated => { root.fit-column(root.menu-column); }
                            }
                            MenuItem {
                                title: @tr("Size all columns to fit");
                                activated => { root.run(Command.fit-columns); }
                            }
                            MenuItem {
                                title: @tr("Fit columns to window");
                                activated => { root.run(Command.fit-columns-to-window); }
                            }
                        }
                        HeaderCell {
                            x: Theme.s1;
                            width: root.name-width - Theme.s1;
                            height: parent.height;
                            label: @tr("Name");
                            sorted: root.sort-column == 0;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(0); }
                            right-pressed(x, y) => {
                                root.menu-column = 0;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        HeaderCell {
                            x: root.name-width;
                            width: root.folder-width;
                            height: parent.height;
                            label: @tr("Folder");
                            sorted: root.sort-column == 1;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(1); }
                            right-pressed(x, y) => {
                                root.menu-column = 1;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        HeaderCell {
                            x: root.name-width + root.folder-width;
                            width: root.size-width;
                            height: parent.height;
                            label: @tr("Size");
                            align: right;
                            sorted: root.sort-column == 2;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(2); }
                            right-pressed(x, y) => {
                                root.menu-column = 2;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        HeaderCell {
                            x: root.name-width + root.folder-width + root.size-width;
                            width: root.date-width;
                            height: parent.height;
                            label: @tr("Modified");
                            sorted: root.sort-column == 3;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(3); }
                            right-pressed(x, y) => {
                                root.menu-column = 3;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-type: HeaderCell {
                            x: root.type-x;
                            width: root.type-width;
                            height: parent.height;
                            label: @tr("Type");
                            sorted: root.sort-column == 4;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(4); }
                            right-pressed(x, y) => {
                                root.menu-column = 4;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-ext: HeaderCell {
                            x: root.ext-x;
                            width: root.ext-width;
                            height: parent.height;
                            label: @tr("Extension");
                            sorted: root.sort-column == 5;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(5); }
                            right-pressed(x, y) => {
                                root.menu-column = 5;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-created: HeaderCell {
                            x: root.created-x;
                            width: root.created-width;
                            height: parent.height;
                            label: @tr("Created");
                            sorted: root.sort-column == 6;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(6); }
                            right-pressed(x, y) => {
                                root.menu-column = 6;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-accessed: HeaderCell {
                            x: root.accessed-x;
                            width: root.accessed-width;
                            height: parent.height;
                            label: @tr("Accessed");
                            sorted: root.sort-column == 7;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(7); }
                            right-pressed(x, y) => {
                                root.menu-column = 7;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-attrs: HeaderCell {
                            x: root.attr-x;
                            width: root.attr-width;
                            height: parent.height;
                            label: @tr("Attributes");
                            sorted: root.sort-column == 8;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(8); }
                            right-pressed(x, y) => {
                                root.menu-column = 8;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-md5: HeaderCell {
                            x: root.md5-x;
                            width: root.md5-width;
                            height: parent.height;
                            label: @tr("MD5");
                            right-pressed(x, y) => {
                                root.menu-column = 9;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-sha256: HeaderCell {
                            x: root.sha256-x;
                            width: root.sha256-width;
                            height: parent.height;
                            label: @tr("SHA-256");
                            right-pressed(x, y) => {
                                root.menu-column = 10;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-crc32: HeaderCell {
                            x: root.crc32-x;
                            width: root.crc32-width;
                            height: parent.height;
                            label: @tr("CRC-32");
                            right-pressed(x, y) => {
                                root.menu-column = 11;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-name-freq: HeaderCell {
                            x: root.name-freq-x;
                            width: root.name-freq-width;
                            height: parent.height;
                            label: @tr("Same name");
                            sorted: root.sort-column == 12;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(12); }
                            right-pressed(x, y) => {
                                root.menu-column = 12;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-ext-freq: HeaderCell {
                            x: root.ext-freq-x;
                            width: root.ext-freq-width;
                            height: parent.height;
                            label: @tr("Same extension");
                            sorted: root.sort-column == 13;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(13); }
                            right-pressed(x, y) => {
                                root.menu-column = 13;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                        if root.show-size-freq: HeaderCell {
                            x: root.size-freq-x;
                            width: root.size-freq-width;
                            height: parent.height;
                            label: @tr("Same size");
                            sorted: root.sort-column == 14;
                            descending: root.sort-descending;
                            clicked => { root.sort-by(14); }
                            right-pressed(x, y) => {
                                root.menu-column = 14;
                                header-menu.show({ x: self.x + x, y: y });
                            }
                        }
                    }
                    // Boundary grips, on top of the cells.
                    // A double-click on a grip sizes the column on its left to fit.
                    ColumnGrip {
                        x: root.name-width - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(0, delta); }
                        fit => { root.fit-column(0); }
                    }
                    ColumnGrip {
                        x: root.name-width + root.folder-width - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(1, delta); }
                        fit => { root.fit-column(1); }
                    }
                    ColumnGrip {
                        x: root.name-width + root.folder-width + root.size-width - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(2, delta); }
                        fit => { root.fit-column(2); }
                    }
                    // One on the left edge of each optional column shown.
                    if root.show-type: ColumnGrip {
                        x: root.type-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(4, delta); }
                        fit => { root.fit-column(root.left-of(4)); }
                    }
                    if root.show-ext: ColumnGrip {
                        x: root.ext-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(5, delta); }
                        fit => { root.fit-column(root.left-of(5)); }
                    }
                    if root.show-created: ColumnGrip {
                        x: root.created-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(6, delta); }
                        fit => { root.fit-column(root.left-of(6)); }
                    }
                    if root.show-accessed: ColumnGrip {
                        x: root.accessed-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(7, delta); }
                        fit => { root.fit-column(root.left-of(7)); }
                    }
                    if root.show-attrs: ColumnGrip {
                        x: root.attr-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(8, delta); }
                        fit => { root.fit-column(root.left-of(8)); }
                    }
                    if root.show-md5: ColumnGrip {
                        x: root.md5-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(9, delta); }
                        fit => { root.fit-column(root.left-of(9)); }
                    }
                    if root.show-sha256: ColumnGrip {
                        x: root.sha256-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(10, delta); }
                        fit => { root.fit-column(root.left-of(10)); }
                    }
                    if root.show-crc32: ColumnGrip {
                        x: root.crc32-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(11, delta); }
                        fit => { root.fit-column(root.left-of(11)); }
                    }
                    if root.show-name-freq: ColumnGrip {
                        x: root.name-freq-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(12, delta); }
                        fit => { root.fit-column(root.left-of(12)); }
                    }
                    if root.show-ext-freq: ColumnGrip {
                        x: root.ext-freq-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(13, delta); }
                        fit => { root.fit-column(root.left-of(13)); }
                    }
                    if root.show-size-freq: ColumnGrip {
                        x: root.size-freq-x - self.width / 2;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(14, delta); }
                        fit => { root.fit-column(root.left-of(14)); }
                    }
                    // The right edge of the last column: dragged to the right, the
                    // columns get wider than the window.
                    ColumnGrip {
                        x: root.table-width - self.width;
                        height: parent.height;
                        dragged(delta) => { root.drag-boundary(99, delta); }
                        fit => { root.fit-column(root.last-shown()); }
                    }
                }
                // Measures the texts of fit-width(); never drawn.
                Rectangle {
                    width: 0px;
                    height: 0px;
                    clip: true;
                    fit-a-probe := Text { text: root.fit-a; font-size: Theme.list-text; }
                    fit-b-probe := Text { text: root.fit-b; font-size: Theme.list-text; }
                    fit-c-probe := Text { text: root.fit-c; font-size: Theme.list-text; }
                    fit-label-probe := Text { text: root.fit-label; font-size: Theme.small; font-weight: 600; }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }

            // Results
            keys := FocusScope {
                vertical-stretch: 1;
                // Shift extends the selection, Ctrl moves the cursor alone.
                property <int> move-mode: 0;
                key-pressed(event) => {
                    if (root.dispatch(2, event)) {
                        return accept;
                    }
                    // Movement and Esc are fixed; every other key is a command.
                    self.move-mode = event.modifiers.shift ? 2 : event.modifiers.control ? -1 : 0;
                    if (event.modifiers.alt || event.modifiers.meta) {
                        return reject;
                    }
                    if (event.text == Key.DownArrow) { root.move-to(root.current + 1, self.move-mode); return accept; }
                    if (event.text == Key.UpArrow) {
                        if (root.current <= 0 && !event.modifiers.shift) { search.focus-and-select(); } else { root.move-to(root.current - 1, self.move-mode); }
                        return accept;
                    }
                    if (event.text == Key.PageDown) { root.move-to(root.current + root.page, self.move-mode); return accept; }
                    if (event.text == Key.PageUp) { root.move-to(root.current - root.page, self.move-mode); return accept; }
                    if (event.text == Key.Home) { root.move-to(0, self.move-mode); return accept; }
                    if (event.text == Key.End) { root.move-to(root.results.length - 1, self.move-mode); return accept; }
                    // Esc clears the selection first, then goes back to the search.
                    if (event.text == Key.Escape) {
                        if (!root.clear-selection()) { search.focus-and-select(); }
                        return accept;
                    }
                    reject
                }

                menu-area := ContextMenuArea {
                    enabled: root.current >= 0;
                    Menu {
                        MenuItem {
                            title: @tr("Open");
                            enabled: root.can-run(Command.open);
                            activated => { root.run(Command.open); }
                        }
                        MenuItem {
                            title: @tr("Open with…");
                            enabled: root.can-run(Command.open-with);
                            activated => { root.run(Command.open-with); }
                        }
                        MenuItem {
                            title: @tr("Open containing folder");
                            enabled: root.can-run(Command.open-folder);
                            activated => { root.run(Command.open-folder); }
                        }
                        MenuItem {
                            title: @tr("Search in EveryGrep");
                            enabled: root.can-run(Command.search-in-program);
                            activated => { root.run(Command.search-in-program); }
                        }
                        MenuItem {
                            title: @tr("Search path in EveryGrep");
                            enabled: root.can-run(Command.search-containing-folder);
                            activated => { root.run(Command.search-containing-folder); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Cut");
                            enabled: root.can-run(Command.cut);
                            activated => { root.run(Command.cut); }
                        }
                        MenuItem {
                            title: @tr("Copy");
                            enabled: root.can-run(Command.copy);
                            activated => { root.run(Command.copy); }
                        }
                        MenuItem {
                            title: @tr("Paste into folder");
                            enabled: root.can-run(Command.paste);
                            activated => { root.run(Command.paste); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Copy name");
                            enabled: root.can-run(Command.copy-name);
                            activated => { root.run(Command.copy-name); }
                        }
                        MenuItem {
                            title: @tr("Copy path");
                            enabled: root.can-run(Command.copy-path);
                            activated => { root.run(Command.copy-path); }
                        }
                        MenuItem {
                            title: @tr("Copy full path");
                            enabled: root.can-run(Command.copy-full-path);
                            activated => { root.run(Command.copy-full-path); }
                        }
                        MenuItem {
                            title: @tr("Copy path with quotes");
                            enabled: root.can-run(Command.copy-path-quoted);
                            activated => { root.run(Command.copy-path-quoted); }
                        }
                        MenuItem {
                            title: @tr("Copy full path with quotes");
                            enabled: root.can-run(Command.copy-full-path-quoted);
                            activated => { root.run(Command.copy-full-path-quoted); }
                        }
                        MenuSeparator { }
                        MenuItem {
                            title: @tr("Rename");
                            enabled: root.can-run(Command.rename);
                            activated => { root.run(Command.rename); }
                        }
                        MenuItem {
                            title: @tr("Create shortcuts…");
                            enabled: root.can-run(Command.create-shortcut);
                            activated => { root.run(Command.create-shortcut); }
                        }
                        MenuItem {
                            title: @tr("Move to trash");
                            enabled: root.can-run(Command.trash);
                            activated => { root.run(Command.trash); }
                        }
                        MenuItem {
                            title: @tr("Delete permanently…");
                            enabled: root.can-run(Command.delete-permanently);
                            activated => { root.run(Command.delete-permanently); }
                        }
                    }

                list := ListView {
                    // Wider than the window when the columns do not fit.
                    content-width: root.table-width;
                    for row[i] in root.results: Row {
                        width: root.table-width;
                        data: row;
                        current: i == root.current && keys.has-focus;
                        alternate: root.alternate-rows && Math.mod(i, 2) == 1;
                        name-width: root.name-width;
                        folder-width: root.folder-width;
                        size-width: root.size-width;
                        date-width: root.date-width;
                        type-width: root.type-width;
                        ext-width: root.ext-width;
                        created-width: root.created-width;
                        accessed-width: root.accessed-width;
                        attr-width: root.attr-width;
                        md5-width: root.md5-width;
                        sha256-width: root.sha256-width;
                        crc32-width: root.crc32-width;
                        name-freq-width: root.name-freq-width;
                        ext-freq-width: root.ext-freq-width;
                        size-freq-width: root.size-freq-width;
                        pressed(mods) => {
                            root.current = i;
                            keys.focus();
                            root.select(i, mods.shift ? 2 : mods.control ? 1 : 0);
                        }
                        right-pressed(x, y) => {
                            root.current = i;
                            keys.focus();
                            if (!root.is-selected(i)) { root.select(i, 0); }
                            menu-area.show({ x: x + list.content-x, y: i * Theme.row-height + list.content-y + y });
                        }
                        // In the Folder column it opens the containing
                        // folder, when the setting says so.
                        double-clicked(x) => {
                            if (root.path-click-opens-folder && x >= root.name-width
                                    && x < root.name-width + root.folder-width) {
                                root.open-folder(i);
                            } else {
                                root.activate(i);
                            }
                        }
                        editing: i == root.rename-row;
                        edit-text <=> root.rename-text;
                        edit-stem: root.rename-stem;
                        edit-commit(text) => { root.rename-commit(text); }
                        edit-cancel => { root.rename-cancel(); }
                    }
                }
                }

                Text {
                    visible: root.message != "";
                    text: root.message;
                    color: Theme.text-muted;
                    font-size: Theme.body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Status line
            Rectangle { height: 1px; background: Theme.line; }
            Rectangle {
                height: Theme.status-height;
                background: Theme.surface-alt;
                HorizontalLayout {
                    padding-left: Theme.s3;
                    padding-right: Theme.s3;
                    spacing: Theme.s4;
                    Text {
                        text: root.status-count;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        min-width: self.preferred-width;
                        horizontal-stretch: 0;
                    }
                    // Details of the selection: the part that shrinks (elided)
                    // first when the line runs out of room.
                    if root.status-detail != "": Text {
                        text: root.status-detail;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.status-index;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                        horizontal-stretch: 0;
                    }
                    // Takes the room left, so what follows sits at the right end.
                    Rectangle {
                        min-width: 0px;
                        horizontal-stretch: 1;
                    }
                    // The long operation running, and its Cancel button.
                    if root.progress-text != "": Text {
                        text: root.progress-text;
                        font-size: Theme.small;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if root.can-cancel: VerticalLayout {
                        alignment: center;
                        StatusButton {
                            text: @tr("Cancel");
                            clicked => { root.cancel-task(); }
                        }
                    }
                    // Matching modes that are on.
                    if root.show-mode-badges: HorizontalLayout {
                        spacing: Theme.s1;
                        alignment: start;
                        for badge in root.badges: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: Theme.badge-height;
                                width: badge-text.preferred-width + 2 * Theme.s1 + 2px;
                                border-radius: 4px;
                                background: Theme.selection;
                                badge-text := Text {
                                    text: badge;
                                    font-size: Theme.small - 1px;
                                    color: Theme.selection-text;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                    // Shown in full up to a width that leaves room for the rest
                    // of the line even in a narrow window.
                    Text {
                        text: root.notice;
                        font-size: Theme.small;
                        color: root.notice-error ? Theme.danger : Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        overflow: elide;
                        min-width: min(self.preferred-width, 360px);
                        horizontal-stretch: 0;
                    }
                    Text {
                        text: root.status-right;
                        font-size: Theme.small;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }
    }

    // The window's top left corner below the menu bar: the tip is placed
    // from absolute positions.
    origin := Rectangle {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
    }

    if root.history-open: Rectangle {
        TouchArea { clicked => { root.history-open = false; } }
        Rectangle {
            x: search.absolute-position.x - origin.absolute-position.x;
            y: search.absolute-position.y - origin.absolute-position.y + search.height;
            width: search.width;
            height: min(300px, max(100px, root.height - self.y - Theme.s3));
            background: Theme.surface;
            border-color: Theme.line;
            border-width: 1px;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: Theme.s2;
                spacing: Theme.s1;
                HorizontalLayout {
                    Text { text: @tr("Sort history by"); color: Theme.text; vertical-alignment: center; }
                    ComboBox {
                        accessible-label: @tr("Sort history by");
                        model: [@tr("Last used"), @tr("Times used"), @tr("Search text")];
                        current-index <=> root.history-sort;
                        selected => { root.history-current = -1; root.history-sort-changed(root.history-sort); }
                    }
                }
                if root.history-rows.length == 0: Text {
                    text: @tr("No search history"); color: Theme.text-muted;
                    vertical-alignment: center;
                }
                ListView {
                    content-y: -max(0, root.history-current - 6) * Theme.row-height;
                    for search-text[i] in root.history-rows: Rectangle {
                        height: Theme.row-height;
                        background: root.history-current == i ? Theme.selection : history-touch.has-hover ? Theme.hover : Theme.surface;
                        Text {
                            x: Theme.s2;
                            width: parent.width - 2 * Theme.s2;
                            height: parent.height;
                            text: search-text;
                            color: root.history-current == i ? Theme.selection-text : Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        history-touch := TouchArea { clicked => { root.choose-history(i); } }
                    }
                }
            }
        }
    }

    // Tip of the matching-mode toggle under the mouse.
    if search.hover-tip != "": Rectangle {
        x: min(search.hover-x - origin.absolute-position.x, root.width - self.width - Theme.s2);
        y: search.hover-bottom - origin.absolute-position.y + Theme.s1;
        width: tip-text.preferred-width + 2 * Theme.s2;
        height: tip-text.preferred-height + 2 * Theme.s1;
        background: Theme.surface;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000030;
        tip-text := Text {
            text: search.hover-tip;
            font-size: Theme.small;
            color: Theme.text;
        }
    }

    // Hidden text field used by copy-text() and paste-text().
    clip := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        single-line: false;
        read-only: true;
        enabled: false;
    }

    // Confirmation dialog, above all other content. The backdrop takes all
    // clicks so the window behind cannot be used meanwhile.
    if root.confirm-open: Rectangle {
        background: #00000060;
        TouchArea { }
        dialog-keys := FocusScope {
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.confirm-cancelled(); return accept; }
                if (event.text == Key.Return) { root.confirm-accepted(); return accept; }
                accept
            }
        }
        Rectangle {
            width: min(420px, root.width - 2 * Theme.s5);
            // Never taller than the window, so the buttons stay on screen.
            height: min(dialog-layout.preferred-height, root.height - 2 * Theme.s5);
            clip: true;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            dialog-layout := VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s3;
                Text {
                    text: root.confirm-title;
                    font-size: Theme.body + 2px;
                    font-weight: 600;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                Text {
                    text: root.confirm-text;
                    color: Theme.text-muted;
                    wrap: word-wrap;
                    overflow: elide;
                    max-height: 8 * (Theme.body + 4px);
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.s2;
                    padding-top: Theme.s2;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.confirm-cancelled(); }
                    }
                    Button {
                        text: root.confirm-action;
                        primary: true;
                        clicked => { root.confirm-accepted(); }
                    }
                }
            }
        }
    }

    if root.fileops-rename-open: FileopsRename {
        location: root.fileops-rename-location;
        name <=> root.fileops-rename-name;
        selection-end: root.fileops-rename-stem;
        error: root.fileops-rename-error;
        edited(name) => { root.fileops-rename-edited(name); }
        submit => { root.fileops-rename-submit(); }
        cancel => { root.fileops-rename-cancel(); }
    }

    if root.shortcuts-open: InfoDialog {
        title: @tr("Keyboard shortcuts");
        card-width: 520px;
        close => {
            root.shortcuts-open = false;
            search.focus-and-select();
        }
        ListView {
            // Grows with the rows up to what the window leaves.
            preferred-height: root.shortcuts.length * 24px;
            min-height: 120px;
            for row in root.shortcuts: HorizontalLayout {
                height: 24px;
                spacing: Theme.s3;
                Text {
                    width: 200px;
                    text: row.keys;
                    color: Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.action;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }

    if root.help-open: InfoDialog {
        title: @tr("Help");
        card-width: 680px;
        close => {
            root.help-open = false;
            search.focus-and-select();
        }
        // Page tabs. They take no keyboard focus, so Esc keeps closing the
        // window after a click.
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: start;
            HelpTab {
                text: @tr("Search syntax");
                selected: root.help-page == 0;
                clicked => { root.help-page = 0; }
            }
            HelpTab {
                text: @tr("Regular expressions");
                selected: root.help-page == 1;
                clicked => { root.help-page = 1; }
            }
            HelpTab {
                text: @tr("Command line options");
                selected: root.help-page == 2;
                clicked => { root.help-page = 2; }
            }
        }
        ListView {
            property <[HelpRow]> rows: root.help-page == 0 ? root.help-syntax
                : root.help-page == 1 ? root.help-regex : root.help-command-line;
            // Grows with the rows up to what the window leaves.
            preferred-height: self.rows.length * 26px;
            min-height: 160px;
            for row in self.rows: HorizontalLayout {
                spacing: Theme.s3;
                padding-top: row.example == "" ? Theme.s3 : 2px;
                padding-bottom: 2px;
                if row.example != "": Text {
                    width: 230px;
                    text: row.example;
                    font-family: "monospace";
                    color: Theme.text;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.meaning;
                    color: row.example == "" ? Theme.text : Theme.text-muted;
                    font-weight: row.example == "" ? 600 : 400;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }

    if root.about-open: InfoDialog {
        title: @tr("About EveryGrep");
        close => {
            root.about-open = false;
            search.focus-and-select();
        }
        HorizontalLayout {
            spacing: Theme.s3;
            Image {
                source: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "EveryGrep";
                    font-size: Theme.body + 4px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: @tr("Version {}", root.version);
                    color: Theme.text-muted;
                }
            }
        }
        Text {
            text: @tr("Finds files and folders by name as you type.");
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: @tr("Licensed under the MIT license or the Apache License 2.0, at your option.");
            font-size: Theme.small;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        // The toolkit's attribution, required by its royalty-free license.
        HorizontalLayout {
            alignment: center;
            AboutSlint { }
        }
    }

    // The menu bar. It is drawn inside the window (GNOME has no global menu
    // bar). Its keys are matched before the focused control sees them, so
    // it only shows global keys that edit no text and that no control binds
    // otherwise (see menu-keys); Ctrl+C, Delete or F2 keep their meaning in
    // the search field.
    if root.show-menu-bar: MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("New window");
                shortcut: root.menu-keys.new-window;
                enabled: root.can-run(Command.new-window);
                activated => { root.run(Command.new-window); }
            }
            MenuItem {
                title: @tr("Close window");
                shortcut: root.menu-keys.close-window;
                enabled: root.can-run(Command.close-window);
                activated => { root.run(Command.close-window); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Export results…");
                shortcut: root.menu-keys.export-results;
                enabled: root.can-run(Command.export-results);
                activated => { root.run(Command.export-results); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Quit");
                shortcut: root.menu-keys.quit;
                enabled: root.can-run(Command.quit);
                activated => { root.run(Command.quit); }
            }
        }
        Menu {
            title: @tr("Edit");
            MenuItem {
                title: @tr("Cut");
                shortcut: root.menu-keys.cut;
                enabled: root.can-run(Command.cut);
                activated => { root.run(Command.cut); }
            }
            MenuItem {
                title: @tr("Copy");
                shortcut: root.menu-keys.copy;
                enabled: root.can-run(Command.copy);
                activated => { root.run(Command.copy); }
            }
            MenuItem {
                title: @tr("Paste into folder");
                shortcut: root.menu-keys.paste;
                enabled: root.can-run(Command.paste);
                activated => { root.run(Command.paste); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Copy name");
                shortcut: root.menu-keys.copy-name;
                enabled: root.can-run(Command.copy-name);
                activated => { root.run(Command.copy-name); }
            }
            MenuItem {
                title: @tr("Copy path");
                shortcut: root.menu-keys.copy-path;
                enabled: root.can-run(Command.copy-path);
                activated => { root.run(Command.copy-path); }
            }
            MenuItem {
                title: @tr("Copy full path");
                shortcut: root.menu-keys.copy-full-path;
                enabled: root.can-run(Command.copy-full-path);
                activated => { root.run(Command.copy-full-path); }
            }
            MenuItem {
                title: @tr("Copy path with quotes");
                shortcut: root.menu-keys.copy-path-quoted;
                enabled: root.can-run(Command.copy-path-quoted);
                activated => { root.run(Command.copy-path-quoted); }
            }
            MenuItem {
                title: @tr("Copy full path with quotes");
                shortcut: root.menu-keys.copy-full-path-quoted;
                enabled: root.can-run(Command.copy-full-path-quoted);
                activated => { root.run(Command.copy-full-path-quoted); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Select all");
                shortcut: root.menu-keys.select-all;
                enabled: root.can-run(Command.select-all);
                activated => { root.run(Command.select-all); }
            }
            MenuItem {
                title: @tr("Invert selection");
                shortcut: root.menu-keys.invert-selection;
                enabled: root.can-run(Command.invert-selection);
                activated => { root.run(Command.invert-selection); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Rename");
                shortcut: root.menu-keys.rename;
                enabled: root.can-run(Command.rename);
                activated => { root.run(Command.rename); }
            }
            MenuItem {
                title: @tr("Move to trash");
                shortcut: root.menu-keys.trash;
                enabled: root.can-run(Command.trash);
                activated => { root.run(Command.trash); }
            }
            MenuItem {
                title: @tr("Delete permanently…");
                shortcut: root.menu-keys.delete-permanently;
                enabled: root.can-run(Command.delete-permanently);
                activated => { root.run(Command.delete-permanently); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Focus the search field");
                shortcut: root.menu-keys.focus-search;
                enabled: root.can-run(Command.focus-search);
                activated => { root.run(Command.focus-search); }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Refresh");
                shortcut: root.menu-keys.refresh;
                enabled: root.can-run(Command.refresh);
                activated => { root.run(Command.refresh); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Type column");
                shortcut: root.menu-keys.type-column;
                checkable: true;
                checked <=> root.show-type;
                activated => { root.toggled(Command.type-column); }
            }
            MenuItem {
                title: @tr("Extension column");
                shortcut: root.menu-keys.extension-column;
                checkable: true;
                checked <=> root.show-ext;
                activated => { root.toggled(Command.extension-column); }
            }
            MenuItem {
                title: @tr("Created column");
                shortcut: root.menu-keys.created-column;
                checkable: true;
                checked <=> root.show-created;
                activated => { root.toggled(Command.created-column); }
            }
            MenuItem {
                title: @tr("Accessed column");
                shortcut: root.menu-keys.accessed-column;
                checkable: true;
                checked <=> root.show-accessed;
                activated => { root.toggled(Command.accessed-column); }
            }
            MenuItem {
                title: @tr("Attributes column");
                shortcut: root.menu-keys.attributes-column;
                checkable: true;
                checked <=> root.show-attrs;
                activated => { root.toggled(Command.attributes-column); }
            }
            MenuItem {
                title: @tr("MD5 column");
                shortcut: root.menu-keys.md5-column;
                checkable: true;
                checked <=> root.show-md5;
                activated => { root.toggled(Command.md5-column); }
            }
            MenuItem {
                title: @tr("SHA-256 column");
                shortcut: root.menu-keys.sha256-column;
                checkable: true;
                checked <=> root.show-sha256;
                activated => { root.toggled(Command.sha256-column); }
            }
            MenuItem {
                title: @tr("CRC-32 column");
                shortcut: root.menu-keys.crc32-column;
                checkable: true;
                checked <=> root.show-crc32;
                activated => { root.toggled(Command.crc32-column); }
            }
            MenuItem {
                title: @tr("Same name column");
                shortcut: root.menu-keys.name-frequency-column;
                checkable: true;
                checked <=> root.show-name-freq;
                activated => { root.toggled(Command.name-frequency-column); }
            }
            MenuItem {
                title: @tr("Same extension column");
                shortcut: root.menu-keys.extension-frequency-column;
                checkable: true;
                checked <=> root.show-ext-freq;
                activated => { root.toggled(Command.extension-frequency-column); }
            }
            MenuItem {
                title: @tr("Same size column");
                shortcut: root.menu-keys.size-frequency-column;
                checkable: true;
                checked <=> root.show-size-freq;
                activated => { root.toggled(Command.size-frequency-column); }
            }
            MenuItem {
                title: @tr("Size all columns to fit");
                shortcut: root.menu-keys.fit-columns;
                enabled: root.can-run(Command.fit-columns);
                activated => { root.run(Command.fit-columns); }
            }
            MenuItem {
                title: @tr("Fit columns to window");
                shortcut: root.menu-keys.fit-columns-to-window;
                enabled: root.can-run(Command.fit-columns-to-window);
                activated => { root.run(Command.fit-columns-to-window); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Sort by");
                for item in root.sort-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    enabled: item.enabled && !root.confirm-open;
                    activated => { root.sort-to(item.column, root.sort-descending); }
                }
                MenuSeparator { }
                for item[i] in root.sort-order-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    enabled: !root.confirm-open;
                    activated => { root.sort-to(root.sort-column, i == 1); }
                }
            }
            Menu {
                title: @tr("Folder size");
                for item[i] in root.folder-size-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-folder-size(i); }
                }
            }
            Menu {
                title: @tr("Density");
                for item[i] in root.density-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-density(i); }
                }
            }
            Menu {
                title: @tr("Theme");
                for item[i] in root.theme-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => { root.choose-theme(i); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Selection details");
                shortcut: root.menu-keys.selection-details;
                checkable: true;
                checked <=> root.status-details;
                activated => { root.toggled(Command.selection-details); }
            }
            MenuItem {
                title: @tr("Menu bar");
                shortcut: root.menu-keys.menu-bar;
                checkable: true;
                checked <=> root.show-menu-bar;
                activated => { root.toggled(Command.menu-bar); }
            }
        }
        Menu {
            title: @tr("Search");
            MenuItem {
                title: @tr("Match case");
                shortcut: root.menu-keys.match-case;
                checkable: true;
                checked <=> root.match-case;
                activated => { root.toggled(Command.match-case); }
            }
            MenuItem {
                title: @tr("Match whole words");
                shortcut: root.menu-keys.whole-words;
                checkable: true;
                checked <=> root.whole-words;
                activated => { root.toggled(Command.whole-words); }
            }
            MenuItem {
                title: @tr("Match the full path");
                shortcut: root.menu-keys.match-path;
                checkable: true;
                checked <=> root.match-path;
                activated => { root.toggled(Command.match-path); }
            }
            MenuItem {
                title: @tr("Match diacritics");
                shortcut: root.menu-keys.match-diacritics;
                checkable: true;
                checked <=> root.match-diacritics;
                activated => { root.toggled(Command.match-diacritics); }
            }
            MenuItem {
                title: @tr("Regular expression");
                shortcut: root.menu-keys.regex;
                checkable: true;
                checked <=> root.use-regex;
                activated => { root.toggled(Command.regex); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Match prefix");
                shortcut: root.menu-keys.match-prefix;
                checkable: true;
                checked <=> root.match-prefix;
                activated => { root.toggled(Command.match-prefix); }
            }
            MenuItem {
                title: @tr("Match suffix");
                shortcut: root.menu-keys.match-suffix;
                checkable: true;
                checked <=> root.match-suffix;
                activated => { root.toggled(Command.match-suffix); }
            }
            MenuItem {
                title: @tr("Ignore punctuation");
                shortcut: root.menu-keys.ignore-punctuation;
                checkable: true;
                checked <=> root.ignore-punctuation;
                activated => { root.toggled(Command.ignore-punctuation); }
            }
            MenuItem {
                title: @tr("Ignore whitespace");
                shortcut: root.menu-keys.ignore-whitespace;
                checkable: true;
                checked <=> root.ignore-whitespace;
                activated => { root.toggled(Command.ignore-whitespace); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Hidden files");
                MenuItem {
                    title: @tr("Show hidden files");
                    shortcut: root.menu-keys.show-hidden-files;
                    enabled: root.can-run(Command.show-hidden-files);
                    checkable: true;
                    checked: root.hidden-files == 0;
                    activated => { root.run(Command.show-hidden-files); }
                }
                MenuItem {
                    title: @tr("Hide hidden files");
                    shortcut: root.menu-keys.hide-hidden-files;
                    enabled: root.can-run(Command.hide-hidden-files);
                    checkable: true;
                    checked: root.hidden-files == 1;
                    activated => { root.run(Command.hide-hidden-files); }
                }
                MenuItem {
                    title: @tr("Only hidden files");
                    shortcut: root.menu-keys.only-hidden-files;
                    enabled: root.can-run(Command.only-hidden-files);
                    checkable: true;
                    checked: root.hidden-files == 2;
                    activated => { root.run(Command.only-hidden-files); }
                }
                MenuItem {
                    title: @tr("Cycle hidden files");
                    shortcut: root.menu-keys.cycle-hidden-files;
                    enabled: root.can-run(Command.cycle-hidden-files);
                    activated => { root.run(Command.cycle-hidden-files); }
                }
            }
            Menu {
                title: @tr("Filter");
                MenuItem { title: @tr("Save as filter…"); shortcut: root.menu-keys.add-filter; activated => { root.run(Command.add-filter); } }
                MenuItem { title: @tr("Manage filters…"); shortcut: root.menu-keys.organize-filters; activated => { root.run(Command.organize-filters); } }
                MenuItem { title: @tr("Restore default filters"); shortcut: root.menu-keys.restore-filters; activated => { root.run(Command.restore-filters); } }
                for item[i] in root.filter-items: MenuItem {
                    title: item.title;
                    checkable: true;
                    checked: item.checked;
                    activated => {
                        root.filter-index = i;
                        root.options-edited();
                    }
                }
            }
            MenuItem {
                title: @tr("Previous filter");
                shortcut: root.menu-keys.previous-filter;
                enabled: root.can-run(Command.previous-filter);
                activated => { root.run(Command.previous-filter); }
            }
            MenuItem {
                title: @tr("Next filter");
                shortcut: root.menu-keys.next-filter;
                enabled: root.can-run(Command.next-filter);
                activated => { root.run(Command.next-filter); }
            }
            MenuItem { title: @tr("Advanced Search…"); shortcut: root.menu-keys.advanced-search; activated => { root.run(Command.advanced-search); } }
            MenuSeparator { }
            Menu {
                title: @tr("Find duplicates");
                MenuItem {
                    title: @tr("By contents");
                    shortcut: root.menu-keys.find-duplicates;
                    activated => { root.run(Command.find-duplicates); }
                }
                MenuItem {
                    title: @tr("By name");
                    shortcut: root.menu-keys.find-name-duplicates;
                    activated => { root.run(Command.find-name-duplicates); }
                }
                MenuItem {
                    title: @tr("By size");
                    shortcut: root.menu-keys.find-size-duplicates;
                    activated => { root.run(Command.find-size-duplicates); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Stop finding duplicates");
                    shortcut: root.menu-keys.clear-duplicates;
                    activated => { root.run(Command.clear-duplicates); }
                }
            }
        }
        Menu {
            title: @tr("Bookmarks");
            MenuItem { title: @tr("Save bookmark…"); shortcut: root.menu-keys.add-bookmark; activated => { root.run(Command.add-bookmark); } }
            MenuItem { title: @tr("Manage bookmarks…"); shortcut: root.menu-keys.organize-bookmarks; activated => { root.run(Command.organize-bookmarks); } }
            for name[i] in root.bookmark-names: MenuItem {
                title: name;
                activated => { root.open-bookmark(i); }
            }
        }
        Menu {
            title: @tr("History");
            MenuItem {
                title: @tr("Back");
                shortcut: root.menu-keys.previous-search;
                enabled: root.can-run(Command.previous-search);
                activated => { root.run(Command.previous-search); }
            }
            MenuItem {
                title: @tr("Forward");
                shortcut: root.menu-keys.next-search;
                enabled: root.can-run(Command.next-search);
                activated => { root.run(Command.next-search); }
            }
            MenuItem {
                title: @tr("Show search history");
                shortcut: root.menu-keys.show-history;
                activated => { root.run(Command.show-history); }
            }
            MenuItem {
                title: @tr("Organize search history…");
                shortcut: root.menu-keys.organize-history;
                activated => { root.run(Command.organize-history); }
            }
        }
        Menu { title: @tr("Tabs");
            MenuItem { title: @tr("New tab"); shortcut: root.menu-keys.new-tab; enabled: root.can-run(Command.new-tab); activated => { root.run(Command.new-tab); } }
            MenuItem { title: @tr("Close tab"); shortcut: root.menu-keys.close-tab; enabled: root.can-run(Command.close-tab); activated => { root.run(Command.close-tab); } }
            MenuItem { title: @tr("Duplicate tab"); shortcut: root.menu-keys.duplicate-tab; enabled: root.can-run(Command.duplicate-tab); activated => { root.run(Command.duplicate-tab); } }
            MenuItem { title: @tr("Next tab"); shortcut: root.menu-keys.next-tab; enabled: root.can-run(Command.next-tab); activated => { root.run(Command.next-tab); } }
            MenuItem { title: @tr("Previous tab"); shortcut: root.menu-keys.previous-tab; enabled: root.can-run(Command.previous-tab); activated => { root.run(Command.previous-tab); } }
            MenuItem { title: @tr("List all tabs"); shortcut: root.menu-keys.list-tabs; enabled: root.can-run(Command.list-tabs); activated => { root.run(Command.list-tabs); } }
            MenuItem { title: @tr("Close multiple tabs"); shortcut: root.menu-keys.close-multiple-tabs; enabled: root.can-run(Command.close-multiple-tabs); activated => { root.run(Command.close-multiple-tabs); } }
            MenuItem { title: @tr("Close tabs to the left"); shortcut: root.menu-keys.close-left-tabs; enabled: root.can-run(Command.close-left-tabs); activated => { root.run(Command.close-left-tabs); } }
            MenuItem { title: @tr("Close tabs to the right"); shortcut: root.menu-keys.close-right-tabs; enabled: root.can-run(Command.close-right-tabs); activated => { root.run(Command.close-right-tabs); } }
            MenuItem { title: @tr("Close other tabs"); shortcut: root.menu-keys.close-other-tabs; enabled: root.can-run(Command.close-other-tabs); activated => { root.run(Command.close-other-tabs); } }
            MenuItem { title: @tr("Reopen closed tab"); shortcut: root.menu-keys.reopen-tab; enabled: root.can-run(Command.reopen-tab); activated => { root.run(Command.reopen-tab); } }
            MenuItem { title: @tr("Reopen all closed tabs"); shortcut: root.menu-keys.reopen-all-tabs; enabled: root.can-run(Command.reopen-all-tabs); activated => { root.run(Command.reopen-all-tabs); } }
            Menu { title: @tr("Recently closed tabs");
                for title[i] in root.closed-tab-names: MenuItem { title: title; activated => { root.closed-tab-selected(i); } }
            }
            MenuSeparator { }
            for tab[i] in root.tabs: MenuItem { title: tab.title; checkable: true; checked: tab.checked; activated => { root.tab-selected(i); } }
            MenuSeparator { }
            MenuItem { title: @tr("Open searches in tabs instead of new windows"); checkable: true; checked <=> root.open-searches-in-tabs; activated => { root.tab-preference-changed(0, self.checked); } }
            MenuItem { title: @tr("Switch to new tabs immediately"); checkable: true; checked <=> root.switch-to-new-tab; activated => { root.tab-preference-changed(1, self.checked); } }
            MenuItem { title: @tr("Restore the last window's tabs at startup"); checkable: true; checked <=> root.restore-session; activated => { root.tab-preference-changed(2, self.checked); } }
        }
        Menu {
            title: @tr("Index");
            MenuItem {
                title: @tr("Rebuild index now");
                shortcut: root.menu-keys.rebuild-index;
                enabled: root.can-run(Command.rebuild-index);
                activated => { root.run(Command.rebuild-index); }
            }
            MenuItem {
                title: @tr("Pause index updates");
                shortcut: root.menu-keys.pause-index-updates;
                checkable: true;
                checked <=> root.index-paused;
                activated => { root.toggled(Command.pause-index-updates); }
            }
        }
        Menu {
            title: @tr("Tools");
            MenuItem {
                title: @tr("Settings…");
                shortcut: root.menu-keys.settings;
                enabled: root.can-run(Command.settings);
                activated => { root.run(Command.settings); }
            }
            MenuItem {
                title: @tr("Customize shortcuts…");
                shortcut: root.menu-keys.keyboard-settings;
                enabled: root.can-run(Command.keyboard-settings);
                activated => { root.run(Command.keyboard-settings); }
            }
            MenuItem {
                title: @tr("Open the settings file");
                shortcut: root.menu-keys.open-settings-file;
                enabled: root.can-run(Command.open-settings-file);
                activated => { root.run(Command.open-settings-file); }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Search syntax");
                shortcut: root.menu-keys.search-syntax-help;
                enabled: root.can-run(Command.search-syntax-help);
                activated => { root.run(Command.search-syntax-help); }
            }
            MenuItem {
                title: @tr("Regular expressions");
                shortcut: root.menu-keys.regex-help;
                enabled: root.can-run(Command.regex-help);
                activated => { root.run(Command.regex-help); }
            }
            MenuItem {
                title: @tr("Command line options");
                shortcut: root.menu-keys.command-line-help;
                enabled: root.can-run(Command.command-line-help);
                activated => { root.run(Command.command-line-help); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Copy troubleshooting information");
                shortcut: root.menu-keys.copy-troubleshooting-info;
                enabled: root.can-run(Command.copy-troubleshooting-info);
                activated => { root.run(Command.copy-troubleshooting-info); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Keyboard shortcuts");
                shortcut: root.menu-keys.shortcuts-help;
                enabled: root.can-run(Command.shortcuts-help);
                activated => { root.run(Command.shortcuts-help); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("About EveryGrep");
                shortcut: root.menu-keys.about;
                enabled: root.can-run(Command.about);
                activated => { root.run(Command.about); }
            }
        }
    }

    init => { search.focus-and-select(); }
}
