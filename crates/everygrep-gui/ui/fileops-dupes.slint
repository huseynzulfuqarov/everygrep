import { Button, ComboBox, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// One line of the preview: state 0 a group's heading, 1 kept, 2 to the
// trash, 3 left as it is.
export struct DupeRow {
    text: string,
    note: string,
    state: int,
}

// Cleaning up duplicates: a rule for the copies to keep, and a preview of
// what is kept and what goes to the trash (see src/fileops_dupes.rs).
export component FileopsDupes inherits Rectangle {
    in-out property <int> keep;
    in property <string> folder;
    in property <[DupeRow]> rows;
    in property <string> summary;
    in property <bool> can-apply;
    in property <bool> busy;
    callback changed();
    callback choose-folder();
    callback apply();
    callback cancel();

    background: #00000060;
    TouchArea { }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { if (!root.busy) { root.cancel(); } return accept; }
            reject
        }
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: max(0px, (parent.height - self.height) / 2);
            width: min(760px, parent.width - 2 * Theme.s5);
            height: min(640px, parent.height - 2 * Theme.s5);
            clip: true;
            background: Theme.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000040;
            VerticalLayout {
                padding: Theme.dialog-padding;
                spacing: Theme.s3;
                Text {
                    text: @tr("Clean up duplicates");
                    color: Theme.text;
                    font-size: Theme.body + 2px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("In each group"); color: Theme.text; vertical-alignment: center; }
                    ComboBox {
                        model: [@tr("Keep the newest copy"), @tr("Keep the oldest copy"), @tr("Keep the copies in a folder")];
                        current-index <=> root.keep;
                        enabled: !root.busy;
                        selected => { root.changed(); }
                    }
                }
                if root.keep == 2: HorizontalLayout {
                    spacing: Theme.gap;
                    Text {
                        horizontal-stretch: 1;
                        text: root.folder == "" ? @tr("No folder chosen") : root.folder;
                        color: root.folder == "" ? Theme.text-muted : Theme.text;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Button { text: @tr("Choose…"); enabled: !root.busy; clicked => { root.choose-folder(); } }
                }
                Rectangle {
                    vertical-stretch: 1;
                    min-height: 160px;
                    border-width: 1px;
                    border-color: Theme.line;
                    border-radius: Theme.radius;
                    clip: true;
                    ListView {
                        for row in root.rows: HorizontalLayout {
                            padding-left: row.state == 0 ? Theme.s2 : Theme.s5;
                            padding-right: Theme.s2;
                            spacing: Theme.s2;
                            height: Theme.row-height;
                            Text {
                                horizontal-stretch: 1;
                                text: row.text;
                                color: row.state == 3 ? Theme.text-muted : Theme.text;
                                font-weight: row.state == 0 ? 600 : 400;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: row.note;
                                color: row.state == 2 ? Theme.danger : Theme.text-muted;
                                horizontal-alignment: right;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text { text: root.summary; color: Theme.text; wrap: word-wrap; }
                Text {
                    text: @tr("Just before a copy goes to the trash it is compared byte for byte with the copy that stays; a copy that changed or differs stays. Undo brings the copies back from the trash.");
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: Theme.s2;
                    Button { text: @tr("Cancel"); enabled: !root.busy; clicked => { root.cancel(); } }
                    Button {
                        text: @tr("Move to trash");
                        primary: true;
                        enabled: root.can-apply && !root.busy;
                        clicked => { root.apply(); }
                    }
                }
            }
        }
    }
}
