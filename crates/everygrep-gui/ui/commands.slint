// The main window's commands. One list for the keys, the menus and the
// keyboard settings; src/commands.rs gives each one its id, label and
// default keys.
export enum Command {
    none,
    new-window,
    close-window,
    export-results,
    quit,
    open,
    open-folder,
    open-with,
    cut,
    copy,
    paste,
    copy-name,
    copy-path,
    copy-full-path,
    copy-path-quoted,
    copy-full-path-quoted,
    select-all,
    invert-selection,
    toggle-row,
    rename,
    create-shortcut,
    search-in-program,
    search-containing-folder,
    trash,
    delete-permanently,
    focus-search,
    context-menu,
    type-column,
    extension-column,
    created-column,
    accessed-column,
    attributes-column,
    md5-column,
    sha256-column,
    crc32-column,
    name-frequency-column,
    extension-frequency-column,
    size-frequency-column,
    selection-details,
    menu-bar,
    fit-columns,
    fit-columns-to-window,
    refresh,
    match-case,
    whole-words,
    match-path,
    match-diacritics,
    regex,
    match-prefix,
    match-suffix,
    ignore-punctuation,
    ignore-whitespace,
    show-hidden-files,
    hide-hidden-files,
    only-hidden-files,
    cycle-hidden-files,
    previous-filter,
    next-filter,
    previous-search,
    next-search,
    find-duplicates,
    find-name-duplicates,
    find-size-duplicates,
    clear-duplicates,
    rebuild-index,
    pause-index-updates,
    show-history,
    organize-history,
    add-filter,
    organize-filters,
    restore-filters,
    add-bookmark,
    organize-bookmarks,
    advanced-search,
    settings,
    keyboard-settings,
    shortcuts-help,
    about,
}

// The key shown next to each command in the menu bar; empty for none (see
