// The main window's commands. One list for the keys, the menus and the
// keyboard settings; src/commands.rs gives each one its id, label and
// default keys.
export enum Command {
    none,
    new-window,
    export-results,
    quit,
    open,
    open-folder,
    open-with,
    cut,
    copy,
    paste,
    copy-name,
    copy-path,
    copy-full-path,
    select-all,
    invert-selection,
    toggle-row,
    rename,
    trash,
    delete-permanently,
    focus-search,
    context-menu,
    match-case,
    whole-words,
    match-path,
    match-diacritics,
    regex,
    match-prefix,
    match-suffix,
    ignore-punctuation,
    ignore-whitespace,
    previous-filter,
    next-filter,
    previous-search,
    next-search,
    settings,
}
