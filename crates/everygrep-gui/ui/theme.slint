// Design tokens (see docs/design.md). Components use only these values.
import { Palette } from "std-widgets.slint";

export struct AccentColors {
    light: color,
    dark: color,
    light-selection: color,
    dark-selection: color,
    custom-selection: bool,
}

export global Theme {
    in-out property <AccentColors> accents: {
        light: #1f5fd6, dark: #70a6ff,
        light-selection: #d3e2fd, dark-selection: #2b4a80,
        custom-selection: false,
    };
    // The colors the program chose: light or dark. Unknown follows the
    // toolkit's own reading of the desktop setting, which is used until the
    // program knows it (see set-color-scheme in the windows).
    in-out property <ColorScheme> scheme: ColorScheme.unknown;
    out property <bool> dark: scheme == ColorScheme.unknown
        ? Palette.color-scheme == ColorScheme.dark
        : scheme == ColorScheme.dark;

    in-out property <int> dark-style: 0;
    in-out property <int> light-style: 0;
    // Preserve the initial desktop binding until an explicit scheme is known.
    in-out property <bool> palette-set: false;

    // Colors. Light: text is 17.9:1 on the surface and muted text 7.1:1
    // (6.3:1 on hover); the selection keeps dark text (13:1), and the accent
    // marks focus and the sort column. The search field is white with a
    // visible border, since the surface is white too.
    out property <color> surface: dark ? (dark-style == 1 ? #17191d : dark-style == 2 ? #202124 : dark-style == 3 ? #1c1d20 : #1c2430) : (light-style == 1 ? #f5f8fc : light-style == 2 ? #f0f2f5 : light-style == 3 ? #fafafa : #ffffff);
    out property <color> surface-alt: dark ? (dark-style == 1 ? #292c32 : dark-style == 2 ? #2b2d31 : dark-style == 3 ? #232428 : #263244) : (light-style == 1 ? #e8eef7 : light-style == 2 ? #e2e6ec : light-style == 3 ? #eeeeee : #f5f6f8);
    out property <color> field: dark ? (dark-style == 1 ? #22262d : dark-style == 2 ? #191a1d : dark-style == 3 ? #2a2b30 : #16202d) : #ffffff;
    out property <color> field-line: dark ? (dark-style == 1 ? #747c89 : dark-style == 2 ? #656a74 : dark-style == 3 ? #33353b : #637992) : (light-style == 1 ? #aebdd0 : light-style == 2 ? #9eabba : light-style == 3 ? #b8b8b8 : #c5cad2);
    out property <color> text: dark ? #ecedf0 : (light-style == 1 ? #172233 : light-style == 2 ? #151b24 : light-style == 3 ? #202020 : #16171a);
    out property <color> text-muted: dark ? (dark-style == 1 ? #b0b7c4 : dark-style == 2 ? #a3a6ad : dark-style == 3 ? #a3a6ad : #b1becd) : (light-style == 1 ? #485971 : light-style == 2 ? #4d5a6b : light-style == 3 ? #555555 : #545862);
    out property <color> line: dark ? (dark-style == 1 ? #555e6c : dark-style == 2 ? #50545d : dark-style == 3 ? #33353b : #495e76) : (light-style == 1 ? #cbd6e5 : light-style == 2 ? #b7c2d0 : light-style == 3 ? #d0d0d0 : #dfe2e7);
    out property <color> accent: dark ? accents.dark : accents.light;
    out property <color> accent-text: dark ? #08121c : #ffffff;
    out property <color> selection: accents.custom-selection ? (dark ? accents.dark-selection : accents.light-selection) : dark ? (dark-style == 1 ? #2f5087 : dark-style == 2 ? #2b4a80 : dark-style == 3 ? #2b4a80 : #315580) : #d3e2fd;
    out property <color> selection-text: dark ? #ffffff : #0b1b3d;
    out property <color> hover: dark ? (dark-style == 1 ? #353c47 : dark-style == 2 ? #34373d : dark-style == 3 ? #26282d : #304159) : (light-style == 1 ? #e4edf9 : light-style == 2 ? #dae3ef : light-style == 3 ? #e7e7e7 : #eef1f5);
    // Every second row, when alternate row colors are on: text keeps
    // 17.0:1 (13.6:1 dark), muted text 6.8:1 (6.5:1) and offline text
    // 3.9:1 (4.1:1) on it.
    out property <color> row-alt: dark ? (dark-style == 1 ? #20242b : dark-style == 2 ? #26282c : dark-style == 3 ? #212226 : #222d3d) : (light-style == 1 ? #eef3fa : light-style == 2 ? #e8edf3 : light-style == 3 ? #f3f3f3 : #f8f9fb);
    out property <color> danger: dark ? #ff8080 : #b42323;
    // Entries of a drive that is not connected: dimmer than muted text,
    // still readable (4.1:1 on the light surface, 4.3:1 on the dark one).
    out property <color> text-offline: dark ? #7d8189 : (light-style == 1 ? #65768d : light-style == 2 ? #637388 : light-style == 3 ? #737373 : #787d87);

    // Floating surfaces keep an opaque edge in both schemes.
    out property <color> popup-surface: dark ? (dark-style == 1 ? #343a45 : dark-style == 2 ? #2c2e33 : dark-style == 3 ? #272930 : #2b394b) : (light-style == 1 ? #f4f7fc : light-style == 2 ? #ffffff : light-style == 3 ? #f8f8f8 : #ffffff);
    out property <color> popup-edge: dark ? (dark-style == 1 ? #a1adbe : dark-style == 2 ? #8d949f : dark-style == 3 ? #858b98 : #8ba2bc) : (light-style == 1 ? #6c819b : light-style == 2 ? #6b7c91 : light-style == 3 ? #777777 : #77808e);
    out property <color> popup-shadow: dark ? #00000080 : #00000040;

    // Spacing
    out property <length> s1: 4px;
    out property <length> s2: 8px;
    out property <length> s3: 12px;
    out property <length> s4: 16px;
    out property <length> s5: 24px;
    // Layout, used by every window instead of its own numbers: the outer
    // margin of a window (nothing touches the window edge), the padding
    // inside a dialog card or a settings page, and the gap between a label
    // and its field and between the controls of a row.
    out property <length> margin: s4;
    out property <length> dialog-padding: s5;
    out property <length> gap: s2;

    // Density: compact packs the list, its header, the top bar and the
    // status line tighter (rows 22 px instead of 28 px).
    in-out property <bool> compact: false;
    // Zoom of the result list (1 = 100 %): its rows, header, text and icons.
    in-out property <float> zoom: 1;

    // Shapes and sizes
    out property <length> radius: 6px;
    out property <length> row-height: round((compact ? 22px : 28px) * zoom / 1px) * 1px;
    out property <length> header-height: round((compact ? 24px : 30px) * zoom / 1px) * 1px;
    out property <length> top-bar-height: compact ? 40px : 48px;
    out property <length> field-height: compact ? 30px : 34px;
    out property <length> status-height: compact ? 22px : 26px;
    out property <length> badge-height: compact ? 16px : 18px;
    out property <length> icon: 16px;
    // File-type icons in the rows.
    out property <length> row-icon: round((compact ? 14px : 16px) * zoom / 1px) * 1px;

    // Type
    out property <length> body: 13px;
    out property <length> small: 12px;
    out property <length> header-text: round(small * zoom / 1px) * 1px;
    // Text in the rows.
    out property <length> list-text: round((compact ? 12px : 13px) * zoom / 1px) * 1px;
}

// Shared surface for the app's dialog cards and floating overlays.
export component PopupCard inherits Rectangle {
    background: Theme.popup-surface;
    border-color: Theme.popup-edge;
    border-width: 2px;
    border-radius: Theme.radius;
    drop-shadow-color: Theme.popup-shadow;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
}

// Keep a client edge independently of the desktop's window decorations.
export component PopupOutline inherits Rectangle {
    x: 0px; y: 0px;
    width: 100%; height: 100%;
    border-width: 2px;
    border-color: Theme.popup-edge;
    background: transparent;
}
