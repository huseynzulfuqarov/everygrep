// The settings window. Changes apply at once; each page has a button that
// puts its settings back to the defaults.
import { Button, CheckBox, ComboBox, Palette, SpinBox, StandardListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

component Heading inherits Text {
    font-size: Theme.body;
    font-weight: 600;
    color: Theme.text;
}

component Note inherits Text {
    font-size: Theme.small;
    color: Theme.text-muted;
    wrap: word-wrap;
}

// A list of folders with Add and Remove buttons.
component FolderList inherits VerticalLayout {
    in property <string> title;
    in property <string> count;
    in property <string> empty-text;
    in property <[StandardListViewItem]> model;
    // Remove is offered only while more than this many folders are listed.
    in property <int> keep: 0;
    callback add();
    callback remove(int);

    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s2;
        Heading { text: root.title; }
        Note { text: root.count; vertical-alignment: center; horizontal-stretch: 1; }
    }
    Rectangle {
        min-height: 92px;
        vertical-stretch: 1;
        list := StandardListView {
            accessible-label: root.title;
            model: root.model;
        }
        if root.model.length == 0: Note {
            text: root.empty-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        alignment: start;
        Button {
            text: "Add…";
            clicked => { root.add(); }
        }
        Button {
            text: "Remove";
            enabled: list.current-item >= 0 && list.current-item < root.model.length
                && root.model.length > root.keep;
            clicked => {
                root.remove(list.current-item);
                list.current-item = -1;
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "EveryGrep settings";
    icon: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
    preferred-width: 680px;
    preferred-height: 560px;
    min-width: 520px;
    min-height: 420px;
    background: Theme.surface;
    default-font-size: Theme.body;

    // 0 indexing, 1 search, 2 appearance, 3 window, 4 keyboard shortcut.
    in-out property <int> page: 0;
    // A problem with the settings file or the last action; empty when fine.
    in property <string> error;

    // Indexing
    in property <[StandardListViewItem]> roots;
    in property <string> roots-count;
    in property <[StandardListViewItem]> excludes;
    in property <string> excludes-count;
    // Shown when the folders came from the command line.
    in property <string> index-note;
    in property <string> index-status;
    callback add-roots();
    callback remove-root(int);
    callback add-excludes();
    callback remove-exclude(int);
    callback rebuild();

    // Search
    in property <[string]> filter-names;
    in-out property <int> default-filter;
    in-out property <bool> default-case;
    in-out property <bool> default-words;
    in-out property <bool> default-path;
    in-out property <bool> default-diacritics;
    in-out property <int> history-size;
    in property <int> history-max;
    in-out property <bool> history-on-disk;
    callback search-changed();

    // Appearance
    in property <[string]> theme-names;
    in-out property <int> theme;
    in property <[string]> density-names;
    in-out property <int> density;
    in-out property <bool> status-details;
    in-out property <bool> menu-bar;
    callback appearance-changed();

    // Window
    in property <[string]> close-names;
    in-out property <int> on-close;
    in property <string> on-close-note;
    in-out property <bool> remember-columns;
    in property <[string]> folder-size-names;
    in-out property <int> folder-size;
    in property <string> folder-size-note;
    callback window-changed();

    // Keyboard shortcut
    in property <string> command;
    in property <string> shortcut-steps;
    callback copy-command();

    // Puts the settings of the page back to their defaults.
    callback reset-page(int);
    callback close-window();

    // Focuses the page list, on the current page.
    public function focus-pages() {
        pages.set-current-item(root.page);
        pages.focus();
    }

    changed page => { pages.set-current-item(root.page); }

    // Colors: 1 light, 2 dark, 0 the toolkit's reading of the desktop
    // setting. Sets the palette of the standard widgets too.
    public function set-color-scheme(scheme: int) {
        Theme.scheme = scheme == 1 ? ColorScheme.light : scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Palette.color-scheme = Theme.scheme;
    }

    // Puts text on the clipboard through a hidden text field.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-window();
                return accept;
            }
            if (event.modifiers.control && (event.text == Key.PageDown || event.text == Key.PageUp)) {
                root.page = Math.mod(root.page + (event.text == Key.PageDown ? 1 : -1), 5);
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // Pages
            Rectangle {
                width: 170px;
                background: Theme.surface-alt;
                VerticalLayout {
                    padding: Theme.s2;
                    pages := StandardListView {
                        accessible-label: "Settings pages";
                        model: [
                            { text: "Indexing" },
                            { text: "Search" },
                            { text: "Appearance" },
                            { text: "Window" },
                            { text: "Keyboard shortcut" },
                        ];
                        // Not bound to the page: the list keeps its own
                        // keyboard position, which set-current-item() moves.
                        current-item-changed(i) => { root.page = i; }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }

            VerticalLayout {
                padding: Theme.s5;
                spacing: Theme.s4;

                if root.error != "": Text {
                    text: root.error;
                    color: Theme.danger;
                    font-size: Theme.small;
                    wrap: word-wrap;
                }

                if root.page == 0: VerticalLayout {
                    spacing: Theme.s4;
                    vertical-stretch: 1;
                    if root.index-note != "": Note { text: root.index-note; }
                    FolderList {
                        title: "Folders to index";
                        count: root.roots-count;
                        empty-text: "Your home folder";
                        model: root.roots;
                        keep: 1;
                        add => { root.add-roots(); }
                        remove(i) => { root.remove-root(i); }
                    }
                    FolderList {
                        title: "Excluded folders";
                        count: root.excludes-count;
                        empty-text: "None. Folders listed here are shown but not searched inside.";
                        model: root.excludes;
                        add => { root.add-excludes(); }
                        remove(i) => { root.remove-exclude(i); }
                    }
                    HorizontalLayout {
                        spacing: Theme.s3;
                        Button {
                            text: "Rebuild index now";
                            clicked => { root.rebuild(); }
                        }
                        Note {
                            text: root.index-status;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                if root.page == 1: VerticalLayout {
                    spacing: Theme.s3;
                    alignment: start;
                    vertical-stretch: 1;
                    Heading { text: "When EveryGrep starts"; }
                    HorizontalLayout {
                        spacing: Theme.s3;
                        Text {
                            text: "Filter";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            width: 180px;
                            accessible-label: "Default filter";
                            model: root.filter-names;
                            current-index <=> root.default-filter;
                            selected => { root.search-changed(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    CheckBox {
                        text: "Match case";
                        checked <=> root.default-case;
                        toggled => { root.search-changed(); }
                    }
                    CheckBox {
                        text: "Match whole words";
                        checked <=> root.default-words;
                        toggled => { root.search-changed(); }
                    }
                    CheckBox {
                        text: "Match the full path";
                        checked <=> root.default-path;
                        toggled => { root.search-changed(); }
                    }
                    CheckBox {
                        text: "Match diacritics";
                        checked <=> root.default-diacritics;
                        toggled => { root.search-changed(); }
                    }
                    Note { text: "Options given on the command line take their place."; }
                    Rectangle { height: Theme.s2; }
                    Heading { text: "Search history"; }
                    HorizontalLayout {
                        spacing: Theme.s3;
                        Text {
                            text: "Searches to keep";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        SpinBox {
                            width: 140px;
                            horizontal-stretch: 0;
                            accessible-label: "Searches to keep";
                            minimum: 0;
                            maximum: root.history-max;
                            value <=> root.history-size;
                            edited => { root.search-changed(); }
                        }
                        Note {
                            text: "0 turns the history off.";
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    CheckBox {
                        text: "Keep the history after EveryGrep closes";
                        enabled: root.history-size > 0;
                        checked <=> root.history-on-disk;
                        toggled => { root.search-changed(); }
                    }
                    Note { text: "Off: the history is forgotten when EveryGrep quits. Turning it off deletes the saved history."; }
                }

                if root.page == 2: VerticalLayout {
                    spacing: Theme.s3;
                    alignment: start;
                    vertical-stretch: 1;
                    Heading { text: "Colors"; }
                    HorizontalLayout {
                        spacing: Theme.s3;
                        Text {
                            text: "Theme";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            width: 200px;
                            accessible-label: "Theme";
                            model: root.theme-names;
                            current-index <=> root.theme;
                            selected => { root.appearance-changed(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Note { text: "Same as the desktop follows the light or dark style chosen in the desktop's settings, also when it changes."; }
                    Rectangle { height: Theme.s2; }
                    Heading { text: "Result list"; }
                    HorizontalLayout {
                        spacing: Theme.s3;
                        Text {
                            text: "Density";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            width: 200px;
                            accessible-label: "Density of the result list";
                            model: root.density-names;
                            current-index <=> root.density;
                            selected => { root.appearance-changed(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Note { text: "Compact shows more rows at once, with smaller icons and text."; }
                    Rectangle { height: Theme.s2; }
                    Heading { text: "Status line"; }
                    CheckBox {
                        text: "Show details of the selected items";
                        checked <=> root.status-details;
                        toggled => { root.appearance-changed(); }
                    }
                    Note { text: "One selected item shows its size, modification time and full path; several show their number and the total size of the files among them."; }
                    Rectangle { height: Theme.s2; }
                    Heading { text: "Menu bar"; }
                    CheckBox {
                        text: "Show the menu bar";
                        checked <=> root.menu-bar;
                        toggled => { root.appearance-changed(); }
                    }
                    Note { text: "Without it, the ⋯ button next to the filter holds Settings, Keyboard shortcuts, About and Quit."; }
                }

                if root.page == 3: VerticalLayout {
                    spacing: Theme.s3;
                    alignment: start;
                    vertical-stretch: 1;
                    Heading { text: "Closing the window"; }
                    HorizontalLayout {
                        ComboBox {
                            width: 300px;
                            accessible-label: "When the window is closed";
                            model: root.close-names;
                            current-index <=> root.on-close;
                            selected => { root.window-changed(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Note { text: root.on-close-note; }
                    Rectangle { height: Theme.s2; }
                    Heading { text: "Columns"; }
                    CheckBox {
                        text: "Remember the shown columns and their widths";
                        checked <=> root.remember-columns;
                        toggled => { root.window-changed(); }
                    }
                    Note { text: "Right-click the column headers to show the Type and Extension columns; drag the header borders to resize."; }
                    Rectangle { height: Theme.s2; }
                    Heading { text: "Folder size"; }
                    HorizontalLayout {
                        spacing: Theme.s3;
                        Text {
                            text: "The Size column shows";
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            width: 180px;
                            accessible-label: "What the Size column shows for folders";
                            model: root.folder-size-names;
                            current-index <=> root.folder-size;
                            selected => { root.window-changed(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Note { text: root.folder-size-note; }
                }

                if root.page == 4: VerticalLayout {
                    spacing: Theme.s3;
                    alignment: start;
                    vertical-stretch: 1;
                    Heading { text: "Open EveryGrep with a key"; }
                    Note { text: root.shortcut-steps; color: Theme.text; }
                    HorizontalLayout {
                        spacing: Theme.s2;
                        Rectangle {
                            height: 32px;
                            horizontal-stretch: 1;
                            border-radius: Theme.radius;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: Theme.line;
                            Text {
                                x: Theme.s3;
                                text: root.command;
                                color: Theme.text;
                                font-family: "monospace";
                                vertical-alignment: center;
                            }
                        }
                        Button {
                            text: "Copy command";
                            clicked => { root.copy-command(); }
                        }
                    }
                    Note { text: "Pressing the keys again while EveryGrep is open brings its window to the front."; }
                }

                if root.page < 4: HorizontalLayout {
                    alignment: end;
                    Button {
                        text: "Reset to defaults";
                        clicked => { root.reset-page(root.page); }
                    }
                }
            }
        }
    }

    // Hidden text field used by copy-text().
    clip := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        single-line: false;
        read-only: true;
        enabled: false;
    }
}
