// The settings window. Changes apply at once; each page has a button that
// puts its settings back to the defaults.
import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, SpinBox, StandardListView } from "std-widgets.slint";
import { Theme } from "theme.slint";

// A command for a keyboard shortcut, on the Keyboard shortcut page.
export struct ShortcutCommand {
    // What the shortcut does: "Show the window", ...
    title: string,
    command: string,
    // When to choose it.
    note: string,
}

// One known removable drive in the Drives list.
export struct DriveRow {
    // The label, or the UUID when it has none.
    title: string,
    // UUID, connected or not, entries, last seen, mount point.
    details: string,
    online: bool,
    // Forget is offered only for a drive that is not connected.
    can-forget: bool,
    // "Don't index this drive" or "Index this drive".
    action: string,
}

component Heading inherits Text {
    font-size: Theme.body;
    font-weight: 600;
    color: Theme.text;
}

component Note inherits Text {
    font-size: Theme.small;
    color: Theme.text-muted;
    wrap: word-wrap;
}

// A list of folders with Add and Remove buttons.
component FolderList inherits VerticalLayout {
    in property <string> title;
    in property <string> count;
    in property <string> empty-text;
    in property <[StandardListViewItem]> model;
    // Remove is offered only while more than this many folders are listed.
    in property <int> keep: 0;
    callback add();
    callback remove(int);

    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s2;
        Heading { text: root.title; }
        Note { text: root.count; vertical-alignment: center; horizontal-stretch: 1; }
    }
    Rectangle {
        min-height: 92px;
        vertical-stretch: 1;
        list := StandardListView {
            accessible-label: root.title;
            model: root.model;
        }
        if root.model.length == 0: Note {
            text: root.empty-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        alignment: start;
        Button {
            text: @tr("Add…");
            clicked => { root.add(); }
        }
        Button {
            text: @tr("Remove");
            enabled: list.current-item >= 0 && list.current-item < root.model.length
                && root.model.length > root.keep;
            clicked => {
                root.remove(list.current-item);
                list.current-item = -1;
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("EveryGrep settings");
    icon: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
    preferred-width: 680px;
    preferred-height: 600px;
    min-width: 520px;
    min-height: 420px;
    background: Theme.surface;
    default-font-size: Theme.body;

    // 0 indexing, 1 search, 2 appearance, 3 window, 4 keyboard.
    in-out property <int> page: 0;
    // A problem with the settings file or the last action; empty when fine.
    in property <string> error;

    // Indexing
    in property <[StandardListViewItem]> roots;
    in property <string> roots-count;
    in property <[StandardListViewItem]> excludes;
    in property <string> excludes-count;
    // Shown when the folders came from the command line.
    in property <string> index-note;
    in property <string> index-status;
    callback add-roots();
    callback remove-root(int);
    callback add-excludes();
    callback remove-exclude(int);
    // Excluded folders and file filters, and their switch.
    in-out property <bool> use-excludes;
    in-out property <string> exclude-pattern;
    in-out property <string> include-files;
    in-out property <string> exclude-files;
    // Why the last change of them was refused; empty when fine.
    in property <string> rule-error;
    callback add-exclude-pattern(string);
    callback rules-changed();
    in-out property <bool> watch-changes;
    callback watch-changed();
    callback rebuild();
    // Removable drives (shown when the program can keep drive indexes).
    in property <bool> drives-enabled;
    in-out property <bool> index-drives;
    in property <[string]> removed-names;
    in-out property <int> removed-choice;
    in property <[DriveRow]> drives;
    callback drives-changed();
    callback forget-drive(int);
    callback toggle-drive(int);

    // Search
    in property <[string]> filter-names;
    in-out property <int> default-filter;
    in-out property <bool> default-case;
    in-out property <bool> default-words;
    in-out property <bool> default-path;
    in-out property <bool> default-diacritics;
    in-out property <bool> default-regex;
    in-out property <bool> default-prefix;
    in-out property <bool> default-suffix;
    in-out property <bool> default-punctuation;
    in-out property <bool> default-whitespace;
    in-out property <bool> as-you-type;
    in-out property <bool> select-search-on-click;
    in-out property <int> history-size;
    in property <int> history-max;
    in-out property <bool> history-on-disk;
    callback search-changed();

    // Appearance
    in property <[string]> language-names;
    in-out property <int> language;
    in property <[string]> theme-names;
    in-out property <int> theme;
    in property <[string]> density-names;
    in-out property <int> density;
    in-out property <bool> status-details;
    in-out property <bool> menu-bar;
    in-out property <bool> alternate-rows;
    callback appearance-changed();

    // Window
    in property <[string]> close-names;
    in-out property <int> on-close;
    in property <string> on-close-note;
    in-out property <bool> remember-columns;
    in-out property <bool> rename-name-only;
    in-out property <bool> focus-on-show;
    in-out property <bool> dates-newest-first;
    in-out property <bool> sizes-largest-first;
    in-out property <bool> start-on-login;
    in property <string> start-on-login-note;
    callback start-on-login-changed(bool);
    in property <[string]> folder-size-names;
    in-out property <int> folder-size;
    in property <string> folder-size-note;
    callback window-changed();

    // Keyboard: the commands of the main window shown for the filter, the
    // chosen one (-1 for none) and its keys.
    in-out property <string> key-filter;
    in property <[StandardListViewItem]> key-commands;
    in-out property <int> key-current: -1;
    in property <[StandardListViewItem]> key-bindings;
    in-out property <int> key-binding-current: -1;
    callback key-filter-edited(string);
    callback key-command-chosen(int);
    callback remove-binding(int);
    callback restore-keys();
    // The dialog that adds or changes one key of the chosen command: where
    // the key works (0 global, 1 search field, 2 result list), the key
    // pressed, the commands that have it, and why it cannot be used.
    callback add-binding();
    callback edit-binding(int);
    in-out property <bool> key-dialog-open;
    in property <string> key-dialog-title;
    in property <string> key-dialog-command;
    in property <[string]> scope-names;
    in-out property <int> key-scope;
    in property <string> key-captured;
    in property <string> key-used-by;
    in property <string> key-also-used;
    in property <string> key-refused;
    in property <bool> key-can-apply;
    callback key-scope-changed();
    callback key-pressed-in-dialog(string, bool, bool, bool, bool);
    callback key-dialog-accepted();
    callback key-dialog-cancelled();
    // Opening EveryGrep with a desktop shortcut.
    in property <[ShortcutCommand]> commands;
    in property <string> shortcut-steps;
    callback copy-command(int);

    // Puts the settings of the page back to their defaults.
    callback reset-page(int);
    callback close-window();

    // Focuses the page list, on the current page.
    public function focus-pages() {
        pages.set-current-item(root.page);
        pages.focus();
    }

    changed page => { pages.set-current-item(root.page); }

    // Colors: 1 light, 2 dark, 0 the toolkit's reading of the desktop
    // setting. Sets the palette of the standard widgets too.
    public function set-color-scheme(scheme: int) {
        Theme.scheme = scheme == 1 ? ColorScheme.light : scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Palette.color-scheme = Theme.scheme;
    }

    // Puts text on the clipboard through a hidden text field.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-window();
                return accept;
            }
            if (event.modifiers.control && (event.text == Key.PageDown || event.text == Key.PageUp)) {
                root.page = Math.mod(root.page + (event.text == Key.PageDown ? 1 : -1), 5);
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // Pages
            Rectangle {
                width: 170px;
                background: Theme.surface-alt;
                VerticalLayout {
                    padding: Theme.s2;
                    pages := StandardListView {
                        accessible-label: @tr("Settings pages");
                        model: [
                            { text: @tr("Indexing") },
                            { text: @tr("Search") },
                            { text: @tr("Appearance") },
                            { text: @tr("Window") },
                            { text: @tr("Keyboard") },
                        ];
                        // Not bound to the page: the list keeps its own
                        // keyboard position, which set-current-item() moves.
                        current-item-changed(i) => { root.page = i; }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }

            VerticalLayout {
                // The page scrolls when it is taller than the window (longer
                // translations wrap to more lines); Reset stays in view.
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Theme.s5;
                        spacing: Theme.s4;

                        if root.error != "": Text {
                            text: root.error;
                            color: Theme.danger;
                            font-size: Theme.small;
                            wrap: word-wrap;
                        }

                        if root.page == 0: VerticalLayout {
                            spacing: Theme.s4;
                            vertical-stretch: 1;
                            if root.index-note != "": Note { text: root.index-note; }
                            FolderList {
                                title: @tr("Folders to index");
                                count: root.roots-count;
                                empty-text: @tr("Your home folder");
                                model: root.roots;
                                keep: 1;
                                add => { root.add-roots(); }
                                remove(i) => { root.remove-root(i); }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                CheckBox {
                                    text: @tr("Watch for changes");
                                    checked <=> root.watch-changes;
                                    toggled => { root.watch-changed(); }
                                }
                                Note { text: @tr("Off: files added, removed or renamed while EveryGrep runs are not seen, and the status line says so. Turning it on again catches up with the changes, then watches."); }
                            }
                            CheckBox {
                                text: @tr("Use the exclude list");
                                checked <=> root.use-excludes;
                                toggled => { root.rules-changed(); }
                            }
                            FolderList {
                                title: @tr("Excluded folders");
                                count: root.excludes-count;
                                empty-text: @tr("None. Folders listed here are left out of the index with all they hold.");
                                model: root.excludes;
                                add => { root.add-excludes(); }
                                remove(i) => { root.remove-exclude(i); }
                            }
                            HorizontalLayout {
                                spacing: Theme.s2;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    accessible-label: @tr("Folder pattern");
                                    placeholder-text: @tr("Folder name or pattern: node_modules, *.git, regex:^te?mp$");
                                    text <=> root.exclude-pattern;
                                    accepted(text) => { root.add-exclude-pattern(text); }
                                }
                                Button {
                                    text: @tr("Add pattern");
                                    enabled: root.exclude-pattern != "";
                                    clicked => { root.add-exclude-pattern(root.exclude-pattern); }
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                Heading { text: @tr("Include only files"); }
                                LineEdit {
                                    accessible-label: @tr("Include only files");
                                    placeholder-text: @tr("Empty includes all files. Example: *.mp3;*.jpg");
                                    text <=> root.include-files;
                                    accepted => { root.rules-changed(); }
                                }
                                Heading { text: @tr("Exclude files"); }
                                LineEdit {
                                    accessible-label: @tr("Exclude files");
                                    placeholder-text: @tr("Example: *.tmp;~*");
                                    text <=> root.exclude-files;
                                    accepted => { root.rules-changed(); }
                                }
                                Note { text: @tr("Separate patterns with “;”. * matches any characters except /, ** any characters, ? one character. A pattern is matched against the whole name, ignoring case; with a / it is matched against the full path. regex: starts a regular expression. An exclude pattern wins over an include pattern."); }
                                HorizontalLayout {
                                    spacing: Theme.s3;
                                    Button {
                                        text: @tr("Apply filters");
                                        clicked => { root.rules-changed(); }
                                    }
                                    Note {
                                        text: @tr("Changing the lists or the switch indexes again.");
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                                if root.rule-error != "": Text {
                                    text: root.rule-error;
                                    color: Theme.danger;
                                    font-size: Theme.small;
                                    wrap: word-wrap;
                                }
                            }
                            if root.drives-enabled: VerticalLayout {
                                spacing: Theme.s2;
                                Heading { text: @tr("Removable drives"); }
                                CheckBox {
                                    text: @tr("Index removable drives automatically");
                                    checked <=> root.index-drives;
                                    toggled => { root.drives-changed(); }
                                }
                                Note { text: @tr("Drives the desktop mounts when they are plugged in (under /run/media) are indexed each in a file of their own. Disks the system mounts, such as those listed in /etc/fstab, are never indexed this way."); }
                                HorizontalLayout {
                                    spacing: Theme.s3;
                                    Text {
                                        text: @tr("When a drive is removed");
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                    ComboBox {
                                        width: 260px;
                                        accessible-label: @tr("When a drive is removed");
                                        model: root.removed-names;
                                        current-index <=> root.removed-choice;
                                        selected => { root.drives-changed(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.drives.length == 0: Note {
                                    text: @tr("No drives yet. Plug one in to index it.");
                                }
                                for drive[i] in root.drives: Rectangle {
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.field;
                                    HorizontalLayout {
                                        padding: Theme.s2;
                                        padding-left: Theme.s3;
                                        spacing: Theme.s2;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text {
                                                text: drive.title;
                                                color: drive.online ? Theme.text : Theme.text-offline;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Note { text: drive.details; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: @tr("Forget");
                                                enabled: drive.can-forget;
                                                clicked => { root.forget-drive(i); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: drive.action;
                                                clicked => { root.toggle-drive(i); }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Button {
                                    text: @tr("Rebuild index now");
                                    clicked => { root.rebuild(); }
                                }
                                Note {
                                    text: root.index-status;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        if root.page == 1: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            CheckBox {
                                text: @tr("Search as you type");
                                checked <=> root.as-you-type;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: the results change only when you press Enter in the search field."); }
                            CheckBox {
                                text: @tr("Select the search text on a click into the field");
                                checked <=> root.select-search-on-click;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("A second click places the cursor. Off: the first click places it."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("When EveryGrep starts"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Filter");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 180px;
                                    accessible-label: @tr("Default filter");
                                    model: root.filter-names;
                                    current-index <=> root.default-filter;
                                    selected => { root.search-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            CheckBox {
                                text: @tr("Match case");
                                checked <=> root.default-case;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match whole words");
                                checked <=> root.default-words;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match the full path");
                                checked <=> root.default-path;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match diacritics");
                                checked <=> root.default-diacritics;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Regular expression");
                                checked <=> root.default-regex;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match prefix");
                                checked <=> root.default-prefix;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match suffix");
                                checked <=> root.default-suffix;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Ignore punctuation");
                                checked <=> root.default-punctuation;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Ignore whitespace");
                                checked <=> root.default-whitespace;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Options given on the command line take their place."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Search history"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Searches to keep");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    width: 140px;
                                    horizontal-stretch: 0;
                                    accessible-label: @tr("Searches to keep");
                                    minimum: 0;
                                    maximum: root.history-max;
                                    value <=> root.history-size;
                                    edited => { root.search-changed(); }
                                }
                                Note {
                                    text: @tr("0 turns the history off.");
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                            CheckBox {
                                text: @tr("Keep the history after EveryGrep closes");
                                enabled: root.history-size > 0;
                                checked <=> root.history-on-disk;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: the history is forgotten when EveryGrep quits. Turning it off deletes the saved history."); }
                        }

                        if root.page == 2: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            Heading { text: @tr("Language and colors"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Language");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Language");
                                    model: root.language-names;
                                    current-index <=> root.language;
                                    selected => { root.appearance-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("Same as the system follows LANGUAGE, LC_ALL, LC_MESSAGES or LANG. The command line stays in English."); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Theme");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Theme");
                                    model: root.theme-names;
                                    current-index <=> root.theme;
                                    selected => { root.appearance-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("Same as the desktop follows the light or dark style chosen in the desktop's settings, also when it changes."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Result list"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Density");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Density of the result list");
                                    model: root.density-names;
                                    current-index <=> root.density;
                                    selected => { root.appearance-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("Compact shows more rows at once, with smaller icons and text."); }
                            CheckBox {
                                text: @tr("Alternate row color");
                                checked <=> root.alternate-rows;
                                toggled => { root.appearance-changed(); }
                            }
                            Note { text: @tr("Every second row has a slightly different background, which makes long rows easier to follow."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Status line"); }
                            CheckBox {
                                text: @tr("Show details of the selected items");
                                checked <=> root.status-details;
                                toggled => { root.appearance-changed(); }
                            }
                            Note { text: @tr("One selected item shows its size, modification time and full path; several show their number and the total size of the files among them."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Menu bar"); }
                            CheckBox {
                                text: @tr("Show the menu bar");
                                checked <=> root.menu-bar;
                                toggled => { root.appearance-changed(); }
                            }
                            Note { text: @tr("Without it, the ⋯ button next to the filter holds Settings, Keyboard shortcuts, About and Quit."); }
                        }

                        if root.page == 3: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            Heading { text: @tr("Closing the window"); }
                            HorizontalLayout {
                                ComboBox {
                                    width: 300px;
                                    accessible-label: @tr("When the window is closed");
                                    model: root.close-names;
                                    current-index <=> root.on-close;
                                    selected => { root.window-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: root.on-close-note; }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Starting"); }
                            CheckBox {
                                text: @tr("Start EveryGrep when I log in");
                                checked <=> root.start-on-login;
                                toggled => { root.start-on-login-changed(self.checked); }
                            }
                            Note { text: root.start-on-login-note; }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Showing the window"); }
                            CheckBox {
                                text: @tr("Focus the search field when the window is shown");
                                checked <=> root.focus-on-show;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Its text is selected, so typing starts a new search. Off: the field or the list that had the focus keeps it."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Columns"); }
                            CheckBox {
                                text: @tr("Remember the shown columns and their widths");
                                checked <=> root.remember-columns;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Right-click the column headers to show the Type, Extension, Created, Accessed and Attributes columns; drag the header borders to resize."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Sorting"); }
                            CheckBox {
                                text: @tr("Sort dates newest first");
                                checked <=> root.dates-newest-first;
                                toggled => { root.window-changed(); }
                            }
                            CheckBox {
                                text: @tr("Sort sizes largest first");
                                checked <=> root.sizes-largest-first;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("The first click on the header of a date column or of Size sorts in this order; a second click reverses it. Off: they start with the oldest or smallest."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Rename"); }
                            CheckBox {
                                text: @tr("Leave the extension unselected when renaming");
                                checked <=> root.rename-name-only;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Off: the whole name is selected, extension included."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Folder size"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("The Size column shows");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 180px;
                                    accessible-label: @tr("What the Size column shows for folders");
                                    model: root.folder-size-names;
                                    current-index <=> root.folder-size;
                                    selected => { root.window-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: root.folder-size-note; }
                        }

                        if root.page == 4: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            Heading { text: @tr("Shortcuts in the window"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Show commands containing:");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    accessible-label: @tr("Show commands containing:");
                                    text <=> root.key-filter;
                                    edited(text) => { root.key-filter-edited(text); }
                                }
                            }
                            Rectangle {
                                height: 220px;
                                StandardListView {
                                    accessible-label: @tr("Commands");
                                    model: root.key-commands;
                                    current-item <=> root.key-current;
                                    current-item-changed(i) => { root.key-command-chosen(i); }
                                }
                                if root.key-commands.length == 0: Note {
                                    text: @tr("No command matches.");
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: @tr("Shortcuts for the selected command:");
                                color: Theme.text;
                            }
                            Rectangle {
                                height: 96px;
                                bindings := StandardListView {
                                    accessible-label: @tr("Shortcuts for the selected command:");
                                    model: root.key-bindings;
                                    current-item <=> root.key-binding-current;
                                }
                                if root.key-current >= 0 && root.key-bindings.length == 0: Note {
                                    text: @tr("None");
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.s2;
                                Button {
                                    text: @tr("Add…");
                                    enabled: root.key-current >= 0 && root.key-current < root.key-commands.length;
                                    clicked => { root.add-binding(); }
                                }
                                Button {
                                    text: @tr("Edit…");
                                    enabled: root.key-binding-current >= 0
                                        && root.key-binding-current < root.key-bindings.length;
                                    clicked => { root.edit-binding(root.key-binding-current); }
                                }
                                Button {
                                    text: @tr("Remove");
                                    enabled: root.key-binding-current >= 0
                                        && root.key-binding-current < root.key-bindings.length;
                                    clicked => { root.remove-binding(root.key-binding-current); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: @tr("Reset to defaults");
                                    clicked => { root.restore-keys(); }
                                }
                            }
                            Note { text: @tr("Movement keys, Tab and Esc cannot be changed. A key of the search field or the result list wins over a global key while that control has the focus."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Open EveryGrep with a key"); }
                            Note { text: root.shortcut-steps; color: Theme.text; }
                            for c[i] in root.commands: VerticalLayout {
                                spacing: Theme.s1;
                                padding-top: Theme.s2;
                                Text {
                                    text: c.title;
                                    color: Theme.text;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: Theme.s2;
                                    Rectangle {
                                        height: 32px;
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius;
                                        background: Theme.field;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        Text {
                                            x: Theme.s3;
                                            width: parent.width - 2 * Theme.s3;
                                            text: c.command;
                                            color: Theme.text;
                                            font-family: "monospace";
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    Button {
                                        text: @tr("Copy command");
                                        accessible-label: c.title;
                                        clicked => { root.copy-command(i); }
                                    }
                                }
                                Note { text: c.note; }
                            }
                        }
                    }
                }
                if root.page < 4: HorizontalLayout {
                    alignment: end;
                    padding: Theme.s5;
                    padding-top: Theme.s2;
                    Button {
                        text: @tr("Reset to defaults");
                        clicked => { root.reset-page(root.page); }
                    }
                }
            }
        }
    }

    // Adding or changing a key: above the page, which cannot be used
    // meanwhile. Esc and Cancel close it, Enter applies.
    if root.key-dialog-open: Rectangle {
        background: #00000060;
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.key-dialog-cancelled();
                    return accept;
                }
                if (event.text == Key.Return && root.key-can-apply) {
                    root.key-dialog-accepted();
                    return accept;
                }
                reject
            }
            Rectangle {
                width: min(460px, root.width - 2 * Theme.s5);
                height: min(dialog-layout.preferred-height, root.height - 2 * Theme.s5);
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000040;
                clip: true;
                dialog-layout := VerticalLayout {
                    padding: Theme.s5;
                    spacing: Theme.s3;
                    Text {
                        text: root.key-dialog-title;
                        font-size: Theme.body + 2px;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    Note { text: root.key-dialog-command; color: Theme.text; }
                    HorizontalLayout {
                        spacing: Theme.s3;
                        Text {
                            text: @tr("Use shortcut in:");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            horizontal-stretch: 1;
                            accessible-label: @tr("Use shortcut in:");
                            model: root.scope-names;
                            current-index <=> root.key-scope;
                            selected => { root.key-scope-changed(); }
                        }
                    }
                    Text {
                        text: @tr("Shortcut key:");
                        color: Theme.text;
                    }
                    // Takes the next key pressed. Esc cancels and Tab moves
                    // the focus, so the dialog stays usable from the keyboard.
                    capture := FocusScope {
                        height: 36px;
                        accessible-role: text-input;
                        accessible-label: @tr("Shortcut key:");
                        accessible-value: root.key-captured;
                        init => { self.focus(); }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.key-dialog-cancelled();
                                return accept;
                            }
                            if (event.text == Key.Tab || event.text == Key.Backtab) {
                                return reject;
                            }
                            if (!event.repeat) {
                                root.key-pressed-in-dialog(event.text, event.modifiers.control,
                                    event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                            accept
                        }
                        Rectangle {
                            border-radius: Theme.radius;
                            background: Theme.field;
                            border-width: capture.has-focus ? 2px : 1px;
                            border-color: capture.has-focus ? Theme.accent : Theme.field-line;
                            Text {
                                x: Theme.s3;
                                width: parent.width - 2 * Theme.s3;
                                text: root.key-captured != "" ? root.key-captured : @tr("Press a new keyboard shortcut.");
                                color: root.key-captured != "" ? Theme.text : Theme.text-muted;
                                font-weight: root.key-captured != "" ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => { capture.focus(); }
                            }
                        }
                    }
                    if root.key-refused != "": Text {
                        text: root.key-refused;
                        color: Theme.danger;
                        font-size: Theme.small;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Shortcut key currently used by:");
                        color: Theme.text;
                    }
                    Note {
                        text: root.key-used-by != "" ? root.key-used-by : @tr("None");
                        color: Theme.text;
                    }
                    if root.key-used-by != "": Note {
                        text: @tr("Adding it removes it from these commands.");
                    }
                    if root.key-also-used != "": Note { text: root.key-also-used; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Theme.s2;
                        padding-top: Theme.s2;
                        Button {
                            text: @tr("Cancel");
                            clicked => { root.key-dialog-cancelled(); }
                        }
                        Button {
                            text: @tr("OK");
                            primary: true;
                            enabled: root.key-can-apply;
                            clicked => { root.key-dialog-accepted(); }
                        }
                    }
                }
            }
        }
    }

    // Hidden text field used by copy-text().
    clip := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        single-line: false;
        read-only: true;
        enabled: false;
    }
}
