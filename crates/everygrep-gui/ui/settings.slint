// The settings window. Changes apply at once; each page has a button that
// puts its settings back to the defaults.
import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, SpinBox, StandardListView, StandardTableView } from "std-widgets.slint";
import { PropertySettings } from "property-settings.slint";
import { Theme } from "theme.slint";
import { FileopsSettings } from "fileops-settings.slint";
import { PreviewSettings } from "preview-settings.slint";
import { ContentSettings, DuplicateSettings, HashCacheSettings } from "content-settings.slint";

// A command for a keyboard shortcut, on the Keyboard shortcut page.
export struct ShortcutCommand {
    // What the shortcut does: "Show the window", ...
    title: string,
    command: string,
    // When to choose it.
    note: string,
}

// One known removable drive in the Drives list.
export struct DriveRow {
    // The label, or the UUID when it has none.
    title: string,
    // UUID, connected or not, entries, last seen, mount point.
    details: string,
    online: bool,
    // Forget is offered only for a drive that is not connected.
    can-forget: bool,
    // "Don't index this drive" or "Index this drive".
    action: string,
}

// One file list in the File lists of the Indexing page.
export struct FileListRow {
    // The file name of the list.
    title: string,
    // What became of it and the folder it is of.
    details: string,
    // The list's file.
    file: string,
    enabled: bool,
    failed: bool,
}

component Heading inherits Text {
    font-size: Theme.body;
    font-weight: 600;
    color: Theme.text;
}

component Note inherits Text {
    font-size: Theme.small;
    color: Theme.text-muted;
    wrap: word-wrap;
    // Its height at the width it gets: inside a row the layout measures a
    // wrapped text at the row's full width, which made the page shorter
    // than its content, so its end could not be scrolled into view.
    min-height: self.preferred-height;
}

// A list of folders with Add and Remove buttons.
component FolderList inherits VerticalLayout {
    in property <string> title;
    in property <string> count;
    in property <string> empty-text;
    in property <[StandardListViewItem]> model;
    // Remove is offered only while more than this many folders are listed.
    in property <int> keep: 0;
    callback add();
    callback remove(int);

    spacing: Theme.s2;
    HorizontalLayout {
        spacing: Theme.s2;
        Heading { text: root.title; }
        Note { text: root.count; vertical-alignment: center; horizontal-stretch: 1; }
    }
    Rectangle {
        min-height: 92px;
        vertical-stretch: 1;
        list := StandardListView {
            accessible-label: root.title;
            model: root.model;
        }
        if root.model.length == 0: Note {
            text: root.empty-text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: Theme.s2;
        alignment: start;
        Button {
            text: @tr("Add…");
            clicked => { root.add(); }
        }
        Button {
            text: @tr("Remove");
            enabled: list.current-item >= 0 && list.current-item < root.model.length
                && root.model.length > root.keep;
            clicked => {
                root.remove(list.current-item);
                list.current-item = -1;
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: @tr("EveryGrep settings");
    icon: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
    preferred-width: 680px;
    preferred-height: 600px;
    min-width: 520px;
    min-height: 420px;
    background: Theme.surface;
    default-font-size: Theme.body;

    // 0 indexing, 1 search, 2 appearance, 3 window, 4 keyboard, 5 advanced.
    in-out property <int> page: 0;
    // A problem with the settings file or the last action; empty when fine.
    in property <string> error;

    // Indexing
    in property <[StandardListViewItem]> roots;
    in property <string> roots-count;
    in property <[StandardListViewItem]> excludes;
    in property <string> excludes-count;
    // Shown when the folders came from the command line.
    in property <string> index-note;
    in property <string> index-status;
    // Off while every folder is read: a click would only start it again.
    in property <bool> can-scan-now: true;
    callback add-roots();
    callback remove-root(int);
    callback add-excludes();
    callback remove-exclude(int);
    // Excluded folders and file filters, and their switch.
    in-out property <bool> use-excludes;
    in-out property <string> exclude-pattern;
    in-out property <string> include-files;
    in-out property <string> exclude-files;
    // Why the last change of them was refused; empty when fine.
    in property <string> rule-error;
    callback add-exclude-pattern(string);
    callback rules-changed();
    in-out property <bool> watch-changes;
    callback watch-changed();
    in-out property <bool> file-details;
    callback file-details-changed();
    // Scanning the folders again by themselves: never, every N hours, every
    // day at a time (HH:MM), and why a typed time was refused.
    in property <[string]> rescan-names;
    in-out property <int> rescan-kind;
    in-out property <int> rescan-hours;
    in property <int> rescan-hours-max;
    in-out property <string> rescan-time;
    in property <string> rescan-error;
    callback rescan-changed();
    // Numbers about the index, one fact a line; counted again on request.
    in property <string> index-details;
    callback refresh-details();
    // Where the index file is, whether that is the default folder, and
    // whether this window may change it (not with --root or --index-file).
    in property <string> index-file;
    in property <bool> index-file-default;
    in property <bool> index-file-changeable;
    callback choose-index-folder();
    callback default-index-folder();
    callback rebuild();
    // Removable drives (shown when the program can keep drive indexes).
    in property <bool> drives-enabled;
    in-out property <bool> index-drives;
    in property <[string]> removed-names;
    in-out property <int> removed-choice;
    in property <[DriveRow]> drives;
    callback drives-changed();
    callback forget-drive(int);
    callback toggle-drive(int);
    // File lists: entries of disks that are not connected.
    in property <[FileListRow]> file-lists;
    in-out property <bool> hide-offline;
    callback add-file-list();
    callback create-file-list();
    callback reload-file-lists();
    callback toggle-file-list(int);
    callback remove-file-list(int);
    callback hide-offline-changed(bool);

    // Search
    in property <[string]> filter-names;
    in-out property <int> default-filter;
    in-out property <bool> default-case;
    in-out property <bool> default-words;
    in-out property <bool> default-path;
    in-out property <bool> default-diacritics;
    in-out property <bool> default-regex;
    in-out property <bool> default-prefix;
    in-out property <bool> default-suffix;
    in-out property <bool> default-punctuation;
    in-out property <bool> default-whitespace;
    in-out property <bool> as-you-type;
    in-out property <bool> show-mode-badges;
    in-out property <bool> and-before-or;
    in-out property <bool> literal-operators;
    in-out property <bool> wildcards-anywhere;
    in-out property <bool> filter-wrap;
    in-out property <bool> select-search-on-click;
    in-out property <bool> clear-selection-on-search;
    in-out property <bool> hide-results-when-empty;
    in-out property <int> search-delay;
    in-out property <int> history-size;
    in-out property <int> history-entries;
    in property <int> history-max;
    in-out property <bool> history-on-disk;
    in-out property <bool> history-enabled;
    in-out property <bool> always-suggestions;
    in-out property <int> history-days;
    in property <int> committed-history-days;
    callback edit-history-days(int);
    callback commit-history-days();
    callback clear-history();
    in-out property <int> hidden-files;
    in property <[string]> hidden-names;
    in-out property <int> content-max-size;
    in property <int> content-max-size-max;
    in property <[string]> content-code-page-names;
    in-out property <int> content-code-page;
    in-out property <bool> content-pdf;
    in-out property <bool> content-documents;
    in-out property <int> content-document-max;
    in property <int> content-document-max-max;
    in-out property <bool> content-on-enter;
    in-out property <bool> content-multi-line;
    in-out property <bool> dupe-empty-files;
    in-out property <bool> dupe-verify-bytes;
    in property <string> content-pdf-note;
    in-out property <int> hash-cache-max;
    in property <int> hash-cache-max-max;
    in property <string> hash-cache-used;
    in property <[string]> property-names;
    in-out property <int> property-selected;
    in-out property <int> property-cache-mb;
    in-out property <bool> property-indexed;
    in-out property <int> property-max-mb;
    in-out property <string> property-include;
    in-out property <string> property-exclude;
    in property <string> property-error;
    in property <string> property-progress;
    callback property-selection(); callback properties-changed(); callback clear-properties(); callback scan-properties(); callback cancel-properties();
    callback clear-hash-cache();
    callback search-changed();

    // Appearance
    in property <[string]> language-names;
    in-out property <int> language;
    in property <[string]> theme-names;
    in-out property <int> theme;
    in property <[string]> density-names;
    in-out property <int> density;
    in-out property <bool> status-details;
    in-out property <bool> menu-bar;
    in-out property <bool> status-bar;
    in-out property <bool> alternate-rows;
    in property <[string]> size-unit-names;
    in-out property <int> size-unit;
    in property <[string]> size-standard-names;
    in-out property <int> size-standard;
    callback appearance-changed();

    // Window
    in-out property <bool> preview-visible;
    in-out property <bool> preview-cache;
    in-out property <bool> preview-images;
    in-out property <bool> preview-thumbnailers;
    in-out property <bool> preview-sandbox;
    in-out property <bool> preview-text;
    callback preview-changed();
    in property <[string]> close-names;
    in-out property <int> on-close;
    in property <string> on-close-note;
    in-out property <bool> remember-columns;
    in-out property <bool> rename-name-only;
    in-out property <bool> fileops-rename-dialog;
    in-out property <bool> fileops-conflict-ask;
    in-out property <bool> fileops-undo-enabled;
    in-out property <int> fileops-undo-limit: 100;
    in-out property <bool> fileops-search-new-window;
    in-out property <bool> fileops-search-recursive;
    in-out property <bool> fileops-search-exact-name;
    in-out property <int> fileops-shortcut-kind;
    in-out property <int> fileops-shortcut-collision;
    in-out property <bool> fileops-new-folder-inside: true;
    in-out property <bool> fileops-drag-to-folders: true;
    in-out property <int> fileops-drop-action;
    in-out property <bool> path-click-opens-folder;
    in-out property <bool> copy-full-path-quotes;
    in-out property <bool> export-protect-formulas;
    in-out property <bool> drive-root-labels;
    in-out property <bool> type-to-jump;
    in-out property <int> open-confirm-over;
    in-out property <int> tab-results-kept;
    in property <int> tab-results-max;
    in property <int> open-confirm-max;
    in-out property <bool> focus-on-show;
    in-out property <bool> dates-newest-first;
    in-out property <bool> sizes-largest-first;
    in-out property <bool> start-on-login;
    in property <string> start-on-login-note;
    callback start-on-login-changed(bool);
    in property <[string]> folder-size-names;
    in-out property <int> folder-size;
    in property <string> folder-size-note;
    in-out property <bool> open-searches-in-tabs;
    in-out property <bool> switch-to-new-tab;
    in-out property <bool> restore-session;
    callback window-changed();
    in-out property <bool> session-confirm;
    callback session-answer(bool);

    // Keyboard: the commands of the main window shown for the filter, the
    // chosen one (-1 for none) and its keys.
    in-out property <string> key-filter;
    in property <[StandardListViewItem]> key-commands;
    in-out property <int> key-current: -1;
    in property <[StandardListViewItem]> key-bindings;
    in-out property <int> key-binding-current: -1;
    callback key-filter-edited(string);
    callback key-command-chosen(int);
    callback remove-binding(int);
    callback restore-keys();
    // The dialog that adds or changes one key of the chosen command: where
    // the key works (0 global, 1 search field, 2 result list), the key
    // pressed, the commands that have it, and why it cannot be used.
    callback add-binding();
    callback edit-binding(int);
    in-out property <bool> key-dialog-open;
    in property <string> key-dialog-title;
    in property <string> key-dialog-command;
    in property <[string]> scope-names;
    in-out property <int> key-scope;
    in property <string> key-captured;
    in property <string> key-used-by;
    in property <string> key-also-used;
    in property <string> key-refused;
    in property <bool> key-can-apply;
    callback key-scope-changed();
    callback key-pressed-in-dialog(string, bool, bool, bool, bool);
    callback key-dialog-accepted();
    callback key-dialog-cancelled();
    // Opening EveryGrep with a desktop shortcut.
    in property <[ShortcutCommand]> commands;
    in property <string> shortcut-steps;
    callback copy-command(int);

    // Advanced: the settings file, exporting and importing it, putting
    // every setting back to its default; a question waiting for an answer
    // (its text and the button that agrees), and the last outcome.
    in property <string> settings-file;
    in property <bool> settings-writable;
    callback export-settings();
    callback import-settings();
    callback reset-all-settings();
    in-out property <bool> export-filters;
    in-out property <bool> export-bookmarks;
    callback export-options-changed();
    in property <string> pending-text;
    in property <string> pending-action;
    callback pending-answered(bool);
    in property <string> settings-note;
    in-out property <bool> reload-changed;
    callback reload-changed-toggled();
    in-out property <bool> ask-reload;
    callback ask-reload-toggled();
    // The raw settings table: its filter, "only changed", the rows shown
    // (key, value, default), the chosen row and its value being edited,
    // what can be done with it, and why the last edit was refused.
    in-out property <string> raw-filter;
    in-out property <bool> raw-only-changed;
    in property <[[StandardListViewItem]]> raw-rows;
    in-out property <int> raw-current: -1;
    in-out property <string> raw-value;
    in property <bool> raw-editable;
    in property <bool> raw-toggle;
    in property <bool> raw-resettable;
    in property <string> raw-error;
    callback raw-filter-changed();
    callback raw-chosen(int);
    callback raw-apply();
    callback raw-toggle-value();
    callback raw-reset();
    callback raw-copy();

    // Puts the settings of the page back to their defaults.
    callback reset-page(int);
    callback close-window();

    // Focuses the page list, on the current page.
    public function focus-pages() {
        pages.set-current-item(root.page);
        pages.focus();
    }

    changed page => { pages.set-current-item(root.page); }

    // Colors: 1 light, 2 dark, 0 the toolkit's reading of the desktop
    // setting. Sets the palette of the standard widgets too.
    public function set-color-scheme(scheme: int) {
        Theme.scheme = scheme == 1 ? ColorScheme.light : scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Palette.color-scheme = Theme.scheme;
    }

    // Puts text on the clipboard through a hidden text field.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-window();
                return accept;
            }
            if (event.modifiers.control && (event.text == Key.PageDown || event.text == Key.PageUp)) {
                root.page = Math.mod(root.page + (event.text == Key.PageDown ? 1 : -1), 6);
                return accept;
            }
            reject
        }

        HorizontalLayout {
            // Pages
            Rectangle {
                width: 170px;
                background: Theme.surface-alt;
                VerticalLayout {
                    padding: Theme.s2;
                    pages := StandardListView {
                        accessible-label: @tr("Settings pages");
                        model: [
                            { text: @tr("Indexing") },
                            { text: @tr("Search") },
                            { text: @tr("Appearance") },
                            { text: @tr("Window") },
                            { text: @tr("Keyboard") },
                            { text: @tr("Advanced") },
                        ];
                        // Not bound to the page: the list keeps its own
                        // keyboard position, which set-current-item() moves.
                        current-item-changed(i) => { root.page = i; }
                    }
                }
            }
            Rectangle { width: 1px; background: Theme.line; }

            VerticalLayout {
                // The page scrolls when it is taller than the window (longer
                // translations wrap to more lines); Reset stays in view.
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Theme.dialog-padding;
                        spacing: Theme.s4;

                        if root.error != "": Text {
                            text: root.error;
                            color: Theme.danger;
                            font-size: Theme.small;
                            wrap: word-wrap;
                            min-height: self.preferred-height;
                        }

                        if root.page == 0: VerticalLayout {
                            spacing: Theme.s4;
                            vertical-stretch: 1;
                            if root.index-note != "": Note { text: root.index-note; }
                            FolderList {
                                title: @tr("Folders to index");
                                count: root.roots-count;
                                empty-text: @tr("Your home folder");
                                model: root.roots;
                                keep: 1;
                                add => { root.add-roots(); }
                                remove(i) => { root.remove-root(i); }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                CheckBox {
                                    text: @tr("Watch for changes");
                                    checked <=> root.watch-changes;
                                    toggled => { root.watch-changed(); }
                                }
                                Note { text: @tr("Off: files added, removed or renamed while EveryGrep runs are not seen, and the status line says so. Turning it on again catches up with the changes, then watches."); }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                CheckBox {
                                    text: @tr("Index file sizes and modification times");
                                    checked <=> root.file-details;
                                    toggled => { root.file-details-changed(); }
                                }
                                Note { text: @tr("Off: only names are read, so indexing is faster, but the Size and Modified columns are empty for files, folders show no total size, and size: and modified: find no files. Created, Accessed and Attributes are read from the disk either way. Changing it indexes again."); }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                HorizontalLayout {
                                    spacing: Theme.s3;
                                    Text {
                                        text: @tr("Rescan the folders");
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Button {
                                        text: @tr("Scan now");
                                        enabled: root.can-scan-now;
                                        clicked => { root.rebuild(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Theme.s3;
                                    ComboBox {
                                        width: 200px;
                                        accessible-label: @tr("Rescan the folders");
                                        model: root.rescan-names;
                                        current-index <=> root.rescan-kind;
                                        selected => { root.rescan-changed(); }
                                    }
                                    if root.rescan-kind == 1: SpinBox {
                                        width: 120px;
                                        horizontal-stretch: 0;
                                        accessible-label: @tr("Hours between rescans");
                                        minimum: 1;
                                        maximum: root.rescan-hours-max;
                                        value <=> root.rescan-hours;
                                        edited => { root.rescan-changed(); }
                                    }
                                    if root.rescan-kind == 2: LineEdit {
                                        width: 90px;
                                        accessible-label: @tr("Time of day of the rescan");
                                        placeholder-text: "03:00";
                                        text <=> root.rescan-time;
                                        accepted => { root.rescan-changed(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                // Right below the field it is about, not after the
                                // long note, where it could end at the page's edge.
                                if root.rescan-error != "": Text {
                                    text: root.rescan-error;
                                    color: Theme.danger;
                                    font-size: Theme.small;
                                    wrap: word-wrap;
                                    min-height: self.preferred-height;
                                }
                                Note { text: @tr("A rescan reads every folder to index again from scratch, as Rebuild index now does, and also finds changes no event reported, such as a file whose contents changed without touching its folder. Hours count from the last full scan, also across restarts (from the start of EveryGrep when none is known); a daily time passed while the computer slept runs at the next check. Nothing runs while index updates are paused."); }
                            }
                            CheckBox {
                                text: @tr("Use the exclude list");
                                checked <=> root.use-excludes;
                                toggled => { root.rules-changed(); }
                            }
                            FolderList {
                                title: @tr("Excluded folders");
                                count: root.excludes-count;
                                empty-text: @tr("None. Folders listed here are left out of the index with all they hold.");
                                model: root.excludes;
                                add => { root.add-excludes(); }
                                remove(i) => { root.remove-exclude(i); }
                            }
                            HorizontalLayout {
                                spacing: Theme.s2;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    accessible-label: @tr("Folder pattern");
                                    placeholder-text: @tr("Folder name or pattern: node_modules, *.git, regex:^te?mp$");
                                    text <=> root.exclude-pattern;
                                    accepted(text) => { root.add-exclude-pattern(text); }
                                }
                                Button {
                                    text: @tr("Add pattern");
                                    enabled: root.exclude-pattern != "";
                                    clicked => { root.add-exclude-pattern(root.exclude-pattern); }
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                Heading { text: @tr("Include only files"); }
                                LineEdit {
                                    accessible-label: @tr("Include only files");
                                    placeholder-text: @tr("Empty includes all files. Example: *.mp3;*.jpg");
                                    text <=> root.include-files;
                                    accepted => { root.rules-changed(); }
                                }
                                Heading { text: @tr("Exclude files"); }
                                LineEdit {
                                    accessible-label: @tr("Exclude files");
                                    placeholder-text: @tr("Example: *.tmp;~*");
                                    text <=> root.exclude-files;
                                    accepted => { root.rules-changed(); }
                                }
                                Note { text: @tr("Separate patterns with “;”. * matches any characters except /, ** any characters, ? one character. A pattern is matched against the whole name, ignoring case; with a / it is matched against the full path. regex: starts a regular expression. An exclude pattern wins over an include pattern."); }
                                HorizontalLayout {
                                    spacing: Theme.s3;
                                    Button {
                                        text: @tr("Apply filters");
                                        clicked => { root.rules-changed(); }
                                    }
                                    Note {
                                        text: @tr("Changing the lists or the switch indexes again.");
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                }
                                if root.rule-error != "": Text {
                                    text: root.rule-error;
                                    color: Theme.danger;
                                    font-size: Theme.small;
                                    wrap: word-wrap;
                                    min-height: self.preferred-height;
                                }
                            }
                            if root.drives-enabled: VerticalLayout {
                                spacing: Theme.s2;
                                Heading { text: @tr("Removable drives"); }
                                CheckBox {
                                    text: @tr("Index removable drives automatically");
                                    checked <=> root.index-drives;
                                    toggled => { root.drives-changed(); }
                                }
                                Note { text: @tr("Drives the desktop mounts when they are plugged in (under /run/media) are indexed each in a file of their own. Disks the system mounts, such as those listed in /etc/fstab, are never indexed this way."); }
                                HorizontalLayout {
                                    spacing: Theme.s3;
                                    Text {
                                        text: @tr("When a drive is removed");
                                        color: Theme.text;
                                        vertical-alignment: center;
                                    }
                                    ComboBox {
                                        width: 260px;
                                        accessible-label: @tr("When a drive is removed");
                                        model: root.removed-names;
                                        current-index <=> root.removed-choice;
                                        selected => { root.drives-changed(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.drives.length == 0: Note {
                                    text: @tr("No drives yet. Plug one in to index it.");
                                }
                                for drive[i] in root.drives: Rectangle {
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.field;
                                    HorizontalLayout {
                                        padding: Theme.s2;
                                        padding-left: Theme.s3;
                                        spacing: Theme.s2;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text {
                                                text: drive.title;
                                                color: drive.online ? Theme.text : Theme.text-offline;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Note { text: drive.details; }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: @tr("Forget");
                                                enabled: drive.can-forget;
                                                clicked => { root.forget-drive(i); }
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: drive.action;
                                                clicked => { root.toggle-drive(i); }
                                            }
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                Heading { text: @tr("File lists"); }
                                Note { text: @tr("A file list keeps the entries of a folder, such as a disk, in a file. Its entries are found while the disk is not connected and are shown like a drive that is not connected. When the index has the folder itself, the list is not shown."); }
                                CheckBox {
                                    text: @tr("Hide entries of drives and file lists that are not connected");
                                    checked <=> root.hide-offline;
                                    toggled => { root.hide-offline-changed(self.checked); }
                                }
                                for list[i] in root.file-lists: Rectangle {
                                    border-radius: Theme.radius;
                                    border-width: 1px;
                                    border-color: Theme.line;
                                    background: Theme.field;
                                    HorizontalLayout {
                                        padding: Theme.s2;
                                        padding-left: Theme.s3;
                                        spacing: Theme.s2;
                                        CheckBox {
                                            checked: list.enabled;
                                            accessible-label: list.title;
                                            toggled => { root.toggle-file-list(i); }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text {
                                                text: list.title;
                                                color: list.enabled ? Theme.text : Theme.text-offline;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: list.details;
                                                color: list.failed ? Theme.danger : Theme.text-muted;
                                                font-size: Theme.small;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: list.file;
                                                color: Theme.text-muted;
                                                font-size: Theme.small;
                                                overflow: elide;
                                            }
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            Button {
                                                text: @tr("Remove");
                                                clicked => { root.remove-file-list(i); }
                                            }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: Theme.s2;
                                    alignment: start;
                                    Button {
                                        text: @tr("Add file list…");
                                        clicked => { root.add-file-list(); }
                                    }
                                    Button {
                                        text: @tr("Create file list…");
                                        clicked => { root.create-file-list(); }
                                    }
                                    Button {
                                        text: @tr("Read lists again");
                                        enabled: root.file-lists.length > 0;
                                        clicked => { root.reload-file-lists(); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Button {
                                    text: @tr("Rebuild index now");
                                    enabled: root.can-scan-now;
                                    clicked => { root.rebuild(); }
                                }
                                Note {
                                    text: root.index-status;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                HorizontalLayout {
                                    spacing: Theme.s3;
                                    Heading {
                                        text: @tr("Index details");
                                        vertical-alignment: center;
                                    }
                                    Button {
                                        text: @tr("Count again");
                                        clicked => { root.refresh-details(); }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                Note { text: root.index-details; }
                            }
                            VerticalLayout {
                                spacing: Theme.s2;
                                Heading { text: @tr("Index file"); }
                                Text {
                                    text: root.index-file;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                    min-height: self.preferred-height;
                                }
                                HorizontalLayout {
                                    spacing: Theme.s2;
                                    alignment: start;
                                    Button {
                                        text: @tr("Choose folder…");
                                        enabled: root.index-file-changeable;
                                        clicked => { root.choose-index-folder(); }
                                    }
                                    Button {
                                        text: @tr("Use the default folder");
                                        enabled: root.index-file-changeable && !root.index-file-default;
                                        clicked => { root.default-index-folder(); }
                                    }
                                }
                                Note { text: @tr("The index is saved in this folder as index.bin, with the hash cache next to it. A new folder takes it at once; the old file is removed once the new one is written. Removable drives keep their indexes in the cache folder."); }
                            }
                        }

                        if root.page == 1: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            CheckBox {
                                text: @tr("Wrap when moving to the next or previous filter");
                                checked <=> root.filter-wrap;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: moving past the first or last filter keeps the current filter."); }
                            CheckBox {
                                text: @tr("Match wildcards anywhere in the filename");
                                checked <=> root.wildcards-anywhere;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: a wildcard pattern must match the whole name. wholename: and nowholename: change this for one term; wholename: on text without wildcards matches the whole name exactly."); }
                            CheckBox {
                                text: @tr("Allow literal AND / OR / NOT operators");
                                checked <=> root.literal-operators;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("On: standalone uppercase AND, OR and NOT act as operators. Quoted words stay literal."); }
                            CheckBox {
                                text: @tr("Evaluate AND before OR");
                                checked <=> root.and-before-or;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: OR is evaluated before AND. Use < > to group terms in either mode."); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text { text: @tr("Hidden files"); color: Theme.text; vertical-alignment: center; }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Hidden files");
                                    model: root.hidden-names;
                                    current-index <=> root.hidden-files;
                                    selected => { root.search-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("Dotfiles and the contents of dot-prefixed folders. This filters results without changing the index."); }
                            CheckBox {
                                text: @tr("Show active matching modes in the status line");
                                checked <=> root.show-mode-badges;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Shows badges for window options, including hidden-file filters. Per-term modifiers stay in the query."); }
                            CheckBox {
                                text: @tr("Search as you type");
                                checked <=> root.as-you-type;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: the results change only when you press Enter in the search field."); }
                            CheckBox {
                                text: @tr("Select the search text on a click into the field");
                                checked <=> root.select-search-on-click;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("A second click places the cursor. Off: the first click places it."); }
                            CheckBox {
                                text: @tr("Clear the selection when the search changes");
                                checked <=> root.clear-selection-on-search;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: the selected items stay selected while the new results list them. Sorting and file changes never clear it."); }
                            CheckBox {
                                text: @tr("Hide the results while the search field is empty");
                                checked <=> root.hide-results-when-empty;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: an empty search lists every indexed file and folder that the filter lets through."); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text { text: @tr("Search delay (ms)"); color: Theme.text; vertical-alignment: center; }
                                SpinBox {
                                    width: 140px;
                                    horizontal-stretch: 0;
                                    accessible-label: @tr("Search delay (ms)");
                                    minimum: 0;
                                    maximum: 5000;
                                    step-size: 50;
                                    value <=> root.search-delay;
                                    edited => { root.search-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("While you type, the search waits this long after the last key. 0 searches at once; Enter always searches at once."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("File contents"); }
                            ContentSettings {
                                max-size <=> root.content-max-size;
                                max-size-max: root.content-max-size-max;
                                code-page-names: root.content-code-page-names;
                                code-page <=> root.content-code-page;
                                pdf <=> root.content-pdf;
                                documents <=> root.content-documents;
                                document-max <=> root.content-document-max;
                                document-max-max: root.content-document-max-max;
                                pdf-note: root.content-pdf-note;
                                on-enter <=> root.content-on-enter;
                                multi-line <=> root.content-multi-line;
                                changed => { root.search-changed(); }
                            }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Properties"); }
                            PropertySettings {
                                names: root.property-names; selected <=> root.property-selected;
                                cache-mb <=> root.property-cache-mb; indexed <=> root.property-indexed;
                                max-mb <=> root.property-max-mb; include <=> root.property-include; exclude <=> root.property-exclude;
                                error: root.property-error; progress: root.property-progress;
                                changed => { root.properties-changed(); } selected-property => { root.property-selection(); }
                                clear => { root.clear-properties(); } scan => { root.scan-properties(); } cancel => { root.cancel-properties(); }
                            }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Duplicates"); }
                            DuplicateSettings {
                                empty-files <=> root.dupe-empty-files;
                                verify-bytes <=> root.dupe-verify-bytes;
                                changed => { root.search-changed(); }
                            }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Hash cache"); }
                            HashCacheSettings {
                                max-size <=> root.hash-cache-max;
                                max-size-max: root.hash-cache-max-max;
                                used: root.hash-cache-used;
                                changed => { root.search-changed(); }
                                clear => { root.clear-hash-cache(); }
                            }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("When EveryGrep starts"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Filter");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 180px;
                                    accessible-label: @tr("Default filter");
                                    model: root.filter-names;
                                    current-index <=> root.default-filter;
                                    selected => { root.search-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            CheckBox {
                                text: @tr("Match case");
                                checked <=> root.default-case;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match whole words");
                                checked <=> root.default-words;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match the full path");
                                checked <=> root.default-path;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match diacritics");
                                checked <=> root.default-diacritics;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Regular expression");
                                checked <=> root.default-regex;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match prefix");
                                checked <=> root.default-prefix;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Match suffix");
                                checked <=> root.default-suffix;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Ignore punctuation");
                                checked <=> root.default-punctuation;
                                toggled => { root.search-changed(); }
                            }
                            CheckBox {
                                text: @tr("Ignore whitespace");
                                checked <=> root.default-whitespace;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Options given on the command line take their place."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Search history"); }
                            CheckBox {
                                text: @tr("Suggest earlier searches while typing");
                                checked <=> root.always-suggestions;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: suggestions appear only when Search as you type is off."); }
                            CheckBox {
                                text: @tr("Record search history");
                                checked <=> root.history-enabled;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("At most 10,000 distinct searches are kept. Apply confirms the days to keep."); }
                            HorizontalLayout {
                                Text { text: @tr("Distinct searches to keep"); color: Theme.text; vertical-alignment: center; }
                                SpinBox { accessible-label: @tr("Distinct searches to keep"); minimum: 1; maximum: 10000; value <=> root.history-entries; edited => { root.search-changed(); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text { text: @tr("Days to keep (0 = forever)"); color: Theme.text; vertical-alignment: center; }
                                SpinBox {
                                    accessible-label: @tr("Days to keep (0 = forever)");
                                    minimum: 0; maximum: 36500;
                                    value <=> root.history-days;
                                    edited(value) => { root.edit-history-days(value); }
                                }
                                Button { text: @tr("Apply"); enabled: root.history-days != root.committed-history-days; clicked => { root.commit-history-days(); } }
                                Button { text: @tr("Clear now"); clicked => { root.clear-history(); } }
                            }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Searches to keep");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    width: 140px;
                                    horizontal-stretch: 0;
                                    accessible-label: @tr("Searches to keep");
                                    minimum: 0;
                                    maximum: root.history-max;
                                    value <=> root.history-size;
                                    edited => { root.search-changed(); }
                                }
                                Note {
                                    text: @tr("0 turns the history off.");
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }
                            CheckBox {
                                text: @tr("Keep the history after EveryGrep closes");
                                enabled: root.history-size > 0;
                                checked <=> root.history-on-disk;
                                toggled => { root.search-changed(); }
                            }
                            Note { text: @tr("Off: the history is forgotten when EveryGrep quits. Turning it off deletes the saved history."); }
                        }

                        if root.page == 2: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            Heading { text: @tr("Language and colors"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Language");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Language");
                                    model: root.language-names;
                                    current-index <=> root.language;
                                    selected => { root.appearance-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("Same as the system follows LANGUAGE, LC_ALL, LC_MESSAGES or LANG. The command line stays in English."); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Theme");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Theme");
                                    model: root.theme-names;
                                    current-index <=> root.theme;
                                    selected => { root.appearance-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("Same as the desktop follows the light or dark style chosen in the desktop's settings, also when it changes."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Result list"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Density");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Density of the result list");
                                    model: root.density-names;
                                    current-index <=> root.density;
                                    selected => { root.appearance-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("Compact shows more rows at once, with smaller icons and text."); }
                            CheckBox {
                                text: @tr("Alternate row color");
                                checked <=> root.alternate-rows;
                                toggled => { root.appearance-changed(); }
                            }
                            Note { text: @tr("Every second row has a slightly different background, which makes long rows easier to follow."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Sizes"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Size format");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Size format");
                                    model: root.size-unit-names;
                                    current-index <=> root.size-unit;
                                    selected => { root.appearance-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Size units");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 200px;
                                    accessible-label: @tr("Size units");
                                    model: root.size-standard-names;
                                    current-index <=> root.size-standard;
                                    selected => { root.appearance-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("For the Size column and the status line. Automatic shows bytes below one kilobyte, then the largest unit that fits. Size searches (size:) always count 1 KB as 1024 bytes."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Status line"); }
                            CheckBox {
                                text: @tr("Show the status line");
                                checked <=> root.status-bar;
                                toggled => { root.appearance-changed(); }
                            }
                            Note { text: @tr("Without it, progress, the Cancel button and messages appear in a small box at the bottom right while they last."); }
                            CheckBox {
                                text: @tr("Show details of the selected items");
                                checked <=> root.status-details;
                                toggled => { root.appearance-changed(); }
                            }
                            Note { text: @tr("One selected item shows its size, modification time and full path; several show their number and the total size of the files among them."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Menu bar"); }
                            CheckBox {
                                text: @tr("Show the menu bar");
                                checked <=> root.menu-bar;
                                toggled => { root.appearance-changed(); }
                            }
                            Note { text: @tr("Without it, the ⋯ button next to the filter holds Settings, Search syntax, Keyboard shortcuts, About and Quit."); }
                        }

                        if root.page == 3: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            Heading { text: @tr("Preview"); }
                            PreviewSettings {
                                shown <=> root.preview-visible; cache <=> root.preview-cache; images <=> root.preview-images;
                                thumbnailers <=> root.preview-thumbnailers; sandbox <=> root.preview-sandbox; text-files <=> root.preview-text;
                                changed => { root.preview-changed(); }
                            }
                            Heading { text: @tr("Tabs and session"); }
                            CheckBox {
                                text: @tr("Open searches in tabs instead of new windows");
                                checked <=> root.open-searches-in-tabs;
                                toggled => { root.window-changed(); }
                            }
                            CheckBox {
                                text: @tr("Switch to new tabs immediately");
                                enabled: root.open-searches-in-tabs;
                                checked <=> root.switch-to-new-tab;
                                toggled => { root.window-changed(); }
                            }
                            CheckBox {
                                text: @tr("Restore the last window's tabs at startup");
                                checked <=> root.restore-session;
                                toggled => { root.window-changed(); }
                            }
                            Text {
                                text: @tr("Saving tabs requires search history recording and disk storage.");
                                color: Theme.text-muted;
                                wrap: word-wrap;
                                min-height: self.preferred-height;
                            }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Background tabs that keep their results");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    width: 140px;
                                    horizontal-stretch: 0;
                                    accessible-label: @tr("Background tabs that keep their results");
                                    minimum: 0;
                                    maximum: root.tab-results-max;
                                    value <=> root.tab-results-kept;
                                    edited => { root.window-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("The tabs shown last keep their result lists in memory; older ones free theirs and search again when shown (a stopped content search keeps its matches). Fewer saves memory with many tabs."); }
                            Rectangle { height: Theme.s2; }
                            if root.session-confirm: VerticalLayout {
                                spacing: Theme.s2;
                                Note { text: @tr("Restoring tabs needs search history on disk. Enable recording and disk storage too?"); }
                                HorizontalLayout {
                                    Button { text: @tr("Cancel"); clicked => { root.session-answer(false); } }
                                    Button { text: @tr("Enable"); primary: true; clicked => { root.session-answer(true); } }
                                }
                            }
                            Heading { text: @tr("Closing the window"); }
                            HorizontalLayout {
                                ComboBox {
                                    width: 300px;
                                    accessible-label: @tr("When the window is closed");
                                    model: root.close-names;
                                    current-index <=> root.on-close;
                                    selected => { root.window-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: root.on-close-note; }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Starting"); }
                            CheckBox {
                                text: @tr("Start EveryGrep when I log in");
                                checked <=> root.start-on-login;
                                toggled => { root.start-on-login-changed(self.checked); }
                            }
                            Note { text: root.start-on-login-note; }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Showing the window"); }
                            CheckBox {
                                text: @tr("Focus the search field when the window is shown");
                                checked <=> root.focus-on-show;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Its text is selected, so typing starts a new search. Off: the field or the list that had the focus keeps it."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Columns"); }
                            CheckBox {
                                text: @tr("Remember the shown columns and their widths");
                                checked <=> root.remember-columns;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Right-click the column headers to show the Type, Extension, Created, Accessed and Attributes columns; drag the header borders to resize."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Sorting"); }
                            CheckBox {
                                text: @tr("Sort dates newest first");
                                checked <=> root.dates-newest-first;
                                toggled => { root.window-changed(); }
                            }
                            CheckBox {
                                text: @tr("Sort sizes largest first");
                                checked <=> root.sizes-largest-first;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("The first click on the header of a date column or of Size sorts in this order; a second click reverses it. Off: they start with the oldest or smallest."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("File operations"); }
                            FileopsSettings {
                                rename-dialog <=> root.fileops-rename-dialog;
                                conflict-ask <=> root.fileops-conflict-ask;
                                undo-enabled <=> root.fileops-undo-enabled;
                                undo-limit <=> root.fileops-undo-limit;
                                search-new-window <=> root.fileops-search-new-window;
                                search-recursive <=> root.fileops-search-recursive;
                                search-exact-name <=> root.fileops-search-exact-name;
                                shortcut-kind <=> root.fileops-shortcut-kind;
                                shortcut-collision <=> root.fileops-shortcut-collision;
                                new-folder-inside <=> root.fileops-new-folder-inside;
                                drag-to-folders <=> root.fileops-drag-to-folders;
                                drop-action <=> root.fileops-drop-action;
                                changed => { root.window-changed(); }
                            }
                            CheckBox {
                                text: @tr("Leave the extension unselected when renaming");
                                checked <=> root.rename-name-only;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Off: the whole name is selected, extension included."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Opening"); }
                            CheckBox {
                                text: @tr("Double-click in the Folder column opens the folder");
                                checked <=> root.path-click-opens-folder;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Off: a double-click anywhere in a row opens the item itself."); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Ask before opening more items than");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                SpinBox {
                                    width: 140px;
                                    horizontal-stretch: 0;
                                    accessible-label: @tr("Ask before opening more items than");
                                    minimum: 0;
                                    maximum: root.open-confirm-max;
                                    value <=> root.open-confirm-over;
                                    edited => { root.window-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: @tr("Opening the selection asks first when it holds more items than this. 0 opens any number without asking."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Copying"); }
                            CheckBox {
                                text: @tr("Copy full path adds quotes");
                                checked <=> root.copy-full-path-quotes;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Each path is put in double quotes, as Copy full path with quotes does."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Export"); }
                            CheckBox {
                                text: @tr("Protect spreadsheet formulas in CSV and TSV");
                                checked <=> root.export-protect-formulas;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("Adds an apostrophe before cells starting with =, +, -, @, tab or carriage return. Other formats keep their contents."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Drives"); }
                            CheckBox {
                                text: @tr("Show the drive label on drive roots");
                                checked <=> root.drive-root-labels;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("The root of an indexed drive is shown as its label followed by the mount point, such as USB DISK (/run/media/…)."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Typing in the result list"); }
                            CheckBox {
                                text: @tr("Jump to a name by typing its start");
                                checked <=> root.type-to-jump;
                                toggled => { root.window-changed(); }
                            }
                            Note { text: @tr("With the list focused, typing moves to the next row whose name starts with the typed text. A pause of a second starts a new text; typing one letter again steps through its names."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Folder size"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("The Size column shows");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    width: 180px;
                                    accessible-label: @tr("What the Size column shows for folders");
                                    model: root.folder-size-names;
                                    current-index <=> root.folder-size;
                                    selected => { root.window-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Note { text: root.folder-size-note; }
                        }

                        if root.page == 4: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            Heading { text: @tr("Shortcuts in the window"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                Text {
                                    text: @tr("Show commands containing:");
                                    color: Theme.text;
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    horizontal-stretch: 1;
                                    accessible-label: @tr("Show commands containing:");
                                    text <=> root.key-filter;
                                    edited(text) => { root.key-filter-edited(text); }
                                }
                            }
                            Rectangle {
                                height: 220px;
                                StandardListView {
                                    accessible-label: @tr("Commands");
                                    model: root.key-commands;
                                    current-item <=> root.key-current;
                                    current-item-changed(i) => { root.key-command-chosen(i); }
                                }
                                if root.key-commands.length == 0: Note {
                                    text: @tr("No command matches.");
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: @tr("Shortcuts for the selected command:");
                                color: Theme.text;
                            }
                            Rectangle {
                                height: 96px;
                                bindings := StandardListView {
                                    accessible-label: @tr("Shortcuts for the selected command:");
                                    model: root.key-bindings;
                                    current-item <=> root.key-binding-current;
                                }
                                if root.key-current >= 0 && root.key-bindings.length == 0: Note {
                                    text: @tr("None");
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.s2;
                                Button {
                                    text: @tr("Add…");
                                    enabled: root.key-current >= 0 && root.key-current < root.key-commands.length;
                                    clicked => { root.add-binding(); }
                                }
                                Button {
                                    text: @tr("Edit…");
                                    enabled: root.key-binding-current >= 0
                                        && root.key-binding-current < root.key-bindings.length;
                                    clicked => { root.edit-binding(root.key-binding-current); }
                                }
                                Button {
                                    text: @tr("Remove");
                                    enabled: root.key-binding-current >= 0
                                        && root.key-binding-current < root.key-bindings.length;
                                    clicked => { root.remove-binding(root.key-binding-current); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: @tr("Reset to defaults");
                                    clicked => { root.restore-keys(); }
                                }
                            }
                            Note { text: @tr("Movement keys, Tab and Esc cannot be changed. A key of the search field or the result list wins over a global key while that control has the focus."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("Open EveryGrep with a key"); }
                            Note { text: root.shortcut-steps; color: Theme.text; }
                            for c[i] in root.commands: VerticalLayout {
                                spacing: Theme.s1;
                                padding-top: Theme.s2;
                                Text {
                                    text: c.title;
                                    color: Theme.text;
                                    font-weight: 600;
                                }
                                HorizontalLayout {
                                    spacing: Theme.s2;
                                    Rectangle {
                                        height: 32px;
                                        horizontal-stretch: 1;
                                        border-radius: Theme.radius;
                                        background: Theme.field;
                                        border-width: 1px;
                                        border-color: Theme.line;
                                        Text {
                                            x: Theme.s3;
                                            width: parent.width - 2 * Theme.s3;
                                            text: c.command;
                                            color: Theme.text;
                                            font-family: "monospace";
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    Button {
                                        text: @tr("Copy command");
                                        accessible-label: c.title;
                                        clicked => { root.copy-command(i); }
                                    }
                                }
                                Note { text: c.note; }
                            }
                        }

                        if root.page == 5: VerticalLayout {
                            spacing: Theme.s3;
                            alignment: start;
                            vertical-stretch: 1;
                            Heading { text: @tr("Settings file"); }
                            Text {
                                text: root.settings-file;
                                color: Theme.text;
                                wrap: word-wrap;
                                min-height: self.preferred-height;
                            }
                            HorizontalLayout {
                                spacing: Theme.s2;
                                alignment: start;
                                Button {
                                    text: @tr("Export settings…");
                                    clicked => { root.export-settings(); }
                                }
                                Button {
                                    text: @tr("Import settings…");
                                    enabled: root.settings-writable;
                                    clicked => { root.import-settings(); }
                                }
                                Button {
                                    text: @tr("Reset all settings…");
                                    enabled: root.settings-writable;
                                    clicked => { root.reset-all-settings(); }
                                }
                            }
                            CheckBox { text: @tr("Include filters in settings export"); checked <=> root.export-filters; toggled => { root.export-options-changed(); } }
                            CheckBox { text: @tr("Include bookmarks in settings export"); checked <=> root.export-bookmarks; toggled => { root.export-options-changed(); } }
                            Note { text: @tr("Included saved searches are merged on import. Their keyboard shortcuts are not included."); }
                            Note { text: @tr("Export writes the settings as they are saved: the settings that differ from the defaults, and your keys. Import replaces every setting with those of the chosen file; Reset all puts every setting back to its default. Both ask first, and both index again when the folders to index or their rules change. The search history is never part of the settings."); }
                            if root.pending-text != "": Rectangle {
                                border-radius: Theme.radius;
                                border-width: 1px;
                                border-color: Theme.line;
                                background: Theme.field;
                                HorizontalLayout {
                                    padding: Theme.s3;
                                    spacing: Theme.s2;
                                    Text {
                                        text: root.pending-text;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                        min-height: self.preferred-height;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Button {
                                            text: @tr("Cancel");
                                            clicked => { root.pending-answered(false); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Button {
                                            text: root.pending-action;
                                            primary: true;
                                            clicked => { root.pending-answered(true); }
                                        }
                                    }
                                }
                            }
                            if root.settings-note != "": Note { text: root.settings-note; color: Theme.text; }
                            CheckBox {
                                text: @tr("Apply changes made to the settings file outside this window");
                                checked <=> root.reload-changed;
                                toggled => { root.reload-changed-toggled(); }
                            }
                            CheckBox {
                                text: @tr("Ask before applying them");
                                enabled: root.reload-changed;
                                checked <=> root.ask-reload;
                                toggled => { root.ask-reload-toggled(); }
                            }
                            Note { text: @tr("The file is looked at every 2 seconds. When another program or another EveryGrep window changes it, EveryGrep asks whether to apply the change, or applies it at once, as an import would, when asking is off. Off: such changes apply at the next start, and a change made here keeps them in the file."); }
                            Rectangle { height: Theme.s2; }
                            Heading { text: @tr("All settings"); }
                            HorizontalLayout {
                                spacing: Theme.s3;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    accessible-label: @tr("Search settings");
                                    placeholder-text: @tr("Search settings…");
                                    text <=> root.raw-filter;
                                    edited => { root.raw-filter-changed(); }
                                }
                                CheckBox {
                                    text: @tr("Only changed settings");
                                    checked <=> root.raw-only-changed;
                                    toggled => { root.raw-filter-changed(); }
                                }
                            }
                            StandardTableView {
                                min-height: 240px;
                                columns: [
                                    { title: @tr("Setting"), min-width: 160px },
                                    { title: @tr("Value"), min-width: 120px },
                                    { title: @tr("Default"), min-width: 100px },
                                ];
                                rows: root.raw-rows;
                                current-row <=> root.raw-current;
                                current-row-changed(i) => { root.raw-chosen(i); }
                            }
                            Note { text: @tr("Every setting as the settings file writes it: true or false, numbers, names, and paths with backslash escapes; an empty value is the default where the default is empty. A change applies at once and is saved, as if it were made on its page. Folders, drives and keys repeat their key once per value and are changed on their pages; lines this version does not know are kept as they are."); }
                        }
                    }
                }
                // A line keeps the page apart from the buttons below it, so
                // text cut off at the page's edge never looks covered by them.
                if root.page != 4: Rectangle { height: 1px; background: Theme.line; }
                // The value of the chosen setting and its buttons stay in
                // view below the page, which is taller than the window.
                if root.page == 5: VerticalLayout {
                    padding: Theme.dialog-padding;
                    padding-top: Theme.s2;
                    spacing: Theme.s2;
                    Text {
                        text: root.raw-current >= 0 && root.raw-current < root.raw-rows.length
                            ? root.raw-rows[root.raw-current][0].text : "";
                        color: Theme.text;
                        font-weight: 600;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: Theme.s2;
                        LineEdit {
                            horizontal-stretch: 1;
                            accessible-label: @tr("Value of the chosen setting");
                            enabled: root.raw-editable;
                            text <=> root.raw-value;
                            accepted => { root.raw-apply(); }
                        }
                        Button {
                            text: @tr("Apply");
                            enabled: root.raw-editable;
                            clicked => { root.raw-apply(); }
                        }
                        if root.raw-toggle: Button {
                            text: @tr("Toggle");
                            clicked => { root.raw-toggle-value(); }
                        }
                        Button {
                            text: @tr("Reset");
                            enabled: root.raw-resettable;
                            clicked => { root.raw-reset(); }
                        }
                        Button {
                            text: @tr("Copy");
                            enabled: root.raw-current >= 0;
                            clicked => { root.raw-copy(); }
                        }
                    }
                    if root.raw-error != "": Text {
                        text: root.raw-error;
                        color: Theme.danger;
                        font-size: Theme.small;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                }
                if root.page < 4: HorizontalLayout {
                    alignment: end;
                    padding: Theme.dialog-padding;
                    padding-top: Theme.s2;
                    Button {
                        text: @tr("Reset to defaults");
                        clicked => { root.reset-page(root.page); }
                    }
                }
            }
        }
    }

    // Adding or changing a key: above the page, which cannot be used
    // meanwhile. Esc and Cancel close it, Enter applies.
    if root.key-dialog-open: Rectangle {
        background: #00000060;
        TouchArea { }
        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.key-dialog-cancelled();
                    return accept;
                }
                if (event.text == Key.Return && root.key-can-apply) {
                    root.key-dialog-accepted();
                    return accept;
                }
                reject
            }
            Rectangle {
                width: min(460px, root.width - 2 * Theme.s5);
                height: min(dialog-layout.preferred-height, root.height - 2 * Theme.s5);
                background: Theme.surface;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.line;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000040;
                clip: true;
                dialog-layout := VerticalLayout {
                    padding: Theme.dialog-padding;
                    spacing: Theme.s3;
                    Text {
                        text: root.key-dialog-title;
                        font-size: Theme.body + 2px;
                        font-weight: 600;
                        color: Theme.text;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                    Note { text: root.key-dialog-command; color: Theme.text; }
                    HorizontalLayout {
                        spacing: Theme.s3;
                        Text {
                            text: @tr("Use shortcut in:");
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            horizontal-stretch: 1;
                            accessible-label: @tr("Use shortcut in:");
                            model: root.scope-names;
                            current-index <=> root.key-scope;
                            selected => { root.key-scope-changed(); }
                        }
                    }
                    Text {
                        text: @tr("Shortcut key:");
                        color: Theme.text;
                    }
                    // Takes the next key pressed. Esc cancels and Tab moves
                    // the focus, so the dialog stays usable from the keyboard.
                    capture := FocusScope {
                        height: 36px;
                        accessible-role: text-input;
                        accessible-label: @tr("Shortcut key:");
                        accessible-value: root.key-captured;
                        init => { self.focus(); }
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                root.key-dialog-cancelled();
                                return accept;
                            }
                            if (event.text == Key.Tab || event.text == Key.Backtab) {
                                return reject;
                            }
                            if (!event.repeat) {
                                root.key-pressed-in-dialog(event.text, event.modifiers.control,
                                    event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                            accept
                        }
                        Rectangle {
                            border-radius: Theme.radius;
                            background: Theme.field;
                            border-width: capture.has-focus ? 2px : 1px;
                            border-color: capture.has-focus ? Theme.accent : Theme.field-line;
                            Text {
                                x: Theme.s3;
                                width: parent.width - 2 * Theme.s3;
                                text: root.key-captured != "" ? root.key-captured : @tr("Press a new keyboard shortcut.");
                                color: root.key-captured != "" ? Theme.text : Theme.text-muted;
                                font-weight: root.key-captured != "" ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            TouchArea {
                                clicked => { capture.focus(); }
                            }
                        }
                    }
                    if root.key-refused != "": Text {
                        text: root.key-refused;
                        color: Theme.danger;
                        font-size: Theme.small;
                        wrap: word-wrap;
                        min-height: self.preferred-height;
                    }
                    Text {
                        text: @tr("Shortcut key currently used by:");
                        color: Theme.text;
                    }
                    Note {
                        text: root.key-used-by != "" ? root.key-used-by : @tr("None");
                        color: Theme.text;
                    }
                    if root.key-used-by != "": Note {
                        text: @tr("Adding it removes it from these commands.");
                    }
                    if root.key-also-used != "": Note { text: root.key-also-used; }
                    HorizontalLayout {
                        alignment: end;
                        spacing: Theme.s2;
                        padding-top: Theme.s2;
                        Button {
                            text: @tr("Cancel");
                            clicked => { root.key-dialog-cancelled(); }
                        }
                        Button {
                            text: @tr("OK");
                            primary: true;
                            enabled: root.key-can-apply;
                            clicked => { root.key-dialog-accepted(); }
                        }
                    }
                }
            }
        }
    }

    // Hidden text field used by copy-text().
    clip := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        single-line: false;
        read-only: true;
        enabled: false;
    }
}
