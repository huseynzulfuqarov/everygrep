import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, StandardTableView } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component SavedWindow inherits Window {
    title: root.bookmarks ? @tr("Manage bookmarks") : @tr("Manage filters");
    in property <bool> bookmarks;
    in property <string> shortcut-text;
    callback capture-shortcut(string, bool, bool, bool, bool);
    callback clear-shortcut();
    in property <[string]> sort-names;
    in-out property <int> sort-column;
    in-out property <bool> descending;
    // Layout a filter or bookmark brings along: index 0 keeps the window's.
    in property <[string]> column-choices;
    in-out property <int> column-choice;
    in property <[string]> filter-sorts;
    in-out property <int> filter-sort;
    // Bookmark rows: 0 search, 1 folder, 2 separator (of the edited row).
    in-out property <int> entry-kind;
    in property <[int]> row-kinds;
    private property <int> current-kind: root.current >= 0 && root.current < root.row-kinds.length ? root.row-kinds[root.current] : 0;
    in property <[string]> folder-names;
    in-out property <int> folder-choice;
    callback new-group(int);
    callback import-csv();
    callback export-csv();
    callback open-entry();
    callback open-all-entries();
    callback append-entry();
    callback copy-search();
    in-out property <string> find-text;
    callback find-changed();
    public function focus-find() { finder.focus(); }
    icon: @image-url("../../../data/icons/hicolor/scalable/apps/az.huseynz.EveryGrep.svg");
    preferred-width: 800px;
    preferred-height: 700px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.surface;
    default-font-size: Theme.body;
    forward-focus: table;
    in property <[[StandardListViewItem]]> rows;
    in-out property <int> current <=> table.current-row;
    in-out property <bool> editing;
    // The editor's labels share one column, so its fields line up.
    property <length> label-width: max(m-name.preferred-width, m-search.preferred-width,
        m-filter.preferred-width, m-sort.preferred-width, m-key.preferred-width,
        m-hidden.preferred-width, m-columns.preferred-width, m-folder.preferred-width);
    private property <bool> search-row: !root.bookmarks || root.entry-kind == 0;
    in-out property <string> entry-name;
    in-out property <string> search-text;
    in property <[string]> kinds;
    in-out property <int> kind;
    in-out property <bool> match-case;
    in-out property <bool> whole-words;
    in-out property <bool> match-path;
    in-out property <bool> diacritics;
    in-out property <bool> prefix;
    in-out property <bool> suffix;
    in-out property <bool> punctuation;
    in-out property <bool> whitespace;
    in-out property <bool> regex;
    in property <[string]> hidden-names;
    in-out property <int> hidden-mode;
    in-out property <bool> and-before-or;
    in-out property <bool> literal-operators;
    in-out property <bool> wildcards-anywhere;
    in-out property <bool> deleting;
    in-out property <bool> resetting;
    in property <bool> recoverable;
    in property <string> confirm-name;
    private property <bool> busy: root.editing || root.confirming || root.deleting || root.resetting;
    callback request-remove();
    callback recover();
    in property <string> notice;
    in property <bool> notice-error;
    in-out property <bool> confirming;
    callback begin-edit(bool);
    callback save-entry();
    callback remove-entry();
    callback move-entry(int);
    callback restore();
    callback close-window();

    public function set-color-scheme(scheme: int) {
        Theme.scheme = scheme == 1 ? ColorScheme.light : scheme == 2 ? ColorScheme.dark : ColorScheme.unknown;
        Palette.color-scheme = Theme.scheme;
    }
    public function focus-name() { name.focus(); }

    FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.deleting) { root.deleting = false; }
                else if (root.resetting) { root.resetting = false; }
                else if (root.editing) { root.editing = false; }
                else if (root.confirming) { root.confirming = false; }
                else { root.close-window(); }
                return accept;
            }
            if (!root.busy && event.modifiers.alt && !event.modifiers.control && !event.modifiers.shift && !event.modifiers.meta && (event.text == Key.UpArrow || event.text == Key.DownArrow)) {
                root.move-entry(event.text == Key.UpArrow ? -1 : 1); return accept;
            }
            reject
        }
        ScrollView {
        VerticalLayout {
            padding: Theme.margin;
            spacing: Theme.s2;
            finder := LineEdit {
                accessible-label: root.bookmarks ? @tr("Find Bookmark…") : @tr("Find Filter…");
                placeholder-text: root.bookmarks ? @tr("Find Bookmark…") : @tr("Find Filter…");
                text <=> root.find-text;
                edited => { root.find-changed(); }
            }
            table := StandardTableView {
                accessible-label: root.bookmarks ? @tr("Bookmarks") : @tr("Filters");
                enabled: !root.confirming && !root.deleting && !root.resetting;
                rows: root.rows;
                columns: [ { title: @tr("Name"), width: 240px, horizontal-stretch: 1 }, { title: @tr("Search"), width: 400px, horizontal-stretch: 1 } ];
                min-height: 120px;
            }
            HorizontalLayout {
                spacing: Theme.s2;
                Button { enabled: !root.busy; text: @tr("New"); clicked => { root.begin-edit(true); } }
                if root.bookmarks: Button { enabled: !root.busy; text: @tr("New folder"); clicked => { root.new-group(1); } }
                if root.bookmarks: Button { enabled: !root.busy; text: @tr("New separator"); clicked => { root.new-group(2); } }
                if root.bookmarks: Button { text: @tr("Copy Search"); enabled: !root.busy && root.current >= 0 && root.current-kind == 0; clicked => { root.copy-search(); } }
                Button { text: @tr("Edit"); enabled: !root.busy && root.current >= 0 && root.current-kind != 2; clicked => { root.begin-edit(false); } }
                Button { text: @tr("Delete"); enabled: !root.busy && root.current >= 0; clicked => { root.request-remove(); } }
                Button { text: @tr("Move up"); enabled: !root.busy && root.current > 0; clicked => { root.move-entry(-1); } }
                Button { text: @tr("Move down"); enabled: !root.busy && root.current >= 0 && root.current + 1 < root.rows.length; clicked => { root.move-entry(1); } }
            }
            if root.bookmarks: HorizontalLayout {
                spacing: Theme.s2;
                Button { text: @tr("Open"); enabled: !root.busy && root.current >= 0 && root.current-kind == 0; clicked => { root.open-entry(); } }
                Button { text: @tr("Append to search"); enabled: !root.busy && root.current >= 0 && root.current-kind == 0; clicked => { root.append-entry(); } }
                Button { text: @tr("Open all in tabs"); enabled: !root.busy && root.rows.length > 0; clicked => { root.open-all-entries(); } }
            }
            VerticalLayout {
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Name"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    name := LineEdit { enabled: root.editing; accessible-label: @tr("Name"); text <=> root.entry-name; }
                }
                if root.bookmarks && root.entry-kind != 1: HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Folder"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    ComboBox { enabled: root.editing; accessible-label: @tr("Folder"); model: root.folder-names; current-index <=> root.folder-choice; }
                }
                if root.search-row: VerticalLayout {
                spacing: Theme.s2;
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Search"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    LineEdit { enabled: root.editing; accessible-label: @tr("Search"); text <=> root.search-text; }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Filter"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    ComboBox { enabled: root.editing; accessible-label: @tr("Filter"); model: root.kinds; current-index <=> root.kind; }
                }
                if root.bookmarks: HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Sort by"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    ComboBox { enabled: root.editing; accessible-label: @tr("Sort by"); model: root.sort-names; current-index <=> root.sort-column; }
                    CheckBox { enabled: root.editing; text: @tr("Descending"); checked <=> root.descending; }
                }
                if !root.bookmarks: HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Sort by"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    ComboBox { enabled: root.editing; accessible-label: @tr("Sort by"); model: root.filter-sorts; current-index <=> root.filter-sort; }
                    CheckBox { enabled: root.editing && root.filter-sort > 0; text: @tr("Descending"); checked <=> root.descending; }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Columns"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    ComboBox { enabled: root.editing; accessible-label: @tr("Columns"); model: root.column-choices; current-index <=> root.column-choice; }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Keyboard shortcut"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    capture := FocusScope {
                        height: 36px; min-width: 160px; horizontal-stretch: 1;
                        accessible-role: text-input;
                        accessible-label: @tr("Keyboard shortcut");
                        accessible-value: root.shortcut-text;
                        key-pressed(event) => {
                            if (!root.editing || event.text == Key.Tab || event.text == Key.Backtab || event.text == Key.Escape) { return reject; }
                            if (!event.repeat) {
                                root.capture-shortcut(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta);
                            }
                            accept
                        }
                        Rectangle {
                            background: Theme.field; border-radius: Theme.radius;
                            border-width: capture.has-focus ? 2px : 1px;
                            border-color: capture.has-focus ? Theme.accent : Theme.field-line;
                            Text {
                                x: Theme.s2; width: parent.width - 2 * Theme.s2; height: parent.height;
                                vertical-alignment: center;
                                text: root.shortcut-text != "" ? root.shortcut-text : @tr("Press a new keyboard shortcut.");
                                color: root.shortcut-text != "" ? Theme.text : Theme.text-muted;
                                overflow: elide;
                            }
                            TouchArea { enabled: root.editing; clicked => { capture.focus(); } }
                        }
                    }
                    Button { enabled: root.editing; text: @tr("Clear shortcut"); clicked => { root.clear-shortcut(); } }
                }
                Text { text: @tr("Shortcuts use the active keyboard layout."); color: Theme.text-muted; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Text { text: @tr("Hidden files"); color: Theme.text; vertical-alignment: center; width: root.label-width; }
                    ComboBox { enabled: root.editing; accessible-label: @tr("Hidden files"); model: root.hidden-names; current-index <=> root.hidden-mode; }
                }
                CheckBox { enabled: root.editing; text: @tr("Evaluate AND before OR"); checked <=> root.and-before-or; }
                CheckBox { enabled: root.editing; text: @tr("Allow literal AND / OR / NOT operators"); checked <=> root.literal-operators; }
                CheckBox { enabled: root.editing; text: @tr("Match wildcards anywhere in the filename"); checked <=> root.wildcards-anywhere; }
                GridLayout {
                    spacing-vertical: Theme.s2;
                    spacing-horizontal: Theme.gap;
                    Row {
                        CheckBox { enabled: root.editing; text: @tr("Match case"); checked <=> root.match-case; }
                        CheckBox { enabled: root.editing; text: @tr("Whole words"); checked <=> root.whole-words; }
                        CheckBox { enabled: root.editing; text: @tr("Match full path"); checked <=> root.match-path; }
                    }
                    Row {
                        CheckBox { enabled: root.editing; text: @tr("Match diacritics"); checked <=> root.diacritics; }
                        CheckBox { enabled: root.editing; text: @tr("Match prefix"); checked <=> root.prefix; }
                        CheckBox { enabled: root.editing; text: @tr("Match suffix"); checked <=> root.suffix; }
                    }
                    Row {
                        CheckBox { enabled: root.editing; text: @tr("Ignore punctuation"); checked <=> root.punctuation; }
                        CheckBox { enabled: root.editing; text: @tr("Ignore whitespace"); checked <=> root.whitespace; }
                        CheckBox { enabled: root.editing; text: @tr("Regular expression"); checked <=> root.regex; }
                    }
                }
                }
                HorizontalLayout {
                    spacing: Theme.gap;
                    Button { enabled: root.editing; text: @tr("Save"); clicked => { root.save-entry(); } }
                    Button { text: @tr("Cancel"); clicked => { root.editing = false; } }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.deleting: HorizontalLayout {
                spacing: Theme.gap;
                Text { text: @tr("Delete “{}”?", root.confirm-name); color: Theme.text; wrap: word-wrap; }
                Button { text: @tr("Delete"); clicked => { root.deleting = false; root.remove-entry(); } }
                Button { text: @tr("Cancel"); clicked => { root.deleting = false; } }
            }
            if root.resetting: HorizontalLayout {
                spacing: Theme.gap;
                Text { text: @tr("Save a copy of unreadable saved searches and reset them?"); color: Theme.text; wrap: word-wrap; }
                Button { text: @tr("Save a copy and reset"); clicked => { root.resetting = false; root.recover(); } }
                Button { text: @tr("Cancel"); clicked => { root.resetting = false; } }
            }
            if root.recoverable: Button {
                text: @tr("Save a copy and reset…"); enabled: !root.busy;
                clicked => { root.resetting = true; }
            }
            if root.notice != "": Text { text: root.notice; color: root.notice-error ? Theme.danger : Theme.text-muted; wrap: word-wrap; }
            if root.confirming && !root.bookmarks: HorizontalLayout {
                spacing: Theme.gap;
                Text { text: @tr("Restore built-in filters and keep your own filters?"); color: Theme.text; wrap: word-wrap; }
                Button { text: @tr("Restore"); clicked => { root.confirming = false; root.restore(); } }
                Button { text: @tr("Cancel"); clicked => { root.confirming = false; } }
            }
            HorizontalLayout {
                spacing: Theme.gap;
                Button { visible: !root.bookmarks; text: @tr("Restore default filters"); enabled: !root.busy; clicked => { root.confirming = true; } }
                Button { text: @tr("Import CSV…"); enabled: !root.busy; clicked => { root.import-csv(); } }
                Button { text: @tr("Export CSV…"); enabled: !root.busy; clicked => { root.export-csv(); } }
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Close"); clicked => { root.close-window(); } }
            }
        }
        }
    }
    // Only measure the labels above (not shown).
    m-name := Text { visible: false; text: @tr("Name"); }
    m-search := Text { visible: false; text: @tr("Search"); }
    m-filter := Text { visible: false; text: @tr("Filter"); }
    m-sort := Text { visible: false; text: @tr("Sort by"); }
    m-key := Text { visible: false; text: @tr("Keyboard shortcut"); }
    m-hidden := Text { visible: false; text: @tr("Hidden files"); }
    m-columns := Text { visible: false; text: @tr("Columns"); }
    m-folder := Text { visible: false; text: @tr("Folder"); }
}
