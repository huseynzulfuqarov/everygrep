import { Button, CheckBox, ComboBox, SpinBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component FileopsSettings inherits VerticalLayout {
    in-out property <bool> rename-dialog;
    in-out property <bool> conflict-ask;
    in-out property <bool> undo-enabled;
    in-out property <int> undo-limit;
    in-out property <int> shortcut-kind;
    in-out property <int> shortcut-collision;
    in-out property <bool> search-new-window;
    in-out property <bool> search-recursive;
    in-out property <bool> search-exact-name;
    callback changed();
    changed undo-limit => { history-limit.value = root.undo-limit; }
    spacing: Theme.s2;
    CheckBox {
        text: @tr("Rename in a dialog");
        checked <=> root.rename-dialog;
        toggled => { root.changed(); }
    }
    CheckBox {
        text: @tr("Ask when a pasted name exists");
        checked <=> root.conflict-ask;
        toggled => { root.changed(); }
    }
    CheckBox {
        text: @tr("Enable file undo for this session");
        checked <=> root.undo-enabled;
        toggled => { root.changed(); }
    }
    Text { text: @tr("Maximum undo steps"); color: Theme.text; }
    HorizontalLayout {
        spacing: Theme.gap;
        history-limit := SpinBox { value: root.undo-limit; minimum: 1; maximum: 1000; }
        Button {
            text: @tr("Apply history limit");
            clicked => { root.undo-limit = history-limit.value; root.changed(); }
        }
    }
    Text { text: @tr("Shortcut type"); color: Theme.text; }
    ComboBox {
        model: [@tr("Symbolic link"), @tr("Desktop link")];
        current-index <=> root.shortcut-kind;
        selected => { root.changed(); }
    }
    Text { text: @tr("When a shortcut name exists"); color: Theme.text; }
    ComboBox {
        model: [@tr("Use a numbered name"), @tr("Skip")];
        current-index <=> root.shortcut-collision;
        selected => { root.changed(); }
    }
    CheckBox {
        text: @tr("Open context searches in a new window");
        checked <=> root.search-new-window;
        toggled => { root.changed(); }
    }
    CheckBox {
        text: @tr("Include subfolders in context searches");
        checked <=> root.search-recursive;
        toggled => { root.changed(); }
    }
    CheckBox {
        text: @tr("Search for the exact name from the result menu");
        checked <=> root.search-exact-name;
        toggled => { root.changed(); }
    }
}
